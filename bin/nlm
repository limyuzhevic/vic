def run_simulation(args):
    """Run NLM simulation."""
    print("Starting NLM simulation...")
    
    # Build command
    cmd = ["./build/nlm"]
    
    if args.config:
        cmd.extend(["--config", args.config])
    
    if args.neuron_count:
        cmd.extend(["--neuron-count", str(args.neuron_count)])
    
    if args.region_count:
        cmd.extend(["--region-count", str(args.region_count)])
    
    if args.connection_prob:
        cmd.extend(["--connection-prob", str(args.connection_prob)])
    
    if args.simulation_timestep:
        cmd.extend(["--simulation-timestep", str(args.simulation_timestep)])
    
    if args.enable_stdp:
        cmd.append("--enable-stdp")
    
    if args.enable_hebbian:
        cmd.append("--enable-hebbian")
    
    if args.enable_structural:
        cmd.append("--enable-structural")
    
    if args.enable_homeostatic:
        cmd.append("--enable-homeostatic")
    
    if args.enable_curiosity:
        cmd.append("--enable-curiosity")
    
    if args.enable_dopamine:
        cmd.append("--enable-dopamine")
    
    if args.enable_replay:
        cmd.append("--enable-replay")
    
    if args.enable_development:
        cmd.append("--enable-development")
    
    if args.episodes:
        cmd.extend(["--episodes", str(args.episodes)])
    
    if args.steps:
        cmd.extend(["--steps", str(args.steps)])
    
    if args.output:
        cmd.extend(["--output", args.output])
    
    if args.verbose:
        print(f"Running command: {' '.join(cmd)}")
    
    # Run simulation
    try:
        result = subprocess.run(cmd, capture_output=not args.verbose, text=True)
        if result.returncode != 0:
            print(f"Simulation failed with error code: {result.returncode}")
            if not args.verbose:
                print(f"Error output: {result.stderr}")
            return False
        return True
    except FileNotFoundError:
        print("Error: NLM executable not found. Please build NLM first.")
        return False
    except Exception as e:
        print(f"Error running simulation: {e}")
        return False

def config_command(args):
    """Handle configuration commands."""
    if args.command == "list":
        print("Available configurations:")
        configs_dir = Path("configs")
        if configs_dir.exists():
            for config_file in configs_dir.glob("*.json"):
                print(f"  {config_file.stem}")
        else:
            print("  No configuration directory found")
    
    elif args.command == "show":
        config_file = Path(f"configs/{args.name}.json")
        if config_file.exists():
            with open(config_file, 'r') as f:
                config = json.load(f)
            print(f"Configuration: {config.get('name', args.name)}")
            print(f"Description: {config.get('description', 'No description')}")
            print(f"Version: {config.get('version', 'Unknown')}")
            print("\nSettings:")
            for key, value in config.items():
                if key not in ['name', 'description', 'version']:
                    print(f"  {key}: {value}")
        else:
            print(f"Configuration '{args.name}' not found")
    
    elif args.command == "create":
        config_name = args.name
        config_file = Path(f"configs/{config_name}.json")
        
        if config_file.exists():
            print(f"Configuration '{config_name}' already exists")
            return
        
        # Create default configuration
        default_config = {
            "name": config_name,
            "version": "1.0",
            "description": f"Default configuration for {config_name}",
            "neural": {
                "neuron_count": 500,
                "region_count": 1,
                "connection_probability": 0.1,
                "simulation_timestep": 0.001
            },
            "plasticity": {
                "enable_stdp": True,
                "enable_hebbian": True,
                "enable_structural": False,
                "stdp_ltp_weight": 0.01,
                "stdp_ltd_weight": 0.012
            },
            "environment": {
                "world_width": 50,
                "world_height": 50,
                "vision_range": 16,
                "action_interval": 0.1
            }
        }
        
        with open(config_file, 'w') as f:
            json.dump(default_config, f, indent=2)
        
        print(f"Configuration '{config_name}' created")
    
    elif args.command == "set":
        config_file = Path(f"configs/{args.name}.json")
        if not config_file.exists():
            print(f"Configuration '{args.name}' not found")
            return
        
        with open(config_file, 'r') as f:
            config = json.load(f)
        
        # Set configuration value
        config[args.key] = args.value
        
        with open(config_file, 'w') as f:
            json.dump(config, f, indent=2)
        
        print(f"Configuration '{args.name}' updated")
    
    elif args.command == "validate":
        config_file = Path(f"configs/{args.name}.json")
        if not config_file.exists():
            print(f"Configuration '{args.name}' not found")
            return
        
        with open(config_file, 'r') as f:
            config = json.load(f)
        
        # Validate configuration
        errors = []
        
        if 'neural' not in config:
            errors.append("Missing 'neural' section")
        else:
            if 'neuron_count' not in config['neural']:
                errors.append("Missing 'neuron_count' in neural section")
            elif config['neural']['neuron_count'] <= 0:
                errors.append("'neuron_count' must be greater than 0")
            
            if 'region_count' not in config['neural']:
                errors.append("Missing 'region_count' in neural section")
            elif config['neural']['region_count'] <= 0:
                errors.append("'region_count' must be greater than 0")
            
            if 'connection_probability' not in config['neural']:
                errors.append("Missing 'connection_probability' in neural section")
            elif not (0.0 <= config['neural']['connection_probability'] <= 1.0):
                errors.append("'connection_probability' must be between 0.0 and 1.0")
        
        if errors:
            print("Configuration validation failed:")
            for error in errors:
                print(f"  - {error}")
            return False
        else:
            print("Configuration validation passed")
            return True
    
    elif args.command == "export":
        config_file = Path(f"configs/{args.name}.json")
        if not config_file.exists():
            print(f"Configuration '{args.name}' not found")
            return
        
        output_file = Path(args.output)
        with open(output_file, 'w') as f:
            with open(config_file, 'r') as f_in:
                f.write(f_in.read())
        
        print(f"Configuration exported to {output_file}")
    
    elif args.command == "import":
        input_file = Path(args.file)
        if not input_file.exists():
            print(f"Configuration file '{input_file}' not found")
            return
        
        config_name = args.name
        output_file = Path(f"configs/{config_name}.json")
        
        with open(output_file, 'w') as f:
            with open(input_file, 'r') as f_in:
                f.write(f_in.read())
        
        print(f"Configuration imported as '{config_name}'")
    
    elif args.command == "remove":
        config_file = Path(f"configs/{args.name}.json")
        if config_file.exists():
            config_file.unlink()
            print(f"Configuration '{args.name}' removed")
        else:
            print(f"Configuration '{args.name}' not found")

def analyze_command(args):
    """Handle analysis commands."""
    print(f"Analyzing {args.analysis_type} data...")
    
    if args.file and Path(args.file).exists():
        if args.analysis_type == "pattern-discrimination":
            print("Performing pattern discrimination analysis...")
            # Implementation would go here
            print("Pattern discrimination analysis completed")
        
        elif args.analysis_type == "learning-curves":
            print("Analyzing learning curves...")
