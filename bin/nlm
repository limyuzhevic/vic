#!/usr/bin/env python3
"""
NLM (Neural Learning Machine) Command Line Interface

A comprehensive CLI for NLM with improved usability and advanced features.
"""

import subprocess
import sys
import os
import json
import time
import argparse
from pathlib import Path

def print_help():
    """Print help message."""
    help_text = """
NLM (Neural Learning Machine) - Advanced Brain Simulator

Usage:
    nlm [OPTIONS] [ARGS...]

Core Commands:
    run          Run NLM simulation
    config       Configuration management
    analyze      Analyze simulation results
    benchmark    Run performance benchmark
    help         Show help information
    version      Show version information

Options:
    --config FILE    Load configuration from file
    --output FILE    Output results to file
    --verbose        Enable verbose output
    --quiet          Quiet mode
    --help           Show help message
    --version        Show version information

Examples:
    nlm run                                    # Run default simulation
    nlm run --config configs/expert.cfg          # Run with expert configuration
    nlm config list                            # List all configurations
    nlm config show expert_configuration         # Show configuration details
    nlm analyze pattern-discrimination results.dat
    nlm benchmark --config benchmark_config.json

For more information:
    nlm help
    nlm help command
"""\n    print(help_text)

