            background-color: #2d2d2d;
            color: #f8f8f2;
            padding: 15px;
            border-radius: 4px;
            overflow-x: auto;
            font-family: 'Courier New', monospace;
        }
        .nav-sidebar {
            float: left;
            width: 250px;
            margin-right: 30px;
        }
        .content-wrapper {
            margin-left: 280px;
        }
        .nav-menu {
            background-color: #f8f9fa;
            padding: 20px;
