#!/usr/bin/env bash

# NLM Configuration Utility
# Provides additional CLI commands for common configuration operations

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration utility header
nlm_config() {
    local command="$1"
    shift
    
    case "$command" in
        generate)
            generate_config "$@"
            ;;
        validate)
            validate_config "$@"
            ;;
        list)
            list_config "$@"
            ;;
        help|--help|-h)
            show_config_help
            ;;
        *)
            echo -e "${RED}Error: Unknown configuration command: $command${NC}"
            show_config_help
            exit 1
            ;;
    esac
}

# Generate configuration template
generate_config() {
    local output_file="${1:-template.cfg}"
    
    echo -e "${BLUE}Generating NLM configuration template...${NC}"
    
    cat > "$output_file" << EOF
# NLM Configuration Template
# Generated by nlm-config generate
# Edit these values to customize your NLM simulation

# Core simulation parameters
neuron_count = 500
region_count = 1
simulation_timestep = 0.001
connection_probability = 0.15
random_seed = 42

# STDP parameters
stdp_ltp_weight = 0.02
stdp_ltd_weight = 0.015
stdp_tau = 20.0

# Structural plasticity parameters
synaptogenesis_rate = 0.0001
pruning_rate = 0.00001

# Neuromodulation parameters
neuromodulation_strength = 0.5
novelty_detection_rate = 0.01
curiosity_gain = 0.02

# Working memory parameters
working_memory_capacity = 50
episodic_memory_capacity = 100

# Prediction system parameters
prediction_horizon = 5
planning_horizon = 10

# Social learning parameters
social_learning_rate = 0.1
imitation_accuracy = 0.8

# Environment parameters
environment_seed = 42
max_steps = 1000
reward_decay = 0.95

# Logging parameters
log_level = INFO
log_file = nlm.log
verbose_logging = false
EOF
    
    echo -e "${GREEN}✓ Configuration template generated: $output_file${NC}"
    echo "You can edit this file and use it with: ./nlm --config $output_file"
}

# Validate configuration file
validate_config() {
    local config_file="${1:-configs/default.cfg}"
    
    if [[ ! -f "$config_file" ]]; then
        echo -e "${RED}Error: Configuration file not found: $config_file${NC}"
        exit 1
    fi
    
    echo -e "${BLUE}Validating configuration file: $config_file${NC}"
    
    # Basic validation
    local line_count=$(wc -l < "$config_file")
    local comment_lines=$(grep -c "^\s*#" "$config_file")
    local empty_lines=$(grep -c "^\s*$" "$config_file")
    local key_value_lines=$((line_count - comment_lines - empty_lines))
    
    echo "File statistics:"
    echo "  Total lines: $line_count"
    echo "  Comment lines: $comment_lines"
    echo "  Empty lines: $empty_lines"
    echo "  Key=value lines: $key_value_lines"
    
    # Check for malformed lines
    local malformed=$(grep -v "^\s*[a-zA-Z_][a-zA-Z0-9_]*\s*=.*" "$config_file" | grep -v "^\s*#" | grep -v "^\s*$" | wc -l)
    
    if [[ $malformed -gt 0 ]]; then
        echo -e "${YELLOW}Warning: Found $malformed potentially malformed lines${NC}"
        echo "Malformed lines:"
        grep -v "^\s*[a-zA-Z_][a-zA-Z0-9_]*\s*=.*" "$config_file" | grep -v "^\s*#" | grep -v "^\s*$"
    else
        echo -e "${GREEN}✓ Configuration file format appears valid${NC}"
    fi
}

# List configuration values
list_config() {
    local config_file="${1:-configs/default.cfg}"
    
    if [[ ! -f "$config_file" ]]; then
        echo -e "${RED}Error: Configuration file not found: $config_file${NC}"
        exit 1
    fi
    
    echo -e "${BLUE}NLM Configuration Values:${NC}"
    echo ""
    
    grep -v "^\s*#" "$config_file" | grep -v "^\s*$" | while read -r line; do
        if [[ "$line" == *=* ]]; then
            local key=$(echo "$line" | cut -d'=' -f1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            local value=$(echo "$line" | cut -d'=' -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            echo "  $key = $value"
        fi
    done
}

# Show help information
show_config_help() {
    echo -e "${BLUE}NLM Configuration Utility${NC}"
    echo ""
    echo "Usage: nlm-config <command> [options]"
    echo ""
    echo "Commands:"
    echo "  generate [FILE]    Generate a configuration template (default: template.cfg)"
    echo "  validate FILE      Validate a configuration file"
    echo "  list FILE          List configuration values from file"
    echo "  help               Show this help message"
    echo ""
    echo "Examples:"
    echo "  nlm-config generate                    # Create default template.cfg"
    echo "  nlm-config generate myconfig.cfg       # Create custom template"
    echo "  nlm-config validate configs/myconfig.cfg"
    echo "  nlm-config list configs/default.cfg"
    echo ""
    echo "The generated configuration template includes:"
    echo "  - Core simulation parameters (neuron count, regions, timesteps)"
    echo "  - STDP plasticity rules (LTP, LTD weights)"
    echo "  - Structural plasticity parameters"
    echo "  - Neuromodulation settings"
    echo "  - Memory system configurations"
    echo "  - Prediction and planning parameters"
    echo "  - Social learning capabilities"
    echo "  - Environment settings"
    echo "  - Logging configurations"
}

# Main script when called directly
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    if [[ $# -lt 1 ]]; then
        show_config_help
        exit 1
    fi
    
    nlm_config "$1" "$@"
fi

# Export functions for sourcing
source /dev/stdin << EOF
export -f nlm_config
EOF
