# Function to build NLM
nlm_tools_build() {
    log INFO "Starting NLM build process..."
    
    local debug=false
    local clean=false
    local install=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --debug)
                debug=true
                shift
                ;;
            --clean)
                clean=true
                shift
                ;;
            --install)
                install=true
                shift
                ;;
            --help)
                nlm_tools_command_help build
                return
                ;;
            *)
                log ERROR "Unknown option: $1"
                nlm_tools_command_help build
                return
                ;;
        esac
    done
    
    # Check if build directory exists
    if [[ ! -d "$BUILD_DIR" ]]; then
        log INFO "Creating build directory..."
        mkdir -p "$BUILD_DIR"
    fi
    
    cd "$BUILD_DIR"
    
    if [[ "$clean" == true ]]; then
        log INFO "Cleaning build directory..."
        rm -rf *
    fi
    
    # Configure with CMake
    local build_type="Release"
    if [[ "$debug" == true ]]; then
        build_type="Debug"
    fi
    
    log INFO "Configuring CMake with build type: $build_type"
    cmake "$TOOLS_DIR/.." -DCMAKE_BUILD_TYPE="$build_type" \
        -DCMAKE_CXX_STANDARD=20 \
        -DCMAKE_CXX_STANDARD_REQUIRED=ON \
        -DPYTHON_EXECUTABLE=$(which python3)
    
    if [[ $? -ne 0 ]]; then
        log ERROR "CMake configuration failed"
        return 1
    fi
    
    # Build with parallel jobs
    log INFO "Building NLM with $(nproc) parallel jobs..."
    make -j$(nproc)
    
    if [[ $? -ne 0 ]]; then
        log ERROR "Build failed"
        return 1
    fi
    
    if [[ "$install" == true ]]; then
        log INFO "Installing NLM..."
        make install
        
        if [[ $? -ne 0 ]]; then
            log ERROR "Installation failed"
            return 1
        fi
    fi
    
    log INFO "Build completed successfully!"
}

# Function to run tests
nlm_tools_test() {
    log INFO "Starting NLM test suite..."
    
    local verbose=false
    local quick=false
    local all_tests=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --verbose)
                verbose=true
                shift
                ;;
            --quick)
                quick=true
                shift
                ;;
            --all)
                all_tests=true
                shift
                ;;
            --help)
                nlm_tools_command_help test
                return
                ;;
            *)
                log ERROR "Unknown option: $1"
                nlm_tools_command_help test
                return
                ;;
        esac
    done
    
    # Check if build directory exists and has the test executable
    if [[ ! -f "$BUILD_DIR/nlm_test" ]]; then
        log ERROR "Test executable not found. Please build NLM first."
        return 1
    fi
    
    # Run tests
    if [[ "$quick" == true ]]; then
        log INFO "Running quick tests only..."
        "$BUILD_DIR/nlm_test" --quick
    elif [[ "$all_tests" == true ]]; then
        log INFO "Running all tests..."
        "$BUILD_DIR/nlm_test" --all
    else
        log INFO "Running full test suite..."
        if [[ "$verbose" == true ]]; then
            "$BUILD_DIR/nlm_test" --verbose
        else
            "$BUILD_DIR/nlm_test"
        fi
    fi
    
    local test_result=$?
    
    if [[ $test_result -eq 0 ]]; then
        log INFO "All tests passed!"
    else
        log ERROR "Some tests failed with exit code: $test_result"
    fi
    
    return $test_result
}

# Function to validate configuration
nlm_tools_config_validate() {
    log INFO "Validating configuration..."
    
    local config_file=""
    local format="auto"
    local schema_file=""
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --format)
                format="$2"
                shift 2
                ;;
            --schema)
                schema_file="$2"
                shift 2
                ;;
            --help)
                nlm_tools_command_help config-validate
                return
                ;;
            *)
                if [[ -z "$config_file" ]]; then
                    config_file="$1"
                    shift
                else
                    log ERROR "Unknown option: $1"
                    nlm_tools_command_help config-validate
                    return
                fi
                ;;
        esac
    done
    
    if [[ -z "$config_file" ]]; then
        log ERROR "No configuration file specified"
        nlm_tools_command_help config-validate
        return 1
    fi
    
    if [[ ! -f "$config_file" ]]; then
        log ERROR "Configuration file not found: $config_file"
        return 1
    fi
    
    # Determine format if auto
    if [[ "$format" == "auto" ]]; then
        if [[ "$config_file" == *.json ]]; then
            format="json"
        elif [[ "$config_file" == *.cfg || "$config_file" == *.txt ]]; then
            format="simple"
        else
            format="auto"
        fi
    fi
    
    log INFO "Validating configuration file: $config_file (format: $format)"
    
    # For now, just check if the file is readable and has content
    local file_size=$(stat -f%z "$config_file" 2>/dev/null || stat -c%s "$config_file")
    
    if [[ $file_size -eq 0 ]]; then
        log ERROR "Configuration file is empty"
        return 1
    fi
    
    # Check for basic key=value format
    if [[ "$format" == "simple" ]]; then
        if ! grep -q "=" "$config_file"; then
            log WARN "Configuration file doesn't appear to be in key=value format"
        fi
    fi
    
    log INFO "Configuration validation passed!"
}

