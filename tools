#### Custom Tool Creation

```python
from nlm.tools import BaseTool, ToolArgument
from typing import Dict, Any

class CustomSimulationTool(BaseTool):
    """Custom simulation tool extending NLM tools."""
    
    def __init__(self):
        super().__init__("custom-simulation", "Custom simulation tool")
        self.add_argument("steps", ToolArgument(int, "Number of simulation steps"))
        self.add_argument("neurons", ToolArgument(int, "Number of neurons"))
        self.add_argument("learning_rate", ToolArgument(float, "Learning rate"))
    
    def run(self, arguments: Dict[str, Any]) -> Dict[str, Any]:
        # Custom simulation logic
        config = pynlm.createDefaultConfig()
        config.setInt("brain.neuron_count", arguments["neurons"])
        config.setFloat("plasticity.stdp.learning_rate", arguments["learning_rate"])
        
        brain = pynlm.createBrain(config)
        brain.initialize()
        
        for step in range(arguments["steps"]):
            brain.step(step)
        
        return {
            "total_spikes": brain.getTotalSpikeCount(),
            "firing_rate": brain.getAverageFiringRate()
        }

# Register and use custom tool
from nlm.tools import ToolRegistry
tool_registry = ToolRegistry()
tool_registry.register_tool(CustomSimulationTool())

# Use the tool
results = tool_registry.run_tool("custom-simulation", {
    "steps": 100,
    "neurons": 1000,
    "learning_rate": 0.01
})
