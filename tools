import pynlm
from typing import List, Dict

class MyToolUtils:
    @staticmethod
    def create_brain_from_config(config: Dict[str, Any]) -> pynlm.Brain:
        """Create brain from configuration dictionary."""
        nlm_config = pynlm.createDefaultConfig()
        
        for key, value in config.items():
            if isinstance(value, int):
                nlm_config.setInt(key, value)
            elif isinstance(value, float):
                nlm_config.setFloat(key, value)
            elif isinstance(value, bool):
                nlm_config.setBool(key, value)
            elif isinstance(value, str):
                nlm_config.setString(key, value)
        
        brain = pynlm.createBrain(nlm_config)
        brain.initialize()
        return brain
    
    @staticmethod
    def analyze_results(results: Dict[str, Any]) -> Dict[str, Any]:
        """Analyze simulation results."""
        analysis = {}
        
        # Basic statistics
        analysis['total_spikes'] = results.get('total_spikes', 0)
        analysis['firing_rate'] = results.get('firing_rate', 0.0)
        analysis['neuron_count'] = results.get('neuron_count', 0)
        
        # Advanced statistics
        if 'spike_timestamps' in results:
            analysis['spike_frequency'] = len(results['spike_timestamps']) / max(1, results.get('total_time', 1))
        
        return analysis
