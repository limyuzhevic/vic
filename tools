```bash
# Install system package (if available)
sudo apt install nlm-tools  # Ubuntu/Debian
brew install nlm-tools    # macOS
choco install nlm-tools   # Windows (if available)

# Or install from source
pip install -e .
make install-tools         # (if available)
```

### Development Setup

```bash
# Clone the repository
cd /workspace/app

# Install Python dependencies
pip install -r requirements.txt
pip install -r requirements-dev.txt

# Build command line tools
python setup.py develop
make build-tools         # (if available)

# Make tools executable
chmod +x bin/nlm-*      # (if tools are in bin/ directory)
