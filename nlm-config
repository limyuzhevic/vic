echo_set_config() {
    local config_file="$1"
    local key="$2"
    local value="$3"
    
    if [ ! -f "$config_file" ]; then
        echo -e "${RED}Error: Configuration file not found: $config_file${NC}"
        return 1
    fi
    
    # Check if key already exists
    if grep -q "^[[:space:]]*$key[[:space:]]*=" "$config_file"; then
        # Replace existing line
        sed -i "s/^[[:space:]]*$key[[:space:]]*=[[:space:]].*\$/$key = $value/" "$config_file"
    else
        # Append new key-value pair
        echo "$key = $value" >> "$config_file"
    fi
    
    echo -e "${GREEN}Set configuration key '$key' = '$value' in $config_file${NC}"
}

echo_export_config() {
    local config_file="$1"
    local format="${2:-text}"
    
    if [ ! -f "$config_file" ]; then
        echo -e "${RED}Error: Configuration file not found: $config_file${NC}"
        return 1
    fi
    
    case "$format" in
        "text"|"txt")
            cat "$config_file"
            ;;\n        "json")
            # Simple JSON conversion (limited)
            echo "{"
            local line_num=0
            while IFS= read -r line; do
                # Simple key-value parsing (not robust for all cases)
                if [[ $line =~ ^([a-zA-Z0-9_]+)[[:space:]]*=[[:space:]]*(.+)$ ]]; then
                    key="${BASH_REMATCH[1]}"
                    value="${BASH_REMATCH[2]}"
                    if [ $line_num -gt 0 ]; then
                        echo ","
                    fi
                    # Escape special characters
                    key=$(echo "$key" | sed 's/"/\\"/g')
                    value=$(echo "$value" | sed 's/"/\\"/g')
                    echo -n "  \"$key\": \"$value\""
                    line_num=$((line_num + 1))
                fi
            done < "$config_file"
            echo
            echo "}"
            ;;
        "yaml")
            echo -e "${RED}YAML export not yet implemented${NC}"
            ;;
        "ini")
            echo -e "${RED}INI export not yet implemented${NC}"
            ;;
        *)
            echo -e "${YELLOW}Unknown format '$format'. Available: text, json${NC}"
            ;;
    esac
}

