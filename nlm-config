                    ;;
                "--output"*)
                    echo "  - Output file: ${opt#--output=}"
                    ;;
                *)
                    echo "  - Unknown option: $opt"
                    ;;
            esac
        done
        
        echo ""
        echo -e "${GREEN}Simulation would run with configuration from: $config_file${NC}"
        echo -e "${YELLOW}Note: This is a simulation of the configuration manager.${NC}"
        echo -e "${YELLOW}To actually run the NLM, use: ./nlm --config=$config_file [options]${NC}"
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        echo -e "${YELLOW}Available commands: help, list-configs, validate, create, set, export, run${NC}"
        echo_help
        exit 1
        ;;
esac
