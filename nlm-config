}

# Set configuration value
function set_config() {
    local key="$1"
    local value="$2"
    
    if [[ -z "$key" || -z "$value" ]]; then
        echo "Error: Both key and value must be specified"
        return 1
    fi
    
    case "$key" in
        neuron_count|region_count|random_seed)
            if [[ ! "$value" =~ ^-?[0-9]+$ ]]; then
                echo "Error: $key must be an integer"
                return 1
            fi
            ;;
        simulation_timestep|connection_probability|stdp_ltp_weight|stdp_ltd_weight|stdp_tau|synaptogenesis_rate|pruning_rate)
            if [[ ! "$value" =~ ^-?[0-9]*\.[0-9]+$ ]]; then
                echo "Error: $key must be a floating-point number"
                return 1
            fi
            ;;
        replay_interval|consolidation_interval)
            if [[ ! "$value" =~ ^[0-9]+$ ]]; then
                echo "Error: $key must be a positive integer"
                return 1
            fi
            ;;
        checkpoint_dir|log_level)
            # String values - no validation needed
            ;;
        *)
            echo "Error: Unknown configuration key: $key"
            return 1
            ;;
    esac
    
    echo "Setting $key = $value"
    
    # Save to runtime configuration file
    echo "$key=$value" >> nlm_config.cfg
}

# Check if configuration key exists
function has_config() {
    local key="$1"
    
    if [[ -z "$key" ]]; then
        echo "Error: No configuration key specified"
        return 1
    fi
    
    case "$key" in
        neuron_count|region_count|simulation_timestep|connection_probability|random_seed|stdp_ltp_weight|stdp_ltd_weight|stdp_tau|synaptogenesis_rate|pruning_rate|replay_interval|consolidation_interval|checkpoint_dir|log_level)
            echo "true"
            ;;
        *)
            echo "false"
            ;;
    esac
}

# Remove configuration key
function remove_config() {
    local key="$1"
    
    if [[ -z "$key" ]]; then
        echo "Error: No configuration key specified"
        return 1
    fi
    
    if [[ -f "nlm_config.cfg" ]]; then
        # Remove from runtime configuration file
        sed -i "/^$key=/d" nlm_config.cfg
        echo "Removed $key from configuration"
    else
        echo "Configuration key $key not found in runtime configuration"
    fi
}

# Validate configuration file
function validate_config() {
    local config_file="$1"
    
    if [[ -z "$config_file" ]]; then
        echo "Error: No configuration file specified"
        return 1
    fi
    
    if [[ ! -f "$config_file" ]]; then
        echo "Error: Configuration file not found: $config_file"
        return 1
    fi
    
    echo "Validating configuration file: $config_file"
    
    local line_number=0
    local errors=0
    local warnings=0
    
    while IFS= read -r line; do
        ((line_number++))
        
        # Skip empty lines and comments
        line=$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        
        if [[ -z "$line" ]] || [[ "$line" == \#* ]] || [[ "$line" == \/* ]]; then
            continue
        fi
        
        # Validate key=value format
        if [[ ! "$line" == *"="* ]]; then
            echo "  Line $line_number: Invalid format (expected key=value)"
            ((errors++))
            continue
        fi
        
        local key=$(echo "$line" | cut -d'=' -f1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        local value=$(echo "$line" | cut -d'=' -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        
        # Validate key
        if [[ -z "$key" ]]; then
            echo "  Line $line_number: Empty key"
            ((errors++))
            continue
        fi
        
        # Validate value (basic check)
        if [[ -z "$value" ]]; then
            echo "  Line $line_number: Empty value"
            ((warnings++))
        fi
    done < "$config_file"
    
    if [[ $errors -eq 0 ]]; then
        echo "Configuration file validation successful"
    else
        echo "Configuration file validation failed with $errors errors and $warnings warnings"
    fi
    
    return $((errors > 0 ? 1 : 0))
}

# Export configuration to file
function export_config() {
    local output_file="$1"
    
    if [[ -z "$output_file" ]]; then
        echo "Error: No output file specified"
        return 1
    fi
    
    echo "Exporting configuration to: $output_file"
    
    # Get current configuration values
    cat << EOF > "$output_file"
# NLM Configuration Export
# Generated on $(date)
# Version: 2.0.0

neuron_count = 1000
region_count = 1
simulation_timestep = 0.001
connection_probability = 0.1
random_seed = 42
stdp_ltp_weight = 0.02
stdp_ltd_weight = 0.015
stdp_tau = 20.0
synaptogenesis_rate = 0.0001
pruning_rate = 0.00001
replay_interval = 100
consolidation_interval = 1000
checkpoint_dir = ./checkpoints
log_level = INFO

# Runtime configuration (from nlm_config.cfg)
EOF
    
    # Append runtime configuration if it exists
    if [[ -f "nlm_config.cfg" ]]; then
        cat nlm_config.cfg >> "$output_file"
    fi
    
    echo "Configuration exported successfully"
}

# Import configuration from file
function import_config() {
    local input_file="$1"
    
    if [[ -z "$input_file" ]]; then
        echo "Error: No input file specified"
        return 1
    fi
    
    if [[ ! -f "$input_file" ]]; then
        echo "Error: Configuration file not found: $input_file"
        return 1
    fi
    
    echo "Importing configuration from: $input_file"
    
    # Create backup of existing configuration
    if [[ -f "nlm_config.cfg" ]]; then
        cp nlm_config.cfg nlm_config.cfg.backup
        echo "  Backed up existing configuration to nlm_config.cfg.backup"
    fi
    
    # Clear existing configuration
    > nlm_config.cfg
    
    # Import configuration file
    while IFS= read -r line; do
        # Skip empty lines and comments
        line=$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        
        if [[ -z "$line" ]] || [[ "$line" == \#* ]] || [[ "$line" == \/* ]]; then
            continue
        fi
        
        # Parse key=value pairs
        if [[ "$line" == *"="* ]]; then
            local key=$(echo "$line" | cut -d'=' -f1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            local value=$(echo "$line" | cut -d'=' -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            
            echo "  $key = $value"
            echo "$key=$value" >> nlm_config.cfg
        else
            echo "  Warning: Ignoring invalid line: $line"
        fi
    done < "$input_file"
    
    echo "Configuration imported successfully"
}

# Merge configuration from file
function merge_config() {
    local input_file="$1"
    
    if [[ -z "$input_file" ]]; then
        echo "Error: No input file specified"
        return 1
    fi
    
    if [[ ! -f "$input_file" ]]; then
        echo "Error: Configuration file not found: $input_file"
        return 1
    fi
    
    echo "Merging configuration from: $input_file"
    
    # Create backup of existing configuration
    if [[ -f "nlm_config.cfg" ]]; then
        cp nlm_config.cfg nlm_config.cfg.backup
        echo "  Backed up existing configuration to nlm_config.cfg.backup"
    fi
    
    # Merge configuration file
    while IFS= read -r line; do
        # Skip empty lines and comments
        line=$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        
        if [[ -z "$line" ]] || [[ "$line" == \#* ]] || [[ "$line" == \/* ]]; then
            continue
        fi
        
        # Parse key=value pairs
        if [[ "$line" == *"="* ]]; then
            local key=$(echo "$line" | cut -d'=' -f1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            local value=$(echo "$line" | cut -d'=' -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            
            # Check if key already exists
            if grep -q "^$key=" nlm_config.cfg; then
                echo "  Updating existing key: $key"
                sed -i "/^$key=/c\$key=$value" nlm_config.cfg
            else
                echo "  Adding new key: $key"
                echo "$key=$value" >> nlm_config.cfg
            fi
        else
            echo "  Warning: Ignoring invalid line: $line"
        fi
    done < "$input_file"
    
    echo "Configuration merged successfully"
}

# Main function
function main() {
    local verbose=false
    
    # Parse command line arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help|-h)
                show_config_help
                exit 0
                ;;
            --version|-v)
                show_version
                exit 0
                ;;
            --verbose|-V)
                verbose=true
                shift
                ;;
            --quiet|-q)
                verbose=false
                shift
                ;;
            --list|-l)
                list_config
                shift
                ;;
            --get|-g)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --get requires a key argument"
                    exit 1
                fi
                get_config "$2"
                shift 2
                ;;
            --set|-s)
                if [[ $# -lt 2 ]] || [[ ! "$2" == *=* ]]; then
                    echo "Error: --set requires key=value argument"
                    exit 1
                fi
                local key_value="$2"
                local key=$(echo "$key_value" | cut -d'=' -f1)
                local value=$(echo "$key_value" | cut -d'=' -f2-)
                set_config "$key" "$value"
                shift 2
                ;;
            --has)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --has requires a key argument"
                    exit 1
                fi
                if [[ "$verbose" == true ]]; then
                    echo "Checking if configuration key exists: $2"
                fi
                has_config "$2"
                shift 2
                ;;
            --remove)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --remove requires a key argument"
                    exit 1
                fi
                remove_config "$2"
                shift 2
                ;;
            --clear)
                if [[ "$verbose" == true ]]; then
                    echo "Clearing all configuration values"
                fi
                rm -f nlm_config.cfg
                echo "Configuration cleared"
                shift
                ;;
            --validate)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --validate requires a file argument"
                    exit 1
                fi
                validate_config "$2"
                shift 2
                ;;
            --export)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --export requires a file argument"
                    exit 1
                fi
                export_config "$2"
                shift 2
                ;;
            --import)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --import requires a file argument"
                    exit 1
                fi
                import_config "$2"
                shift 2
                ;;
            --merge)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --merge requires a file argument"
                    exit 1
                fi
                merge_config "$2"
                shift 2
                ;;
            --print|-p)
                echo "Current configuration:"
                get_config neuron_count
                get_config region_count
                get_config simulation_timestep
                get_config connection_probability
                shift
                ;;
            --load)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --load requires a file argument"
                    exit 1
                fi
                load_config "$2"
                shift 2
                ;;
            --source)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --source requires a file argument"
                    exit 1
                fi
                load_config "$2"
                shift 2
                ;;
            --reset)
                if [[ "$verbose" == true ]]; then
                    echo "Resetting configuration to defaults"
                fi
                rm -f nlm_config.cfg
                echo "Configuration reset to defaults"
                shift
                ;;
            *)
                echo "Error: Unknown option: $1"
                show_config_help
                exit 1
                ;;
        esac
    done
}

# Execute main function with all arguments
main "$@"