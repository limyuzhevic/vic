#!/usr/bin/env bash

# NLM Configuration Manager Tool
# A command-line tool to help users configure and run NLM simulations

# Colors for output
GREEN="\033[0;32m"
RED="\033[0;31m"
YELLOW="\033[1;33m"
BLUE="\033[0;34m"
NC="\033[0m" # No Color

echo_help() {
    echo "NLM Configuration Manager Tool"
    echo "==============================="
    echo ""
    echo "Usage: nlm-config [COMMAND] [OPTIONS]"
    echo ""
    echo "Commands:"
    echo "  help                    Show this help message"
    echo "  list-configs          List available configuration templates"
    echo "  validate <file>       Validate a configuration file"
    echo "  create <name> [type]  Create a new configuration file"
    echo "  set <file> <key> <value>  Set a configuration value"
    echo "  run <file> [options] Run the NLM brain with this configuration"
    echo "  export <file> [format] Export configuration to different formats"
    echo ""
    echo "Common options for 'run':"
    echo "  --verbose, -v         Enable verbose output"
    echo "  --debug, -d           Enable debug mode"
    echo "  --steps <N>          Number of simulation steps (default: 100)"
    echo "  --output <file>       Save output to file"
    echo ""
    echo "Examples:""
    echo "  nlm-config help"
    echo "  nlm-config list-configs"
    echo "  nlm-config validate configs/my_config.cfg"
    echo "  nlm-config create my_exp phase3"
    echo "  nlm-config run configs/default.cfg --verbose --steps 1000"
    echo "  nlm-config export configs/default.cfg json"
}

echo_list_configs() {
    echo "Available configuration templates:"
    echo "================================"
    echo ""
    
    # Find all config files
    if [ -d "configs" ]; then
        for config in configs/*.cfg; do
            if [ -f "$config" ]; then
                local name=$(basename "$config" .cfg)
                echo "  $name"
                echo "    Path: $config"
                echo "    Preview:"
                head -10 "$config" | sed 's/^/      /'
                echo ""
            fi
        done
    else
        echo "  No configs directory found"
    fi
    
    echo ""
    echo "Built-in templates:"
    echo "  phase2         - Basic neural computation (LIF neurons, STDP plasticity)"
    echo "  phase3         - World interaction with reward and developmental stages"
    echo "  phase6         - Full integration with memory, prediction, cognition"
    echo "  debug          - High-verbosity debug configuration"
    echo "  minimal        - Minimal configuration for testing"
    echo "  research       - Research-oriented configuration with extended parameters"
}

echo_validate_config() {
    local config_file="$1"
    
    if [ ! -f "$config_file" ]; then
        echo -e "${RED}Error: Configuration file not found: $config_file${NC}"
        return 1
    fi
    
    echo -e "${BLUE}Validating configuration: $config_file${NC}"
    echo ""
    
    # Check for basic structure
    if grep -q "#.*NLM Configuration" "$config_file"; then
        echo -e "${GREEN}✓ Basic configuration header found${NC}"
    else
        echo -e "${YELLOW}⚠ No standard configuration header found${NC}"
    fi
    
    # Check for required keys
    local required_keys=("random_seed" "simulation_timestep" "neuron_count" "region_count")
    local missing_keys=0
    
    for key in "${required_keys[@]}"; do
        if ! grep -q "^[[:space:]]*$key[[:space:]]*=" "$config_file"; then
            echo -e "${RED}✗ Missing required key: $key${NC}"
            missing_keys=$((missing_keys + 1))
        fi
    done
    
    if [ $missing_keys -eq  puisse ]; then
        echo -e "${GREEN}✓ All required keys present${NC}"
    fi
    
    # Check file syntax
    if grep -q "=" "$config_file"; then
        echo -e "${GREEN}✓ Configuration syntax appears valid${NC}"
    else
        echo -e "${YELLOW}⚠ No configuration assignments found${NC}"
    fi
    
    # Count key-value pairs
    local key_count=$(grep -c "^[[:space:]]*[a-zA-Z0-9_]*[[:space:]]*=" "$config_file" 2>/dev/null || echo 0)
    echo "Found ${BLUE}$key_count${NC} configuration parameters"
    
    echo ""
    echo -e "${GREEN}Configuration validation complete${NC}"
}

