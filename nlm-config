#!/bin/bash

# NLM Configuration Tool
# Command-line interface for managing NLM configurations

# Configuration tool version
VERSION="1.0.0"

# Configuration file directory
CONFIG_DIR="~/.nlm-config"

# Color definitions
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_color() {
    local color=$1
    local message=$2
    echo -e "${color}${message}${NC}"
}

# Function to print error
print_error() {
    print_color $RED "Error: $1"
}

# Function to print warning
print_warning() {
    print_color $YELLOW "Warning: $1"
}

# Function to print info
print_info() {
    print_color $BLUE "Info: $1"
}

# Function to show help
function show_help {
    cat << EOF
NLM Configuration Tool (nlm-config) v$VERSION

Usage: nlm-config <command> [options]

Commands:

  validate <file>          Validate configuration file
  compare <file1> <file2>  Compare two configuration files
  merge <file1> <file2> <output>  Merge configuration files
  export <file> <format>    Export configuration to different formats
  import <file> <format>    Import configuration from different formats
  list                     List available presets
  create <name>            Create a new configuration preset
  template <name>          Generate configuration template
  info <file>              Show configuration information
  backup                   Create configuration backup
  restore <backup>         Restore configuration from backup
  backup list              List all backup files
  backup clean             Remove old backup files
  help                     Show this help message

Options:

  -h, --help              Show help message
  -v, --version           Show version information
  -f, --format <format>    Specify configuration format (cfg, json, yaml)
  -o, --output <file>      Specify output file
  -s, --show-errors       Show detailed error information
  -q, --quiet             Quiet mode (minimal output)

Configuration File Formats:
  cfg - Basic key=value format
  json - JSON format
  yaml - YAML format

Preset Management:
  Presets are stored in ~/.nlm-config/presets/
  Use 'nlm-config list' to see available presets
  Use 'nlm-config create <name>' to create new preset
  Use 'nlm-config template <name>' to generate template

Backup Management:
  Backups are stored in ~/.nlm-config/backups/
  Use 'nlm-config backup' to create backup
  Use 'nlm-config backup list' to list backups
  Use 'nlm-config restore <backup>' to restore
  Use 'nlm-config backup clean' to remove old backups

Examples:

  # Validate a configuration file
  nlm-config validate my_config.cfg

  # Compare two configuration files
  nlm-config compare config_v1.cfg config_v2.cfg

  # Merge configurations
  nlm-config merge base.cfg overrides.cfg merged.cfg

  # Export to JSON format
  nlm-config export my_config.cfg my_config.json

  # Import from JSON format
  nlm-config import my_config.json my_config.cfg

  # Show configuration information
  nlm-config info my_config.cfg

  # Create a new preset
  nlm-config create my_preset

  # Generate template for a preset
  nlm-config template my_preset > template.cfg

  # List available presets
  nlm-config list

  # Create backup
  nlm-config backup

  # Restore from backup
  nlm-config restore backup_2024_01_18.cfg

For more information, visit: https://github.com/your-repo/nlm
EOF
}

# Function to show version
function show_version {
    echo "NLM Configuration Tool v$VERSION"
    echo "Configuration file format support: cfg, json, yaml"
    echo "Built with bash $(bash --version | cut -d' ' -f4)"
}

# Function to validate configuration file
function validate_config {
    local file=$1
    local show_errors=${2:-false}
    local quiet=${3:-false}

    if [ ! -f "$file" ]; then
        print_error "Configuration file not found: $file"
        return 1
    fi

    local extension=${file##*.}

    case $extension in
        cfg|config)
            # Basic key=value format validation
            if ! grep -q '=' "$file" 2>/dev/null; then
                print_error "Invalid cfg file format: $file"
                return 1
            fi
            ;;
        json)
            # JSON validation using python if available
            if command -v python3 &> /dev/null; then
                if ! python3 -m json.tool "$file" &> /dev/null; then
                    print_error "Invalid JSON file: $file"
                    return 1
                fi
            else
                print_warning "Python not found, skipping JSON validation"
            fi
            ;;
        yaml|yml)
            # YAML validation using python if available
            if command -v python3 &> /dev/null; then
                if ! python3 -c "import yaml; yaml.safe_load(open('$file'))" &> /dev/null; then
                    print_error "Invalid YAML file: $file"
                    return 1
                fi
            else
                print_warning "Python not found, skipping YAML validation"
            fi
            ;;
        *)
            print_error "Unsupported configuration file format: .$extension"
            return 1
            ;;
    esac

    if [ "$quiet" = false ]; then
        print_info "Validating configuration file: $file"
        echo "Validation passed: $file"
    fi

    return 0
}

# Function to compare configuration files
function compare_configs {
    local file1=$1
    local file2=$2
    local quiet=${3:-false}

    if [ ! -f "$file1" ] || [ ! -f "$file2" ]; then
        print_error "One or both configuration files not found"
        return 1
    fi

    local ext1=${file1##*.}
    local ext2=${file2##*.}

    if [ "$ext1" != "$ext2" ]; then
        print_warning "Different file formats: .$ext1 vs .$ext2"
    fi

    if [ "$quiet" = false ]; then
        print_info "Comparing configuration files: $file1 vs $file2"
        echo "Comparing: $file1 vs $file2"
    fi

    # Simple comparison based on file format
    case $ext1 in
        cfg|config)
            echo "Keys in $file1: $(grep -c '^[^#]*=' "$file1" 2>/dev/null || echo 0)"
            echo "Keys in $file2: $(grep -c '^[^#]*=' "$file2" 2>/dev/null || echo 0)"
            ;;
        json)
            if command -v python3 &> /dev/null; then
                keys1=$(python3 -c "import json; data=json.load(open('$file1')); print(len(data.get('nlm', {}).get('configuration', {})))" 2>/dev/null || echo 0)
                keys2=$(python3 -c "import json; data=json.load(open('$file2')); print(len(data.get('nlm', {}).get('configuration', {})))" 2>/dev/null || echo 0)
                echo "Keys in $file1: $keys1"
                echo "Keys in $file2: $keys2"
            fi
            ;;
        yaml|yml)
            if command -v python3 &> /dev/null; then
                keys1=$(python3 -c "import yaml; data=yaml.safe_load(open('$file1')); print(len(data.get('nlm', {}).get('configuration', {})))" 2>/dev/null || echo 0)
                keys2=$(python3 -c "import yaml; data=yaml.safe_load(open('$file2')); print(len(data.get('nlm', {}).get('configuration', {})))" 2>/dev/null || echo 0)
                echo "Keys in $file1: $keys1"
                echo "Keys in $file2: $keys2"
            fi
            ;;
    esac

    echo "Comparison completed"
}

# Function to merge configuration files
function merge_configs {
    local file1=$1
    local file2=$2
    local output=$3
    local quiet=${4:-false}

    if [ ! -f "$file1" ] || [ ! -f "$file2" ]; then
        print_error "One or both configuration files not found"
        return 1
    fi

    if [ -z "$output" ]; then
        print_error "Output file not specified"
        return 1
    fi

    local ext1=${file1##*.}
    local ext2=${file2##*.}
    local output_ext=${output##*.}

    if [ "$quiet" = false ]; then
        print_info "Merging configuration files: $file1 + $file2 -> $output"
        echo "Merging: $file1 + $file2 -> $output"
    fi

    # Simple merge based on file format
    case $ext1 in
        cfg|config)
            cat "$file1" > "$output"
            echo "" >> "$output"
            echo "# Merged from $file2" >> "$output"
            grep -v '^#' "$file2" >> "$output" 2>/dev/null || cat "$file2" >> "$output"
            ;;
        json)
            if command -v python3 &> /dev/null; then
                python3 << EOF
import json
import sys

# Load both files
with open('$file1', 'r') as f1:
    data1 = json.load(f1)

with open('$file2', 'r') as f2:
    data2 = json.load(f2)

# Merge configuration sections
if 'nlm' in data1 and 'nlm' in data2:
    data1['nlm']['configuration'].update(data2['nlm']['configuration'])

# Write merged result
with open('$output', 'w') as f:
    json.dump(data1, f, indent=2)
EOF
            fi
            ;;
        yaml|yml)
            if command -v python3 &> /dev/null; then
                python3 << EOF
import yaml
import sys

# Load both files
with open('$file1', 'r') as f1:
    data1 = yaml.safe_load(f1)

with open('$file2', 'r') as f2:
    data2 = yaml.safe_load(f2)

# Merge configuration sections
if 'nlm' in data1 and 'nlm' in data2:
    data1['nlm']['configuration'].update(data2['nlm']['configuration'])

# Write merged result
with open('$output', 'w') as f:
    yaml.dump(data1, f, default_flow_style=False)
EOF
            fi
            ;;
    esac

    echo "Merge completed: $output"
}

# Function to export configuration
