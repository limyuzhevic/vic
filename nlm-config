# Function to import configuration
function import_config {
    local input_file=$1
    local output_file=$2
    local quiet=${3:-false}

    if [ ! -f "$input_file" ]; then
        print_error "Input file not found: $input_file"
        return 1
    fi

    if [ -z "$output_file" ]; then
        print_error "Output file not specified"
        return 1
    fi

    local input_ext=${input_file##*.}

    if [ "$quiet" = false ]; then
        print_info "Importing configuration: $input_file -> $output_file"
        echo "Importing: $input_file -> $output_file"
    fi

    # Convert based on format
    case $input_ext in
        json)
            if command -v python3 &> /dev/null; then
                python3 << EOF
import json

# Load JSON file
with open('$input_file', 'r') as f:
    data = json.load(f)

# Extract configuration
config = data.get('nlm', {}).get('configuration', {})

# Write to cfg file
with open('$output_file', 'w') as f:
    for key, value in config.items():
        if isinstance(value, str):
            f.write(f'{key} = "{value}"\n')
        elif isinstance(value, bool):
            f.write(f'{key} = {str(value).lower()}\n')
        else:
            f.write(f'{key} = {value}\n')
print(f"Imported to cfg: $output_file")
EOF
            fi
            ;;
        yaml|yml)
            if command -v python3 &> /dev/null; then
                python3 << EOF
import yaml

# Load YAML file
with open('$input_file', 'r') as f:
    data = yaml.safe_load(f)

# Extract configuration
config = data.get('nlm', {}).get('configuration', {})

# Write to cfg file
with open('$output_file', 'w') as f:
    for key, value in config.items():
        if isinstance(value, str):
            f.write(f'{key} = "{value}"\n')
        elif isinstance(value, bool):
