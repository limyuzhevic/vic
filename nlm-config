#!/usr/bin/env bash
# NLM Configuration Management Tool
# Advanced tool for managing NLM configurations

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Print usage information
print_usage() {
    cat << EOF
NLM Configuration Management Tool

Usage: nlm-config <command> [options]

Commands:
  validate <file>              Validate configuration file
  list-options                 List all available configuration options
  compare <file1> <file2>      Compare two configuration files
  generate <output_file>        Generate sample configuration
  info <file>                   Display configuration information
  backup <file> <output_dir>    Create backup of configuration

Options:
  --help                      Show this help message
  --version                   Show version information

Examples:
  nlm-config validate config.cfg
  nlm-config list-options
  nlm-config compare config1.cfg config2.cfg
  nlm-config generate sample.cfg
  nlm-config info config.cfg
EOF
}

# Print version information
print_version() {
    cat << EOF
NLM Configuration Management Tool v2.($(date +%Y))
Part of NLM (Neural Learning Machine) Project

Configuration System Improvements:
- Fixed saveToFile() to properly serialize all ConfigValue types
- Improved loadFromFile() with validation and error handling
- Enhanced loadFromArgs() with key validation
- Added comprehensive error handling
- Support for JSON/YAML format (Phase 2+)

Built with C++20
EOF
}

# Validate configuration file
validate_config() {
    local config_file="$1"
    
    echo -e "${BLUE}Validating configuration file: $config_file${NC}"
    
    if [ ! -f "$config_file" ]; then
        echo -e "${RED}Error: File not found: $config_file${NC}"
        return 1
    fi
    
    # Simple validation logic
    echo -e "${GREEN}File exists and is readable${NC}"
    
    # Count lines and check for basic syntax
    local total_lines=$(wc -l < "$config_file")
    local comment_lines=$(grep -c "^\s*#" "$config_file" || true)
    local empty_lines=$(grep -c "^\s*$" "$config_file" || true)
    local valid_entries=$((total_lines - comment_lines - empty_lines))
    
    echo -e "Statistics:"
    echo -e "  Total lines: $total_lines"
    echo -e "  Comment lines: $comment_lines"
    echo -e "  Empty lines: $empty_lines"
    echo -e "  Valid key=value entries: $valid_entries"
    
    # Check for malformed entries
    local malformed=0
    while IFS= read -r line; do
        # Skip empty lines and comments
        if [[ -z "$line" ]] || [[ "$line" =~ ^\s*# ]]; then
            continue
        fi
        
        # Check if line contains '='
        if [[ ! "$line" =~ = ]]; then
            echo -e "${YELLOW}Warning: Line appears malformed (no '='): $line${NC}"
            ((malformed++))
        fi
    done < "$config_file"
    
    echo -e "Validation results: ${valid_entries} entries, $malformed malformed lines"
    
    if [ $malformed -eq 0 ]; then
        echo -e "${GREEN}✓ Configuration file appears valid${NC}"
        return 0
    else
        echo -e "${RED}✗ Configuration file has issues${NC}"
        return 1
    fi
}

