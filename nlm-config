visualization_update_rate = 30.0
EOF
}

# Function to show preset info
function info_preset {
    local file=$1
    local quiet=${2:-false}

    if [ ! -f "$file" ]; then
        print_error "Configuration file not found: $file"
        return 1
    fi

    if [ "$quiet" = false ]; then
        print_info "Showing configuration information: $file"
        echo "Configuration Information: $file"
        echo "===================================="
    fi

    local ext=${file##*.}

    case $ext in
        cfg|config)
            echo "File: $file"
            echo "Format: Basic Configuration (.cfg)"
            echo ""
            echo "Configuration Keys:"
            grep -h '^[^#]*=' "$file" | while read line; do
                local key=$(echo "$line" | cut -d'=' -f1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
                local value=$(echo "$line" | cut -d'=' -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
                echo "  $key = $value"
            done
            ;;
        json)
            if command -v python3 &> /dev/null; then
                python3 << EOF
import json

# Load and display JSON information
try:
    with open('$file', 'r') as f:
        data = json.load(f)

    print(f"File: $file")
    print(f"Format: JSON")
    print(f"Version: {data.get('nlm', {}).get('version', 'Unknown')}")
    print(f"Description: {data.get('nlm', {}).get('description', 'Unknown')}")
    print("")
    print("Configuration Keys:")
    config = data.get('nlm', {}).get('configuration', {})
    for key, value in config.items():
        print(f"  $key = {value}")
except Exception as e:
    print(f"Error reading JSON file: {e}")
EOF
            fi
            ;;
        yaml|yml)
            if command -v python3 &> /dev/null; then
                python3 << EOF
import yaml

# Load and display YAML information
try:
    with open('$file', 'r') as f:
        data = yaml.safe_load(f)

    print(f"File: $file")
    print(f"Format: YAML")
    print(f"Version: {data.get('nlm', {}).get('version', 'Unknown')}")
    print(f"Description: {data.get('nlm', {}).get('description', 'Unknown')}")
    print("")
    print("Configuration Keys:")
    config = data.get('nlm', {}).get('configuration', {})
    for key, value in config.items():
        print(f"  $key = {value}")
except Exception as e:
    print(f"Error reading YAML file: {e}")
EOF
            fi
            ;;
    esac

    echo "\nFile size: $(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null || echo "Unknown") bytes"
}

# Function to create backup
function create_backup {
    local source_dir="$CONFIG_DIR"
    local backup_dir="$CONFIG_DIR/backups"
    local timestamp=$(date +%Y%m%d_%H%M%S)
    local backup_file="$backup_dir/config_backup_$timestamp.tar.gz"

    if [ ! -d "$source_dir" ]; then
        print_error "Configuration directory not found: $source_dir"
        return 1
    fi

    if [ ! -d "$backup_dir" ]; then
        mkdir -p "$backup_dir"
    fi

    print_info "Creating configuration backup..."
    print_info "Source: $source_dir"
    print_info "Backup: $backup_file"

    tar -czf "$backup_file" -C "$(dirname "$source_dir")" "$(basename "$source_dir")" 2>/dev/null

    if [ $? -eq 0 ]; then
        echo "Backup created successfully: $backup_file"
        echo "Backup size: $(du -h "$backup_file" | cut -f1)"
    else
        print_error "Failed to create backup"
        return 1
    fi
}

# Function to restore backup
function restore_backup {
    local backup_file=$1
    local quiet=${2:-false}

    if [ ! -f "$backup_file" ]; then
        print_error "Backup file not found: $backup_file"
        return 1
    fi

    local backup_dir="$CONFIG_DIR/backups"
    local source_dir="$CONFIG_DIR"

    if [ "$quiet" = false ]; then
        print_info "Restoring configuration from backup..."
        print_info "Backup: $backup_file"
        print_info "Target: $source_dir"
    fi

    # Create backup directory
    if [ ! -d "$backup_dir" ]; then
        mkdir -p "$backup_dir"
    fi

    # Extract backup
    tar -xzf "$backup_file" -C "$(dirname "$source_dir")" 2>/dev/null

    if [ $? -eq 0 ]; then
        echo "Configuration restored successfully from: $backup_file"
    else
        print_error "Failed to restore configuration"
        return 1
    fi
}

# Function to list backups
function list_backups {
    local backup_dir="$CONFIG_DIR/backups"

    if [ ! -d "$backup_dir" ]; then
        print_error "Backup directory not found: $backup_dir"
        return 1
    fi

    echo "Available Backups:"
    echo "=================="
    ls -la "$backup_dir"/*.tar.gz 2>/dev/null | while read line; do
        local backup_file=$(echo "$line" | awk '{print $9}')
        local backup_size=$(echo "$line" | awk '{print $5}')
        local backup_date=$(echo "$line" | awk '{print $6,$7,$8}')

        echo "  $backup_file"
        echo "    Size: $backup_size"
        echo "    Date: $backup_date"
    done
}

# Function to clean backups
function clean_backups {
    local backup_dir="$CONFIG_DIR/backups"
    local older_than=${1:-30d}

    if [ ! -d "$backup_dir" ]; then
        print_error "Backup directory not found: $backup_dir"
        return 1
    fi

    echo "Cleaning old backup files..."
    echo "Removing backups older than: $older_than"

    # Find and remove old backups
    find "$backup_dir" -name "*.tar.gz" -mtime +$older_than -exec rm {} \; 2>/dev/null

    echo "Backup cleanup completed"
}

# Main command dispatcher
function main {
    local command=$1
    shift

    case $command in
        validate)
            local file=$1
            local show_errors=${2:-false}
            local quiet=${3:-false}
            validate_config "$file" "$show_errors" "$quiet"
            ;;
        compare)
            local file1=$1
            local file2=$2
            local quiet=${3:-false}
            compare_configs "$file1" "$file2" "$quiet"
            ;;
        merge)
            local file1=$1
            local file2=$2
            local output=$3
            local quiet=${4:-false}
            merge_configs "$file1" "$file2" "$output" "$quiet"
            ;;
        export)
            local input_file=$1
            local output_file=$2
            local quiet=${3:-false}
            export_config "$input_file" "$output_file" "$quiet"
            ;;
        import)
            local input_file=$1
            local output_file=$2
            local quiet=${3:-false}
            import_config "$input_file" "$output_file" "$quiet"
            ;;
        list)
            local quiet=${1:-false}
            list_presets "$quiet"
            ;;
        create)
            local name=$1
            local quiet=${2:-false}
            create_preset "$name" "$quiet"
            ;;
        template)
            local name=$1
            local quiet=${2:-false}
            template_preset "$name" "$quiet"
            ;;
        info)
            local file=$1
            local quiet=${2:-false}
            info_preset "$file" "$quiet"
            ;;
        backup)
            create_backup
            ;;
        restore)
            local backup_file=$1
            local quiet=${2:-false}
            restore_backup "$backup_file" "$quiet"
            ;;
        backup_list)
            list_backups
            ;;
        backup_clean)
            local older_than=${1:-30d}
            clean_backups "$older_than"
            ;;
        help)
            show_help
            ;;
        version|-v|--version)
            show_version
            ;;
        *)
            print_error "Unknown command: $command"
            show_help
            exit 1
            ;;
    esac
}

# Run main function
main "$@"
