#!/bin/bash

# NLM Configuration Management Script
# Provides utilities for managing NLM configurations and options

cd "$(dirname "$0")"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration directory
CONFIG_DIR="configs"

# List available configuration files
list_configs() {
    echo -e "${BLUE}=== Available Configuration Files ===${NC}"
    echo
    
    if [[ ! -d "$CONFIG_DIR" ]]; then
        echo -e "${YELLOW}No configs directory found.${NC}"
        return
    fi
    
    # Find all .cfg and .json configuration files
    local config_files=()
    while IFS= read -r -d '' file; do
        config_files+=("$(basename "$file")")
    done < <(find "$CONFIG_DIR" -maxdepth 1 -type f \( -name "*.cfg" -o -name "*.json" \) -print0 2>/dev/null)
    
    if [[ ${#config_files[@]} -eq 0 ]]; then
        echo -e "${YELLOW}No configuration files found in $CONFIG_DIR/${NC}"
        echo -e "${YELLOW}Creating a default configuration directory...${NC}"
        mkdir -p "$CONFIG_DIR"
        
        # Create a simple default config template
        cat > "$CONFIG_DIR/default.cfg" << EOF
# NLM Configuration File
# Default configuration for Neural Learning Machine

# Simulation parameters
random_seed = 42
neuron_count = 1000
region_count = 1
connection_probability = 0.1

# Neuron parameters
v_thresh = -50.0
v_rest = -70.0
v_reset = -75.0
tau_mem = 20.0
tau_ref = 2.0

# Plasticity parameters
plasticity.stdp.enable = true
plasticity.stdp.learning_rate = 0.001
plasticity.stdp.tau_plus = 20.0
plasticity.stdp.tau_minus = 20.0

plasticity.hebbian.enable = true
plasticity.structural.enable = true

# Neuromodulation parameters
neuromod.dopamine.scale = 1.0
neuromod.curiosity.enable = true
neuromod.novelty.enable = true

# Memory parameters
working.memory.capacity = 100
episodic.memory.max_episodes = 1000

# Development parameters
development.enabled = true

development.stage.initial_threshold = 0.1
EOF
        echo -e "${GREEN}Created default.cfg${NC}"
    else
        echo -e "${GREEN}Found ${#config_files[@]} configuration file(s):${NC}"
        for i in "${!config_files[@]}"; do
            local config_file="${config_files[$i]}"
            local display_name="$config_file"
            
            # Add asterisk to current config if it exists
            if [[ "$config_file" == "default.cfg" ]]; then
                display_name="$display_name${NC}${GREEN} (current)${NC}"
            fi
            
            echo "  * $display_name"
        done
    fi
    
    echo
    echo -e "${BLUE}Configuration management options:${NC}"
    echo -e "  * Use -c/--config to specify a configuration file"
    echo -e "  * Config files can be .cfg (key=value) or .json (JSON format)"
    echo -e "  * Most NLM demos support configuration files"
}

# Create a new configuration file from template
create_config() {
    local config_name="$1"
    
    if [[ -z "$config_name" ]]; then
        echo -e "${RED}Error: Configuration name required${NC}"
        echo -e "Usage: nlm-config create [name]"
        return 1
    fi
    
    local config_path="$CONFIG_DIR/$config_name.cfg"
    
    if [[ -f "$config_path" ]]; then
        echo -e "${YELLOW}Warning: Configuration $config_name.cfg already exists${NC}"
        read -p "Overwrite? (y/N): " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo -e "${YELLOW}Configuration not created.${NC}"
            return 0
        fi
    fi
    
    # Create config from template
    cat > "$config_path" << EOF
# NLM Configuration - $config_name
# Configuration file for $config_name scenario

# Simulation parameters
random_seed = 42
neuron_count = 500
region_count = 1
connection_probability = 0.05

# Neuron parameters (modified for this scenario)
v_thresh = -55.0
v_rest = -70.0
v_reset = -75.0
tau_mem = 15.0
tau_ref = 3.0

# Plasticity parameters
plasticity.stdp.enable = true
plasticity.stdp.learning_rate = 0.002
plasticity.stdp.tau_plus = 15.0
plasticity.stdp.tau_minus = 15.0

plasticity.hebbian.enable = true
plasticity.structural.enable = false

# Neuromodulation parameters
neuromod.dopamine.scale = 1.0
neuromod.curiosity.enable = true
neuromod.novelty.enable = false

# Memory parameters
working.memory.capacity = 50
episodic.memory.max_episodes = 500

# Development parameters
development.enabled = true

development.stage.initial_threshold = 0.2
EOF
    
    echo -e "${GREEN}Created configuration $config_name.cfg${NC}"
}

# Show configuration details
display_config() {
    local config_file="$1"
    
    if [[ -z "$config_file" ]]; then
        echo -e "${RED}Error: Configuration file required${NC}"
        echo -e "Usage: nlm-config show <config_file>"
        return 1
    fi
    
    local config_path="$CONFIG_DIR/$config_file"
    
    if [[ ! -f "$config_path" ]]; then
        echo -e "${RED}Error: Configuration file $config_file not found${NC}"
        echo -e "Available configurations:"
        list_configs
        return 1
    fi
    
    echo -e "${BLUE}=== Configuration: $config_file ===${NC}"
    echo
    echo -e "${YELLOW}Configuration preview (first 20 lines):${NC}"
    head -20 "$config_path"
    echo
    
    if [[ "$config_file" == "*.cfg" ]]; then
        echo -e "${YELLOW}Format: key = value (space-separated)${NC}"
    else
        echo -e "${YELLOW}Format: JSON (key-value pairs)${NC}"
    fi
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        list|--list)
            list_configs
            shift
            ;;
        create|--create)
            create_config "$2"
            shift 2
            ;;
        show|--show)
            display_config "$2"
            shift 2
            ;;
        *)
            echo -e "${RED}Error: Unknown command: $1${NC}"
            echo -e "Available commands: list, create, show"
            exit 1
            ;;
    esac
done

# If no arguments provided, show help
if [[ $# -eq 0 ]]; then
    echo -e "${BLUE}NLM Configuration Management${NC}"
    echo -e ""
    echo -e "Usage: nlm-config <command> [arguments]"
    echo -e ""
    echo -e "Commands:"
    echo -e "  list, --list      List all available configuration files"
    echo -e "  create <name>     Create a new configuration file from template"
    echo -e "  show <file>       Display configuration file details"
fi
