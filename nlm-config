            echo -e "${RED}Error: Missing config file for run command${NC}"
            echo -e "${YELLOW}Usage: nlm-config run <file> [options]${NC}"
            exit 1
        fi
        
        # Simulate running the NLM with this configuration
        local config_file="$2"
        shift 2
        
        echo -e "${BLUE}Simulating NLM run with: $config_file${NC}"
        echo ""
        echo "Configuration options:"
        for opt in "$@"; do
            case "$opt" in
                "--verbose"|"-v")
                    echo "  - Verbose output: enabled"
                    ;;
                "--debug"|"-d")
                    echo "  - Debug mode: enabled"
                    ;;
                "--steps"*)
