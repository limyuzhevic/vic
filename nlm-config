#!/usr/bin/env bash

# NLM Configuration Management Tool
#
# This tool provides comprehensive configuration management for the NLM system.
# It can read, modify, list, validate, and export configuration values.
#
# Configuration files can be in simple key=value format or YAML format
# (YAML support planned for Phase 8).
#
# Usage examples:
#   nlm-config --list                    List all configuration values
#   nlm-config --get neuron_count        Get specific configuration value
#   nlm-config --set neuron_count=2000  Set configuration value
#   nlm-config --validate config.cfg     Validate configuration file
#   nlm-config --export config.cfg      Export configuration to file
#   nlm-config --import config.cfg      Import configuration from file
#   nlm-config --merge config.cfg      Merge configuration from file
#
# Configuration precedence (highest to lowest):
#   1. Command-line arguments (--key=value)
#   2. Configuration files (processed in order)
#   3. Default values from code
#   4. Runtime settings
#
# Configuration sources are indicated by their prefix:
#   [Default], [File], [CommandLine], [Runtime]
#
# Configuration value types supported:
#   - int, int64_t (integers)
#   - double (floating-point numbers)
#   - bool (boolean values)
#   - string (text values)
#   - vector<int>, vector<double>, vector<string> (arrays)

# Default configuration file path
DEFAULT_CONFIG_FILE="configs/default.cfg"

# Maximum configuration file size (10MB)
MAX_CONFIG_SIZE=$((10 * 1024 * 1024))

# Configuration validation patterns
PATTERNS_DIR="configs/patterns"

