#!/usr/bin/env bash
# NLM Configuration Manager
# This script helps manage NLM configurations and settings

# Color definitions for terminal output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# Default configuration paths
DEFAULT_CONFIG_DIR="~/.config/nlm"
DEFAULT_CONFIG_FILE="$DEFAULT_CONFIG_DIR/config.ini"

# Print help message
function show_help() {
    cat << EOF
${BOLD}NLM Configuration Manager${NC}

${CY}Usage:${NC}
  nlm-config [OPTIONS] [COMMANDS]

${CY}Configuration Commands:${NC}
  ${GREEN}create${NC}                     Create a new configuration
  ${GREEN}load${NC}                      Load an existing configuration
  ${GREEN}save${NC}                      Save current configuration
  ${GREEN}edit${NC}                      Edit configuration
  ${GREEN}list${NC}                      List all configurations
  ${GREEN}show${NC}                      Show current configuration
  ${GREEN}reset${NC}                     Reset configuration to defaults
  ${GREEN}validate${NC}                  Validate configuration

${CY}Export/Import Commands:${NC}
  ${GREEN}export${NC}                    Export configuration to file
  ${GREEN}import${NC}                    Import configuration from file
  ${GREEN}backup${NC}                    Create backup of current configuration
  ${GREEN}restore${NC}                   Restore configuration from backup

${CY}Experiment Configuration:${NC}
  ${YELLOW}--neurons N${NC}             Number of neurons
  ${YELLOW}--regions R${NC}            Number of regions
  ${YELLOW}--steps S${NC}               Number of simulation steps
  ${YELLOW}--time T${NC}               Simulation time
  ${YELLOW}--seed S${NC}                Random seed
  ${YELLOW}--experiment-type T${NC}     Type of experiment
  ${YELLOW}--enable-plasticity${NC}    Enable synaptic plasticity
  ${YELLOW}--disable-plasticity${NC}   Disable synaptic plasticity
  ${YELLOW}--enable-development${NC}   Enable developmental processes
  ${YELLOW}--disable-development${NC}  Disable developmental processes
  ${YELLOW}--enable-curiosity${NC}     Enable curiosity
  ${YELLOW}--disable-curiosity${NC}    Disable curiosity
  ${YELLOW}--enable-reward${NC}        Enable reward modulation
  ${YELLOW}--disable-reward${NC}       Disable reward modulation

${CY}File Management:${NC}
  ${YELLOW}--config-file F${NC}          Path to configuration file
  ${YELLOW}--output-dir D${NC}           Output directory for files
  ${YELLOW}--backup-dir B${NC}          Backup directory

${CY}Logging:${NC}
  ${YELLOW}--log-level L${NC}           Log level (DEBUG, INFO, WARNING, ERROR)
  ${YELLOW}--log-file F${NC}            Log file path
  ${YELLOW}--verbose${NC}               Enable verbose logging
  ${YELLOW}--quiet${NC}                 Suppress output

${CY}Examples:${NC}
  ${CY}1. Create new configuration:${NC}
    nlm-config create --neurons 1000 --steps 5000

  ${CY}2. Load existing configuration:${NC}
    nlm-config load my_config

  ${CY}3. Save current configuration:${NC}
    nlm-config save --config-file my_config.ini

  ${CY}4. Show current configuration:${NC}
    nlm-config show

  ${CY}5. Export configuration to JSON:${NC}
    nlm-config export --output-dir ./configs

  ${CY}6. Import configuration from JSON:${NC}
    nlm-config import --config-file ./configs/my_config.json

${CY}Common Experiment Configurations:${NC}
  ${YELLOW}Developmental experiment:${NC}
    nlm-config create \
      --neurons 500 \
      --steps 3000 \
      --enable-development \
      --enable-curiosity \
      --enable-reward

  ${YELLOW}Plasticity experiment:${NC}
    nlm-config create \
      --neurons 1000 \
      --steps 5000 \
      --enable-plasticity \
      --enable-curiosity

  ${YELLOW}Integration experiment:${NC}
    nlm-config create \
      --neurons 1500 \
      --steps 10000 \
      --enable-development \
      --enable-plasticity \
      --enable-curiosity \
      --enable-reward

${CY}For more information, visit:${NC}
  https://github.com/nlm-project/nlm
EOF
}

# Print error message
function show_error() {
    echo -e "${RED}Error:${NC} $1" >&2
}

# Print success message
function show_success() {
    echo -e "${GREEN}✓${NC} $1"
}

# Print warning message
function show_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

# Print info message
function show_info() {
    echo -e "${CYAN}ℹ${NC} $1"
}

# Print debug message (if verbose)
function show_debug() {
    if [[ "$VERBOSE" == "true" ]]; then
        echo -e "${BLUE}🐛${NC} $1"
    fi
}

# Parse command line arguments
function parse_arguments() {
    # Default values
    NEURON_COUNT=""
    REGION_COUNT=""
    SIMULATION_STEPS=""
    SIMULATION_TIME=""
    RANDOM_SEED=""
    EXPERIMENT_TYPE=""
    ENABLE_PLASTICITY=""
    ENABLE_DEVELOPMENT=""
    ENABLE_CURIOSITY=""
    ENABLE_REWARD=""
    CONFIG_FILE=""
    OUTPUT_DIR=""
    BACKUP_DIR=""
    LOG_LEVEL=""
    LOG_FILE=""
    VERBOSE=false
    QUIET=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            # Core commands
            create|load|save|edit|list|show|reset|validate|
            export|import|backup|restore)
                COMMAND="$1"
                shift
                break
                ;;
            
            # Experiment configuration
            --neurons)
                NEURON_COUNT="$2"
                shift 2
                ;;
            --regions)
                REGION_COUNT="$2"
                shift 2
                ;;
            --steps)
                SIMULATION_STEPS="$2"
                shift 2
                ;;
            --time)
                SIMULATION_TIME="$2"
                shift 2
                ;;
            --seed)
                RANDOM_SEED="$2"
                shift 2
                ;;
            --experiment-type)
                EXPERIMENT_TYPE="$2"
                shift 2
                ;;
            --enable-plasticity)
                ENABLE_PLASTICITY="true"
                shift
                ;;
            --disable-plasticity)
                ENABLE_PLASTICITY="false"
                shift
                ;;
            --enable-development)
                ENABLE_DEVELOPMENT="true"
                shift
                ;;
            --disable-development)
                ENABLE_DEVELOPMENT="false"
                shift
                ;;
            --enable-curiosity)
                ENABLE_CURIOSITY="true"
                shift
                ;;
            --disable-curiosity)
                ENABLE_CURIOSITY="false"
                shift
                ;;
            --enable-reward)
                ENABLE_REWARD="true"
                shift
                ;;
            --disable-reward)
                ENABLE_REWARD="false"
                shift
                ;;
            
            # File management
            --config-file)
                CONFIG_FILE="$2"
                shift 2
                ;;
            --output-dir)
                OUTPUT_DIR="$2"
                shift 2
                ;;
            --backup-dir)
                BACKUP_DIR="$2"
                shift 2
                ;;
            
            # Logging
            --log-level)
                LOG_LEVEL="$2"
                shift 2
                ;;
            --log-file)
                LOG_FILE="$2"
                shift 2
                ;;
            --verbose)
                VERBOSE=true
                shift
                ;;
            --quiet)
                QUIET=true
                shift
                ;;
            
            # Help options
            -h|--help)
                show_help
                exit 0
                ;;
            
            # Unknown option
            *)
                show_error "Unknown option: $1"
                show_help
                exit 1
                ;;
        esac
    done
    
    # If no command provided, show help
    if [[ -z "$COMMAND" ]]; then
        show_help
        exit 0
    fi
}

# Create new configuration
function create_config() {
    show_info "Creating new NLM configuration..."
    
    # Create config directory if it doesn't exist
    mkdir -p "$DEFAULT_CONFIG_DIR"
    
    # Start Python script to create configuration
    python3 << EOF
import pynlm
import json
import os
import sys

# Create default configuration
config = pynlm.createDefaultConfig()

# Apply custom settings if provided
args = sys.argv[1:]  # Skip script name

# Convert bash-style arguments to Python
kwargs = {}
for i in range(0, len(args), 2):
    if i + 1 < len(args):
        key = args[i].lstrip('-')
        value = args[i + 1]
        
        # Convert string to appropriate type
        if value.lower() == 'true':
            value = True
        elif value.lower() == 'false':
            value = False
        elif value.isdigit():
            value = int(value)
        else:
            try:
                value = float(value)
            except ValueError:
                pass
        
        kwargs[key] = value

# Apply settings to configuration
for key, value in kwargs.items():
    if key == 'neurons':
        config.set('brain.neuron_count', value)
    elif key == 'regions':
        config.set('brain.region_count', value)
    elif key == 'steps':
        config.set('brain.simulation_steps', value)
    elif key == 'time':
        config.set('simulation.timestep', value / 1000)  # Assume 1000 steps per second
    elif key == 'seed':
        config.set('random.seed', value)
    elif key == 'enable_plasticity':
        config.set('plasticity.stdp.enable', value)
    elif key == 'disable_plasticity':
        config.set('plasticity.stdp.enable', False)
    elif key == 'enable_development':
        config.set('development.enabled', value)
    elif key == 'disable_development':
        config.set('development.enabled', False)
    elif key == 'enable_curiosity':
        config.set('neuromod.curiosity.enable', value)
    elif key == 'disable_curiosity':
        config.set('neuromod.curiosity.enable', False)
    elif key == 'enable_reward':
        config.set('neuromod.reward.enable', value)
    elif key == 'disable_reward':
        config.set('neuromod.reward.enable', False)

# Save configuration
save_path = os.path.expanduser('$DEFAULT_CONFIG_FILE')
with open(save_path, 'w') as f:
    config.saveToFile(save_path)

print(f"Configuration created and saved to: {save_path}")
print(f"Configuration contains {len(kwargs)} custom settings")
EOF
}

# Load configuration
function load_config() {
    if [[ -z "$1" ]]; then
        show_error "Configuration name required"
        show_help
        exit 1
    fi
    
    local config_name="$1"
    local config_path="$DEFAULT_CONFIG_DIR/$config_name.ini"
    
    show_info "Loading configuration: $config_name"
    
    if [[ ! -f "$config_path" ]]; then
        show_error "Configuration file not found: $config_path"
        exit 1
    fi
    
    # Load configuration using Python
    python3 << EOF
import pynlm
import os
import sys

config_path = '$config_path'

if os.path.exists(config_path):
    config = pynlm.createDefaultConfig()
    # Note: Config.loadFromFile is a TODO in the current implementation
    # For now, we'll just create a new config
    print(f"Configuration file exists: {config_path}")
    print("Note: Configuration loading is currently limited")
else:
    print(f"Configuration file not found: {config_path}")
    sys.exit(1)
EOF
}

# Save current configuration
function save_config() {
    if [[ -z "$CONFIG_FILE" ]]; then
        CONFIG_FILE="$DEFAULT_CONFIG_FILE"
    fi
    
    show_info "Saving configuration to: $CONFIG_FILE"
    
    # Create output directory if it doesn't exist
    mkdir -p "$(dirname "$CONFIG_FILE")"
    
    # Save configuration using Python
    python3 << EOF
import pynlm
import os

config = pynlm.createDefaultConfig()
config_path = '$CONFIG_FILE'

# Ensure output directory exists
os.makedirs(os.path.dirname(os.path.abspath(config_path)), exist_ok=True)

# Save configuration (note: saveToFile is a basic implementation)
config.saveToFile(config_path)
print(f"Configuration saved to: {config_path}")
EOF
}

# Show current configuration
function show_config() {
    show_info "=== Current NLM Configuration ==="
    
    python3 << EOF
import pynlm
import json

config = pynlm.createDefaultConfig()
print(json.dumps(config.summary(), indent=2))
EOF
}

# Reset configuration
function reset_config() {
    show_warning "Resetting configuration to defaults..."
    
    python3 << EOF
import pynlm
import os

config = pynlm.createDefaultConfig()
reset_path = os.path.expanduser('$DEFAULT_CONFIG_FILE')

# Ensure output directory exists
os.makedirs(os.path.dirname(os.path.abspath(reset_path)), exist_ok=True)

# Save default configuration
config.saveToFile(reset_path)
print(f"Configuration reset to defaults and saved to: {reset_path}")
EOF
}

# Export configuration
function export_config() {
    if [[ -z "$OUTPUT_DIR" ]]; then
        OUTPUT_DIR="configs"
    fi
    
    show_info "Exporting configuration to: $OUTPUT_DIR"
    
    mkdir -p "$OUTPUT_DIR"
    
    python3 << EOF
import pynlm
import json
import os

config = pynlm.createDefaultConfig()
output_dir = '$OUTPUT_DIR'

# Create exports directory
os.makedirs(output_dir, exist_ok=True)

# Export to JSON
json_path = os.path.join(output_dir, 'config.json')
with open(json_path, 'w') as f:
    json.dump(config.summary(), f, indent=2)

print(f"Configuration exported to JSON: {json_path}")

# Export to YAML (if pyyaml is available)
try:
    import yaml
    yaml_path = os.path.join(output_dir, 'config.yaml')
    with open(yaml_path, 'w') as f:
        yaml.dump(config.summary(), f)
    print(f"Configuration exported to YAML: {yaml_path}")
except ImportError:
    print("PyYAML not available, skipping YAML export")

# Export to INI (basic format)
ini_path = os.path.join(output_dir, 'config.ini')
config.saveToFile(ini_path)
print(f"Configuration exported to INI: {ini_path}")
EOF
}

# Import configuration
function import_config() {
    if [[ -z "$CONFIG_FILE" ]]; then
        show_error "Configuration file required for import"
        show_help
        exit 1
    fi
    
    if [[ ! -f "$CONFIG_FILE" ]];n then
        show_error "Configuration file not found: $CONFIG_FILE"
        exit 1
    fi
    
    show_info "Importing configuration from: $CONFIG_FILE"
    
    # Import configuration based on file type
    if [[ "$CONFIG_FILE" == *.json ]]; then
        python3 << EOF
import pynlm
import json
import os

config_path = '$CONFIG_FILE'
config = pynlm.createDefaultConfig()

# Load JSON configuration
try:
    with open(config_path, 'r') as f:
        config_data = json.load(f)
    
    print(f"JSON configuration loaded successfully")
    print(f"Configuration contains {len(config_data)} settings")
except Exception as e:
    print(f"Error loading JSON configuration: {e}")
    exit(1)
EOF
    elif [[ "$CONFIG_FILE" == *.ini || "$CONFIG_FILE" == *.cfg ]]; then
        python3 << EOF
import pynlm
import os

config_path = '$CONFIG_FILE'
config = pynlm.createDefaultConfig()

# Load INI configuration
try:
    if config.loadFromFile(config_path):
        print(f"INI configuration loaded successfully from: {config_path}")
    else:
        print(f"Failed to load INI configuration: {config_path}")
except Exception as e:
    print(f"Error loading INI configuration: {e}")
    exit(1)
EOF
    else
        show_error "Unsupported configuration file format: $CONFIG_FILE"
        show_info "Supported formats: JSON, INI, YAML"
        exit 1
    fi
}

# Create backup
function create_backup() {
    if [[ -z "$BACKUP_DIR" ]]; then
        BACKUP_DIR="backups"
    fi
    
    show_info "Creating backup configuration..."
    
    mkdir -p "$BACKUP_DIR"
    
    local backup_file="$BACKUP_DIR/backup_$(date +%Y%m%d_%H%M%S).ini"
    local original_config_file="$CONFIG_FILE"
    CONFIG_FILE="$backup_file"
    
    save_config "$backup_file"
    show_success "Backup created: $backup_file"
    
    CONFIG_FILE="$original_config_file"
}

# Restore backup
function restore_backup() {
    if [[ -z "$1" ]]; then
        show_error "Backup file required for restore"
        show_help
        exit 1
    fi
    
    local backup_file="$1"
    
    if [[ ! -f "$backup_file" ]]; then
        show_error "Backup file not found: $backup_file"
        exit 1
    fi
    
    show_info "Restoring configuration from backup: $backup_file"
    
    # Restore using Python
    python3 << EOF
import pynlm
import os

backup_path = '$backup_file'
config_path = '$DEFAULT_CONFIG_FILE'

# Copy backup to config location
import shutil
shutil.copy2(backup_path, config_path)
print(f"Configuration restored from backup: {backup_path}")
EOF
}

# Validate configuration
function validate_config() {
    show_info "Validating configuration..."
    
    python3 << EOF
import pynlm

config = pynlm.createDefaultConfig()
print("Configuration validation completed")
print("Note: Configuration validation is currently limited")
print("For full validation, please refer to the NLM documentation")
EOF
}

# List configurations
function list_configs() {
    show_info "=== Available Configurations ==="
    
    if [[ -d "$DEFAULT_CONFIG_DIR" ]]; then
        echo "Configurations in $DEFAULT_CONFIG_DIR:"
        ls -la "$DEFAULT_CONFIG_DIR"/*.ini 2>/dev/null | while read line; do
            echo "  $line"
        done
    else
        show_info "No configuration directory found: $DEFAULT_CONFIG_DIR"
        show_info "Use 'nlm-config create' to create a new configuration"
    fi
}

# Main function
function main() {
    # Parse command line arguments
    parse_arguments "$@"
    
    # Handle quiet mode
    if [[ "$QUIET" == "true" ]]; then
        # Redirect all output to /dev/null (except errors)
        exec 1>/dev/null 2>&1
    fi
    
    # Execute command
    case "$COMMAND" in
        "create")
            shift
            create_config "$@"
            ;;
        "load")
            shift
            load_config "$1"
            ;;
        "save")
            shift
            save_config "$@"
            ;;
        "show")
            shift
            show_config "$@"
            ;;
        "reset")
            shift
            reset_config "$@"
            ;;
        "validate")
            shift
            validate_config "$@"
            ;;
        "export")
            shift
            export_config "$@"
            ;;
        "import")
            shift
            import_config "$@"
            ;;
        "backup")
            shift
            create_backup "$@"
            ;;
        "restore")
            shift
            restore_backup "$1"
            ;;
        "list")
            shift
            list_configs "$@"
            ;;
        *)
            show_error "Invalid command: $COMMAND"
            show_help
            exit 1
            ;;
    esac
    
    # Restore stdout if in quiet mode
    if [[ "$QUIET" == "true" ]]; then
        exec 1>/dev/null 2>&1
    fi
}

# Run main function with all arguments
main "$@"