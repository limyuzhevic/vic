def save_config(config, filename):
    """Save configuration to file."""
    try:
        with open(filename, 'w') as f:
            json.dump(config, f, indent=2)
        print(f"✓ Configuration saved to {filename}")
        return True
    except Exception as e:
        print(f"✗ Error saving configuration: {e}")
        return False

def main():
    """Main entry point."""
    parser = argparse.ArgumentParser(
        description="NLM Configuration File Generator",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Generate example configuration files for NLM experiments.

Examples:
  python3 nlm-config generate basic > basic_config.json
  python3 nlm-config generate stdp > stdp_config.json
  python3 nlm-config generate advanced > advanced_config.json
  python3 nlm-config save basic basic_config.json
        """
    )
    
    parser.add_argument("type", choices=["basic", "stdp", "advanced"],
                       help="Type of configuration to generate")
    parser.add_argument("--output", "-o", dest="output_file",
                       help="Output file path (default: stdout)")
    
    args = parser.parse_args()
    
    # Generate configuration
    if args.type == "basic":
        config = generate_basic_config()
        print("Basic NLM Configuration")
        print("=" * 50)
    elif args.type == "stdp":
        config = generate_stdp_config()
        print("STDP-focused NLM Configuration")
        print("=" * 50)
    elif args.type == "advanced":
        config = generate_advanced_config()
        print("Advanced NLM Configuration")
        print("=" * 50)
    
    # Output configuration
    if args.output_file:
        save_config(config, args.output_file)
    else:
        # Print to stdout
        print(json.dumps(config, indent=2))

if __name__ == "__main__":
    main()