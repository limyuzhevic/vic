def main():
    """Main function."""
    if len(sys.argv) < 2:
        print(__doc__)
        print("\nAvailable commands:")
        commands = [
            ("create", "<config_file> [--template <template_name>]", "Create new config from template"),
            ("validate", "<config_file>", "Validate config file"),
            ("merge", "<output_file> <config_file1> [config_file2...]", "Merge multiple config files"),
            ("get", "<config_file> <key>", "Get config value"),
            ("set", "<config_file> <key> <value>", "Set config value"),
            ("remove", "<config_file> <key>", "Remove config key"),
            ("list", "<config_file>", "List all config keys"),
            ("edit", "<config_file>", "Edit config file interactively"),
            ("backup", "<config_file>", "Create backup of config file")
        ]
        
        for cmd, args, desc in commands:
            print(f"  nlm-config {cmd} {args:30} - {desc}")
        
        sys.exit(1)
    
    # Parse command
    cmd = sys.argv[1]
    args = sys.argv[2:]
    
    # Dispatch to command handler
    command_handlers = {
        "create": cmd_create,
        "validate": cmd_validate,
        "merge": cmd_merge,
        "get": cmd_get,
        "set": cmd_set,
        "remove": cmd_remove,
        "list": cmd_list,
        "edit": cmd_edit,
        "backup": cmd_backup
    }
    
    if cmd not in command_handlers:
        print(f"Error: Unknown command '{cmd}'")
        print("\nAvailable commands:")
        for cmd_name in command_handlers.keys():
            print(f"  nlm-config {cmd_name}")
        sys.exit(1)
    
    try:
        command_handlers[cmd](args)
    except Exception as e:
        print(f"Error: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()
