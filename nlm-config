# Function to list presets
function list_presets {
    local preset_dir="$CONFIG_DIR/presets"
    local quiet=${1:-false}

    if [ ! -d "$preset_dir" ]; then
        print_error "Presets directory not found: $preset_dir"
        return 1
    fi

    if [ "$quiet" = false ]; then
        print_info "Listing available presets"
        echo "Available presets:"
    fi

    local presets=($(ls "$preset_dir"/*.cfg 2>/dev/null))

    if [ ${#presets[@]} -eq 0 ]; then
        print_warning "No presets found"
        return 0
    fi

    for preset in "${presets[@]}"; do
        local preset_name=$(basename "$preset" .cfg)
        local preset_file="$preset_dir/$preset_name.cfg"
        local neuron_count=$(grep -o 'neuron_count = [0-9]*' "$preset_file" 2>/dev/null | cut -d' ' -f3 || echo "N/A")

        echo "  $preset_name ($neuron_count neurons)"
    done
}

# Function to create preset
function create_preset {
    local name=$1
    local quiet=${2:-false}

    if [ -z "$name" ]; then
        print_error "Preset name not specified"
        return 1
    fi

    local preset_dir="$CONFIG_DIR/presets"

    if [ ! -d "$preset_dir" ]; then
        mkdir -p "$preset_dir"
    fi

    local preset_file="$preset_dir/$name.cfg"

    if [ -f "$preset_file" ]; then
        print_warning "Preset already exists: $name"
        read -p "Overwrite? (y/N): " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            return 0
        fi
    fi

    print_info "Creating new preset: $name"

    # Use cat to create the preset
    cat > "$preset_file" << EOF
# NLM Configuration Preset: $name
# Created by nlm-config on $(date)

# Copy your configuration here
random_seed = 42
simulation_timestep = 0.001
neuron_count = 1000
region_count = 2
connection_probability = 0.1

# Enable all features
plasticity_learning_rate = 0.01
stdp_ltp_weight = 0.02
stdp_ltd_weight = 0.015
development_synaptogenesis_rate = 0.0001
development_pruning_rate = 0.00001

# Standard logging
log_level = INFO
log_to_file = true
log_filename = $name.log
EOF

    print_info "Preset created: $preset_file"
}

# Function to generate preset template
