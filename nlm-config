# Format configuration value for display
function format_value() {
    local value="$1"
    local type="$2"
    
    case "$type" in
        "std::string" | "string")
            echo "\"$value\""
            ;;
        "std::vector<int>" | "vector<int>")
            echo "[$(echo "$value" | tr ',' ', ')]"
            ;;
        "std::vector<double>" | "vector<double>")
            echo "[$(echo "$value" | tr ',' ', ')]"
            ;;
        "std::vector<std::string>" | "vector<string>")
            echo "[$(echo "$value" | tr ',' ', ')]"
            ;;
        *)
            echo "$value"
            ;;
    esac
}

# Parse configuration value from string
function parse_value() {
    local input="$1"
    local type="$2"
    
    # Try to auto-detect type from input
    if [[ "$input" =~ ^[0-9]+$ ]]; then
        if [[ "$type" == "int" ]] || [[ "$type" == "auto" ]]; then
            echo "int:$input"
        elif [[ "$type" == "int64_t" ]]; then
            echo "int64_t:$input"
        fi
    elif [[ "$input" =~ ^-?[0-9]*\.[0-9]+$ ]] || [[ "$input" =~ ^-?0\.[0-9]+$ ]]; then
        if [[ "$type" == "double" ]] || [[ "$type" == "auto" ]]; then
            echo "double:$input"
        fi
    elif [[ "$input" =~ ^(true|false|yes|no|1|0)$ ]]; then
        if [[ "$type" == "bool" ]] || [[ "$type" == "auto" ]]; then
            case "$input" in
                true|yes|1) echo "bool:true" ;;
                *) echo "bool:false" ;;
            esac
        fi
    elif [[ "$input" =~ ^\[(.*)\]$ ]]; then
        # Vector format [a,b,c]
        if [[ "$type" == "vector<int>" ]] || [[ "$type" == "auto" ]]; then
            local items=$(echo "$input" | sed 's/\[\|\]//g' | sed 's/,/ /g')
            echo "vector<int>:$(echo "$items" | sed 's/ /,/g')"
        elif [[ "$type" == "vector<double>" ]]; then
            local items=$(echo "$input" | sed 's/\[\|\]//g' | sed 's/,/ /g')
            echo "vector<double>:$(echo "$items" | sed 's/ /,/g')"
        elif [[ "$type" == "vector<string>" ]]; then
            local items=$(echo "$input" | sed 's/\[\|\]//g' | sed 's/,/ /g')
            echo "vector<string>:$(echo "$items" | sed 's/ /,/g')"
        fi
    else
        if [[ "$type" == "string" ]] || [[ "$type" == "auto" ]]; then
            echo "string:$input"
        fi
    fi
}

# Load configuration from file
function load_config() {
    local config_file="$1"
    
    if [[ ! -f "$config_file" ]]; then
        echo "Error: Configuration file not found: $config_file"
        return 1
    fi
    
    # Check file size
    local file_size=$(stat -c%s "$config_file" 2>/dev/null || stat -f%z "$config_file" 2>/dev/null)
    if [[ $file_size -gt $MAX_CONFIG_SIZE ]]; then
        echo "Error: Configuration file too large: $file_size bytes (max: $MAX_CONFIG_SIZE)"
        return 1
    fi
    
    echo "Loading configuration from: $config_file"
    
    # Parse configuration file
    while IFS= read -r line; do
        # Skip empty lines and comments
        line=$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        
        if [[ -z "$line" ]] || [[ "$line" == \#* ]] || [[ "$line" == \/* ]]; then
            continue
        fi
        
        # Parse key=value pairs
        if [[ "$line" == *"="* ]]; then
            local key=$(echo "$line" | cut -d'=' -f1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            local value=$(echo "$line" | cut -d'=' -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            
            # Remove quotes if present
            if [[ "$value" =~ ^".*"$ ]] || [[ "$value" =~ ^'.*'$ ]]; then
                value=${value:1:-1}
            fi
            
            # Set configuration value
            echo "  $key = $value"
        else
            echo "Warning: Ignoring invalid line: $line"
        fi
    done < "$config_file"
}

