#!/usr/bin/env python3

"""
NLM Configuration Management CLI

Command-line tool for managing NLM configurations.

Usage:
  nlm-config create <config_file> [--template <template_name>]
  nlm-config validate <config_file>
  nlm-config merge <output_file> <config_file1> [config_file2...]
  nlm-config get <config_file> <key>
  nlm-config set <config_file> <key> <value>
  nlm-config remove <config_file> <key>
  nlm-config list <config_file>
  nlm-config edit <config_file>
  nlm-config backup <config_file>
"""

import sys
import os
from pathlib import Path
import shutil
import difflib
import json

# Add current directory to path to import validation script
sys.path.insert(0, str(Path(__file__).parent))

from validate_config import parse_config_file, validate_config_entries, CONFIG_SPEC


def load_config(filepath: Path) -> dict:
    """Load a configuration file."""
    if not filepath.exists():
        print(f"Error: Config file not found: {filepath}")
        sys.exit(1)
    
    entries, _, _ = parse_config_file(filepath)
    return entries


def save_config(filepath: Path, entries: dict, backup: bool = False):
    """Save configuration to file."""
    if backup:
        backup_path = filepath.with_suffix(f'.{Path(filepath).stem}_backup{Path(filepath).suffix}')
        shutil.copy2(filepath, backup_path)
        print(f"Created backup at: {backup_path}")
    
    with open(filepath, 'w') as f:
        f.write(f"# NLM Configuration File\n")
        f.write(f"# Generated by nlm-config tool\n\n")
        
        for key, value in sorted(entries.items()):
            # Find description if available
            spec = CONFIG_SPEC.get(key, {"description": ""})
            if spec["description"]:
                f.write(f"# {spec['description']}\n")
            f.write(f"{key} = {value}\n\n")
    
    print(f"Configuration saved to: {filepath}")


def cmd_create(args: list):
    """Create a new configuration file from template."""
    if len(args) < 1:
        print("Error: Missing config_file argument")
        print("Usage: nlm-config create <config_file> [--template <template_name>]")
        sys.exit(1)
    
    config_file = Path(args[0])
    template = "default"
    
    # Parse optional arguments
    i = 1
    while i < len(args):
        if args[i] == "--template":
            if i + 1 < len(args):
                template = args[i + 1]
                i += 2
            else:
                print("Error: Missing template name after --template")
                sys.exit(1)
        else:
            i += 1
    
    # Get template content
    templates = {
        "default": get_default_template(),
        "minimal": get_minimal_template(),
        "training": get_training_template(),
        "exploration": get_exploration_template()
    }
    
    if template not in templates:
        print(f"Error: Unknown template '{template}'")
        print(f"Available templates: {', '.join(templates.keys())}")
        sys.exit(1)
    
    # Create config file
    if config_file.exists():
        print(f"Warning: {config_file} already exists")
        response = input("Overwrite? (y/n): ")
        if response.lower() != 'y':
            print("Operation cancelled")
            return
    
    # Save template
    with open(config_file, 'w') as f:
        f.write(templates[template])
    
    print(f"Created configuration file: {config_file} (template: {template})")


def cmd_validate(args: list):
    """Validate a configuration file."""
    if len(args) < 1:
        print("Error: Missing config_file argument")
        print("Usage: nlm-config validate <config_file>")
        sys.exit(1)
    
    config_file = Path(args[0])
    
    # Run validation script
    import subprocess
    result = subprocess.run([sys.executable, str(Path(__file__).parent / "validate_config.py"), str(config_file)], 
                          capture_output=True, text=True)
    
    print(result.stdout)
    
    if result.returncode != 0:
        print("❌ Validation failed")
        sys.exit(1)
    else:
        print("✅ Validation passed")


def cmd_merge(args: list):
    """Merge multiple configuration files."""
    if len(args) < 2:
        print("Error: Need at least one source config file")
        print("Usage: nlm-config merge <output_file> <config_file1> [config_file2...]")
        sys.exit(1)
    
    output_file = Path(args[0])
    source_files = [Path(f) for f in args[1:]]
    
    # Check that all source files exist
    for source_file in source_files:
        if not source_file.exists():
            print(f"Error: Source config file not found: {source_file}")
            sys.exit(1)
    
    # Merge configurations
    merged = {}
    for source_file in source_files:
        entries = load_config(source_file)
        merged.update(entries)
    
    # Save merged config
    save_config(output_file, merged, backup=True)


def cmd_get(args: list):
    """Get a configuration value."""
    if len(args) < 2:
        print("Error: Missing config_file or key arguments")
        print("Usage: nlm-config get <config_file> <key>")
        sys.exit(1)
    
    config_file = Path(args[0])
    key = args[1]
    
    entries = load_config(config_file)
    
    if key in entries:
        print(entries[key])
    else:
        print(f"Error: Key '{key}' not found in {config_file}")
        sys.exit(1)


def cmd_set(args: list):
    """Set a configuration value."""
    if len(args) < 3:
        print("Error: Missing config_file, key, or value arguments")
        print("Usage: nlm-config set <config_file> <key> <value>")
        sys.exit(1)
    
    config_file = Path(args[0])
    key = args[1]
    value = args[2]
    
    # Load existing config
    if config_file.exists():
        entries = load_config(config_file)
    else:
        entries = {}
    
    # Set value
    entries[key] = value
    
    # Save config
    save_config(config_file, entries, backup=True)


def cmd_remove(args: list):
    """Remove a configuration key."""
    if len(args) < 2:
        print("Error: Missing config_file or key arguments")
        print("Usage: nlm-config remove <config_file> <key>")
        sys.exit(1)
    
    config_file = Path(args[0])
    key = args[1]
    
    entries = load_config(config_file)
    
    if key in entries:
        del entries[key]
        save_config(config_file, entries, backup=True)
        print(f"Removed key '{key}' from {config_file}")
    else:
        print(f"Error: Key '{key}' not found in {config_file}")
        sys.exit(1)


def cmd_list(args: list):
    """List all configuration keys."""
    if len(args) < 1:
        print("Error: Missing config_file argument")
        print("Usage: nlm-config list <config_file>")
        sys.exit(1)
    
    config_file = Path(args[0])
    entries = load_config(config_file)
    
    print(f"Configuration file: {config_file}")
    print(f"Total keys: {len(entries)}")
    print("\nKeys:")
    for key in sorted(entries.keys()):
        print(f"  {key}")


def cmd_edit(args: list):
    """Edit configuration file interactively."""
    if len(args) < 1:
        print("Error: Missing config_file argument")
        print("Usage: nlm-config edit <config_file>")
        sys.exit(1)
    
    config_file = Path(args[0])
    
    if not config_file.exists():
        print(f"Error: Config file not found: {config_file}")
        print("Use 'nlm-config create' to create a new config file")
        sys.exit(1)
    
    # For now, just display the config and suggest validation
    print(f"Opening editor for: {config_file}")
    print("Note: Interactive editing requires a text editor.")
    print("After editing, run 'nlm-config validate' to check for issues.")
    print(f"Current content:")
    with open(config_file, 'r') as f:
        print(f.read())


def cmd_backup(args: list):
    """Create a backup of configuration file."""
    if len(args) < 1:
        print("Error: Missing config_file argument")
        print("Usage: nlm-config backup <config_file>")
        sys.exit(1)
    
    config_file = Path(args[0])
    
    if not config_file.exists():
        print(f"Error: Config file not found: {config_file}")
        sys.exit(1)
    
    # Create backup
    timestamp = Path(config_file).stem + f"_{int(Path(config_file).stat().st_mtime)}.cfg"
    backup_path = config_file.with_name(f"{timestamp}_backup.cfg")
    shutil.copy2(config_file, backup_path)
    
    print(f"Backup created at: {backup_path}")


