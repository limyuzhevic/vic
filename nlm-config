# Get configuration value
function get_config() {
    local key="$1"
    
    if [[ -z "$key" ]]; then
        echo "Error: No configuration key specified"
        return 1
    fi
    
    # Default configuration values
    case "$key" in
        neuron_count)
            echo "1000"
            ;;
        region_count)
            echo "1"
            ;;
        simulation_timestep)
            echo "0.001"
            ;;
        connection_probability)
            echo "0.1"
            ;;
        random_seed)
            echo "42"
            ;;
        stdp_ltp_weight)
            echo "0.02"
            ;;
        stdp_ltd_weight)
            echo "0.015"
            ;;
        stdp_tau)
            echo "20.0"
            ;;
        synaptogenesis_rate)
            echo "0.0001"
            ;;
        pruning_rate)
            echo "0.00001"
            ;;
        replay_interval)
            echo "100"
            ;;
        consolidation_interval)
            echo "1000"
            ;;
        checkpoint_dir)
            echo "./checkpoints"
            ;;
        log_level)
            echo "INFO"
            ;;
        *)
            echo "Error: Unknown configuration key: $key"
            return 1
            ;;
