// NLM Build Configuration
// Provides comprehensive build options and better organization

cmake_minimum_required(VERSION 3.16)
project(NLM VERSION 0.1.0 LANGUAGES CXX)

# C++20 standard
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

# Build type
if(NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE Release)
endif()

# Enable comprehensive warnings
if(MSVC)
    add_compile_options(/W4 /WX)
else()
    add_compile_options(-Wall -Wextra -Wpedantic -Werror)
endif()

# Set source directory
set(NLM_SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/src")

# Core neural computation library
add_library(nlm_core STATIC
    # Core utilities
    src/core/Types/Types.cpp
    src/core/Config/Config.cpp
    src/core/Random/Random.cpp
    src/core/Logger/Logger.cpp
    src/core/SimulationClock/SimulationClock.cpp
    
    # Brain components (Phase 6: Real spiking neural computation)
    src/brain/Neuron.cpp
    src/brain/Synapse.cpp
    src/brain/NeuralPopulation.cpp
    src/brain/NeuralRegion.cpp
    src/brain/Brain.cpp
    
    # Neural dynamics and computation
    src/dynamics/NeuralDynamics.cpp
    src/dynamics/SpikeSystem.cpp
    
    # Learning mechanisms
    src/plasticity/PlasticityRule.cpp
    src/plasticity/Hebbian.cpp
    src/plasticity/STDP.cpp
    src/plasticity/StructuralPlasticity.cpp
    
    # Neuromodulation systems
    src/neuromodulation/Neuromodulator.cpp
    src/neuromodulation/Reward.cpp
    src/neuromodulation/PredictionError.cpp
    src/neuromodulation/Novelty.cpp
    src/neuromodulation/Curiosity.cpp
    
    # Memory systems (Phase 6: Integrated memory)
    src/memory/WorkingMemory.cpp
    src/memory/EpisodicMemory.cpp
    src/memory/SemanticMemory.cpp
    src/memory/ProceduralMemory.cpp
    src/memory/AssociativeMemory.cpp
    src/memory/NeuralWorkingMemory.cpp
    src/memory/NeuralEpisodicMemory.cpp
    
    # Cognitive systems
    src/cognition/ConceptFormation.cpp
    src/cognition/NeuralPlanner.cpp
    
    # Sensory processing
    src/sensory/SensoryInput.cpp
    src/sensory/Vision.cpp
    src/sensory/Audio.cpp
    src/sensory/InternalSignals.cpp
    
    # Prediction systems
    src/prediction/PredictionSystem.cpp
    src/prediction/NeuralPrediction.cpp
    
    # Motor control
    src/motor/MotorSystem.cpp
    src/motor/Action.cpp
    
    # Environment interaction
    src/environment/Environment.cpp
    src/environment/Observation.cpp
    src/environment/Action.cpp
    
    # Experiments (Phase 6: Full integration)
    src/experiments/Experiment.cpp
    src/experiments/ExperimentRunner.cpp
    src/experiments/Metrics.cpp
    src/experiments/Phase3Experiment.cpp
    src/experiments/Phase4Experiment.cpp
    src/experiments/Phase5Experiment.cpp
    src/experiments/Phase6IntegratedExperiment.cpp
    
    # Visualization and debugging
    src/visualization/VisualizationInterface.cpp
)

target_include_directories(nlm_core PUBLIC
    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src>
    $<INSTALL_INTERFACE:include>
)

# Performance optimizations
# SIMD vectorization for large-scale simulations
add_library(nlm_perf STATIC
    src/performance/SIMDVectorization.cpp
    src/performance/MemoryPool.cpp
    src/performance/EventQueue.cpp
    src/performance/SparseConnectivity.cpp
    src/performance/ParallelProcessing.cpp
)

target_include_directories(nlm_perf PUBLIC
    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src/performance>
)

target_link_libraries(nlm_perf PUBLIC nlm_core)

# Agent system (Phase 6: Brain-world interface)
add_library(nlm_agent STATIC
    src/agent/AgentBrain.cpp
    src/agent/SensoryPercept.cpp
    src/agent/AgentBody.cpp
)

target_include_directories(nlm_agent PUBLIC src)
target_link_libraries(nlm_agent PUBLIC nlm_core nlm_perf)

# World system (Phase 6: Environmental interaction)
add_library(nlm_world STATIC
    src/world/SimpleWorld.cpp
)

target_include_directories(nlm_world PUBLIC src)
target_link_libraries(nlm_world PUBLIC nlm_core)

# Main executable (Phase 6: Full integration)
add_executable(nlm
    src/main.cpp
)

target_link_libraries(nlm PUBLIC nlm_core nlm_agent nlm_world)

# Phase 3 demonstration (LIF dynamics and basic plasticity)
add_executable(nlm_phase3_demo
    src/experiments/Phase3Demo.cpp
)

target_link_libraries(nlm_phase3_demo PUBLIC nlm_core nlm_agent nlm_world)

# Phase 4 demonstration (Working memory and episodic memory)
add_executable(nlm_phase4_demo
    src/experiments/Phase4Demo.cpp
)

target_link_libraries(nlm_phase4_demo PUBLIC nlm_core nlm_agent nlm_world)

# Phase 5 demonstration (Performance optimizations)
add_executable(nlm_phase5_demo
    src/experiments/Phase5Demo.cpp
)

target_link_libraries(nlm_phase5_demo PUBLIC nlm_core nlm_agent nlm_world nlm_perf)

# Phase 6 integration test (Final verification of all systems)
add_executable(nlm_phase6_demo
    src/experiments/Phase6Demo.cpp
)

target_link_libraries(nlm_phase6_demo PUBLIC nlm_core nlm_agent nlm_world nlm_perf)

# Testing framework
enable_testing()
add_subdirectory(tests)

# Installation (future)
install(TARGETS nlm nlm_core nlm_agent nlm_world nlm_perf nlm_phase3 nlm_phase4 nlm_phase5
    ARCHIVE DESTINATION lib
    LIBRARY DESTINATION lib
    RUNTIME DESTINATION bin
)

# Configuration options for users
option(NLM_ENABLE_PYTHON_BINDINGS "Enable Python bindings" ON)
option(NLM_ENABLE_PERFORMANCE_OPTIMIZATIONS "Enable performance optimizations" ON)
option(NLM_ENABLE_VISUALIZATION "Enable visualization features" ON)
option(NLM_ENABLE_ALL_EXPERIMENTS "Build all experiment executables" ON)

# Python bindings
if(NLM_ENABLE_PYTHON_BINDINGS)
    find_package(pybind11 REQUIRED)
    pybind11_add_module(pynlm python/bindings.cpp)
    target_link_libraries(pynlm PRIVATE nlm_core nlm_agent nlm_world)
    install(TARGETS pynlm DESTINATION lib/python)
endif()

# Package configuration for find_package (future)
include(CMakePackageConfigHelpers)
write_basic_package_version_file(
    "${CMAKE_CURRENT_BINARY_DIR}/NLMConfigVersion.cmake"
    VERSION ${PROJECT_VERSION}
    COMPATIBILITY AnyNewerVersion
)

configure_package_config_file(
    "${CMAKE_CURRENT_SOURCE_DIR}/config/NLMConfig.cmake.in"
    "${CMAKE_CURRENT_BINARY_DIR}/NLMConfig.cmake"
    INSTALL_DESTINATION lib/cmake/NLM
)

install(FILES
    "${CMAKE_CURRENT_BINARY_DIR}/NLMConfig.cmake"
    "${CMAKE_CURRENT_BINARY_DIR}/NLMConfigVersion.cmake"
    DESTINATION lib/cmake/NLM
)
