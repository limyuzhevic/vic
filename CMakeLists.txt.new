cmake_minimum_required(VERSION 3.16)
project(NLM VERSION 0.1.0 LANGUAGES CXX)

# C++20 standard
if(CMAKE_VERSION VERSION_LESS 3.18)
    set(CMAKE_CXX_STANDARD 20)
else()
    set(CMAKE_CXX_STANDARD 20)
    set(CMAKE_CXX_STANDARD_REQUIRED ON)
    set(CMAKE_CXX_EXTENSIONS OFF)
endif()

# Configure package config for install
include(GNUInstallDirs)
include(CMakePackageConfigHelpers)

# Option for building tests
option(BUILD_TESTS "Build unit tests" ON)
option(BUILD_PYTHON_BINDINGS "Build Python bindings" ON)
option(BUILD_EXAMPLES "Build example executables" ON)
option(BUILD_DOCS "Build documentation" OFF)

# Package dependencies
find_package(pybind11 REQUIRED QUIET)

# Compilation flags
function(apply_safe_compile_options target)
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /WX)
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Werror)
    endif()
    
    # Common C++ flags
    target_compile_options(${target} PRIVATE -fPIC)
    
    # Debug and optimization flags
    target_compile_definitions(${target} PRIVATE $<$<CONFIG:Debug>:_DEBUG>)
endfunction()

# Source directory
set(NLM_SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/src")

# Compile all source files automatically
file(GLOB_RECURSE NLM_CORE_SOURCES "src/*.cpp")
file(GLOB_RECURSE NLM_EXPERIMENT_SOURCES "src/experiments/*.cpp")
file(GLOB_RECURSE NLM_DEMO_SOURCES "src/experiments/Demo*.cpp")

# Core library with target-based organization
add_library(nlm_core STATIC)
apply_safe_compile_options(nlm_core)

# Core modules
set(CORE_MODULES
    core/Types/Types.cpp
    core/Config/Config.cpp
    core/Random/Random.cpp
    core/Logger/Logger.cpp
    core/SimulationClock/SimulationClock.cpp
)

# Brain modules
set(BRAIN_MODULES
    brain/Neuron.cpp
    brain/Synapse.cpp
    brain/NeuralPopulation.cpp
    brain/NeuralRegion.cpp
    brain/Brain.cpp
)

# Dynamics modules
set(DYNAMICS_MODULES
    dynamics/NeuralDynamics.cpp
    dynamics/SpikeSystem.cpp
)

# Plasticity modules
set(PLASTICITY_MODULES
    plasticity/PlasticityRule.cpp
    plasticity/Hebbian.cpp
    plasticity/STDP.cpp
    plasticity/StructuralPlasticity.cpp
)

# Development modules
set(DEVELOPMENT_MODULES
    development/DevelopmentSystem.cpp
    development/Synaptogenesis.cpp
    development/Pruning.cpp
    development/Maturation.cpp
)

# Neuromodulation modules
set(NEUROMODULATION_MODULES
    neuromodulation/Neuromodulator.cpp
    neuromodulation/Reward.cpp
    neuromodulation/PredictionError.cpp
    neuromodulation/Novelty.cpp
