# Enhanced Configuration Schema for NLM System
# Version 2.0 - Advanced Neural Learning Machine Configuration

# This file defines the enhanced configuration schema with validation rules,
# parameter dependencies, and new configuration categories for advanced users.

# ============================================================================
# ENHANCED CONFIGURATION SCHEMA
# ============================================================================

# Advanced Neural Parameters
# ============================================================================
neural_parameters {
    # Learning rates and plasticity settings
    learning_rate = 0.01
    # Type: double, Range: (0.0, 1.0), Validation: > 0.0
    
    plasticity_weight_decay = 0.0001
    # Type: double, Range: [0.0, 1.0], Validation: >= 0.0
    
    stdp_learning_rate = 0.01
    # Type: double, Range: (0.0, 1.0], Validation: > 0.0
    
    hebbian_learning_rate = 0.005
    # Type: double, Range: (0.0, 1.0], Validation: > 0.0
    
    # Threshold and excitability parameters
    excitation_threshold = -50.0
    # Type: double, Range: (-100.0, 0.0], Validation: <= 0.0
    
    inhibition_threshold = -70.0
    # Type: double, Range: (-100.0, 0.0], Validation: <= 0.0
    
    # Membrane dynamics parameters
    membrane_time_constant = 20.0
    # Type: double, Range: (0.0, 100.0], Validation: > 0.0
    
    refractory_period = 2.0
    # Type: double, Range: (0.0, 50.0], Validation: > 0.0
    
    # Synaptic properties
    initial_synaptic_weight = 0.5
    # Type: double, Range: [0.0, 1.0], Validation: >= 0.0
    
    synaptic_weight_std = 0.1
    # Type: double, Range: [0.0, 1.0], Validation: >= 0.0
    
    max_synaptic_weight = 1.0
    # Type: double, Range: [0.0, 10.0], Validation: >= 0.0
    
    min_synaptic_weight = 0.01
    # Type: double, Range: [0.0, 1.0], Validation: >= 0.0
}

# Memory System Parameters
# ============================================================================
memory_parameters {
    # Working memory parameters
    working_memory_capacity = 256
    # Type: int, Range: [64, 2048], Validation: > 0
    
    working_memory_decay_rate = 0.01
    # Type: double, Range: (0.0, 0.1], Validation: > 0.0
    
    working_memory_stability = 0.9
    # Type: double, Range: [0.0, 1.0], Validation: [0.0, 1.0]
    
    # Episodic memory parameters
    episodic_memory_capacity = 1024
    # Type: int, Range: [256, 10000], Validation: > 0
    
    consolidation_rate = 0.001
    # Type: double, Range: (0.0, 0.01], Validation: > 0.0
    
    replay_interval = 100
    # Type: int, Range: [10, 1000], Validation: > 0
    
    replay_duration = 10
    # Type: double, Range: [1.0, 100.0], Validation: > 0.0
    
    # Associative memory parameters
    association_strength = 0.8
    # Type: double, Range: [0.0, 1.0], Validation: [0.0, 1.0]
    
    pattern_matching_threshold = 0.7
    # Type: double, Range: [0.0, 1.0], Validation: [0.0, 1.0]
    
    # Memory management parameters
    memory_cleanup_rate = 0.05
    # Type: double, Range: [0.0, 0.5], Validation: >= 0.0
    
    memory_priority_boost = 1.5
    # Type: double, Range: [1.0, 5.0], Validation: >= 1.0
}

# Neuromodulation Parameters
# ============================================================================
neuromodulation_parameters {
    # Dopamine system parameters
    dopamine_baseline = 0.0
    # Type: double, Range: [-1.0, 1.0], Validation: [-1.0, 1.0]
    
    dopamine_gain = 1.0
    # Type: double, Range: [0.0, 5.0], Validation: >= 0.0
    
    dopamine_time_constant = 100.0
    # Type: double, Range: [1.0, 500.0], Validation: > 0.0
    
    # Serotonin system parameters
    serotonin_baseline = 0.1
    # Type: double, Range: [-1.0, 1.0], Validation: [-1.0, 1.0]
    
    serotonin_scale = 0.5
    # Type: double, Range: [0.0, 2.0], Validation: >= 0.0
    
    # Neuromodulation interaction parameters
    neuromodulation_coupling = 0.3
    # Type: double, Range: [0.0, 1.0], Validation: [0.0, 1.0]
    
    # Novelty detection parameters
    novelty_threshold = 0.5
    # Type: double, Range: [0.0, 1.0], Validation: [0.0, 1.0]
    
    novelty_decay_rate = 0.95
    # Type: double, Range: [0.9, 0.99], Validation: (0.0, 1.0]
    
    # Curiosity parameters
    curiosity_scale = 1.0
    # Type: double, Range: [0.0, 5.0], Validation: >= 0.0
    
    curiosity_threshold = 0.3
    # Type: double, Range: [0.0, 1.0], Validation: [0.0, 1.0]
    
    curiosity_increment = 0.01
    # Type: double, Range: (0.0, 0.1], Validation: > 0.0
}

# Development Parameters
# ============================================================================

development_parameters {
    # Critical period settings
    critical_period_start = 60.0
    # Type: double, Range: [10.0, 200.0], Validation: > 0.0
    
    critical_period_end = 300.0
    # Type: double, Range: [critical_period_start, 1000.0], Validation: > 0.0
    
    critical_period_plasticity_boost = 2.0
    # Type: double, Range: [1.0, 10.0], Validation: >= 1.0
    
    # Maturation parameters
    maturation_rate = 0.1
    # Type: double, Range: (0.0, 1.0], Validation: > 0.0
    
    neural_excitability_decay = 0.05
    # Type: double, Range: [0.0, 0.2], Validation: >= 0.0
    
    # Developmental stages
    initial_plasticity = 1.0
    # Type: double, Range: [0.1, 2.0], Validation: >= 0.1
    
    adult_plasticity = 0.2
    # Type: double, Range: [0.0, 0.5], Validation: >= 0.0
    
    # Structural development
    synaptogenesis_rate = 0.001
    # Type: double, Range: (0.0, 0.01], Validation: > 0.0
    
    pruning_rate = 0.0001
    # Type: double, Range: (0.0, 0.001], Validation: > 0.0
    
    myelination_rate = 0.0005
    # Type: double, Range: (0.0, 0.001], Validation: > 0.0
}

# Prediction System Parameters
# ============================================================================
prediction_parameters {
    # Prediction system settings
    prediction_horizon = 10
    # Type: int, Range: [1, 100], Validation: > 0
    
    confidence_threshold = 0.8
    # Type: double, Range: [0.0, 1.0], Validation: [0.0, 1.0]
    
    prediction_error_threshold = 0.5
    # Type: double, Range: [0.0, 1.0], Validation: [0.0, 1.0]
    
    # Prediction error propagation
    prediction_error_decay = 0.99
    # Type: double, Range: [0.9, 0.999], Validation: (0.0, 1.0]
    
    prediction_error_gain = 1.0
    # Type: double, Range: [0.0, 5.0], Validation: >= 0.0
    
    # Predictive coding parameters
    top_down_prediction_strength = 0.7
    # Type: double, Range: [0.0, 1.0], Validation: [0.0, 1.0]
    
    bottom_up_prediction_strength = 0.3
    # Type: double, Range: [0.0, 1.0], Validation: [0.0, 1.0]
    
    prediction_precision_weight = 0.5
    # Type: double, Range: [0.0, 1.0], Validation: [0.0, 1.0]
}

# Performance & Simulation Parameters
# ============================================================================

performance_parameters {
    # Simulation timing parameters
    simulation_timestep = 0.001
    # Type: double, Range: (0.0, 0.1], Validation: > 0.0
    
    max_simulation_steps = 100000
    # Type: int, Range: [1000, 1000000], Validation: > 0
    
    simulation_time_limit = 0.0
    # Type: double, Range: [0.0, 3600.0], Validation: >= 0.0
    
    # Memory management parameters
    max_memory_usage_mb = 512
    # Type: int, Range: [64, 4096], Validation: > 0
    
    memory_pool_size = 1024
    # Type: int, Range: [256, 16384], Validation: > 0
    
    # Parallel processing parameters
    enable_parallel_processing = true
    # Type: bool, Validation: always
    
    parallel_threads = 4
    # Type: int, Range: [1, 32], Validation: > 0
    
    enable_simd_optimization = true
    # Type: bool, Validation: always
    
    # Performance optimization flags
    enable_neural_compression = false
    # Type: bool, Validation: always
    
    compression_threshold = 0.1
    # Type: double, Range: [0.0, 1.0], Validation: [0.0, 1.0]
    
    enable_persistent_memory = true
    # Type: bool, Validation: always
    
    checkpoint_interval = 1000
    # Type: int, Range: [100, 10000], Validation: > 0
}

# ============================================================================
# CONFIGURATION DEPENDENCIES AND VALIDATION RULES
# ============================================================================

# Parameter dependencies (parameter1 depends on parameter2)
# Example: neural_parameters.learning_rate depends on neural_parameters.excitation_threshold
# This means learning_rate must be adjusted when excitation_threshold changes

# Validation rules for parameter combinations
# Rule: neural_parameters.plasticity_weight_decay must be <= neural_parameters.learning_rate
# Rule: neuromodulation_parameters.dopamine_gain must be >= 0.1 when neuromodulation_parameters.dopamine_baseline != 0.0
# Rule: development_parameters.critical_period_end must be > development_parameters.critical_period_start
# Rule: prediction_parameters.prediction_horizon must be <= performance_parameters.max_simulation_steps / 100

# ============================================================================
# PARAMETER TUNING SYSTEM
# ============================================================================

# Optimization algorithms for parameter tuning
# - gradient_descent: Gradient-based optimization
# - bayesian_optimization: Bayesian optimization with Gaussian processes
# - genetic_algorithm: Evolutionary algorithm for parameter search
# - random_search: Simple random parameter sampling
# - grid_search: Systematic grid-based parameter search

tuning_algorithms {
    default_algorithm = "bayesian_optimization"
    # Type: string, Options: ["gradient_descent", "bayesian_optimization", "genetic_algorithm", "random_search", "grid_search"]
    
    max_iterations = 1000
    # Type: int, Range: [100, 10000], Validation: > 0
    
    population_size = 50
    # Type: int, Range: [10, 200], Validation: > 0
    
    mutation_rate = 0.1
    # Type: double, Range: [0.0, 1.0], Validation: [0.0, 1.0]
    
    crossover_rate = 0.8
    # Type: double, Range: [0.0, 1.0], Validation: [0.0, 1.0]
}

# ============================================================================
# CONFIGURATION PRESETS
# ============================================================================

# Example presets for different use cases
# Each preset contains parameter values optimized for specific applications

presets {
    # Research preset - Maximum exploration and learning
    research {
        neural_parameters.learning_rate = 0.05
        neural_parameters.plasticity_weight_decay = 0.0005
        neuromodulation_parameters.curiosity_scale = 2.0
        neuromodulation_parameters.dopamine_gain = 2.0
        development_parameters.critical_period_plasticity_boost = 5.0
        development_parameters.maturation_rate = 0.05
        performance_parameters.max_memory_usage_mb = 2048
        tuning_algorithms.default_algorithm = "genetic_algorithm"
        tuning_algorithms.population_size = 100
    }
    
    # Production preset - Stable and efficient
    production {
        neural_parameters.learning_rate = 0.01
        neural_parameters.plasticity_weight_decay = 0.001
        neuromodulation_parameters.curiosity_scale = 0.5
        neuromodulation_parameters.dopamine_gain = 0.5
        development_parameters.critical_period_plasticity_boost = 1.5
        development_parameters.maturation_rate = 0.2
        performance_parameters.max_memory_usage_mb = 1024
        performance_parameters.enable_parallel_processing = true
        performance_parameters.parallel_threads = 8
        tuning_algorithms.default_algorithm = "bayesian_optimization"
        tuning_algorithms.max_iterations = 500
    }
    
    # Development preset - Fast adaptation and exploration
    development {
        neural_parameters.learning_rate = 0.02
        neural_parameters.plasticity_weight_decay = 0.0002
        neuromodulation_parameters.curiosity_scale = 1.5
        neuromodulation_parameters.dopamine_gain = 1.5
        development_parameters.critical_period_plasticity_boost = 3.0
        development_parameters.maturation_rate = 0.15
        performance_parameters.max_memory_usage_mb = 512
        performance_parameters.enable_neural_compression = true
        tuning_algorithms.default_algorithm = "genetic_algorithm"
        tuning_algorithms.mutation_rate = 0.2
    }
    
    # Real-time preset - Low latency and responsiveness
    real_time {
        neural_parameters.learning_rate = 0.005
        neural_parameters.plasticity_weight_decay = 0.002
        neuromodulation_parameters.curiosity_scale = 0.3
        neuromodulation_parameters.dopamine_gain = 0.3
        development_parameters.critical_period_plasticity_boost = 1.2
        development_parameters.maturation_rate = 0.3
        performance_parameters.simulation_timestep = 0.0001
        performance_parameters.enable_parallel_processing = true
        performance_parameters.parallel_threads = 2
        performance_parameters.enable_persistent_memory = false
        tuning_algorithms.default_algorithm = "random_search"
        tuning_algorithms.max_iterations = 200
    }
}

# ============================================================================
# SENSITIVITY ANALYSIS CONFIGURATION
# ============================================================================

sensitivity_analysis {
    # Parameters to analyze for sensitivity
    sensitive_parameters = ["neural_parameters.learning_rate", "neuromodulation_parameters.curiosity_scale", "development_parameters.maturation_rate"]
    # Type: array, Validation: must contain valid parameter paths
    
    # Sensitivity analysis settings
    analysis_type = "local"
    # Type: string, Options: ["local", "global", "correlation"]
    
    parameter_range = 20
    # Type: int, Range: [5, 100], Validation: > 0
    
    confidence_level = 0.95
    # Type: double, Range: [0.0, 1.0], Validation: (0.0, 1.0]
    
    # Output configuration
    enable_visualization = true
    # Type: bool, Validation: always
    
    output_directory = "sensitivity_results"
    # Type: string, Validation: non-empty
}

# ============================================================================
# AUTOMATED CONFIGURATION GENERATION
# ============================================================================

auto_generation {
    # Generation strategy
    strategy = "task_optimized"
    # Type: string, Options: ["task_optimized", "performance_balanced", "research_focused"]
    
    # Task-specific parameters
    enable_task_specific = true
    # Type: bool, Validation: always
    
    task_complexity_threshold = 5
    # Type: int, Range: [1, 10], Validation: > 0
    
    # Resource constraints
    memory_constraint_mb = 512
    # Type: int, Range: [128, 2048], Validation: > 0
    
    cpu_constraint = 2.0
    # Type: double, Range: [0.5, 16.0], Validation: > 0.0
    
    # Generation settings
    max_configurations = 100
    # Type: int, Range: [10, 1000], Validation: > 0
    
    diversity_factor = 0.5
    # Type: double, Range: [0.0, 1.0], Validation: [0.0, 1.0]
    
    quality_threshold = 0.8
    # Type: double, Range: [0.0, 1.0], Validation: (0.0, 1.0]
}

# ============================================================================
# CONFIGURATION VERSIONING AND MIGRATION
# ============================================================================

versioning {
    # Version control settings
    current_version = "2.0.0"
    # Type: string, Validation: semantic version format
    
    enable_auto_backup = true
    # Type: bool, Validation: always
    
    backup_retention_days = 30
    # Type: int, Range: [7, 365], Validation: > 0
    
    enable_migration_wizard = true
    # Type: bool, Validation: always
    
    # Migration settings
    migration_validation = true
    # Type: bool, Validation: always
    
    migration_log_level = "INFO"
    # Type: string, Options: ["DEBUG", "INFO", "WARNING", "ERROR"]
    
    # Version compatibility matrix
    compatible_versions = ["1.0.0", "1.1.0", "1.2.0", "1.3.0", "1.4.0", "1.5.0", "2.0.0"]
    # Type: array, Validation: must be sorted
}

# ============================================================================
# ADVANCED CONFIGURATION FEATURES
# ============================================================================

advanced_features {
    # Nested configuration objects
    enable_nested_objects = true
    # Type: bool, Validation: always
    
    # Configuration inheritance
    enable_inheritance = true
    # Type: bool, Validation: always
    
    inheritance_chain = []
    # Type: array, Validation: must contain valid configuration paths
    
    # Configuration macros
    enable_macros = true
    # Type: bool, Validation: always
    
    macro_directory = "macros"
    # Type: string, Validation: non-empty
    
    # Configuration expressions and formulas
    enable_expressions = true
    # Type: bool, Validation: always
    
    expression_language = "python"
    # Type: string, Options: ["python", "javascript", "math"]
    
    # Expression evaluation timeout
    expression_timeout_ms = 1000
    # Type: int, Range: [100, 10000], Validation: > 0
}

# ============================================================================
# PERFORMANCE MONITORING AND TUNING
# ============================================================================

performance_monitoring {
    # Monitoring settings
    enable_real_time_monitoring = true
    # Type: bool, Validation: always
    
    monitoring_interval_ms = 1000
    # Type: int, Range: [100, 10000], Validation: > 0
    
    # Performance thresholds
    max_cpu_usage = 80.0
    # Type: double, Range: [10.0, 100.0], Validation: > 0.0
    
    max_memory_usage_percent = 90.0
    # Type: double, Range: [50.0, 100.0], Validation: (0.0, 100.0]
    
    min_simulation_framerate = 30.0
    # Type: double, Range: [1.0, 60.0], Validation: > 0.0
    
    # Auto-tuning settings
    enable_auto_tuning = true
    # Type: bool, Validation: always
    
    auto_tune_interval_ms = 60000
    # Type: int, Range: [10000, 300000], Validation: > 0
    
    performance_target = "balanced"
    # Type: string, Options: ["fast", "balanced", "accurate"]
}

# ============================================================================
# VALIDATION AND ERROR HANDLING
# ============================================================================

validation {
    # Validation rules
    strict_validation = false
    # Type: bool, Validation: always
    
    validation_level = "standard"
    # Type: string, Options: ["basic", "standard", "strict", "comprehensive"]
    
    # Error handling
    fail_on_invalid_config = true
    # Type: bool, Validation: always
    
    continue_on_warnings = true
    # Type: bool, Validation: always
    
    # Detailed error reporting
    enable_detailed_errors = true
    # Type: bool, Validation: always
    
    max_error_report_size = 10000
    # Type: int, Range: [1000, 100000], Validation: > 0
}

# ============================================================================
# BACKUP AND RESTORATION
# ============================================================================

backup_and_restore {
    # Backup settings
    enable_auto_backup = true
    # Type: bool, Validation: always
    
    backup_directory = "backups"
    # Type: string, Validation: non-empty
    
    backup_format = "json"
    # Type: string, Options: ["json", "xml", "binary"]
    
    max_backups = 10
    # Type: int, Range: [5, 50], Validation: > 0
    
    backup_compression = true
    # Type: bool, Validation: always
    
    # Restoration settings
    enable_auto_restore = false
    # Type: bool, Validation: always
    
    restoration_validation = true
    # Type: bool, Validation: always
    
    restoration_backup_before_restore = true
    # Type: bool, Validation: always
}