    echo "  - Inter-regional connection analysis"
    echo "  - Network module identification"
    echo "  - Hub identification"
    echo "  - Small-world analysis"
}

# Main debug dispatcher
main() {
    local command=""
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_debug_help
                exit 0
                ;;
            -c|--config)
                NLM_CONFIG="$2"
                shift 2
                ;;
            -l|--log)
                shift 1
                ;;
            -*)
                echo "Unknown option: $1"
                show_debug_help
                exit 1
                ;;
            *)
                # First non-option argument is the command
                command="$1"
                shift
                break
                ;;
        esac
    done
    
    # Execute command
    case "$command" in
        neurons)
            debug_neurons "$@"
            ;;
        synapses)
            debug_synapses "$@"
            ;;
        memory)
            debug_memory "$@"
            ;;
        prediction)
            debug_prediction "$@"
            ;;
        attention)
            debug_attention "$@"
            ;;
        neuromodulation)
            debug_neuromodulation "$@"
            ;;
        concept)
            debug_concept "$@"
            ;;
        development)
            debug_development "$@"
            ;;
        performance)
            debug_performance "$@"
            ;;
        connectivity)
            debug_connectivity "$@"
            ;;
        *)
            if [[ -n "$command" ]]; then
                echo "Unknown debug command: $command"
                show_debug_help
                exit 1
            else
                echo "No debug command specified"
                show_debug_help
                exit 1
            fi
            ;;
    esac
}

# Execute main function with all arguments
main "$@"
