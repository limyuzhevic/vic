#!/bin/bash

# NLM Demo Launcher
# Unified launcher for all NLM demos with clear descriptions and usage information.

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUILD_DIR="${PROJECT_ROOT}/build"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

print_help() {
    echo -e "${BLUE}NLM Demo Launcher${NC}"
    echo ""
    echo "Usage: ./demo <demo_name> [options]"
    echo ""
    echo "Available demos:"
    echo "  phase1      Phase 1: Project Infrastructure - Core types and interfaces"
    echo "  phase2      Phase 2: Real Neural Computation - LIF neurons and spike propagation"
    echo "  phase3      Phase 3: World Interaction - World models, sensory/motor systems"
    echo "  phase4      Phase 4: Emergent Cognition - Memory, prediction, planning"
    echo "  phase5      Phase 5: Performance Optimization - Advanced optimizations"
    echo "  phase6      Phase 6: Integration - All systems working together"
    echo "  phase6-text Phase 6: Text Teaching - Text-as-a-sense and social learning"
    echo "  benchmark   Performance benchmarks"
    echo ""
    echo "Options:"
    echo "  --help      Show this help message"
    echo "  --version   Show NLM version"
    echo "  --list      List all available demos"
    echo ""
    echo "Examples:"
    echo "  ./demo phase1              # Run Phase 1 demo (project infrastructure)"
    echo "  ./demo phase6 --help       # Show help for Phase 6 demo"
    echo "  ./demo --list              # List all demos"
    echo ""
    echo "Note: Demos require building with CMake first:"
    echo "  mkdir build && cd build && cmake .. -DCMAKE_BUILD_TYPE=Release"
    echo "  make -j$(nproc)"
}

list_demos() {
    echo -e "${BLUE}NLM Demo List${NC}"
    echo ""
    echo -e "${GREEN}Phase 1: Project Infrastructure${NC}"
    echo "  nlm_phase1_demo: Core types, configuration system, neural interfaces"
    echo ""
    echo -e "${GREEN}Phase 2: Real Neural Computation${NC}"
    echo "  nlm: Real spiking neural computation with LIF neurons"
    echo ""
    echo -e "${YELLOW}Phase 3: World Interaction${NC}"
    echo "  nlm_phase3_demo: World models, sensory input, motor output"
    echo ""
    echo -e "${YELLOW}Phase 4: Emergent Cognition${NC}"
    echo "  nlm_phase4_demo: Memory, prediction, attention, planning"
    echo ""
    echo -e "${YELLOW}Phase 5: Performance Optimization${NC}"
    echo "  nlm_phase5_demo: Advanced optimizations and sandbox demonstrations"
    echo ""
    echo -e "${RED}Phase 6: Final Integration${NC}"
    echo "  nlm_phase6_demo: Integration test showing all systems connected"
    echo "  nlm_phase6_text_demo: Text teaching and social learning demo"
    echo ""
    echo -e "${BLUE}Other${NC}"
    echo "  nlm_benchmark: Performance benchmarks and profiling"
}

run_demo() {
    local demo_name=$1
    shift
    
    # Check if build directory exists
    if [ ! -d "$BUILD_DIR" ]; then
        echo -e "${RED}Error: Build directory not found!${NC}"
        echo "Please build NLM first:"
        echo "  mkdir build && cd build && cmake .. -DCMAKE_BUILD_TYPE=Release"
        echo "  make -j$(nproc)"
        exit 1
    fi
    
    cd "$BUILD_DIR"
    
    case $demo_name in
        "phase1")
            echo -e "${GREEN}Running Phase 1 Demo...${NC}"
            ./nlm_phase1_demo "$@"
            ;;
        "phase2")
            echo -e "${GREEN}Running Phase 2 Demo...${NC}"
            ./nlm "$@"
            ;;
        "phase3")
            echo -e "${YELLOW}Running Phase 3 Demo...${NC}"
            ./nlm_phase3_demo "$@"
            ;;
        "phase4")
            echo -e "${YELLOW}Running Phase 4 Demo...${NC}"
            ./nlm_phase4_demo "$@"
            ;;
        "phase5")
            echo -e "${YELLOW}Running Phase 5 Demo...${NC}"
            ./nlm_phase5_demo "$@"
            ;;
        "phase6")
            echo -e "${RED}Running Phase 6 Integration Demo...${NC}"
            ./nlm_phase6_demo "$@"
            ;;
        "phase6-text")
            echo -e "${RED}Running Phase 6 Text Demo...${NC}"
            ./nlm_phase6_text_demo "$@"
            ;;
        "benchmark")
            echo -e "${BLUE}Running Benchmark...${NC}"
            ./nlm_benchmark "$@"
            ;;
        *)
            echo -e "${RED}Error: Unknown demo '$demo_name'${NC}"
            echo "Use './demo --list' to see available demos."
            exit 1
            ;;
    esac
    
    cd - > /dev/null
}

# Check if we should show help
if [[ "$1" == "--help" ]] || [[ "$1" == "-h" ]]; then
    print_help
    exit 0
fi

# Check if we should list demos
if [[ "$1" == "--list" ]]; then
    list_demos
    exit 0
fi

# Check if we should show version
if [[ "$1" == "--version" ]]; then
    echo -e "${BLUE}NLM Version 0.1.0${NC}"
    echo "Neural Learning Machine - Experimental Artificial Brain"
    exit 0
fi

# Check if we have a demo name
if [ $# -lt 1 ]; then
    echo -e "${RED}Error: No demo specified.${NC}"
    echo "Use './demo --help' for usage information."
    exit 1
fi

# Run the specified demo
run_demo "$1" "$@"