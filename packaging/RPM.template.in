# RPM packaging configuration

# RPM variables
set(RPM_PACKAGE_NAME "@PROJECT_NAME@")
set(RPM_PACKAGE_VERSION "@PROJECT_VERSION@")
set(RPM_PACKAGE_RELEASE 1)
set(RPM_PACKAGE_DESCRIPTION "@PROJECT_DESCRIPTION@")
set(RPM_PACKAGE_VENDOR "NLM Project")
set(RPM_PACKAGE_GROUP "Development")
set(RPM_PACKAGE_URL "@PROJECT_HOMEPAGE_URL@")
set(RPM_PACKAGE_LICENSE "MIT")

# Set RPM generator
set(CPACK_GENERATOR "RPM")

# RPM-specific configuration
set(CPACK_RPM_PACKAGE_NAME "${RPM_PACKAGE_NAME}")
set(CPACK_RPM_PACKAGE_VERSION "${RPM_PACKAGE_VERSION}")
set(CPACK_RPM_PACKAGE_RELEASE ${RPM_PACKAGE_RELEASE})
set(CPACK_RPM_PACKAGE_DESCRIPTION "${RPM_PACKAGE_DESCRIPTION}")
set(CPACK_RPM_PACKAGE_VENDOR "${RPM_PACKAGE_VENDOR}")
set(CPACK_RPM_PACKAGE_GROUP "${RPM_PACKAGE_GROUP}")
set(CPACK_RPM_PACKAGE_URL "${RPM_PACKAGE_URL}")
set(CPACK_RPM_PACKAGE_LICENSE "${RPM_PACKAGE_LICENSE}")

# Architecture-specific settings
if(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64")
    set(CPACK_RPM_PACKAGE_ARCH "x86_64")
elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64")
    set(CPACK_RPM_PACKAGE_ARCH "aarch64")
elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "armv7")
    set(CPACK_RPM_PACKAGE_ARCH "armv7hl")
else()
    set(CPACK_RPM_PACKAGE_ARCH "noarch")
endif()

# Dependency information
set(CPACK_RPM_PACKAGE_REQUIRES "cmake, gcc-c++, make")
