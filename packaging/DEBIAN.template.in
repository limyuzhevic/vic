# DEB packaging configuration

# DEB variables
set(DEBIAN_PACKAGE_NAME "@PROJECT_NAME@")
set(DEBIAN_PACKAGE_VERSION "@PROJECT_VERSION@")
set(DEBIAN_PACKAGE_DESCRIPTION "@PROJECT_DESCRIPTION@")
set(DEBIAN_PACKAGE_MAINTAINER "NLM Project")
set(DEBIAN_PACKAGE_LICENSE "MIT")
set(DEBIAN_PACKAGE_SECTION "devel")
set(DEBIAN_PACKAGE_PRIORITY "optional")
set(DEBIAN_PACKAGE_ARCHITECTURE "all")

# Set DEB generator
set(CPACK_GENERATOR "DEB")

# DEB-specific configuration
set(CPACK_DEBIAN_PACKAGE_NAME "${DEBIAN_PACKAGE_NAME}")
set(CPACK_DEBIAN_PACKAGE_VERSION "${DEBIAN_PACKAGE_VERSION}")
set(CPACK_DEBIAN_PACKAGE_DESCRIPTION "${DEBIAN_PACKAGE_DESCRIPTION}")
set(CPACK_DEBIAN_PACKAGE_MAINTAINER "${DEBIAN_PACKAGE_MAINTAINER}")
set(CPACK_DEBIAN_PACKAGE_LICENSE "${DEBIAN_PACKAGE_LICENSE}")
set(CPACK_DEBIAN_PACKAGE_SECTION "${DEBIAN_PACKAGE_SECTION}")
set(CPACK_DEBIAN_PACKAGE_PRIORITY "${DEBIAN_PACKAGE_PRIORITY}")
set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE "${DEBIAN_PACKAGE_ARCHITECTURE}")

# Dependency information
set(CPACK_DEBIAN_PACKAGE_DEPENDS "cmake, g++, make")
set(CPACK_DEBIAN_PACKAGE_REMAINS)
