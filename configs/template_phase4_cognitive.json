{
  "version": "1.0.0",
  "description": "NLM Phase 4 - Cognitive Development Template",
  "template_type": "phase4_cognitive",
  "phase": 4,
  "focus": "Cognitive development and higher-order functions",
  "components": {
    "simulation": {
      "random_seed": 42,
      "simulation_timestep": 0.001,
      "max_simulation_steps": 100000,
      "simulation_time_limit": 0.0
    },
    "neural": {
      "neuron_count": 2000,
      "region_count": 3,
      "connection_probability": 0.25,
      "neuron_type": "Izhikevich"
    },
    "plasticity": {
      "plasticity_learning_rate": 0.03,
      "stdp_ltp_weight": 0.03,
      "stdp_ltd_weight": 0.025,
      "stdp_time_constant": 40.0
    },
    "development": {
      "development_synaptogenesis_rate": 0.001,
      "development_pruning_rate": 0.0002,
      "maturation_rate": 0.002
    },
    "neuromodulation": {
      "dopamine_baseline": 0.3,
      "curiosity_baseline": 1.5,
      "novelty_threshold": 0.5
    },
    "reward": {
      "reward_discount_factor": 0.9,
      "reward_scale": 3.0
    },
    "environment": {
      "environment_name": "ComplexWorld",
      "environment_width": 30,
      "environment_height": 30,
      "world_bounds_x": 200.0,
      "world_bounds_y": 200.0
    },
    "logging": {
      "log_level": "DEBUG",
      "log_to_file": true,
      "log_filename": "nlm_phase4.log",
      "log_file_append": true,
      "log_max_size": 10485760,
      "colored": true,
      "timestamps": true
    },
    "visualization": {
      "visualization_enabled": true,
      "visualization_update_rate": 30.0,
      "visualization_window_width": 1600,
      "visualization_window_height": 1200
    }
  },
  "notes": [
    "Neural prediction system integration",
    "Working memory implementation",
    "Episodic-like memory systems",
    "Concept formation from experience patterns",
    "Neural attention (NOT Transformer)",
    "Predictive planning",
    "Self-model development",
    "Social learning capabilities",
    "Continual learning mechanisms"
  ]
}
