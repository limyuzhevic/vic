{
  "version": "1.0.0",
  "description": "NLM Phase 3 - Agent-World Interaction Template",
  "template_type": "phase3_interaction",
  "phase": 3,
  "focus": "Agent-environment interaction and world modeling",
  "components": {
    "simulation": {
      "random_seed": 42,
      "simulation_timestep": 0.001,
      "max_simulation_steps": 50000,
      "simulation_time_limit": 0.0
    },
    "neural": {
      "neuron_count": 1000,
      "region_count": 2,
      "connection_probability": 0.2,
      "neuron_type": "LIF"
    },
    "plasticity": {
      "plasticity_learning_rate": 0.02,
      "stdp_ltp_weight": 0.025,
      "stdp_ltd_weight": 0.02,
      "stdp_time_constant": 30.0
    },
    "development": {
      "development_synaptogenesis_rate": 0.0005,
      "development_pruning_rate": 0.00005,
      "maturation_rate": 0.001
    },
    "neuromodulation": {
      "dopamine_baseline": 0.2,
      "curiosity_baseline": 1.0,
      "novelty_threshold": 0.3
    },
    "reward": {
      "reward_discount_factor": 0.95,
      "reward_scale": 2.0
    },
    "environment": {
      "environment_name": "GridWorld",
      "environment_width": 20,
      "environment_height": 20,
      "world_bounds_x": 100.0,
      "world_bounds_y": 100.0
    },
    "logging": {
      "log_level": "INFO",
      "log_to_file": true,
      "log_filename": "nlm_phase3.log",
      "log_file_append": true,
      "log_max_size": 10485760,
      "colored": true,
      "timestamps": true
    },
    "visualization": {
      "visualization_enabled": true,
      "visualization_update_rate": 30.0,
      "visualization_window_width": 1200,
      "visualization_window_height": 800
    }
  },
  "notes": [
    "World interaction loop with sensory input and motor output",
    "Reward prediction error integration",
    "Developmental stages affect plasticity rates",
    "Novelty and curiosity driven exploration behavior",
    "Agent-brain interface and sensory-percept integration"
  ]
}
