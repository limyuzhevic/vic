# NLM Configuration File
# Comprehensive configuration for NLM (熙然) Neural Learning Machine
# Supports JSON and YAML formats

# Random seed for reproducible experiments
# random_seed (int64): Seed for random number generator
random_seed = 42

# Simulation timestep in seconds
# simulation_timestep (double): Time step for neural simulation
# Should be small enough for numerical stability (typically 0.001)
simulation_timestep = 0.001

# Number of neurons in the brain
# neuron_count (size_t): Total number of neurons across all regions
neuron_count = 1000

# Number of brain regions
# region_count (size_t): Number of NeuralRegion instances
region_count = 2

# Connection probability for random connectivity
# connection_probability (float): Probability of synaptic connection between neurons
# Range: [0.0, 1.0]
connection_probability = 0.1

# Plasticity settings (STDP and Hebbian)
stdp_ltp_weight = 0.01         # STDP Long-Term Potentiation weight
stdp_ltd_weight = 0.012        # STDP Long-Term Depression weight  
stdp_time_constant = 20.0      # STDP time constant for eligibility traces
plasticity_learning_rate = 0.01 # Hebbian learning rate

# Development system parameters
# development_synaptogenesis_rate (float): Rate of new synapse formation
# development_pruning_rate (float): Rate of synapse elimination
development_synaptogenesis_rate = 0.001
development_pruning_rate = 0.0001

# Neuromodulation settings
# dopamine_baseline (float): Baseline dopamine level [0.0, 1.0]
dopamine_baseline = 0.1

# Reward and reinforcement learning
# reward_discount_factor (float): Gamma factor for reward discounting [0.0, 1.0]
reward_discount_factor = 0.99

# Curiosity and exploration parameters
# curiosity_threshold (float): Novelty threshold for exploration
# curiosity_gain (float): Learning rate for curiosity-driven exploration
curiosity_threshold = 0.5
curiosity_gain = 0.1

# Novelty detection sensitivity
# novelty_sensitivity (float): Weight for novelty detection in learning
novelty_sensitivity = 0.3

# Prediction error scaling
# prediction_error_scale (float): Scaling factor for prediction errors
prediction_error_scale = 1.0

# Environment settings
# environment_name (string): Name of the simulation environment (GridWorld, etc.)
environment_name = GridWorld
environment_width = 10
environment_height = 10

# Simulation control
# max_simulation_steps (size_t): Maximum number of simulation steps
# simulation_time_limit (double): Maximum simulation time in seconds (0 = unlimited)
max_simulation_steps = 10000
simulation_time_limit = 0.0

# Logging configuration
# log_level (string): Log level (TRACE, DEBUG, INFO, WARN, ERROR, CRITICAL)
log_level = INFO
# log_to_file (bool): Enable/disable logging to file
log_to_file = false
# log_filename (string): Log file name
log_filename = nlm.log

# Checkpoint configuration
# checkpoint_dir (string): Directory for saving brain state checkpoints
checkpoint_dir = ./checkpoints
# checkpoint_interval (size_t): Steps between automatic checkpoints
checkpoint_interval = 10000
# checkpoint_compression (string): Compression level for checkpoints
checkpoint_compression = Balanced
# checkpoint_max_files (int): Maximum number of checkpoint files to keep
checkpoint_max_files = 5

# Visualization settings
# visualization_enabled (bool): Enable/disable real-time visualization
visualization_enabled = false
# visualization_update_rate (double): Update rate for visualization (Hz)
visualization_update_rate = 30.0

# Working memory configuration
# working_memory_capacity (size_t): Number of items working memory can hold
working_memory_capacity = 100
# working_memory_decay_rate (float): Rate of memory trace decay per timestep
working_memory_decay_rate = 0.1

# Episodic memory configuration
# episodic_memory_max_episodes (size_t): Maximum number of episodes to store
episodic_memory_max_episodes = 1000
# episodic_memory_consolidation_interval (size_t): Steps between consolidation
episodic_memory_consolidation_interval = 1000

# Performance optimization
# use_memory_pools (bool): Enable memory pool allocation for performance
use_memory_pools = true
# use_simd (bool): Enable SIMD optimizations where possible
use_simd = true
# event_driven_spiking (bool): Use event-driven spike delivery instead of polling
event_driven_spiking = true

# Cognitive system parameters
# planner_planning_depth (size_t): How many steps ahead the planner looks
planner_planning_depth = 5
# concept_formation_threshold (float): Threshold for concept detection
concept_formation_threshold = 0.8
# attentional_inhibition_strength (float): Strength of competitive inhibition
attentional_inhibition_strength = 0.5
# attentional_excitation_strength (float): Strength of excitation in attention
attentional_excitation_strength = 1.5

# Development stages
# developmental_stage (string): Current developmental stage (Initial, CriticalPeriod, Maturation, Adult)
developmental_stage = Initial

# Simulation debugging and profiling
# debug_mode (bool): Enable debug logging and validation
debug_mode = false
# profile_performance (bool): Enable performance profiling
profile_performance = false