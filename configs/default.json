{
  "nlm": {
    "version": "0.1.0",
    "config_version": "2.0",
    
    "core": {
      "random_seed": 42,
      "simulation_timestep": 0.001,
      "max_simulation_steps": 10000,
      "simulation_time_limit": 0.0
    },
    
    "brain": {
      "neuron_count": 1000,
      "region_count": 2,
      "connection_probability": 0.1,
      
      "plasticity": {
        "learning_rate": 0.01,
        "stdp_ltp_weight": 0.01,
        "stdp_ltd_weight": 0.012,
        "stdp_time_constant": 20.0
      },
      
      "development": {
        "synaptogenesis_rate": 0.001,
        "pruning_rate": 0.0001
      }
    },
    
    "neuromodulation": {
      "dopamine": {
        "baseline": 0.0,
        "modulation_strength": 0.5,
        "phasic_response_strength": 0.8,
        "adaptation_time_constant": 1.0,
        "recovery_rate": 0.2,
        "reward_prediction_error_weight": 0.6
      },
      
      "curiosity": {
        "base_level": 0.0,
        "novelty_weight": 0.5,
        "prediction_error_weight": 0.5,
        "decay_rate": 0.05,
        "exploration_threshold": 0.3
      },
      
      "novelty": {
        "detection_threshold": 0.3,
        "decay_rate": 0.1,
        "sensitivity": 1.0
      },
      
      "prediction_error": {
        "baseline": 0.0,
        "learning_rate": 0.5,
        "history_size": 100,
        "confidence_threshold": 0.5
      }
    },
    
    "reward": {
      "discount_factor": 0.99,
      "discount_time_constant": 10.0,
      "reward_prediction_error": {
        "initial_prediction": 0.0,
        "learning_rate": 0.1,
        "max_history": 100
      }
    },
    
    "environment": {
      "name": "GridWorld",
      "width": 10,
      "height": 10,
      "visible_cells": 5,
      "sensory_range": 5
    },
    
    "logging": {
      "level": "INFO",
      "to_file": false,
      "filename": "nlm.log",
      "max_file_size_mb": 100,
      "max_files": 5
    },
    
    "visualization": {
      "enabled": false,
      "update_rate": 30.0,
      "frame_rate": 30,
      "neuron_scale": 1.0,
      "connection_width": 0.1
    },
    
    "experimental": {
      "enable_checkpointing": true,
      "enable_replay": true,
      "enable_development": true,
      "checkpoint_interval": 1000,
      "replay_ratio": 0.1,
      "replay_decay": 0.95
    }
  }
}
