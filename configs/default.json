    "logging": {
        "level": "INFO",
        "to_file": false,
        "filename": "nlm.log",
        "max_size_mb": 100,
        "rotate_count": 5
    },
    
    "checkpointing": {
        "directory": "./checkpoints",
        "interval": 1000,
        "max_files": 10000,
        "compress": true
    },
    
    "visualization": {
        "enabled": false,
        "update_rate": 30.0
