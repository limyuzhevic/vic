{
  "name": "research",
  "description": "Research-focused configuration with detailed logging and validation enabled",
  "parameters": {
    "log_level": "DEBUG",
    "log_to_file": true,
    "log_filename": "nlm_research.log",
    "max_simulation_steps": 50000,
    "enable_validation": true,
    "validation_frequency": 100,
    "neuron_count": 2000,
    "stdp_ltp_weight": 0.015,
    "stdp_ltd_weight": 0.012,
    "synaptogenesis_rate": 0.002,
    "pruning_rate": 0.0002,
    "parallel_threads": 4,
    "enable_simd": true,
    "enable_avx2": true,
    "enable_avx512": false,
    "enable_memory_pool": true,
    "memory_pool_size": 2000000,
    "record_neurons": true,
    "record_synapses": true,
    "record_memories": true,
    "record_modulators": true,
    "compute_metrics": true,
    "track_rewards": true,
    "track_errors": true,
    "enable_performance_monitoring": true,
    "performance_sample_rate": 0.02,
    "enable_memory_monitoring": true,
    "enable_cpu_monitoring": true,
    "custom_metrics": ["spike_rate", "weight_change", "learning_curve"],
    "enable_custom_metrics": true
  }
}
