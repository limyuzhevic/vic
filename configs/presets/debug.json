{
  "name": "debug",
  "description": "Debug configuration with maximum verbosity and all debugging enabled",
  "parameters": {
    "log_level": "DEBUG",
    "log_to_file": true,
    "log_filename": "nlm_debug.log",
    "max_simulation_steps": 100,
    "enable_validation": true,
    "validation_frequency": 10,
    "parallel_threads": 1,
    "enable_simd": false,
    "enable_avx2": false,
    "enable_avx512": false,
    "enable_memory_pool": false,
    "memory_pool_size": 100000,
    "neuron_count": 100,
    "stdp_ltp_weight": 0.02,
    "stdp_ltd_weight": 0.02,
    "synaptogenesis_rate": 0.01,
    "pruning_rate": 0.001,
    "enable_performance_monitoring": false,
    "enable_memory_monitoring": false,
    "enable_cpu_monitoring": false,
    "enable_custom_metrics": false,
    "record_neurons": true,
    "record_synapses": true,
    "record_memories": true,
    "record_modulators": true,
    "compute_metrics": true,
    "track_rewards": true,
    "track_errors": true,
    "custom_metrics": ["debug_info", "step_details", "neuron_states"],
    "enable_custom_metrics": true
  }
}
