{
  "name": "education",
  "description": "Education-focused configuration with simplified settings and verbose output",
  "parameters": {
    "log_level": "INFO",
    "log_to_file": true,
    "log_filename": "nlm_education.log",
    "max_simulation_steps": 5000,
    "enable_validation": true,
    "validation_frequency": 50,
    "parallel_threads": 2,
    "enable_simd": true,
    "enable_avx2": false,
    "enable_avx512": false,
    "enable_memory_pool": true,
    "memory_pool_size": 500000,
    "neuron_count": 500,
    "stdp_ltp_weight": 0.01,
    "stdp_ltd_weight": 0.01,
    "synaptogenesis_rate": 0.001,
    "pruning_rate": 0.0001,
    "enable_performance_monitoring": true,
    "performance_sample_rate": 0.01,
    "enable_memory_monitoring": true,
    "enable_cpu_monitoring": true,
    "custom_metrics": ["step_count", "firing_rate", "neuron_activity"],
    "enable_custom_metrics": true,
    "record_neurons": true,
    "record_synapses": true,
    "record_memories": true,
    "record_modulators": true,
    "compute_metrics": true,
    "track_rewards": true,
    "track_errors": true
  }
}
