{
  "name": "production",
  "description": "Production configuration with minimal output and validation enabled",
  "parameters": {
    "log_level": "ERROR",
    "log_to_file": true,
    "log_filename": "nlm_production.log",
    "max_simulation_steps": 10000,
    "enable_validation": true,
    "validation_frequency": 200,
    "parallel_threads": 4,
    "enable_simd": true,
    "enable_avx2": true,
    "enable_avx512": true,
    "enable_memory_pool": true,
    "memory_pool_size": 1000000,
    "neuron_count": 1000,
    "stdp_ltp_weight": 0.01,
    "stdp_ltd_weight": 0.012,
    "synaptogenesis_rate": 0.001,
    "pruning_rate": 0.0001,
    "enable_performance_monitoring": true,
    "performance_sample_rate": 0.01,
    "enable_memory_monitoring": true,
    "enable_cpu_monitoring": true,
    "enable_custom_metrics": false,
    "record_neurons": false,
    "record_synapses": false,
    "record_memories": false,
    "record_modulators": false,
    "compute_metrics": true,
    "track_rewards": true,
    "track_errors": true
  }
}
