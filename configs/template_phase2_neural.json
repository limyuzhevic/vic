{
  "version": "1.0.0",
  "description": "NLM Phase 2 - Basic Neural Computation Template",
  "template_type": "phase2_neural",
  "phase": 2,
  "focus": "Neural computation and basic brain dynamics",
  "components": {
    "simulation": {
      "random_seed": 42,
      "simulation_timestep": 0.001,
      "max_simulation_steps": 10000,
      "simulation_time_limit": 0.0
    },
    "neural": {
      "neuron_count": 500,
      "region_count": 1,
      "connection_probability": 0.15,
      "neuron_type": "LIF"
    },
    "plasticity": {
      "plasticity_learning_rate": 0.01,
      "stdp_ltp_weight": 0.02,
      "stdp_ltd_weight": 0.015,
      "stdp_time_constant": 20.0
    },
    "development": {
      "development_synaptogenesis_rate": 0.0001,
      "development_pruning_rate": 0.00001,
      "maturation_rate": 0.0005
    },
    "neuromodulation": {
      "dopamine_baseline": 0.1,
      "curiosity_baseline": 0.5,
      "novelty_threshold": 0.2
    },
    "reward": {
      "reward_discount_factor": 0.99,
      "reward_scale": 1.0
    },
    "environment": {
      "environment_name": "GridWorld",
      "environment_width": 10,
      "environment_height": 10,
      "world_bounds_x": 50.0,
      "world_bounds_y": 50.0
    },
    "logging": {
      "log_level": "INFO",
      "log_to_file": true,
      "log_filename": "nlm_phase2.log",
      "log_file_append": true,
      "log_max_size": 10485760,
      "colored": true,
      "timestamps": true
    },
    "visualization": {
      "visualization_enabled": true,
      "visualization_update_rate": 30.0,
      "visualization_window_width": 800,
      "visualization_window_height": 600
    }
  },
  "notes": [
    "Basic neural computation with real LIF neuron dynamics",
    "Event-driven spike propagation with delays",
    "STDP and Hebbian plasticity rules",
    "Structural plasticity (synaptogenesis/pruning)",
    "Suitable for learning experiments and basic brain testing"
  ]
}
