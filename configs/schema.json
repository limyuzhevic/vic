{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NLM Configuration Schema",
  "description": "JSON Schema for NLM (Neural Learning Machine) Configuration",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Configuration version (semantic versioning)",
          "examples": ["1.0.0", "1.2.3"]
        },
        "created": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp of the configuration"
        },
        "author": {
          "type": "string",
          "description": "Author or creator of the configuration"
        }
      },
      "additionalProperties": false
    },
    "simulation": {
      "type": "object",
      "properties": {
        "random_seed": {
          "type": "integer",
          "minimum": 0,
          "description": "Random seed for reproducible experiments"
        },
        "simulation_timestep": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.0,
          "description": "Simulation timestep in seconds"
        },
        "max_simulation_steps": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum simulation steps"
        },
        "simulation_time_limit": {
          "type": "number",
          "minimum": 0,
          "description": "Simulation time limit in seconds"
        },
        "neuron_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of neurons in the brain"
        },
        "region_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Number of brain regions"
        },
        "connection_probability": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Connection probability for random connectivity"
        }
      },
      "additionalProperties": false
    },
    "plasticity": {
      "type": "object",
      "properties": {
        "plasticity_learning_rate": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Base plasticity learning rate"
        },
        "stdp_ltp_weight": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "STDP LTP weight"
        },
        "stdp_ltd_weight": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "STDP LTD weight"
        },
        "stdp_time_constant": {
          "type": "number",
          "minimum": 0.0,
          "description": "STDP time constant"
        },
        "development_synaptogenesis_rate": {
          "type": "number",
          "minimum": 0.0,
          "description": "Development synaptogenesis rate"
        },
        "development_pruning_rate": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Development pruning rate"
        }
      },
      "additionalProperties": false
    },
    "neuromodulation": {
      "type": "object",
      "properties": {
        "dopamine_baseline": {
          "type": "number",
          "description": "Dopamine baseline level"
        },
        "reward_discount_factor": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Reward discount factor"
        },
        "curiosity_weight": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Curiosity weight (ExtendedConfig specific)"
        },
        "reward_weight": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Reward weight (ExtendedConfig specific)"
        },
        "prediction_error_weight": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Prediction error weight (ExtendedConfig specific)"
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "environment_name": {
          "type": "string",
          "description": "Environment name"
        },
        "environment_width": {
          "type": "integer",
          "minimum": 1,
          "description": "Environment width"
        },
        "environment_height": {
          "type": "integer",
          "minimum": 1,
          "description": "Environment height"
        }
      },
      "additionalProperties": false
    },
    "logging": {
      "type": "object",
      "properties": {
        "log_level": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"],
          "description": "Logging level"
        },
        "log_to_file": {
          "type": "boolean",
          "description": "Whether to log to file"
        },
        "log_filename": {
          "type": "string",
          "description": "Log filename"
        }
      },
      "additionalProperties": false
    },
    "visualization": {
      "type": "object",
      "properties": {
        "visualization_enabled": {
          "type": "boolean",
          "description": "Whether visualization is enabled"
        },
        "visualization_update_rate": {
          "type": "number",
          "minimum": 1.0,
          "description": "Visualization update rate (Hz)"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["simulation"],
  "additionalProperties": true
}