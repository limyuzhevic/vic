{
  "version": "1.0.0",
  "description": "NLM Phase 5 - Performance Optimization Template",
  "template_type": "phase5_performance",
  "phase": 5,
  "focus": "Performance optimization and large-scale simulation",
  "components": {
    "simulation": {
      "random_seed": 42,
      "simulation_timestep": 0.0005,
      "max_simulation_steps": 200000,
      "simulation_time_limit": 0.0
    },
    "neural": {
      "neuron_count": 5000,
      "region_count": 4,
      "connection_probability": 0.3,
      "neuron_type": "LIF"
    },
    "plasticity": {
      "plasticity_learning_rate": 0.04,
      "stdp_ltp_weight": 0.04,
      "stdp_ltd_weight": 0.035,
      "stdp_time_constant": 50.0
    },
    "development": {
      "development_synaptogenesis_rate": 0.002,
      "development_pruning_rate": 0.0003,
      "maturation_rate": 0.003
    },
    "neuromodulation": {
      "dopamine_baseline": 0.5,
      "curiosity_baseline": 2.0,
      "novelty_threshold": 0.7
    },
    "reward": {
      "reward_discount_factor": 0.8,
      "reward_scale": 5.0
    },
    "environment": {
      "environment_name": "HighPerformanceWorld",
      "environment_width": 50,
      "environment_height": 50,
      "world_bounds_x": 500.0,
      "world_bounds_y": 500.0
    },
    "logging": {
      "log_level": "WARNING",
      "log_to_file": true,
      "log_filename": "nlm_phase5.log",
      "log_file_append": true,
      "log_max_size": 10485760,
      "colored": false,
      "timestamps": true
    },
    "visualization": {
      "visualization_enabled": false,
      "visualization_update_rate": 10.0,
      "visualization_window_width": 0,
      "visualization_window_height": 0
    }
  },
  "notes": [
    "Memory pools and event queues optimization",
    "SIMD vectorization implementation",
    "Parallel processing and multi-threading",
    "Checkpoint system for long simulations",
    "Performance profiling tools integration",
    "Reduced logging overhead",
    "Large-scale neural network simulation",
    "Efficient memory management"
  ]
}
