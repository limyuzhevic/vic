## Simple Configuration Example

```
# NLM Phase 6 Configuration File
# This is a simple key=value format for backward compatibility

# Brain Configuration
brain.neuron_count = 1000
brain.region_count = 1
brain.connection_probability = 0.1

# Memory Configuration
memory.working_memory_capacity = 100
memory.episodic_memory_max_episodes = 1000
memory.consolidation_threshold = 0.5

# Neuromodulation Configuration
neuromod.curiosity.enable = true
neuromod.novelty.enable = true
neuromod.dopamine.scale = 1.0

# Performance Configuration
performance.enable_vectorization = true
performance.memory_pool_size = 10000
performance.event_queue_size = 5000

# Development Configuration
development.enable = true
social.enable_social_learning = false

# Checkpoint Configuration
checkpoint.enable = true
checkpoint.path = ./nlm_phase6_checkpoint.bin

# Replay Configuration
replay.enable = true
replay.interval = 100
```

