{
    "nlm_config": {
        "random_seed": 1,
        "simulation_timestep": 0.01,
        "neuron_count": 100,
        "region_count": 1,
        "connection_probability": 0.05,
        "log_level": "ERROR",
        "log_to_file": false,
        
        "plasticity": {
            "learning_rate": 0.001,
            "stdp_ltp_weight": 0.005,
