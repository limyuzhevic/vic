            "enable_development_phases": false,
            "enable_metaplasticity": false
        }
    }
}

# JSON Schema for validation
# --------------------------
{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "NLM Configuration Schema",
    "type": "object",
    "properties": {
        "nlm_config": {
            "type": "object",
            "properties": {
                "random_seed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                },
                "simulation_timestep": {
                    "type": "number",
                    "minimum": 0.0,
                    "maximum": 1.0
                },
                "neuron_count": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 100000
                },
                "region_count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                },
                "connection_probability": {
                    "type": "number",
                    "minimum": 0.0,
                    "maximum": 1.0
                },
                "log_level": {
                    "type": "string",
                    "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "FATAL"]
                },
                "log_to_file": {
                    "type": "boolean"
                },
                "log_filename": {
                    "type": "string"
                }
            }
        }
    },
    "required": ["nlm_config"]
}