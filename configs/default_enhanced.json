{
  "nlm": {
    "description": "Neural Learning Machine Configuration",
    "version": "2.0",
    "environment": "development",
    "brain": {
      "neuron_count": 500,
      "region_count": 1,
      "connection_probability": 0.15,
      "inhibitory_ratio": 0.2
    },
    "plasticity": {
      "stdp_ltp_weight": 0.02,
      "stdp_ltd_weight": 0.015,
      "stdp_time_constant": 20.0,
      "hebbian_learning_rate": 0.01,
      "structural_plasticity": true,
      "synaptogenesis_rate": 0.0001,
      "pruning_rate": 0.00001
    },
    "development": {
      "plasticity_decay_factor": 0.95,
      "excitability_change_rate": 0.001,
      "critical_period_duration": 100.0
    },
    "neuromodulation": {
      "dopamine_baseline": 0.1,
      "dopamine_effect_strength": 1.0,
      "curiosity_threshold": 0.5,
      "novelty_sensitivity": 0.8
    },
    "memory": {
      "working_memory_capacity": 10,
      "episodic_memory_size": 100,
      "consolidation_rate": 0.5,
      "replay_frequency": 0.1
    },
    "cognition": {
      "planning_horizon": 5,
      "concept_formation_threshold": 0.7,
      "attention_span": 10.0
    },
    "environment": {
      "simulation_timestep": 0.001,
      "max_simulation_steps": 10000,
      "environment_width": 10,
      "environment_height": 10,
      "enable_vision": true,
      "enable_audio": true,
      "enable_internal_signals": true
    },
    "logging": {
      "log_level": "INFO",
      "log_to_file": false,
      "log_filename": "nlm.log",
      "enable_colors": true,
      "log_format": "json"
    },
    "experiments": {
      "default_preset": "standard",
      "enable_stdp_experiment": true,
      "enable_plasticity_experiment": true,
      "enable_connectivity_experiment": true,
      "custom_experiment_config": {}
    }
  }
}
