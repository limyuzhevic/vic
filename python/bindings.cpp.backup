    // Helper functions for configuration
    m.def("createDefaultConfig", []() -> std::shared_ptr<Config> {
        auto config = std::make_shared<Config>();
        
        // Set essential default configuration
        config->set("brain.neuronCount", 1000);
        config->set("brain.regionCount", 4);
        config->set("brain.connectionProbability", 0.1f);
        
        // Set neuromodulation defaults
        config->set("neuromodulation.rewardSignal", 0.0f);
        config->set("neuromodulation.curiosityWeight", 0.5f);
        config->set("neuromodulation.noveltyWeight", 0.3f);
        config->set("neuromodulation.predictionErrorWeight", 0.4f);
        
        // Set development defaults
        config->set("development.initialStage", "CriticalPeriod");
        config->set("development.plasticityFactor", 1.0f);
        config->set("development.criticalPeriodDuration", 100);
        
        // Set learning parameters
        config->set("learning.rate", 0.01f);
        config->set("learning.momentum", 0.9f);
        config->set("learning.discountFactor", 0.95f);
        
        // Set simulation parameters
        config->set("simulation.trialDuration", 1000);
        config->set("simulation.maxMemory", 1000.0f);
        
        return config;
    }, "Create a default configuration with essential parameters");
    
    // Helper function to create configured brain
    m.def("createBrain", [](std::shared_ptr<Config> config) -> std::shared_ptr<Brain> {
        if (!config) {
            throw std::runtime_error("Config cannot be null");
        }
        auto brain = std::make_shared<Brain>(config);
        if (!brain->initialize()) {
            throw std::runtime_error("Failed to initialize brain");
        }
        return brain;
    }, py::arg("config"), "Create and initialize a new brain with configuration");
    
    // Helper function to create simple world
    m.def("createSimpleWorld", [](size_t width, size_t height, size_t visionWidth, size_t visionHeight) -> std::shared_ptr<SimpleWorld> {
        auto world = std::make_shared<SimpleWorld>();
        world->configure(width, height, visionWidth, visionHeight);
        return world;
    }, py::arg("width"), py::arg("height"), py::arg("visionWidth"), py::arg("visionHeight"),
       "Create a configured simple world");
    
    // Helper function to create agent brain
    m.def("createAgentBrain", [](std::shared_ptr<Brain> brain) -> std::shared_ptr<AgentBrain> {
        if (!brain) {
            throw std::runtime_error("Brain cannot be null");
        }
        return std::make_shared<AgentBrain>(brain);
    }, py::arg("brain"), "Create a new agent brain interface");
    
    // Simulation utilities
    m.def("runEpisode", [](std::shared_ptr<AgentBrain> agentBrain, std::shared_ptr<SimpleWorld> world, 
                          size_t maxSteps, float* finalReward) -> float {
        if (!agentBrain || !world) {
            throw std::runtime_error("AgentBrain or World cannot be null");
        }
        
        agentBrain->reset();
        *finalReward = 0.0f;
        
        for (size_t step = 0; step < maxSteps; ++step) {
            // Get sensory percept
            auto percept = world->getSensoryPercept();
            
            // Process sensory input
            agentBrain->processSensoryInput(percept);
            
            // Decode motor command
            auto action = agentBrain->decodeMotorCommand();
            
            // Apply action in world
            world->applyMotorCommand(action, world->getSimulationTime());
            
            // Get reward
            auto result = world->getLastActionResult();
            if (result) {
                *finalReward = result->reward;
            }
            
            // Check if episode ended
            if (result && !result->success) {
                break;
            }
            
            world->update(1.0f);
        }
        
        return *finalReward;
    }, py::arg("agentBrain"), py::arg("world"), py::arg("maxSteps"), py::arg("finalReward"),
       "Run a complete episode and return final reward");
    
    // Debugging and monitoring utilities
    m.def("exportBrainState", [](std::shared_ptr<Brain> brain, const std::string& filepath) {
        if (!brain) {
            throw std::runtime_error("Brain cannot be null");
        }
        if (filepath.empty()) {
            throw std::runtime_error("Filepath cannot be empty");
        }
        if (!brain->save(filepath)) {
            throw std::runtime_error("Failed to save brain state");
        }
    }, py::arg("brain"), py::arg("filepath"), "Save brain state to file");
    
    m.def("importBrainState", [](std::shared_ptr<Brain> brain, const std::string& filepath) {
        if (!brain) {
            throw std::runtime_error("Brain cannot be null");
        }
        if (filepath.empty()) {
            throw std::runtime_error("Filepath cannot be empty");
        }
        if (!brain->load(filepath)) {
            throw std::runtime_error("Failed to load brain state");
        }
    }, py::arg("brain"), py::arg("filepath"), "Load brain state from file");
    
    // Configuration utility functions
    m.def("getDefaultConfigTemplate", []() {
        auto config = std::make_shared<Config>();
        
        // Return a configuration with all available keys set to their defaults
        config->set("brain.neuronCount", 1000);
        config->set("brain.regionCount", 4);
        config->set("brain.connectionProbability", 0.1f);
        config->set("brain.maxConnections", 10000);
        config->set("brain.learningRate", 0.01f);
        
        config->set("neuromodulation.rewardSignal", 0.0f);
        config->set("neuromodulation.dopamineLevel", 0.1f);
        config->set("neuromodulation.curiosityWeight", 0.5f);
        config->set("neuromodulation.noveltyWeight", 0.3f);
        config->set("neuromodulation.predictionErrorWeight", 0.4f);
        config->set("neuromodulation.acetylcholineLevel", 0.2f);
        config->set("neuromodulation.norepinephrineLevel", 0.15f);
        config->set("neuromodulation.serotoninLevel", 0.1f);
        
        config->set("development.initialStage", "CriticalPeriod");
        config->set("development.plasticityFactor", 1.0f);
        config->set("development.criticalPeriodDuration", 100);
        config->set("development.synaptogenesisRate", 0.8f);
        config->set("development.pruningRate", 0.1f);
        
        config->set("learning.rate", 0.01f);
        config->set("learning.momentum", 0.9f);
        config->set("learning.discountFactor", 0.95f);
        config->set("learning.explorationRate", 0.1f);
        
        config->set("simulation.trialDuration", 1000);
        config->set("simulation.maxMemory", 1000.0f);
        config->set("simulation.energyDecayRate", 0.01f);
        config->set("simulation.brainResetOnEpisodeEnd", true);
        
        return config;
    }, "Get a configuration template with all default values");
    
    // Performance monitoring utility
    m.def("getBrainStats", [](std::shared_ptr<Brain> brain) {
        if (!brain) {
            throw std::runtime_error("Brain cannot be null");
        }
        
        std::map<std::string, std::variant<int, float, double>> stats;
        stats["neuronCount"] = brain->getTotalNeuronCount();
        stats["synapseCount"] = brain->getTotalSynapseCount();
        stats["activeNeuronCount"] = brain->getActiveNeuronCount();
        stats["firingNeuronCount"] = brain->getFiringNeuronCount();
        stats["averageFiringRate"] = brain->getAverageFiringRate();
        stats["excitementInhibitionRatio"] = brain->getExcitationInhibitionRatio();
        stats["totalSpikeCount"] = brain->getTotalSpikeCount();
        
        auto devSystem = brain->getDevelopmentSystem();
        if (devSystem) {
            stats["developmentalStage"] = static_cast<int>(devSystem->getStage());
            stats["developmentalAge"] = devSystem->getDevelopmentalAge();
            stats["plasticityModifier"] = devSystem->getPlasticityModifier();
            stats["criticalPeriodProgress"] = devSystem->getCriticalPeriodProgress();
        }
        
        auto dopamine = brain->getDopamine();
        if (dopamine) {
            stats["dopamineLevel"] = dopamine->getLevel();
        }
        
        auto curiosity = brain->getCuriosity();
        if (curiosity) {
            stats["curiosityLevel"] = curiosity->getLevel();
        }
        
        auto novelty = brain->getNovelty();
        if (novelty) {
            stats["noveltyLevel"] = novelty->getLevel();
        }
        
        auto predictionError = brain->getPredictionErrorSignal();
        if (predictionError) {
            stats["predictionError"] = predictionError->getError();
            stats["predictionErrorMagnitude"] = predictionError->getMagnitude();
        }
        
        return stats;
    }, py::arg("brain"), "Get comprehensive brain statistics");
    
    // Neural network building utility
    m.def("buildNeuralNetwork", [](std::shared_ptr<Config> config, const std::string& name = "") -> std::shared_ptr<Brain> {
        if (!config) {
            throw std::runtime_error("Config cannot be null");
        }
        
        auto brain = std::make_shared<Brain>(config);
        
        // Add default regions
        if (name.empty()) {
            name = "DefaultNetwork";
        }
        
        // Configure regions based on brain configuration
        auto neuronCount = config->getOr<size_t>("brain.neuronCount", 1000);
        auto regionCount = config->getOr<size_t>("brain.regionCount", 4);
        
        // Create sensory and motor regions
        brain->addRegion("Sensory");
        brain->addRegion("Motor");
        brain->addRegion("Association");
        
        // Connect regions
        auto regions = brain->getRegions();
        for (size_t i = 0; i < regions.size(); ++i) {
            for (size_t j = i + 1; j < regions.size(); ++j) {
                auto connProb = config->getOr<float>("brain.connectionProbability", 0.1f);
                if ((static_cast<float>(rand()) / RAND_MAX) < connProb) {
                    auto sourceId = regions[i]->getId();
                    auto targetId = regions[j]->getId();
                    brain->addInterRegionConnection(sourceId, targetId);
                }
            }
        }
        
        if (!brain->initialize()) {
            throw std::runtime_error("Failed to initialize neural network");
        }
        
        return brain;
    }, py::arg("config"), py::arg("name") = "", "Build a complete neural network from configuration");
    
    // Simulation reset utility
    m.def("resetEnvironment", [](std::shared_ptr<SimpleWorld> world, std::shared_ptr<AgentBrain> agentBrain) {
        if (world) {
            world->reset();
        }
        if (agentBrain) {
            agentBrain->reset();
        }
    }, py::arg("world"), py::arg("agentBrain"), "Reset simulation environment");
    
    // Performance benchmarking utility
    m.def("benchmarkStep", [](std::shared_ptr<Brain> brain, size_t steps = 1000) {
        if (!brain) {
            throw std::runtime_error("Brain cannot be null");
        }
        
        auto startTime = std::chrono::high_resolution_clock::now();
        
        for (size_t i = 0; i < steps; ++i) {
            brain->step(i);
        }
        
        auto endTime = std::chrono::high_resolution_clock::now();
        auto duration = std::chrono::duration_cast<std::chrono::milliseconds>(endTime - startTime);
        
        std::map<std::string, double> results;
        results["totalSteps"] = static_cast<double>(steps);
        results["totalTimeMs"] = static_cast<double>(duration.count());
        results["avgTimePerStepMs"] = static_cast<double>(duration.count()) / steps;
        results["stepsPerSecond"] = steps / (duration.count() / 1000.0);
        
        return results;
    }, py::arg("brain"), py::arg("steps") = 1000, "Benchmark brain stepping performance");
    
    // Configuration validation utility
    m.def("validateConfig", [](std::shared_ptr<Config> config) -> bool {
        if (!config) {
            return false;
        }
        
        // Check essential configuration keys
        bool valid = true;
        
        auto neuronCount = config->getOr<size_t>("brain.neuronCount", 0);
        if (neuronCount == 0) {
            valid = false;
        }
        
        auto regionCount = config->getOr<size_t>("brain.regionCount", 0);
        if (regionCount == 0) {
            valid = false;
        }
        
        auto connProb = config->getOr<float>("brain.connectionProbability", -1.0f);
        if (connProb < 0.0f || connProb > 1.0f) {
            valid = false;
        }
        
        return valid;
    }, py::arg("config"), "Validate configuration and return true if valid");
    
    // Error message utility
    m.def("getConfigValidationError", [](std::shared_ptr<Config> config) -> std::string {
        if (!config) {
            return "Config is null";
        }
        
        std::string errors;
        
        auto neuronCount = config->getOr<size_t>("brain.neuronCount", 0);
        if (neuronCount == 0) {
            errors += "brain.neuronCount must be > 0; ";
        }
        
        auto regionCount = config->getOr<size_t>("brain.regionCount", 0);
        if (regionCount == 0) {
            errors += "brain.regionCount must be > 0; ";
        }
        
        auto connProb = config->getOr<float>("brain.connectionProbability", -1.0f);
        if (connProb < 0.0f || connProb > 1.0f) {
            errors += "brain.connectionProbability must be in range [0, 1]; ";
        }
        
        auto learningRate = config->getOr<float>("brain.learningRate", -1.0f);
        if (learningRate < 0.0f) {
            errors += "brain.learningRate must be >= 0; ";
        }
        
        return errors.empty() ? "Configuration is valid" : errors;
    }, py::arg("config"), "Get human-readable validation errors for configuration");

} // namespace nlm
