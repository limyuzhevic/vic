# pynlm-config.cmake - CMake configuration file for pynlm bindings

# NLM Python bindings package configuration

# Include pybind11's CMake functions for finding the bindings
include(${CMAKE_CURRENT_LIST_DIR}/pynlm-config.cmake.in)

# Add the pynlm target to the build
add_library(pynlm INTERFACE IMPORTED)

# Set the interface properties for the imported target
set_target_properties(pynlm PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${NLM_SOURCE_DIR}"
    INTERFACE_LINK_LIBRARIES "nlm_core nlm_agent nlm_world"
    INTERFACE_COMPILE_DEFINITIONS "PYBIND11_DETAILED_ERROR_MESSAGES"
)

# Set the library path based on the build configuration
if(WIN32)
    set(pynlm_LIBRARY "${CMAKE_CURRENT_BINARY_DIR}/Release/pynlm.pyd")
else()
    set(pynlm_LIBRARY "${CMAKE_CURRENT_BINARY_DIR}/libpynlm.so")
endif()

# Create an imported target for the library
add_library(pynlm::pynlm SHARED IMPORTED)
set_target_properties(pynlm::pynlm PROPERTIES
    IMPORTED_LOCATION "${pynlm_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${NLM_SOURCE_DIR}"
)

# Python module initialization macro
macro(pynlm_python_init target)
    # Add Python dependencies to the target
    target_link_libraries(${target} PRIVATE Python3::Module)
    target_compile_features(${target} PRIVATE cxx_std_20)
endmacro()

# Function to check if pynlm is available
macro(pynlm_check_available)
    find_package(Python3 REQUIRED COMPONENTS Interpreter Development)
    find_package(pybind11 2.11.0 CONFIG REQUIRED)
    
    if(NOT TARGET pynlm::pynlm)
        message(FATAL_ERROR "NLM Python bindings not found. Please build the pynlm target first.")
    endif()
endmacro()

# Export targets for use by other projects
export(TARGETS nlm_core nlm_agent nlm_world pynlm::pynlm
    FILE "${CMAKE_CURRENT_BINARY_DIR}/pynlm-targets.cmake"
)

# Create a convenience variable for finding the module
if(WIN32)
    set(pynlm_MODULE "${pynlm_LIBRARY}")
else()
    set(pynlm_MODULE "${pynlm_LIBRARY}")
endif()

# Package summary
message(STATUS "NLM Python bindings configured")
message(STATUS "  Library: ${pynlm_MODULE}")
message(STATUS "  Include directories: ${NLM_SOURCE_DIR}")
