## Example 7: Error Handling and Validation

This example demonstrates proper error handling.

```python
import pynlm

# Create brain and agent
brain = pynlm.createBrain()
brain.initialize()

world = pynlm.createSimpleWorld()
world.configure(width=10, height=10, visionWidth=6, visionHeight=6)
world.reset()

agent = pynlm.createSimpleAgent(brain, world)

print("=== Error Handling Example ===")

# Demonstrate safe operations
try:
    # This should work fine
    for step in range(50):
        world.update(0.1)
        
        percept = world.getSensoryPercept()
        agent.processSensoryInput(percept)
        
        pynlm.safe_brain_step(brain, step)
        
        action = agent.decodeMotorCommand()
        world.applyMotorCommand(action, world.getSimulationTime())
    
    print("Safe operations completed successfully")
    
except pynlm.PythonRuntimeError as e:
    print(f"Caught Python runtime error: {e}")
    
except Exception as e:
    print(f"Caught unexpected error: {e}")

# Demonstrate batch error handling
try:
    # This will cause an error due to mismatched array sizes
    pynlm.inject_current_batch(brain, [brain.getRegion(1).getAllNeurons()[0].getId()], 
                              [1.0, 2.0])  # Wrong size!
except pynlm.PythonRuntimeError as e:
    print(f"Caught batch operation error: {e}")
```

## Example 8: Machine Learning Style Interface

This example shows a higher-level interface for machine learning workflows.

```python
import pynlm
import numpy as np

class NLMAgent:
    def __init__(self, config=None):
        if config is None:
            config = pynlm.createDefaultConfig()
        
        self.brain = pynlm.createBrainWithConfig(config)
        self.brain.initialize()
        
        self.world = pynlm.createSimpleWorld()
        self.agent = pynlm.createSimpleAgent(self.brain, self.world)
        
        self.episode_rewards = []
        
    def configure_world(self, width=20, height=20, vision_width=8, vision_height=8):
        """Configure the simulation world."""
        self.world.configure(width, height, vision_width, vision_height)
        
    def reset(self):
        """Reset the agent for a new episode."""
        self.world.reset()
        self.agent.reset()
        
    def step(self, timestep=0.1):
        """Take a step in the environment."""
        self.world.update(timestep)
        
        percept = self.world.getSensoryPercept()
        self.agent.processSensoryInput(percept)
        
        step_num = int(self.world.getSimulationTime() / timestep)
        self.brain.step(step_num)
        
        action = self.agent.decodeMotorCommand()
        self.world.applyMotorCommand(action, self.world.getSimulationTime())
        
        # Calculate simple reward
        agent_body = self.world.getAgentBody()
        reward = agent_body.energy * 0.1
        
        self.agent.applyRewardModulation(reward, 0.0)
        return percept, reward, agent_body
        
    def run_episode(self, max_steps=100):
        """Run a complete episode."""
        self.reset()
        episode_reward = 0.0
        
        for step in range(max_steps):
            _, reward, _ = self.step()
            episode_reward += reward
            
            if step % 10 == 0:
                print(f"Step {step}: Reward so far = {episode_reward:.2f}")
        
        self.episode_rewards.append(episode_reward)
        print(f"Episode finished. Total reward: {episode_reward:.2f}")
        return episode_reward
        
    def get_performance_stats(self):
        """Get performance statistics from recent episodes."""
        if not self.episode_rewards:
            return None
            
        rewards = np.array(self.episode_rewards)
        return {
            'mean': np.mean(rewards),
            'std': np.std(rewards),
            'min': np.min(rewards),
            'max': np.max(rewards),
            'episode_count': len(rewards)
        }

# Example usage
print("=== Machine Learning Style Interface ===")

agent = NLMAgent()
agent.configure_world(15, 15, 6, 6)

# Run multiple episodes
for episode in range(5):
    agent.run_episode(max_steps=50)
    
stats = agent.get_performance_stats()
print(f"\nPerformance statistics:")
for key, value in stats.items():
    print(f"  {key}: {value:.3f}")
```

## Advanced Features

### 1. Custom Sensory Inputs

```python
import pynlm
import numpy as np

# Create custom vision input
vision_data = np.random.randn(8, 8, 3).astype(np.float32) * 0.1
vision = pynlm.Vision(8, 8, 3)
vision.setData(vision_data)

# Create internal signals
internal_signals = pynlm.InternalSignals()
internal_signals.addSignal(0.5)
internal_signals.addSignal(-0.3)

# Create combined percept
percept = pynlm.SensoryPercept()
percept.setVision(vision)
percept.setInternal([internal_signals.getAllSignals()])
```

### 2. Region-based Operations

```python
brain = pynlm.createBrain()
brain.initialize()

# Work with specific regions
region_ids = brain.getRegionIds()
if region_ids:
    # Work with the first region
    first_region = brain.getRegion(region_ids[0])
    neurons = first_region.getAllNeurons()
    
    print(f"Region {region_ids[ quadrant]:.2f} has {len(neurons)} neurons")
```

### 3. Checkpointing and Persistence

```python
brain = pynlm.createBrain()
brain.initialize()

# Save brain state
pynlm.save_brain_state(brain, "checkpoint_001.bin")

# Run simulation for a while
for i in range(500):
    brain.step(i)

# Load saved state
pynlm.load_brain_state(brain, "checkpoint_001.bin")

# Continue from saved state
print(f"Loaded brain state. Current neuron count: {brain.getTotalNeuronCount()}")
```

## Troubleshooting

### Common Issues and Solutions

1. **"Brain is not firing neurons"**
   - Ensure `brain.initialize()` is called before simulation
   - Check that world.update() is being called in the loop
   - Verify sensory input is properly connected

2. **"Agent is not moving"**
   - Check that `world.applyMotorCommand()` is being called
   - Ensure agent's motor output is properly decoded
   - Verify world has valid terrain/constraints

3. **"Everything is 0"**
   - Brains need time to "warm up" - try more simulation steps
   - Ensure neurons have proper input to fire
   - Check configuration parameters are reasonable

4. **"ImportError: No module named 'pynlm'"**
   ```bash
   pip install --force-reinstall .
   ```

5. **"Segmentation faults"**
   - Ensure `initialize()` is called before `step()`
   - Call `reset()` before re-running simulation
   - Check that configuration parameters are valid

