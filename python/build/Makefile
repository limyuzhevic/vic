workspace/app/src/world/SimpleWorld.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/nlm_world.dir/build.make CMakeFiles/nlm_world.dir/workspace/app/src/world/SimpleWorld.cpp.i
.PHONY : workspace/app/src/world/SimpleWorld.cpp.i

workspace/app/src/world/SimpleWorld.s: workspace/app/src/world/SimpleWorld.cpp.s
.PHONY : workspace/app/src/world/SimpleWorld.s

# target to generate assembly for a file
workspace/app/src/world/SimpleWorld.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/nlm_world.dir/build.make CMakeFiles/nlm_world.dir/workspace/app/src/world/SimpleWorld.cpp.s
.PHONY : workspace/app/src/world/SimpleWorld.cpp.s

