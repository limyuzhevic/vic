# pynlm Python package initialization file
# This file is generated by CMake during the build process

"""
NLM (熙然) - Neural Learning Machine

**An Experimental Artificial Developmental Brain**

This package provides Python bindings for the NLM C++ neural simulation framework.
It enables Python users to:

- Create and simulate neural networks
- Interact with simulated environments
- Learn from experience through plasticity
- Produce goal-directed behavior

## Basic Usage Example

```python
import pynlm

# Create configuration
config = pynlm.createDefaultConfig()

# Create brain
brain = pynlm.createBrain(config)
brain.initialize()

# Create world for interaction
world = pynlm.createSimpleWorld()

# Create agent brain interface
agent_brain = pynlm.createAgentBrain(brain)

# Main simulation loop
for step in range(1000):
    # Get sensory input
    percept = world.getSensoryPercept()
    
    # Process input
    agent_brain.processSensoryInput(percept)
    
    # Produce action
    action = brain.produceAction()
    
    # Apply to world
    result = world.applyMotorCommand(action, step * 0.001)
    
    # Apply reward modulation if successful
    if result.success:
        agent_brain.applyRewardModulation(result.reward, 1.0)
```

## Version Information

NLM Python Bindings Version: 0.1.0
C++ Framework Version: 0.1.0

## Available Classes

- `Config` - Configuration system
- `SensoryInput` - Base class for sensory inputs
- `Vision` - Visual sensory input
- `Audio` - Audio sensory input  
- `InternalSignals` - Internal brain signals
- `Action` - Motor output actions
- `WorldObject` - Objects in the world
- `AgentBody` - Agent physical state
- `ActionResult` - Results of actions
- `SensoryPercept` - Combined sensory percept
- `SimpleWorld` - 2D world simulation
- `Brain` - Central neural computation
- `AgentBrain` - Agent-world interface

## Key Features

1. **Real Neural Computation** - LIF neurons, spike propagation, plasticity
2. **Closed-Loop Control** - World → Sensory → Neural → Motor → World
3. **Developmental Learning** - Change over time through experience
4. **Neuromodulation** - Reward, curiosity, novelty detection
5. **Memory Systems** - Working, episodic, and associative memory
6. **Prediction & Planning** - Temporal prediction and action planning
7. **Phase 6 Integration** - All systems working together

## Experimental Nature

NLM is a research project investigating computational brain-like systems. We make NO claims that NLM accurately reproduces biological brains. Current limitations include simplified neuron models and lack of biological realism.

See the NLM documentation for more detailed information.
"""

__version__ = "0.1.0"
__author__ = "NLM Authors"
__description__ = "Python bindings for NLM (Neural Learning Machine) C++ neural simulation framework"

# Import main classes for convenience
from .pynlm import (
    Config,
    Vision,
    Audio,
    InternalSignals,
    Action,
    WorldObject,
    AgentBody,
    ActionResult,
    SensoryPercept,
    SimpleWorld,
    Brain,
    AgentBrain,
    NeuronId,
    SynapseId,
    RegionId,
    PopulationId,
    NeuronType,
    SynapseType,
    DevelopmentalStage,
    FiringState,
    ActionType,
    MotorCommand,
    WorldObjectType,
    INVALID_NEURON_ID,
    INVALID_SYNAPSE_ID,
    INVALID_REGION_ID,
    INVALID_POPULATION_ID,
)

# Factory functions for convenience
def createDefaultConfig():
    """Create a default configuration."""
    return Config()

def createBrain(config):
    """Create a new brain with configuration."""
    return Brain(config)

def createSimpleWorld():
    """Create a new simple world."""
    return SimpleWorld()

def createAgentBrain(brain):
    """Create a new agent brain interface."""
    return AgentBrain(brain)

# Package metadata
__all__ = [
    'Config', 'Vision', 'Audio', 'InternalSignals', 'Action',
    'WorldObject', 'AgentBody', 'ActionResult', 'SensoryPercept',
    'SimpleWorld', 'Brain', 'AgentBrain',
    'NeuronId', 'SynapseId', 'RegionId', 'PopulationId',
    'NeuronType', 'SynapseType', 'DevelopmentalStage', 'FiringState',
    'ActionType', 'MotorCommand', 'WorldObjectType',
    'INVALID_NEURON_ID', 'INVALID_SYNAPSE_ID', 'INVALID_REGION_ID',
    'INVALID_POPULATION_ID',
    'createDefaultConfig', 'createBrain', 'createSimpleWorld',
    'createAgentBrain',
]
