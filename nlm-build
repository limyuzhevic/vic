    def _list_built_targets(self):
        """List the targets that were built."""
        print("\nBuilt targets:")
        
        targets = [
            ("nlm", "Main NLM executable"),
            ("nlm_core", "Core NLM library"),
            ("nlm_agent", "Agent system library"),
            ("nlm_world", "World system library"),
            ("nlm_phase3", "Phase 3 experiment library"),
            ("nlm_phase4", "Phase 4 experiment library"),
            ("nlm_phase3_demo", "Phase 3 demo executable"),
            ("nlm_phase4_demo", "Phase 4 demo executable"),
        ]
        
        for target, description in targets:
            target_file = self.build_dir / target
            if target_file.exists():
                size = target_file.stat().st_size / (1024 * 1024)  # MB
                print(f"  ✓ {target} ({description}) - {size:.1f} MB")
            else:
                # Check for library files
                lib_files = list(self.build_dir.glob(f"lib{target}*.a"))
                for lib_file in lib_files:
                    size = lib_file.stat().st_size / (1024 * 1024)  # MB
                    print(f"  ✓ {lib_file.name} (library) - {size:.1f} MB")
    
    def run_tests(self):
        """Run NLM tests."""
        print("Running NLM tests...")
        
        # Look for test executables or run pytest if available
        test_executable = self.build_dir / "test_nlm"
        if test_executable.exists():
            try:
                subprocess.run([str(test_executable)], check=True)
                return True
            except subprocess.CalledProcessError as e:
                print(f"✗ Tests failed: {e}")
                return False
        
        # Try pytest for Python tests
        try:
            subprocess.run([sys.executable, "-m", "pytest", "tests", "-v"], 
                         check=True, cwd=self.project_root)
            return True
        except (subprocess.CalledProcessError, FileNotFoundError):
            print("⚠ No test executables found. Tests not run.")
            return True  # Don't fail the build if tests aren't available

def main():
    tool = NLMBuildTool()
    
    parser = argparse.ArgumentParser(
        description="NLM Build and Configuration Management Tool",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Available commands:

  build
    Configure and build the NLM project

  clean
    Clean build artifacts

  demo
    Run a demo application

  generate
    Generate configuration files from templates

  validate
    Validate configuration files

  run-tests
    Run NLM tests

Examples:
  nlm-build build
  nlm-build build --parallel --target all
  nlm-build demo --type phase6
  nlm-build generate --output research_config.json --template research
  nlm-build validate configs/
        """
    )
    
    subparsers = parser.add_subparsers(dest="command", help="Available commands")
    
    # Build command
    build_parser = subparsers.add_parser("build", help="Configure and build the NLM project")
    build_parser.add_argument("--generator", default="Unix Makefiles", 
                             help="CMake generator (default: Unix Makefiles)")
    build_parser.add_argument("--build-type", default="Release", 
                             choices=["Debug", "Release", "RelWithDebInfo", "MinSizeRel"],
                             help="Build type (default: Release)")
    build_parser.add_argument("--parallel", action="store_true", default=True,
                             help="Use parallel build (default: True)")
    build_parser.add_argument("--no-parallel", action="store_false", dest="parallel",
                             help="Use sequential build")
    build_parser.add_argument("--target", default="all", help="Build target (default: all)")
    
    # Clean command
    clean_parser = subparsers.add_parser("clean", help="Clean build artifacts")
    clean_parser.add_argument("--all", action="store_true", help="Perform complete clean")
    
    # Demo command
    demo_parser = subparsers.add_parser("demo", help="Run a demo application")
    demo_parser.add_argument("--type", "--demo-type", default="phase6",
                           choices=["phase3", "phase4", "phase6"],
                           help="Demo type to run (default: phase6)")
    demo_parser.add_argument("--config", help="Configuration file to use")
    
    # Generate command
    generate_parser = subparsers.add_parser("generate", help="Generate configuration files")
    generate_parser.add_argument("--output", "-o", required=True, help="Output filename")
    generate_parser.add_argument("--template", default="default",
                               choices=["default", "research", "demo"],
                               help="Configuration template (default: default)")
    
    # Validate command
    validate_parser = subparsers.add_parser("validate", help="Validate configuration files")
    validate_parser.add_argument("directory", default="configs", help="Directory containing config files")
    
    # Run tests command
    tests_parser = subparsers.add_parser("run-tests", help="Run NLM tests")
    
    # Parse arguments
    args = parser.parse_args()
    
    if not args.command:
        parser.print_help()
        return
    
    # Execute commands
    try:
        if args.command == "build":
            # Create build directory
            if not tool.build_dir.exists():
                if not tool.create_build_directory(args.generator, args.build_type):
                    sys.exit(1)
            
            # Build the project
            if not tool.build_nml(args.parallel, args.target):
                sys.exit(1)
                
        elif args.command == "clean":
            tool.clean_build(args.all)
            
        elif args.command == "demo":
            if not tool.run_demo(args.type, args.config):
                sys.exit(1)
                
        elif args.command == "generate":
            if not tool.generate_config(args.output, args.template):
                sys.exit(1)
                
        elif args.command == "validate":
            if not tool.validate_configs(args.directory):
                sys.exit(1)
                
        elif args.command == "run-tests":
            if not tool.run_tests():
                sys.exit(1)
                
    except Exception as e:
        print(f"✗ Error: {e}")
        import traceback
        traceback.print_exc()
        sys.exit(1)

if __name__ == "__main__":
    main()
