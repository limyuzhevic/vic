# Generated automatically for the unified command-line interface project

# The PROJECT_NAME tag is a text string that should identify the project for which
# the documentation is generated. This tag is used in the title of most generated
# pages and in a few other places.
PROJECT_NAME           = "NLM - Neural Learning Machine"

# The PROJECT_NUMBER tag can be used to enter a project or revision number. This
