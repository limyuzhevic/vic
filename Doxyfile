# supported in the LATEX, RTF and DOCX output.
CREATE_SUBDIRS        = NO

# The PROJECT_BRIEF tag can be used to enter a project brief description which
# appears at the beginning of the documentation.
PROJECT_BRIEF         = "An experimental artificial developmental brain that implements real spiking neural computation"

# The PROJECT_LOGO tag specifies a logo or an icon to be used as an identifier for
# the project. The logo should be in PNG format. If no logo is specified,
# doxygen will use a default logo.
PROJECT_LOGO          = docs/nlm_logo.png

