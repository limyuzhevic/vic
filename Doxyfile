# If the REPEAT_BRIEF tag is set to YES, doxygen will prepend the brief
# description of a member or function before the detailed description. Note that
# if a member or function has a brief description, the brief description is
# included verbatim following the brief description of the preceding context,
# unless there is a sub-section that describes the member or function in more
# detail and the BRIEF_MEMBER_DESC tag is set to NO.
REPEAT_BRIEF          = YES

# If the INLINE_INCLUDES tag is set to YES, doxygen will include the content of
# non-documentation includes in the documentation.
INLINE_INCLUDES       = NO

# If the USE_MDFILE_ASMAINPAGE tag refers to an existing file in the documentation,
