inline std::string AdvancedCLI::getSessionDuration() const {
    auto now = std::chrono::high_resolution_clock::now();
    auto duration = std::chrono::duration_cast<std::chrono::seconds>(now - sessionStartTime);
    
    int hours = duration.count() / 3600;
    int minutes = (duration.count() % 3600) / 60;
    int seconds = duration.count() % 60;
    
    if (hours > 0) {
        return std::to_string(hours) + "h " + std::to_string(minutes) + "m " + std::to_string(seconds) + "s";
    } else if (minutes > 0) {
        return std::to_string(minutes) + "m " + std::to_string(seconds) + "s";
    } else {
        return std::to_string(seconds) + "s";
    }
}

inline void AdvancedCLI::addToHistory(const std::string& commandLine) {
    commandHistory.push_back(commandLine);
    if (commandHistory.size() > 1000) {
        commandHistory.erase(commandHistory.begin());
    }
}

inline void AdvancedCLI::logError(const std::string& error) {
    std::lock_guard<std::mutex> lock(errorMutex);
    errorMessages.push_back(error);
    NLM_LOG_ERROR("Advanced CLI Error: " + error);
}

inline void AdvancedCLI::executeCommand(const std::string& commandName, const CommandArgs& args) {
    if (commands.find(commandName) != commands.end()) {
        commands[commandName](args);
    }
}

inline bool AdvancedCLI::isValidCommand(const std::string& command) const {
    return commands.find(command) != commands.end();
}

inline std::vector<std::string> AdvancedCLI::getCommandCompletions(const std::string& partialCommand) const {
    std::vector<std::string> completions;
    
    for (const auto& cmd : commands) {
        if (cmd.first.find(partialCommand) == 0) {
            completions.push_back(cmd.first);
        }
    }
    
    return completions;
}

