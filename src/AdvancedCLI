inline std::string AdvancedBrainCommandHandler::formatTime(double seconds) const {
    if (seconds < 60.0) {
        return std::to_string(seconds) + "s";
    } else if (seconds < 3600.0) {
        int minutes = static_cast<int>(seconds / 60.0);
        double remainingSeconds = seconds - minutes * 60.0;
        return std::to_string(minutes) + "m " + std::to_string(remainingSeconds) + "s";
    } else {
        int hours = static_cast<int>(seconds / 3600.0);
        double remainingSeconds = seconds - hours * 3600.0;
        int minutes = static_cast<int>(remainingSeconds / 60.0);
        remainingSeconds -= minutes * 60.0;
        return std::to_string(hours) + "h " + std::to_string(minutes) + "m " + std::to_string(remainingSeconds) + "s";
    }
}

inline std::string AdvancedBrainCommandHandler::formatMemory(size_t bytes) const {
    if (bytes < 1024) {
        return std::to_string(bytes) + " B";
    } else if (bytes < 1024 * 1024) {
        return std::to_string(bytes / 1024) + " KB";
    } else if (bytes < 1024 * 1024 * 1024) {
        return std::to_string(bytes / (1024 * 1024)) + " MB";
    } else {
        return std::to_string(bytes / (1024 * 1024 * 1024)) + " GB";
    }
}

inline std::string AdvancedBrainCommandHandler::formatPercentage(float value) const {
    std::ostringstream oss;
    oss << std::fixed << std::setprecision(1) << value * 100.0 << "%";
    return oss.str();
}

