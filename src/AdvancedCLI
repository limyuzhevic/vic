// Command argument structure
struct CommandArgs {
    std::string command;
    std::vector<std::string> args;
    std::unordered_map<std::string, std::string> flags;
    
    CommandArgs(const std::string& cmd) : command(cmd) {}
    
    // Parse command line arguments
    static CommandArgs parse(int argc, char** argv);
    
    // Check if flag is present
    bool hasFlag(const std::string& flag) const {
        return flags.find(flag) != flags.end();
    }
    
    // Get flag value
    std::string getFlag(const std::string& flag, const std::string& defaultValue = "") const {
        auto it = flags.find(flag);
        return it != flags.end() ? it->second : defaultValue;
    }
    
    // Get positional argument
    std::string getArg(size_t index, const std::string& defaultValue = "") const {
        if (index < args.size()) {
            return args[index];
        }
        return defaultValue;
    }
    
    // Get numeric argument
    int getIntArg(size_t index, int defaultValue = 0) const {
        if (index < args.size()) {
            try {
                return std::stoi(args[index]);
            } catch (...) {
                return defaultValue;
            }
        }
        return defaultValue;
    }
    
    // Get float argument
    float getFloatArg(size_t index, float defaultValue = 0.0f) const {
        if (index < args.size()) {
            try {
                return std::stof(args[index]);
            } catch (...) {
                return defaultValue;
            }
        }
        return defaultValue;
    }
    
    // Get boolean argument
    bool getBoolArg(size_t index, bool defaultValue = false) const {
        if (index < args.size()) {
            std::string arg = args[index];
            std::transform(arg.begin(), arg.end(), arg.begin(), ::tolower);
            return arg == "true" || arg == "1" || arg == "yes" || arg == "on";
        }
        return defaultValue;
    }
};

