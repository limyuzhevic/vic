inline void AdvancedCLI::processCommand(const std::string& commandLine) {
    if (commandLine.empty()) return;
    
    // Parse command line
    CommandArgs cmd = CommandArgs::parse(1, &commandLine[0]);
    
    // Check for command existence
    if (commands.find(cmd.command) == commands.end()) {
        std::cout << "Unknown command: " << cmd.command << "\n";
        std::cout << "Type 'help' for available commands.\n";
        return;
    }
    
    // Execute command with error handling
    try {
        commands[cmd.command](cmd);
        commandCount++;
        addToHistory(commandLine);
    } catch (const std::exception& e) {
        logError(std::string("Command execution failed: ") + e.what());
    } catch (...) {
        logError("Command execution failed with unknown error");
    }
}

