inline void AdvancedBrainCommandHandler::handleDebugCommand(const CommandArgs& args) const {
    if (args.args.empty()) {
        std::cout << "Debug command requires additional arguments.\n";
        std::cout << "Usage: debug <neuron|synapse|region> <id> [details]\n";
        return;
    }
    
    std::string target = args.args[0];
    
    if (target == "neuron" && args.args.size() > 1) {
        NeuronId neuronId;
        if (validateNeuronId(args.args[1], neuronId)) {
            debugNeuron(neuronId);
        }
    } else if (target == "synapse" && args.args.size() > 1) {
        SynapseId synapseId;
        if (validateSynapseId(args.args[1], synapseId)) {
            debugSynapse(synapseId);
        }
    } else if (target == "region" && args.args.size() > 1) {
        RegionId regionId;
        if (validateRegionId(args.args[1], regionId)) {
            debugRegion(regionId);
        }
    } else {
        std::cout << "Invalid debug target or missing ID.\n";
        std::cout << "Available targets: neuron, synapse, region\n";
    }
}

