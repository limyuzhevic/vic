inline void AdvancedBrainCommandHandler::exportBrainState(const std::string& filename) const {
    if (!brain) {
        std::cout << "Brain is not initialized.\n";
        return;
    }
    
    std::cout << "Exporting brain state to: " << filename << "...\n";
    bool success = brain->save(filename);
    if (success) {
        std::cout << "Brain state exported successfully.\n";
    } else {
        std::cout << "Failed to export brain state.\n";
    }
}

