// CommandArgs implementation
inline CommandArgs CommandArgs::parse(int argc, char** argv) {
    CommandArgs cmd("");
    
    if (argc < 1) {
        return cmd;
    }
    
    cmd.command = argv[0];
    
    for (int i = 1; i < argc; ++i) {
        std::string arg = argv[i];
        
        if (arg.substr(0, 2) == "--") {
            // Flag argument
            size_t equalsPos = arg.find('=');
            if (equalsPos != std::string::npos) {
                std::string flag = arg.substr(2, equalsPos - 2);
                std::string value = arg.substr(equalsPos + 1);
                cmd.flags[flag] = value;
            } else {
                cmd.flags[arg.substr(2)] = "true";
            }
        } else if (arg.substr(0, 1) == "-") {
            // Short flag argument
            std::string flag = arg.substr(1);
            cmd.flags[flag] = "true";
        } else {
            // Positional argument
            cmd.args.push_back(arg);
        }
    }
    
    return cmd;
}

// AdvancedCLI implementation - key parts
inline AdvancedCLI::AdvancedCLI(std::shared_ptr<Brain> brain, std::shared_ptr<Config> config)
    : brain(brain), config(config), interactiveMode(false), 
      profilingEnabled(false), debugLoggingEnabled(false), currentLogLevel(0),
      commandCount(0) {
    
    sessionStartTime = std::chrono::high_resolution_clock::now();
    commandHandler = std::make_unique<AdvancedBrainCommandHandler>(brain);
    
    initializeCommands();
}

inline AdvancedCLI::~AdvancedCLI() {
    // Save command history
    if (!commandHistoryFile.empty()) {
        std::ofstream file(commandHistoryFile, std::ios::app);
        if (file.is_open()) {
            for (const auto& cmd : commandHistory) {
                file << cmd << "\n";
            }
        }
    }
}

inline void AdvancedCLI::initializeCommands() {
    registerBuiltInCommands();
    registerExperimentalCommands();
    registerDebugCommands();
    registerPerformanceCommands();
    registerConfigurationCommands();
    registerBrainCommands();
}

inline void AdvancedCLI::registerBuiltInCommands() {
    // General commands
    commands["help"] = [this](const CommandArgs& args) { showHelp(args.getArg(0)); };
    commands["exit"] = [this](const CommandArgs& args) { interactiveMode = false; };
    commands["quit"] = [this](const CommandArgs& args) { interactiveMode = false; };
    commands["clear"] = [this](const CommandArgs& args) { system("clear"); };
    commands["status"] = [this](const CommandArgs& args) { commandHandler->showAdvancedStatus(); };
    
    // Configuration commands
    commands["config"] = [this](const CommandArgs& args) { 
        if (args.args.empty()) {
            showCurrentConfiguration();
        } else {
            std::string subcommand = args.args[0];
            if (subcommand == "load") {
                std::string filename = args.getArg(1);
                if (!filename.empty()) loadConfiguration(filename);
            } else if (subcommand == "save") {
                std::string filename = args.getArg(1);
                if (!filename.empty()) config->saveToFile(filename);
            }
        }
    };
    
    // Brain commands
    commands["brain"] = [this](const CommandArgs& args) { 
        if (args.args.empty()) {
            std::cout << "Brain command requires subcommand.\n";
            return;
        }
        std::string subcommand = args.args[0];
        if (subcommand == "init") initializeBrain();
        else if (subcommand == "reset") resetBrain();
        else if (subcommand == "save") {
            std::string filename = args.getArg(1);
            if (!filename.empty()) saveBrainState(filename);
        } else if (subcommand == "load") {
            std::string filename = args.getArg(1);
            if (!filename.empty()) loadBrainState(filename);
        }
    };
    
    // Performance commands
    commands["perf"] = [this](const CommandArgs& args) { 
        if (args.args.empty()) {
            std::cout << "Performance command requires subcommand.\n";
            return;
        }
