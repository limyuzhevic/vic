// NLM (熙然) - Neural Learning Machine
// Phase 2: Advanced User Commands and Configuration Interface
//
// This module provides enhanced command-line interface for NLM with:
// - Advanced configuration options
// - Simulation control commands
// - Output formatting options
// - Persistence and checkpoint management
// - Advanced debugging and analysis tools

#pragma once

#include <string>
#include <vector>
#include <memory>
#include <map>
#include <functional>
#include <chrono>
#include <thread>
#include <filesystem>
#include "core/Config/Config.hpp"
