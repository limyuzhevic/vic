struct CLIOptions {
    std::string configFile = "configs/default.cfg";
    std::string outputFile;
    std::string checkpointDir = ".";
    std::string logLevel = "info";
    int seed = 42;
    int steps = 1000;
    double timestep = 0.001;
    int64_t neuronCount = 500;
    int64_t regionCount = 1;
    float connectionProbability = 0.15f;
    float stdpLtpWeight = 0.02f;
    float stdpLtdWeight = 0.015f;
    float stdpTau = 20.0f;
    float synaptogenesisRate = 0.0001f;
    float pruningRate = 0.00001f;
    bool verbose = false;
    bool debug = false;
    int phase = 2;
    std::string testType = "all";
    bool listConfig = false;
    bool showHelp = false;
    bool showVersion = false;
    int worldWidth = 10;
    int worldHeight = 10;
    float rewardScale = 1.0f;
    std::map<std::string, std::string> configOverrides;
};

bool parseArguments(int argc, char** argv, CLIOptions& options) {
    for (int i = 1; i < argc; ++i) {
        std::string arg = argv[i];
        
        if (arg == "--help" || arg == "-h") {
            options.showHelp = true;
            continue;
        }
        
        if (arg == "--version") {
            options.showVersion = true;
            continue;
        }
        
        if (arg == "--verbose" || arg == "-v") {
            options.verbose = true;
            options.logLevel = "debug";
            continue;
        }
        
        if (arg == "--debug") {
            options.debug = true;
            options.logLevel = "trace";
            continue;
        }
        
        if (arg == "--list") {
            options.listConfig = true;
            continue;
        }
        
        if (arg == "--config" && i + 1 < argc) {
            options.configFile = argv[++i];
            continue;
        }
        
        if (arg == "--log-level" && i + 1 < argc) {
            options.logLevel = argv[++i];
            continue;
        }
        
        if (arg == "--seed" && i + 1 < argc) {
            options.seed = std::stoi(argv[++i]);
            continue;
        }
        
        if (arg == "--steps" && i + 1 < argc) {
            options.steps = std::stoi(argv[++i]);
            continue;
        }
        
        if (arg == "--timestep" && i + 1 < argc) {
            options.timestep = std::stod(argv[++i]);
            continue;
        }
        
        if (arg == "--neurons" && i + 1 < argc) {
            options.neuronCount = std::stoll(argv[++i]);
            continue;
        }
        
        if (arg == "--regions" && i + 1 < argc) {
            options.regionCount = std::stoll(argv[++i]);
            continue;
        }
        
        if (arg == "--connect-prob" && i + 1 < argc) {
            options.connectionProbability = std::stof(argv[++i]);
            continue;
        }
        
        if (arg == "--stdp-ltp" && i + 1 < argc) {
            options.stdpLtpWeight = std::stof(argv[++i]);
            continue;
        }
        
        if (arg == "--stdp-ltd" && i + 1 < argc) {
            options.stdpLtdWeight = std::stof(argv[++i]);
            continue;
        }
        
        if (arg == "--stdp-tau" && i + 1 < argc) {
            options.stdpTau = std::stof(argv[++i]);
            continue;
        }
        
        if (arg == "--synaptogenesis" && i + 1 < argc) {
            options.synaptogenesisRate = std::stof(argv[++i]);
            continue;
        }
        
        if (arg == "--pruning" && i + 1 < argc) {
            options.pruningRate = std::stof(argv[++i]);
            continue;
        }
        
        if (arg == "--phase" && i + 1 < argc) {
            options.phase = std::stoi(argv[++i]);
            continue;
        }
        
        if (arg == "--test-type" && i + 1 < argc) {
            options.testType = argv[++i];
            continue;
        }
        
        if (arg == "--output" && i + 1 < argc) {
            options.outputFile = argv[++i];
            continue;
        }
        
        if (arg == "--checkpoints" && i + 1 < argc) {
            options.checkpointDir = argv[++i];
            continue;
        }
        
        if (arg == "--world-size" && i + 2 < argc) {
            options.worldWidth = std::stoi(argv[++i]);
            options.worldHeight = std::stoi(argv[++i]);
            continue;
        }
        
        if (arg == "--reward-scale" && i + 1 < argc) {
            options.rewardScale = std::stof(argv[++i]);
            continue;
        }
        
        // Handle --set key=value
        if (arg.find("--set=") == 0 || arg.find("--set ") == 0) {
            std::string setArg = arg;
            if (arg.find("--set=") == 0) {
                setArg = arg.substr(6);
            } else {
                setArg = argv[++i];
            }
            size_t equalsPos = setArg.find('=');
            if (equalsPos != std::string::npos) {
                std::string key = setArg.substr(0, equalsPos);
                std::string value = setArg.substr(equalsPos + 1);
                options.configOverrides[key] = value;
            }
            continue;
        }
        
        std::cerr << "Unknown option: " << arg << std::endl;
        return false;
    }
    
    return true;
}

void printConfigurationSummary(const Config& config, const CLIOptions& options) {
    std::cout << std::endl;
    std::cout << "=== Configuration Summary ===" << std::endl;
    
    if (!options.configFile.empty()) {
        std::cout << "Configuration file: " << options.configFile << std::endl;
    }
    
    std::cout << "Random seed: " << options.seed << std::endl;
    std::cout << "Simulation steps: " << options.steps << std::endl;
    std::cout << "Timestep: " << options.timestep << "s" << std::endl;
    std::cout << "Neurons: " << options.neuronCount << std::endl;
    std::cout << "Regions: " << options.regionCount << std::endl;
    std::cout << "Connection probability: " << options.connectionProbability << std::endl;
    std::cout << "Log level: " << options.logLevel << std::endl;
    
    if (options.verbose) {
        std::cout << "Verbose mode: Enabled" << std::endl;
    }
    
    if (options.debug) {
        std::cout << "Debug mode: Enabled" << std::endl;
    }
    
    std::cout << "World size: " << options.worldWidth << " x " << options.worldHeight << std::endl;
    std::cout << "Reward scale: " << options.rewardScale << std::endl;
    
    if (!options.outputFile.empty()) {
        std::cout << "Output file: " << options.outputFile << std::endl;
    }
    
    std::cout << std::endl;
}

