#include "PredictionError.hpp"
#include "../core/Logger/Logger.hpp"
#include <cmath>
#include <algorithm>

namespace nlm {

struct PredictionError::Impl {
    Brain* brain;
    float error;
    float predictedValue;
    float actualValue;
    std::vector<float> history;
    std::vector<float> errorComponents;  // Multi-dimensional error
    bool isSurprising;
    
    Impl() : brain(nullptr), error(0.0f), predictedValue(0.0f), actualValue(0.0f), 
             isSurprising(false) {}
};

PredictionError::PredictionError() : pImpl(new Impl), lastError_(0.0f), surpriseThreshold_(0.3f) {}

PredictionError::~PredictionError() = default;

void PredictionError::initialize(Brain* brain) {
    pImpl->brain = brain;
    NLM_LOG_INFO("PredictionError system initialized with multi-dimensional error computation");
    // Register with neuromodulators if they exist
    if (brain) {
        // The brain will handle registering prediction errors with neuromodulators
    }
}

float PredictionError::getError() const {
    return lastError_;
}

void PredictionError::computeError(float predicted, float actual) {
    lastError_ = actual - predicted;
    
    // Multi-dimensional error computation for neuromodulation
    // Error has different components: temporal, spatial, intensity
    float temporalError = 0.0f;
    float spatialError = 0.0f;
    float intensityError = std::abs(lastError_);
    
    // If we have a brain, use its current state for context-sensitive error
    if (pImpl->brain) {
        // Check if this error triggers surprising events
        pImpl->isSurprising = (intensityError > surpriseThreshold_);
        
        // For temporal error, check against learned timing
        temporalError = std::min(1.0f, lastError_ * 2.0f);  // Scale temporal sensitivity
        
        // For spatial error, check against predicted locations
        // This would require access to spatial prediction models
        spatialError = 0.0f;  // Placeholder - would use spatial prediction
        
        // If this is a surprising event, broadcast stronger signal
        if (pImpl->isSurprising) {
            // Amplify error components
            temporalError *= 1.5f;
            spatialError *= 1.5f;
            intensityError *= 1.5f;
        }
    }
    
    errorComponents_.intensityError = intensityError;
    errorComponents_.spatialError = spatialError;
    errorComponents_.temporalError = temporalError;
    errorComponents_.totalError = std::sqrt(intensityError * intensityError + 
                                           spatialError * spatialError + 
                                           temporalError * temporalError);
    
    pImpl->history.push_back(lastError_);
}

void PredictionError::updatePrediction(float newPrediction) {
    lastError_ = newPrediction;
}

const std::vector<float>& PredictionError::getHistory() const {
    return pImpl->history;
}

void PredictionError::clearHistory() {
    pImpl->history.clear();
    pImpl->errorComponents.clear();
}

float PredictionError::getMagnitude() const {
    return std::abs(lastError_);
}

float PredictionError::getModulationSignal() const {
    // Convert error to modulation signal (0-1)
    // Higher error = stronger modulation for learning
    return std::min(1.0f, std::abs(lastError_) * 2.0f);
}

bool PredictionError::isSurprising() const {
    return std::abs(lastError_) > surpriseThreshold_;
}

void PredictionError::recordError(float error, SimulationStep step) {
    pImpl->history.push_back(error);
    if (pImpl->history.size() > 10000) {
        pImpl->history.erase(pImpl->history.begin());
    }
}

} // namespace nlm