bool AdvancedCLI::runDemo() {
    std::cout << "=== NLM Advanced CLI Demo ===\n";
    
    // Create configuration
    auto config = std::make_shared<Config>();
    config->set("neuron_count", neurons_);
    config->set("region_count", 1);
    config->set("connection_probability", 0.1f);
    config->set("simulation_timestep", timestep_);
    config->set("random_seed", seed_);
    
    // Enable features based on flags
    if (enableReward_) {
        config->set("neuromod.dopamine.enable", true);
    }
    if (enableCuriosity_) {
        config->set("neuromod.curiosity.enable", true);
    }
    if (enableDevelopment_) {
        config->set("development.enabled", true);
    }
    if (enableStructuralPlasticity_) {
        config->set("plasticity.structural.enable", true);
    }
    
    // Create and initialize brain
    auto brain = std::make_shared<Brain>(config);
    if (!brain->initialize()) {
        std::cerr << "Failed to initialize brain!" << std::endl;
        return false;
    }
    
    std::cout << "Brain initialized with " << neurons_ << " neurons" << std::endl;
    
    // Run simulation
    for (int step = 0; step < steps_; ++step) {
        if (stopRequested_) {
            std::cout << "Simulation stopped by user request." << std::endl;
            break;
        }
        
        brain->step(step, step * timestep_);
        
        if (step % 100 == 0) {
            std::cout << "Step " << step << ": " 
                     << brain->getFiringNeuronCount() << " firing, "
                     << brain->getTotalSpikeCount() << " total spikes" << std::endl;
        }
    }
    
    std::cout << "\n=== Demo Complete ===\n";
    std::cout << "Final stats:" << std::endl;
    std::cout << "  Neurons: " << brain->getTotalNeuronCount() << std::endl;
    std::cout << "  Firing neurons: " << brain->getFiringNeuronCount() << std::endl;
    std::cout << "  Total spikes: " << brain->getTotalSpikeCount() << std::endl;
    std::cout << "  Average firing rate: " << brain->getAverageFiringRate() << std::endl;
    std::cout << "  E/I ratio: " << brain->getExcitationInhibitionRatio() << std::endl;
    
    return true;
}

bool AdvancedCLI::runResearchSimulation() {
    std::cout << "=== NLM Research Simulation ===\n";
    
    // Use the Phase 6 integration experiment
    Phase6IntegratedExperiment experiment;
    
    Phase6Config config;
    config.neuronCount = neurons_;
    config.maxSteps = steps_;
    config.enableCheckpointing = !checkpointPath_.empty();
    config.enableReplay = false;
    config.enableDevelopment = enableDevelopment_;
    config.checkpointPath = checkpointPath_;
    
    auto startTime = std::chrono::high_resolution_clock::now();
    
    auto result = experiment.run(config);
    
    auto endTime = std::chrono::high_resolution_clock::now();
    auto duration = std::chrono::duration_cast<std::chrono::seconds>(endTime - startTime);
    
    std::cout << "=== Research Simulation Complete ===\n";
    std::cout << "Results:" << std::endl;
    std::cout << "  Total reward: " << result.totalReward << std::endl;
    std::cout << "  Average firing rate: " << result.avgFiringRate << std::endl;
    std::cout << "  Episodes stored: " << result.memoryEpisodesStored << std::endl;
    std::cout << "  Dopamine level: " << result.dopamineLevel << std::endl;
    std::cout << "  Novelty level: " << result.noveltyLevel << std::endl;
    std::cout << "  Curiosity level: " << result.curiosityLevel << std::endl;
    std::cout << "  Total wall time: " << duration.count() << "s" << std::endl;
    std::cout << "\nIntegration status:" << std::endl;
    std::cout << "  Working Memory: " << (result.memoryWorkingMemoryIntegrated ? "CONNECTED" : "DISCONNECTED") << std::endl;
    std::cout << "  Episodic Memory: " << (result.memoryEpisodicMemoryIntegrated ? "CONNECTED" : "DISCONNECTED") << std::endl;
    std::cout << "  Neuromodulation: " << (result.neuromodulationIntegrated ? "CONNECTED" : "DISCONNECTED") << std::endl;
    std::cout << "  Prediction: " << (result.predictionIntegrated ? "CONNECTED" : "DISCONNECTED") << std::endl;
    std::cout << "  Development: " << (result.developmentIntegrated ? "CONNECTED" : "DISCONNECTED") << std::endl;
    
    return true;
}

bool AdvancedCLI::runAnalysis() {
    std::cout << "=== NLM Brain Analysis ===\n";
    
    // Load brain from checkpoint or create new one
    std::shared_ptr<Brain> brain;
    
    if (!checkpointPath_.empty()) {
        auto config = std::make_shared<Config>();
        brain = std::make_shared<Brain>(config);
        if (!brain->initialize()) {
            std::cerr << "Failed to initialize brain for analysis!" << std::endl;
            return false;
        }
        if (!brain->load(checkpointPath_)) {
            std::cerr << "Failed to load brain from " << checkpointPath_ << std::endl;
            return false;
        }
        std::cout << "Loaded brain from " << checkpointPath_ << std::endl;
    } else {
        auto config = std::make_shared<Config>();
        config->set("neuron_count", neurons_);
        brain = std::make_shared<Brain>(config);
        if (!brain->initialize()) {
            std::cerr << "Failed to initialize brain for analysis!" << std::endl;
            return false;
        }
        std::cout << "Created new brain with " << neurons_ << " neurons" << std::endl;
    }
    
    // Run analysis
    std::cout << "Analyzing brain connectivity and activity..." << std::endl;
    
    // Get comprehensive statistics
    std::cout << "\n=== Brain Statistics ===" << std::endl;
    std::cout << "Total neurons: " << brain->getTotalNeuronCount() << std::endl;
    std::cout << "Total synapses: " << brain->getTotalSynapseCount() << std::endl;
    std::cout << "Firing neurons: " << brain->getFiringNeuronCount() << std::endl;
    std::cout << "Average firing rate: " << brain->getAverageFiringRate() << std::endl;
    std::cout << "E/I ratio: " << brain->getExcitationInhibitionRatio() << std::endl;
    std::cout << "Total spike count: " << brain->getTotalSpikeCount() << std::endl;
    
    // Regional analysis
    auto regions = brain->getRegions();
    std::cout << "\n=== Regional Analysis ===" << std::endl;
    for (size_t i = 0; i < regions.size(); ++i) {
        auto region = regions[i].get();
        std::cout << "Region " << i << " (ID: " << region->getId() << "):" << std::endl;
        std::cout << "  Neurons: " << region->getTotalNeuronCount() << std::endl;
        std::cout << "  Synapses: " << region->getSynapseCount() << std::endl;
        std::cout << "  Firing rate: " << region->getAverageFiringRate() << std::endl;
    }
    
    // Save analysis results
    if (!outputFile_.empty()) {
        std::cout << "Saving analysis to " << outputFile_ << std::endl;
        // Create a simple analysis file
        std::ofstream file(outputFile_);
        if (file.is_open()) {
            file << "NLM Brain Analysis\n";
            file << "===================\n\n";
            file << "Total Neurons: " << brain->getTotalNeuronCount() << "\n";
            file << "Total Synapses: " << brain->getTotalSynapseCount() << "\n";
            file << "Firing Neurons: " << brain->getFiringNeuronCount() << "\n";
            file << "Average Firing Rate: " << brain->getAverageFiringRate() << "\n";
            file << "E/I Ratio: " << brain->getExcitationInhibitionRatio() << "\n";
            file << "Total Spike Count: " << brain->getTotalSpikeCount() << "\n";
            file.close();
        } else {
            std::cerr << "Failed to write analysis to " << outputFile_ << std::endl;
        }
    }
    
    std::cout << "\n=== Analysis Complete ===\n";
    return true;
}

bool AdvancedCLI::runBatchSimulation() {
    std::cout << "=== NLM Batch Simulation ===\n";
    
    if (steps_ <= 0) {
        std::cerr << "Error: Number of steps must be positive for batch simulation" << std::endl;
        return false;
    }
    
    int numBatches = 3;
    std::cout << "Running " << numBatches << " batch simulations..." << std::endl;
    
    for (int batch = 1; batch <= numBatches; ++batch) {
        std::cout << "\n--- Batch " << batch << " ---" << std::endl;
        
        // Modify configuration for each batch
        auto config = std::make_shared<Config>();
        config->set("neuron_count", neurons_);
        config->set("region_count", 1);
        config->set("connection_probability", 0.1f * batch);
        config->set("simulation_timestep", timestep_);
        config->set("random_seed", seed_ + batch * 1000);
        
        auto brain = std::make_shared<Brain>(config);
        if (!brain->initialize()) {
            std::cerr << "Failed to initialize brain for batch " << batch << std::endl;
            continue;
        }
        
        // Run simulation
        for (int step = 0; step < steps_; ++step) {
            brain->step(step, step * timestep_);
            
            if (step % 500 == 0) {
                std::cout << "  Step " << step << ": " 
                         << brain->getFiringNeuronCount() << " firing" << std::endl;
            }
        }
        
        // Collect results
        std::cout << "  Batch " << batch << " results:" << std::endl;
        std::cout << "    Firing neurons: " << brain->getFiringNeuronCount() << std::endl;
        std::cout << "    Total spikes: " << brain->getTotalSpikeCount() << std::endl;
        std::cout << "    Average firing rate: " << brain->getAverageFiringRate() << std::endl;
        
        // Save checkpoint for this batch
        std::string batchCheckpoint = checkpointPath_ + "_batch" + std::to_string(batch) + ".bin";
        if (!brain->save(batchCheckpoint)) {
            std::cerr << "Warning: Failed to save checkpoint for batch " << batch << std::endl;
        }
    }
    
    std::cout << "\n=== Batch Simulation Complete ===\n";
    return true;
}

bool AdvancedCLI::runExport() {
    std::cout << "=== NLM Brain Export ===\n";
    
    auto config = std::make_shared<Config>();
    auto brain = std::make_shared<Brain>(config);
    
    if (!brain->initialize()) {
        std::cerr << "Failed to initialize brain for export!" << std::endl;
        return false;
    }
    
    // Run a quick simulation to generate interesting brain state
    for (int step = 0; step < 100; ++step) {
        brain->step(step, step * 0.001);
    }
    
    // Save brain state
    if (outputFile_.empty()) {
        outputFile_ = "nlm_export.bin";
    }
    
    if (brain->save(outputFile_)) {
        std::cout << "Successfully exported brain state to " << outputFile_ << std::endl;
        
        // Also export configuration
        std::string configFile = outputFile_ + ".cfg";
        if (config->saveToFile(configFile)) {
            std::cout << "Configuration saved to " << configFile << std::endl;
        }
        
        return true;
    } else {
        std::cerr << "Failed to export brain state to " << outputFile_ << std::endl;
        return false;
    }
}

