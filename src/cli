AdvancedCLI::AdvancedCLI() : stopRequested_(false) {
}

AdvancedCLI::~AdvancedCLI() = default;

bool AdvancedCLI::run(int argc, char* argv[]) {
    // Parse command line arguments
    parseArgs(argc, argv);
    
    if (showHelp_) {
        printHelp();
        return true;
    }
    
    if (showVersion_) {
        printVersion();
        return true;
    }
    
    try {
        // Run the appropriate command
        if (command_ == "demo") {
            return runDemo();
        } else if (command_ == "research") {
            return runResearchSimulation();
        } else if (command_ == "analyze") {
            return runAnalysis();
        } else if (command_ == "batch") {
            return runBatchSimulation();
        } else if (command_ == "export") {
            return runExport();
        } else {
            std::cerr << "Error: Unknown command: " << command_ << std::endl;
            return false;
        }
    } catch (const std::exception& e) {
        std::cerr << "Error: " << e.what() << std::endl;
        return false;
    }
}

void AdvancedCLI::parseArgs(int argc, char* argv[]) {
    // Simple argument parsing
    for (int i = 1; i < argc; ++i) {
        std::string arg = argv[i];
        
        if (arg == "--help" || arg == "-h") {
            showHelp_ = true;
        } else if (arg == "--version") {
            showVersion_ = true;
        } else if (arg == "--command" && i + 1 < argc) {
            command_ = argv[++i];
        } else if (arg == "--config" && i + 1 < argc) {
            configFile_ = argv[++i];
        } else if (arg == "--output" && i + 1 < argc) {
            outputFile_ = argv[++i];
        } else if (arg == "--steps" && i + 1 < argc) {
            steps_ = std::stoi(argv[++i]);
        } else if (arg == "--neurons" && i + 1 < argc) {
            neurons_ = std::stoi(argv[++i]);
        } else if (arg == "--timestep" && i + 1 < argc) {
            timestep_ = std::stod(argv[++i]);
        } else if (arg == "--seed" && i + 1 < argc) {
            seed_ = std::stoull(argv[++i]);
        } else if (arg == "--enable-reward" && i + 1 < argc) {
            enableReward_ = (std::string(argv[++i]) == "true");
        } else if (arg == "--enable-curiosity" && i + 1 < argc) {
            enableCuriosity_ = (std::string(argv[++i]) == "true");
        } else if (arg == "--enable-development" && i + 1 < argc) {
            enableDevelopment_ = (std::string(argv[++i]) == "true");
        } else if (arg == "--enable-structural" && i + 1 < argc) {
            enableStructuralPlasticity_ = (std::string(argv[++i]) == "true");
        } else if (arg == "--world-width" && i + 1 < argc) {
            worldWidth_ = std::stoi(argv[++i]);
        } else if (arg == "--world-height" && i + 1 < argc) {
            worldHeight_ = std::stoi(argv[++i]);
        } else if (arg == "--world-vision-width" && i + 1 < argc) {
            worldVisionWidth_ = std::stoi(argv[++i]);
        } else if (arg == "--world-vision-height" && i + 1 < argc) {
            worldVisionHeight_ = std::stoi(argv[++i]);
        } else if (arg == "--checkpoint" && i + 1 < argc) {
            checkpointPath_ = argv[++i];
        } else if (arg == "--logfile" && i + 1 < argc) {
            logfile_ = argv[++i];
        } else if (arg == "--loglevel" && i + 1 < argc) {
            logLevel_ = argv[++i];
        } else {
            // Unknown argument
            std::cerr << "Warning: Unknown argument: " << arg << std::endl;
        }
    }
    
    // Set default command if not specified
    if (command_.empty()) {
        command_ = "demo";
    }
}

