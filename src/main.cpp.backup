void printAdvancedHelp() {
    printBanner();
    
    std::cout << R"(
USAGE:
  ./nlm --config <file> [OPTIONS]
  ./nlm [OPTIONS]

BASIC OPTIONS:
  --config <file>                Load configuration from file
  --help                          Show this help message

INTEGRATION CONTROL OPTIONS:
  --enable-system <name>          Enable specific integration system (working_memory, prediction, neuromodulation, development, curiosity, novelty, replay, sleep)
  --disable-system <name>         Disable specific integration system
  --integration-threshold <key>=<value>  Set integration threshold (format: key=value, e.g., prediction_error_threshold=0.5)
  --integration-priority <region>=<priority> Set integration priority (e.g., working_memory=1, prediction=2)
  --monitor-integration            Enable integration status monitoring

ADVANCED CONFIGURATION OPTIONS:
  --working-memory <size>          Set working memory capacity (size)
  --prediction-config <key>=<value> Configure prediction system (e.g., prediction_window=0.1)
  --neuromodulation <level>        Set global neuromodulation level (0.0-1.0)
  --development-stage <stage>      Set development stage (initial, critical, maturation, adult)
  --memory-consolidation <interval> Set memory consolidation interval (seconds)
  --replay-checkpoint <mode>       Set replay/checkpoint mode (continuous, periodic, manual)
  --memory-span <span>             Set memory span (in simulation steps)

DEBUGGING AND MONITORING OPTIONS:
  --debug-log <system>            Enable debug logging for system (all, brain, integration, memory, prediction, neuromodulation, curiosity, novelty)
  --debug-level <level>            Set debug level (0=OFF, 1=ERROR, 2=WARNING, 3=INFO, 4=DEBUG, 5=TRACE)
  --monitor-status                 Enable system status monitoring
  --metrics <interval>             Record system metrics every N steps
  --integration-features <flags>   Enable integration features (comma-separated: replay, sleep, prediction, curiosity, novelty)

VISUALIZATION AND ANALYSIS OPTIONS:
  --generate-reports               Generate comprehensive integration status reports
  --export-connectivity <file>     Export system connectivity information to file
  --performance-metrics <file>     Export performance metrics to file
  --visualize-integration <file>   Create integration graph visualization (requires GraphViz)
  --export-config <file>           Export current configuration to file
  --analyze-performance            Analyze and report performance bottlenecks

ADVANCED FEATURE OPTIONS:
  --experimental-features          Enable experimental integration features
  --debug-build                    Enable debug build with enhanced validation
  --performance-profiling          Enable performance profiling mode
  --development-tools              Enable development tools and debugging utilities
  --enable-replay                  Enable replay system for debugging and analysis
  --enable-sleep                   Enable sleep system for memory consolidation

EXAMPLES:
  ./nlm --config my_config.cfg --enable-system working_memory --working-memory 100 \
        --debug-log integration --monitor-status --metrics 100 \
        --generate-reports --export-config config_output.cfg

  ./nlm --integration-threshold prediction_error_threshold=0.1 \
        --neuromodulation 0.8 --development-stage critical \
        --experimental-features --performance-profiling

FOR MORE INFORMATION:
  Consult the NLM Phase 2 documentation for advanced configuration examples
)" << std::endl;
}

// Learning Experiment: Demonstrates measurable synaptic changes through experience
struct LearningExperiment {
    std::shared_ptr<Brain> brain;
    uint64_t seed;
    size_t initialSynapseCount;
    std::vector<float> initialWeights;
    std::vector<float> finalWeights;
    std::vector<NeuronId> mostActiveNeurons;
    
    LearningExperiment(std::shared_ptr<Brain> b, uint64_t s) 
        : brain(b), seed(s), initialSynapseCount(0) {}
    
    void recordInitialState() {
        initialSynapseCount = brain->getTotalSynapseCount();
        initialWeights.clear();
        
        // Record initial weights from first region
        if (auto* region = brain->getRegion(RegionId(1))) {
            for (const auto& syn : region->getSynapses()) {
                initialWeights.push_back(syn->getWeight());
            }
        }
        
        NLM_LOG_INFO("Initial state recorded:");
        NLM_LOG_INFO("  Synapses: " + std::to_string(initialSynapseCount));
        if (!initialWeights.empty()) {
            float sum = std::accumulate(initialWeights.begin(), initialWeights.end(), 0.0f);
            float mean = sum / initialWeights.size();
            NLM_LOG_INFO("  Mean weight: " + std::to_string(mean));
        }
    }
    
    void recordFinalState() {
        finalWeights.clear();
        
        // Record final weights from first region
        if (auto* region = brain->getRegion(RegionId(1))) {
            for (const auto& syn : region->getSynapses()) {
                finalWeights.push_back(syn->getWeight());
            }
        }
        
        mostActiveNeurons = brain->getSpikeSystem()->getMostActiveNeurons(10);
        
        NLM_LOG_INFO("Final state recorded:");
        NLM_LOG_INFO("  Total spikes: " + std::to_string(brain->getTotalSpikeCount()));
        if (!finalWeights.empty()) {
            float sum = std::accumulate(finalWeights.begin(), finalWeights.end(), 0.0f);
            float mean = sum / finalWeights.size();
            NLM_LOG_INFO("  Mean weight: " + std::to_string(mean));
        }
    }
    
    void computeStatistics() {
        NLM_LOG_INFO("");
        NLM_LOG_INFO("=== Learning Experiment Results ===");
        NLM_LOG_INFO("");
        
        if (initialWeights.empty() || finalWeights.empty()) {
            NLM_LOG_INFO("ERROR: No weights recorded");
            return;
        }
        
        // Compute weight changes
        float initialSum = std::accumulate(initialWeights.begin(), initialWeights.end(), 0.0f);
        float finalSum = std::accumulate(finalWeights.begin(), finalWeights.end(), 0.0f);
        float initialMean = initialSum / initialWeights.size();
        float finalMean = finalSum / finalWeights.size();
        
        NLM_LOG_INFO("Weight Statistics:");
        NLM_LOG_INFO("  Initial mean weight: " + std::to_string(initialMean));
        NLM_LOG_INFO("  Final mean weight: " + std::to_string(finalMean));
        NLM_LOG_INFO("  Change: " + std::to_string(finalMean - initialMean));
        
        // Count synapses that changed significantly
        size_t strengthened = 0;
        size_t weakened = 0;
        size_t unchanged = 0;
        
        size_t minSize = std::min(initialWeights.size(), finalWeights.size());
        for (size_t i = 0; i < minSize; ++i) {
            float delta = finalWeights[i] - initialWeights[i];
            if (delta > 0.01f) ++strengthened;
            else if (delta < -0.01f) ++weakened;
            else ++unchanged;
        }
        
        NLM_LOG_INFO("");
        NLM_LOG_INFO("Synaptic Changes:");
        NLM_LOG_INFO("  Strengthened: " + std::to_string(strengthened));
        NLM_LOG_INFO("  Weakened: " + std::to_string(weakened));
        NLM_LOG_INFO("  Unchanged: " + std::to_string(unchanged));
        
        NLM_LOG_INFO("");
        NLM_LOG_INFO("Spike Activity:");
        NLM_LOG_INFO("  Total spikes: " + std::to_string(brain->getTotalSpikeCount()));
        NLM_LOG_INFO("  Most active neurons recorded: " + std::to_string(mostActiveNeurons.size()));
        
        // Determine if learning occurred
        bool learningOccurred = (std::abs(finalMean - initialMean) > 0.001f) ||
                                (strengthened > 0 || weakened > 0);
        
        NLM_LOG_INFO("");
        if (learningOccurred) {
            NLM_LOG_INFO("✓ LEARNING DETECTED: Synaptic weights changed through experience");
        } else {
            NLM_LOG_INFO("✗ NO LEARNING: Weights did not change significantly");
        }
    }
};

void runBasicConnectivityTest(std::shared_ptr<Brain> brain) {
    NLM_LOG_INFO("");
    NLM_LOG_INFO("=== Test 1: Basic Neural Connectivity ===");
    
    // Inject current into a few neurons and see if spikes propagate
    auto* region = brain->getRegion(RegionId(1));
    if (!region) return;
    
    auto neurons = region->getAllNeurons();
    if (neurons.empty()) {
        NLM_LOG_INFO("  No neurons found!");
        return;
    }
    
    // Get initial spike count
    size_t initialSpikes = brain->getTotalSpikeCount();
    
    // Inject strong current into first 10 neurons
    NLM_LOG_INFO("  Injecting current into 10 neurons...");
    for (size_t i = 0; i < std::min(size_t(10), neurons.size()); ++i) {
        neurons[i]->injectCurrent(50.0f);  // Strong excitatory input
    }
    
    // Run a few steps
    for (SimulationStep step = 0; step < 50; ++step) {
        brain->step(step, step * 0.001);
    }
    
    size_t spikes = brain->getTotalSpikeCount() - initialSpikes;
    NLM_LOG_INFO("  Spikes generated: " + std::to_string(spikes));
    
    if (spikes > 0) {
        NLM_LOG_INFO("  ✓ Spikes propagate through network");
    } else {
        NLM_LOG_INFO("  ! No spikes - checking neuron parameters...");
        for (size_t i = 0; i < std::min(size_t(3), neurons.size()); ++i) {
            NLM_LOG_INFO("    Neuron " + std::to_string(i) + 
                        " V=" + std::to_string(neurons[i]->getMembranePotential()) +
                        " thresh=" + std::to_string(neurons[i]->getThreshold()));
        }
    }
}

void runPlasticityExperiment(std::shared_ptr<Brain> brain) {
    NLM_LOG_INFO("");
    NLM_LOG_INFO("=== Test 2: Plasticity Learning Experiment ===");
    
    LearningExperiment experiment(brain, 42);
    
    // Record initial state
    experiment.recordInitialState();
    
    // Enable plasticity on synapses
    if (auto* region = brain->getRegion(RegionId(1))) {
        for (auto& syn : region->getSynapses()) {
            syn->enablePlasticity(true, true, false);  // Enable Hebbian and STDP
        }
    }
    
    // Apply repeated input pattern to stimulate learning
    NLM_LOG_INFO("");
    NLM_LOG_INFO("Applying repeated input patterns (1000 steps)...");
    
    for (SimulationStep step = 0; step < 1000; ++step) {
        // Create input pattern - inject current into sensory neurons
        for (size_t i = 0; i < 20 && i < brain->getTotalNeuronCount() / 4; ++i) {
            brain->injectCurrentToNeurons(NeuronType::Sensory, 30.0f);
        }
        
        brain->step(step, step * 0.001);
        
        // Log progress every 100 steps
        if (step % 100 == 0) {
            NLM_LOG_INFO("  Step " + std::to_string(step) + 
                        " | Spikes: " + std::to_string(brain->getTotalSpikeCount()) +
                        " | Firing: " + std::to_string(brain->getFiringNeuronCount()));
        }
    }
    
    // Record final state
    experiment.recordFinalState();
    
    // Compute and display statistics
    experiment.computeStatistics();
}

void runStdpVerification(std::shared_ptr<Brain> brain) {
    NLM_LOG_INFO("");
    NLM_LOG_INFO("=== Test 3: STDP Verification ===");
    
    auto* region = brain->getRegion(RegionId(1));
    if (!region) return;
    
    // Get first few synapses
    auto& synapses = region->getSynapses();
    if (synapses.size() < 5) {
        NLM_LOG_INFO("  Not enough synapses for STDP test");
        return;
    }
    
    NLM_LOG_INFO("  Testing STDP on 5 synapses:");
    
    // Record initial weights
    std::vector<float> beforeWeights;
    for (size_t i = 0; i < 5; ++i) {
        beforeWeights.push_back(synapses[i]->getWeight());
        synapses[i]->enablePlasticity(false, true, false);  // Enable only STDP
        NLM_LOG_INFO("    Synapse " + std::to_string(i) + 
                    " before: " + std::to_string(beforeWeights[i]));
    }
    
    // Create correlated activity: fire pre then post to trigger LTP
    NLM_LOG_INFO("");
    NLM_LOG_INFO("  Creating correlated pre->post activity (potentiation)...");
    
    for (int trial = 0; trial < 50; ++trial) {
        // Fire pre-synaptic neuron
        Neuron* preNeuron = nullptr;
        Neuron* postNeuron = nullptr;
        
        auto neurons = region->getAllNeurons();
        if (neurons.size() >= 2) {
            preNeuron = neurons[0];
            postNeuron = neurons[1];
        }
        
        if (preNeuron && postNeuron) {
            // Pre fires first
            preNeuron->injectCurrent(60.0f);
            brain->step(trial * 2, trial * 2 * 0.001);
            
            // Then post fires
            postNeuron->injectCurrent(60.0f);
            brain->step(trial * 2 + 1, (trial * 2 + 1) * 0.001);
        }
    }
    
    // Record after weights
    NLM_LOG_INFO("  After correlated activity:");
    for (size_t i = 0; i < 5; ++i) {
        float delta = synapses[i]->getWeight() - beforeWeights[i];
        NLM_LOG_INFO("    Synapse " + std::to_string(i) + 
                    " after: " + std::to_string(synapses[i]->getWeight()) +
                    " (Δ=" + std::to_string(delta) + ")");
    }
    
    // Check if weights increased (LTP)
    float totalDelta = 0.0f;
    for (size_t i = 0; i < 5; ++i) {
        totalDelta += synapses[i]->getWeight() - beforeWeights[i];
    }
    
    NLM_LOG_INFO("");
    if (totalDelta > 0.001f) {
        NLM_LOG_INFO("  ✓ STDP WORKING: Pre-before-post produced potentiation");
    } else if (totalDelta < -0.001f) {
        NLM_LOG_INFO("  ! STDP reversed: Check parameters");
    } else {
        NLM_LOG_INFO("  ! No change: STDP may not be triggering");
    }
}

}

bool isIntegrationSystemEnabled(const std::string& name) {
    static std::unordered_set<std::string> enabledSystems;
    return enabledSystems.find(name) != enabledSystems.end();
}

void enableIntegrationSystem(const std::string& name) {
    static std::unordered_set<std::string> enabledSystems;
    enabledSystems.insert(name);
    NLM_LOG_INFO("Integration system enabled: " + name);
}

void disableIntegrationSystem(const std::string& name) {
    static std::unordered_set<std::string> enabledSystems;
    enabledSystems.erase(name);
    NLM_LOG_INFO("Integration system disabled: " + name);
}

void processAdvancedCLIArgs(int argc, char** argv, std::shared_ptr<Config> config) {
    for (int i = 1; i < argc; ++i) {
        std::string arg(argv[i]);
        
        // Handle integration control options
        if (arg.substr(0, 15) == "--enable-system") {
            if (i + 1 < argc) {
                enableIntegrationSystem(argv[++i]);
                config->set("integration_system_" + std::string(argv[i-1].substr(15)), 
                           std::string("true"), ConfigSource::CommandLine);
            }
        } else if (arg.substr(0, 16) == "--disable-system") {
            if (i + 1 < argc) {
                disableIntegrationSystem(argv[++i]);
                config->set("integration_system_" + std::string(argv[i-1].substr(16)), 
                           std::string("false"), ConfigSource::CommandLine);
            }
        } else if (arg.substr(0, 22) == "--integration-threshold") {
            if (arg.find('=') != std::string::npos) {
                size_t pos = arg.find('=');
                std::string key = arg.substr(22, pos - 22);
                std::string value = arg.substr(pos + 1);
                config->set("integration_threshold_" + key, value, ConfigSource::CommandLine);
                NLM_LOG_INFO("Set integration threshold: " + key + " = " + value);
            }
        } else if (arg.substr(0, 21) == "--integration-priority") {
            if (arg.find('=') != std::string::npos) {
                size_t pos = arg.find('=');
                std::string key = arg.substr(21, pos - 21);
                std::string value = arg.substr(pos + 1);
                config->set("integration_priority_" + key, value, ConfigSource::CommandLine);
                NLM_LOG_INFO("Set integration priority: " + key + " = " + value);
            }
        } else if (arg == "--monitor-integration") {
            config->set("monitor_integration", true, ConfigSource::CommandLine);
            NLM_LOG_INFO("Integration monitoring enabled");
        }
        
        // Handle advanced configuration options
        else if (arg.substr(0, 20) == "--working-memory") {
            if (i + 1 < argc) {
                config->set("working_memory_size", std::stoll(argv[++i]), ConfigSource::CommandLine);
                NLM_LOG_INFO("Set working memory size: " + std::string(argv[i]) + " items");
            }
        } else if (arg.substr(0, 20) == "--prediction-config") {
            if (arg.find('=') != std::string::npos) {
                size_t pos = arg.find('=');
                std::string key = arg.substr(20, pos - 20);
                std::string value = arg.substr(pos + 1);
                config->set("prediction_" + key, value, ConfigSource::CommandLine);
                NLM_LOG_INFO("Set prediction config: " + key + " = " + value);
            }
        } else if (arg.substr(0, 20) == "--neuromodulation") {
            if (i + 1 < argc) {
                float level = std::stof(argv[++i]);
                config->set("neuromodulation_level", level, ConfigSource::CommandLine);
                NLM_LOG_INFO("Set neuromodulation level: " + std::to_string(level));
            }
        } else if (arg.substr(0, 23) == "--development-stage") {
            if (i + 1 < argc) {
                std::string stage = argv[++i];
                config->set("development_stage", stage, ConfigSource::CommandLine);
                NLM_LOG_INFO("Set development stage: " + stage);
            }
        } else if (arg.substr(0, 24) == "--memory-consolidation") {
            if (i + 1 < argc) {
                config->set("memory_consolidation_interval", std::stod(argv[++i]), ConfigSource::CommandLine);
                NLM_LOG_INFO("Set memory consolidation interval: " + std::string(argv[i]) + "s");
            }
        } else if (arg.substr(0, 20) == "--replay-checkpoint") {
            if (i + 1 < argc) {
                config->set("replay_checkpoint_mode", argv[++i], ConfigSource::CommandLine);
                NLM_LOG_INFO("Set replay/checkpoint mode: " + std::string(argv[i]));
            }
        } else if (arg.substr(0, 15) == "--memory-span") {
            if (i + 1 < argc) {
                config->set("memory_span", std::stoll(argv[++i]), ConfigSource::CommandLine);
                NLM_LOG_INFO("Set memory span: " + std::string(argv[i]) + " steps");
            }
        }
        
        // Handle debugging and monitoring options
        else if (arg.substr(0, 14) == "--debug-log") {
            if (i + 1 < argc) {
                std::string system = argv[++i];
                config->set("debug_log_" + system, true, ConfigSource::CommandLine);
                NLM_LOG_INFO("Debug logging enabled for system: " + system);
            }
        } else if (arg.substr(0, 14) == "--debug-level") {
            if (i + 1 < argc) {
                int level = std::stoi(argv[++i]);
                config->set("debug_level", level, ConfigSource::CommandLine);
                NLM_LOG_INFO("Set debug level: " + std::to_string(level));
            }
        } else if (arg == "--monitor-status") {
            config->set("monitor_status", true, ConfigSource::CommandLine);
            NLM_LOG_INFO("System status monitoring enabled");
        } else if (arg.substr(0, 10) == "--metrics") {
            if (i + 1 < argc) {
                config->set("metrics_interval", std::stoi(argv[++i]), ConfigSource::CommandLine);
                NLM_LOG_INFO("Set metrics recording interval: " + std::string(argv[i]) + " steps");
            }
        } else if (arg.substr(0, 24) == "--integration-features") {
            if (i + 1 < argc) {
                config->set("integration_features", argv[++i], ConfigSource::CommandLine);
                NLM_LOG_INFO("Enabled integration features: " + std::string(argv[i]));
            }
        }
        
        // Handle visualization and analysis options
        else if (arg == "--generate-reports") {
            config->set("generate_reports", true, ConfigSource::CommandLine);
            NLM_LOG_INFO("Report generation enabled");
        } else if (arg.substr(0, 20) == "--export-connectivity") {
            if (i + 1 < argc) {
                config->set("export_connectivity_file", argv[++i], ConfigSource::CommandLine);
                NLM_LOG_INFO("Connectivity export file: " + std::string(argv[i]));
            }
        } else if (arg.substr(0, 21) == "--performance-metrics") {
            if (i + 1 < argc) {
                config->set("performance_metrics_file", argv[++i], ConfigSource::CommandLine);
                NLM_LOG_INFO("Performance metrics file: " + std::string(argv[i]));
            }
        } else if (arg.substr(0, 23) == "--visualize-integration") {
            if (i + 1 < argc) {
                config->set("visualize_integration_file", argv[++i], ConfigSource::CommandLine);
                NLM_LOG_INFO("Integration visualization file: " + std::string(argv[i]));
            }
        } else if (arg.substr(0, 14) == "--export-config") {
            if (i + 1 < argc) {
                config->set("export_config_file", argv[++i], ConfigSource::CommandLine);
                NLM_LOG_INFO("Configuration export file: " + std::string(argv[i]));
            }
        } else if (arg == "--analyze-performance") {
            config->set("analyze_performance", true, ConfigSource::CommandLine);
            NLM_LOG_INFO("Performance analysis enabled");
        }
        
        // Handle advanced feature options
        else if (arg == "--experimental-features") {
            config->set("experimental_features", true, ConfigSource::CommandLine);
            NLM_LOG_INFO("Experimental features enabled");
        } else if (arg == "--debug-build") {
            config->set("debug_build", true, ConfigSource::CommandLine);
            NLM_LOG_INFO("Debug build enabled with enhanced validation");
        } else if (arg == "--performance-profiling") {
            config->set("performance_profiling", true, ConfigSource::CommandLine);
            NLM_LOG_INFO("Performance profiling enabled");
        } else if (arg == "--development-tools") {
            config->set("development_tools", true, ConfigSource::CommandLine);
            NLM_LOG_INFO("Development tools enabled");
        } else if (arg == "--enable-replay") {
            config->set("enable_replay", true, ConfigSource::CommandLine);
            NLM_LOG_INFO("Replay system enabled");
        } else if (arg == "--enable-sleep") {
            config->set("enable_sleep", true, ConfigSource::CommandLine);
            NLM_LOG_INFO("Sleep system enabled");
        }
    }
}

