// Export results to files
void exportResults(const std::string& outputDir, const std::shared_ptr<Config>& config,
                   const std::shared_ptr<Brain>& brain) {
    
    if (outputDir.empty()) return;
    
    NLM_LOG_INFO("Exporting simulation results to: " + outputDir);
    
    // Create directory if it doesn't exist
    std::string mkdirCmd = "mkdir -p " + outputDir;
    system(mkdirCmd.c_str());
    
    // Export brain state (checkpoint format)
    std::string brainFile = outputDir + "/brain_state.checkpoint";
    if (brain->save(brainFile)) {
        NLM_LOG_INFO("  ✓ Brain state saved to: " + brainFile);
    } else {
        NLM_LOG_ERROR("  ✗ Failed to save brain state");
    }
    
    // Export configuration
    std::string configFile = outputDir + "/config.json";
    if (config->saveToFile(configFile)) {
        NLM_LOG_INFO("  ✓ Configuration saved to: " + configFile);
    } else {
        NLM_LOG_ERROR("  ✗ Failed to save configuration");
    }
    
    // Export simulation statistics
    std::string statsFile = outputDir + "/simulation_stats.json";
    std::ofstream statsOut(statsFile);
    if (statsOut.is_open()) {
        statsOut << "{\n";
        statsOut << "  \"simulation_parameters\": {\n";
        statsOut << "    \"neuron_count\": " << config->getOr<int64_t>("neuron_count", 500) << ",\n";
        statsOut << "    \"region_count\": " << config->getOr<int64_t>("region_count", 1) << ",\n";
        statsOut << "    \"connection_probability\": " << config->getOr<float>("connection_probability", 0.1f) << ",\n";
        statsOut << "    \"simulation_timestep\": " << config->getOr<double>("simulation_timestep", 0.001) << ",\n";
        statsOut << "    \"random_seed\": " << config->getOr<int64_t>("random_seed", 42) << "\n";
        statsOut << "  },\n";
        statsOut << "  \"brain_statistics\": {\n";
        statsOut << "    \"total_neurons\": " << brain->getTotalNeuronCount() << ",\n";
        statsOut << "    \"total_synapses\": " << brain->getTotalSynapseCount() << ",\n";
        statsOut << "    \"active_neurons\": " << brain->getActiveNeuronCount() << ",\n";
        statsOut << "    \"firing_neurons\": " << brain->getFiringNeuronCount() << ",\n";
        statsOut << "    \"total_spikes\": " << brain->getTotalSpikeCount() << ",\n";
        statsOut << "    \"e_i_ratio\": " << brain->getExcitationInhibitionRatio() << ",\n";
        statsOut << "    \"average_firing_rate\": " << brain->getAverageFiringRate() << "\n";
        statsOut << "  }\n";
        statsOut << "}\n";
        statsOut.close();
        NLM_LOG_INFO("  ✓ Simulation statistics saved to: " + statsFile);
    } else {
        NLM_LOG_ERROR("  ✗ Failed to save simulation statistics");
    }
    
    NLM_LOG_INFO("Result export complete");
}

// Run benchmarks
void runBenchmarks() {
    std::cout << "Running NLM Performance Benchmarks..." << std::endl;
    
    // Simple benchmark using the existing benchmark.cpp logic
    std::vector<BenchmarkResult> results;
    
    // Test configurations
    std::vector<std::pair<size_t, size_t>> benchmarks = {
        {100, 1000},
        {500, 1000},
        {1000, 500},
        {2000, 200},
    };
    
    for (const auto& [neurons, steps] : benchmarks) {
        auto result = runBenchmark(neurons, steps);
        results.push_back(result);
        std::cout << std::endl;
    }
    
    printBenchmarkResults(results);
    std::cout << "Benchmarks complete." << std::endl;
}

// Main function with comprehensive command-line parsing
int main(int argc, char** argv) {
    // Parse command line arguments
    std::string configFile = "configs/default.cfg";
    std::string experimentName = "";
    std::string outputDir = "";
    std::string outputFile = "";
    std::string plasticityMode = "both";
    std::string neuronModel = "lif";
    bool debugMode = false;
    bool quietMode = false;
    bool validateOnly = false;
    bool listExperimentsFlag = false;
    bool runBenchmarksFlag = false;
    bool simulateOnly = false;
    
    SimulationStep steps = 1000;
    size_t neurons = 500;
    size_t regions = 1;
    size_t seed = 42;
    
    // Parse arguments
    for (int i = 1; i < argc; ++i) {
        std::string arg = argv[i];
        
        if (arg == "--help") {
            printHelp();
            return 0;
        } else if (arg == "--version") {
            printVersion();
            return 0;
        } else if (arg == "--validate-config") {
            validateOnly = true;
        } else if (arg == "--list-experiments") {
            listExperimentsFlag = true;
        } else if (arg == "--run-benchmarks") {
            runBenchmarksFlag = true;
        } else if (arg == "--debug") {
            debugMode = true;
        } else if (arg == "--quiet") {
            quietMode = true;
        } else if (arg == "--simulate-only") {
            simulateOnly = true;
        } else if (arg.find("--config") == 0) {
            if (arg.find('=') != std::string::npos) {
                configFile = arg.substr(arg.find('=') + 1);
            } else if (i + 1 < argc) {
                configFile = argv[++i];
            }
        } else if (arg.find("--experiment") == 0) {
            if (arg.find('=') != std::string::npos) {
                experimentName = arg.substr(arg.find('=') + 1);
            } else if (i + 1 < argc) {
                experimentName = argv[++i];
            }
        } else if (arg.find("--export-results") == 0) {
            if (arg.find('=') != std::string::npos) {
                outputDir = arg.substr(arg.find('=') + 1);
            } else if (i + 1 < argc) {
                outputDir = argv[++i];
            }
        } else if (arg.find("--output-file") == 0) {
            if (arg.find('=') != std::string::npos) {
                outputFile = arg.substr(arg.find('=') + 1);
            } else if (i + 1 < argc) {
                outputFile = argv[++i];
            }
        } else if (arg.find("--steps") == 0) {
            if (arg.find('=') != std::string::npos) {
                steps = std::stoul(arg.substr(arg.find('=') + 1));
            } else if (i + 1 < argc) {
                steps = std::stoul(argv[++i]);
            }
        } else if (arg.find("--neurons") == 0) {
            if (arg.find('=') != std::string::npos) {
                neurons = std::stoul(arg.substr(arg.find('=') + 1));
            } else if (i + 1 < argc) {
                neurons = std::stoul(argv[++i]);
            }
        } else if (arg.find("--regions") == 0) {
            if (arg.find('=') != std::string::npos) {
                regions = std::stoul(arg.substr(arg.find('=') + 1));
            } else if (i + 1 < argc) {
                regions = std::stoul(argv[++i]);
            }
        } else if (arg.find("--seed") == 0) {
            if (arg.find('=') != std::string::npos) {
                seed = std::stoul(arg.substr(arg.find('=') + 1));
            } else if (i + 1 < argc) {
                seed = std::stoul(argv[++i]);
            }
        } else if (arg.find("--plasticity") == 0) {
            if (arg.find('=') != std::string::npos) {
                plasticityMode = arg.substr(arg.find('=') + 1);
            } else if (i + 1 < argc) {
                plasticityMode = argv[++i];
            }
        } else if (arg.find("--neuron-model") == 0) {
            if (arg.find('=') != std::string::npos) {
                neuronModel = arg.substr(arg.find('=') + 1);
            } else if (i + 1 < argc) {
                neuronModel = argv[++i];
            }
        } else if (arg.find("--plasticity-rate") == 0) {
            if (arg.find('=') != std::string::npos) {
                // Parse and set plasticity rate
            } else if (i + 1 < argc) {
                ++i; // Skip value
            }
        } else if (arg.find("--learning-rate") == 0) {
            if (arg.find('=') != std::string::npos) {
                // Parse and set learning rate
            } else if (i + 1 < argc) {
                ++i; // Skip value
            }
        } else if (arg.find("--connection-density") == 0) {
            if (arg.find('=') != std::string::npos) {
                // Parse and set connection density
            } else if (i + 1 < argc) {
                ++i; // Skip value
            }
        } else if (arg.find("--inhibition-level") == 0) {
            if (arg.find('=') != std::string::npos) {
                // Parse and set inhibition level
            } else if (i + 1 < argc) {
                ++i; // Skip value
            }
        } else if (arg.find("--synaptic-delay") == 0) {
            if (arg.find('=') != std::string::npos) {
                // Parse and set synaptic delay
            } else if (i + 1 < argc) {
                ++i; // Skip value
            }
        } else if (arg.find("--refractory-period") == 0) {
            if (arg.find('=') != std::string::npos) {
                // Parse and set refractory period
            } else if (i + 1 < argc) {
                ++i; // Skip value
            }
        } else if (arg.find("--adaptation-rate") == 0) {
            if (arg.find('=') != std::string::npos) {
                // Parse and set adaptation rate
            } else if (i + 1 < argc) {
                ++i; // Skip value
            }
        } else if (arg.find("--spike-timing") == 0) {
            if (arg.find('=') != std::string::npos) {
                // Parse and set spike timing mode
            } else if (i + 1 < argc) {
                ++i; // Skip value
            }
        } else {
            // Try to parse as key=value pair for configuration
            if (arg.find("=") != std::string::npos) {
                std::string key = arg.substr(0, arg.find("="));
                std::string value = arg.substr(arg.find("=") + 1);
                
                // Parse value based on key type
                if (key == "neuron_count") config->set(key, std::stoll(value), ConfigSource::CommandLine);
                else if (key == "region_count") config->set(key, std::stoll(value), ConfigSource::CommandLine);
                else if (key == "connection_probability") config->set(key, std::stof(value), ConfigSource::CommandLine);
                else if (key == "stdp_ltp_weight") config->set(key, std::stof(value), ConfigSource::CommandLine);
                else if (key == "stdp_ltd_weight") config->set(key, std::stof(value), ConfigSource::CommandLine);
                else if (key == "stdp_tau") config->set(key, std::stof(value), ConfigSource::CommandLine);
                else if (key == "synaptogenesis_rate") config->set(key, std::stof(value), ConfigSource::CommandLine);
                else if (key == "pruning_rate") config->set(key, std::stof(value), ConfigSource::CommandLine);
                else {
                    NLM_LOG_WARNING("Unknown configuration key: " + key);
                }
            } else {
                NLM_LOG_WARNING("Unknown argument: " + arg);
            }
        }
    }
    
    // Handle special flags
    if (listExperimentsFlag) {
        listExperiments();
        return 0;
    }
    
    if (runBenchmarksFlag) {
        runBenchmarks();
        return 0;
    }
    
    if (validateOnly) {
        auto config = std::make_shared<Config>();
        if (config->loadFromFile(configFile)) {
            validateConfig(config);
        }
        return 0;
    }
    
    // Initialize logger
    auto logger = std::make_shared<Logger>();
    LogLevel logLevel = debugMode ? LogLevel::Debug : (quietMode ? LogLevel::Error : LogLevel::Info);
    auto consoleLogger = std::make_shared<ConsoleLogger>(logLevel);
    logger->addLogger(consoleLogger);
    Logger::setGlobal(logger);
    
    NLM_LOG_INFO("=== NLM Advanced Command-Line Interface ===");
    
    // Load configuration
    auto config = std::make_shared<Config>();
    
    if (config->loadFromFile(configFile)) {
        NLM_LOG_INFO("Loaded configuration from: " + configFile);
    } else {
        NLM_LOG_INFO("Using default configuration (file not found: " + configFile + ")");
    }
    
    // Override with command line parameters
    config->set("random_seed", static_cast<int64_t>(seed), ConfigSource::CommandLine);
    config->set("neuron_count", static_cast<int64_t>(neurons), ConfigSource::CommandLine);
    config->set("region_count", static_cast<int64_t>(regions), ConfigSource::CommandLine);
    
    // Set advanced parameters based on command line options
    config->set("plasticity_mode", plasticityMode, ConfigSource::CommandLine);
    config->set("neuron_model", neuronModel, ConfigSource::CommandLine);
    
    // Validate configuration
    validateConfig(config);
    
    // Create brain with configuration
    auto brain = std::make_shared<Brain>(config);
    
    if (!brain->initialize()) {
        NLM_LOG_ERROR("Failed to initialize brain!");
        return 1;
    }
    
    brain->logStatus();
    
    // Run experiment or simulation
    if (!experimentName.empty()) {
        runExperiment(experimentName, config, outputDir);
    } else if (simulateOnly) {
        // Run basic simulation
        NLM_LOG_INFO("Running basic simulation only...");
        for (SimulationStep step = 0; step < steps; ++step) {
            brain->step(step, step * config->getOr<double>("simulation_timestep", 0.001));
            
            if (step % 100 == 0) {
                NLM_LOG_INFO("Step " + std::to_string(step) + "/" + std::to_string(steps) + 
                           " | Spikes: " + std::to_string(brain->getTotalSpikeCount()));
            }
        }
    } else {
        // Run comprehensive learning experiments
        NLM_LOG_INFO("Running comprehensive learning experiments...");
        
        // Test 1: Basic connectivity
        NLM_LOG_INFO("\n=== Test 1: Basic Connectivity ===");
        runBasicConnectivityTest(brain);
        
        // Reset and run plasticity experiment
        brain->reset();
        brain->initialize();
        
        NLM_LOG_INFO("\n=== Test 2: Plasticity Learning ===");
        runPlasticityExperiment(brain);
        
        // Reset and run STDP verification
        brain->reset();
        brain->initialize();
        
        NLM_LOG_INFO("\n=== Test 3: STDP Verification ===");
        runStdpVerification(brain);
        
        // Final status
        brain->logStatus();
    }
    
    // Export results if requested
    if (!outputDir.empty() && !experimentName.empty()) {
        exportResults(outputDir, config, brain);
    } else if (!outputDir.empty() && !simulateOnly) {
        exportResults(outputDir, config, brain);
    }
    
    NLM_LOG_INFO("\n=== NLM Simulation Complete ===");
    
    return 0;
}
