// Experiment runner function
void runExperiment(const std::string& experimentName, const std::shared_ptr<Config>& config, 
                   const std::string& outputDir = "") {
    
    auto brain = std::make_shared<Brain>(config);
    
    if (!brain->initialize()) {
        NLM_LOG_ERROR("Failed to initialize brain for experiment: " + experimentName);
        return;
    }
    
    NLM_LOG_INFO("Starting experiment: " + experimentName);
    
    // Run experiment based on type
    if (experimentName == "basic-connectivity") {
        // Basic connectivity test
        runBasicConnectivityTest(brain);
    } else if (experimentName == "plasticity-learning") {
        // Plasticity learning experiment
        runPlasticityExperiment(brain);
    } else if (experimentName == "stdp-verification") {
        // STDP verification
        runStdpVerification(brain);
    } else {
        NLM_LOG_WARNING("Unknown experiment: " + experimentName + ", running basic simulation");
        // Run basic simulation
        for (SimulationStep step = 0; step < 1000; ++step) {
            brain->step(step, step * 0.001);
        }
    }
    
    brain->logStatus();
    
    // Export results if output directory specified
    if (!outputDir.empty()) {
        std::string brainFile = outputDir + "/brain_state.json";
        brain->save(brainFile);
        NLM_LOG_INFO("Experiment results exported to: " + outputDir);
    }
}

// Configuration validation
void validateConfig(const std::shared_ptr<Config>& config) {
    NLM_LOG_INFO("=== Configuration Validation ===");
    
    // Check for required parameters
    if (!config->has("neuron_count")) {
        NLM_LOG_WARNING("Missing 'neuron_count' in configuration");
    }
    
    if (!config->has("region_count")) {
        NLM_LOG_WARNING("Missing 'region_count' in configuration");
    }
    
    // Validate parameter ranges
    if (config->has("neuron_count")) {
        int64_t neurons = config->getOr<int64_t>("neuron_count", 500);
        if (neurons < 10 || neurons > 100000) {
            NLM_LOG_WARNING("neuron_count " + std::to_string(neurons) + " is outside recommended range (10-100000)");
        }
    }
    
    if (config->has("connection_probability")) {
        float prob = config->getOr<float>("connection_probability", 0.1f);
        if (prob < 0.0f || prob > 1.0f) {
            NLM_LOG_ERROR("connection_probability " + std::to_string(prob) + " must be between 0.0 and 1.0");
        }
    }
    
    NLM_LOG_INFO("Configuration validation complete");
}

