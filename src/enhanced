// Enhanced Simulation Runner
class SimulationRunner {
public:
    struct SimulationMetrics {
        size_t steps = 0;
        float totalReward = 0.0f;
        float avgFiringRate = 0.0f;
        size_t maxFiringNeurons = 0;
        size_t totalSpikes = 0;
        std::chrono::milliseconds wallClockTime = std::chrono::milliseconds(0);
        std::vector<float> firingRateHistory;
        std::vector<float> rewardHistory;
        std::vector<float> neuromodulationHistory;
        
        // Helper methods
        float getAverageFiringRate() const {
            return avgFiringRate;
        }
        
        float getTotalReward() const {
            return totalReward;
        }
        
        size_t getMaxFiringNeurons() const {
            return maxFiringNeurons;
        }
    };
    
    static SimulationMetrics runEpisode(
        EnhancedBrain* brain,
        SimpleWorld* world,
        EnhancedAgentBrain* agent,
        size_t stepsPerEpisode,
        bool enableMonitoring = true);
    
    static std::vector<SimulationMetrics> runMultipleEpisodes(
        EnhancedBrain* brain,
        SimpleWorld* world,
        EnhancedAgentBrain* agent,
        size_t numEpisodes,
        size_t stepsPerEpisode,
        bool enableMonitoring = true);
};

// Memory Management Utilities
class MemoryManager {
public:
    static void clearAllMemory(EnhancedBrain* brain);
    static size_t getMemoryUsage(EnhancedBrain* brain);
    static void optimizeMemory(EnhancedBrain* brain, float retentionRate = 0.3f);
    
    // Convenience methods
    static void reset(EnhancedBrain* brain) {
        clearAllMemory(brain);
    }
    
    static size_t getUsage(EnhancedBrain* brain) {
        return getMemoryUsage(brain);
    }
};

// Performance Monitoring and Profiling
class PerformanceProfiler {
public:
    struct PerformanceStats {
        std::chrono::high_resolution_clock::time_point startTime;
        size_t stepsCompleted = 0;
        size_t totalSpikeCount = 0;
        float totalCPUUsage = 0.0f;
        size_t memoryUsage = 0;
        float avgStepTime = 0.0f;
        std::vector<float> stepTimes;
        std::map<std::string, float> customMetrics;
        
        // Helper methods
        float getAverageStepTime() const {
            return avgStepTime;
        }
        
        size_t getStepsCompleted() const {
            return stepsCompleted;
        }
        
        float getTotalSpikeCount() const {
            return static_cast<float>(totalSpikeCount);
        }
    };
    
    static PerformanceStats startProfiling();
    static void recordStep(PerformanceStats& stats, EnhancedBrain* brain);
    static std::string generateReport(const PerformanceStats& stats);
    
    // Convenience methods
    static PerformanceStats start() {
        return startProfiling();
    }
    
    static void record(EnhancedBrain* brain) {
        static PerformanceStats stats = startProfiling();
        recordStep(stats, brain);
    }
};

