#include "Config.hpp"
#include "core/Logger/Logger.hpp"
#include <fstream>
#include <sstream>
#include <algorithm>
#include <filesystem>

namespace nlm {

struct Config::Impl {
    std::vector<ConfigEntry> entries;
};

Config::Config() : pImpl(std::make_unique<Impl>()) {
    /*
     * Default constructor creates an empty configuration.
     * 
     * The configuration starts with no entries and all values will use defaults
     * when accessed via getOr(). This constructor initializes the internal
     * implementation object using the Pimpl idiom.
     */
}

Config::~Config() = default;

Config::Config(Config&& other) noexcept : pImpl(std::move(other.pImpl)) {
    /*
     * Move constructor enables efficient transfer of configuration data.
     * 
     * This constructor transfers ownership of the implementation object from
     * the source configuration to the target configuration without copying
     * the actual configuration entries. This is much more efficient than
     * copying each configuration key-value pair individually.
     * 
     * @param other The source configuration object to move from.
     * 
     * @note After the move, the source configuration will be in a valid but
     *       unspecified state (empty configuration).
     */
}

Config& Config::operator=(Config&& other) noexcept {
    /*
     * Move assignment operator enables efficient transfer of configuration data.
     * 
     * This operator transfers ownership of the implementation object from
     * the source configuration to the target configuration without copying
     * the actual configuration entries. It also handles self-assignment
     * correctly and ensures the source configuration is left in a valid state.
     * 
     * @param other The source configuration object to move from.
     * @return Reference to this configuration object (for method chaining).
     * 
     * @note This implementation uses the copy-and-swap idiom for safety.
     */
    if (this != &other) {
        pImpl = std::move(other.pImpl);
    }
    return *this;
}

bool Config::loadFromFile(const std::string& filepath) {
    /*
     * Load configuration from a file in a simple key=value format.
     * 
     * This function implements a basic configuration parser that reads key-value
     * pairs from a text file. Each line should be in the format: key = value
     * where value can be quoted. Lines starting with # or / are treated as comments.
     * 
     * @param filepath Path to the configuration file to load.
     * 
     * @return true if the file was successfully loaded and parsed, false otherwise.
     * 
     * @note This is a simplified implementation for Phase 1. A full JSON/YAML
     *       parser would be implemented in a future phase.
     */
    std::ifstream file(filepath);
    if (!file.is_open()) {
        NLM_LOG_ERROR("Failed to open config file: " + filepath);
        return false;
    }
    
    std::string line;
    size_t lineNumber = 0;
    
    while (std::getline(file, line)) {
        ++lineNumber;
        
        // Skip empty lines and comments
        line = trim(line);
        if (line.empty() || line[0] == '#' || line[0] == '/') {
            continue;
        }
        
        // Parse key=value pairs
        size_t pos = line.find('=');
        if (pos != std::string::npos) {
            std::string key = trim(line.substr(0, pos));
            std::string value = trim(line.substr(pos + 1));
            
            // Remove quotes if present
            if (value.size() >= 2 && 
                ((value.front() == '"' && value.back() == '"') ||
                 (value.front() == '\'' && value.back() == '\''))) {
                value = value.substr(1, value.size() - 2);
            }
            
            set(key, value, ConfigSource::File);
        } else {
            NLM_LOG_WARNING("Invalid config line " + std::to_string(lineNumber) + ": " + line);
        }
    }
    
    return true;
}

bool Config::loadFromArgs(int argc, char** argv) {
    /*
     * Load configuration from command line arguments.
     * 
     * This function parses command line arguments for configuration values.
     * It supports two formats:
     * - --key=value (long format)
     * - -k value (short format)
     * 
     * Command line arguments have the highest precedence in the configuration
     * system, overriding values from config files and defaults.
     * 
     * @param argc Number of command line arguments (as passed to main).
     * @param argv Array of command line argument strings (as passed to main).
     * 
     * @return true if arguments were successfully parsed, false otherwise.
     * 
     * @note Command line arguments override values from config files.
     */
    for (int argIndex = 1; argIndex < argc; ++argIndex) {
        const std::string& arg = argv[argIndex];
        
        // Handle --key=value format
        if (arg.rfind("--", 0) == 0) {
            size_t equalsPos = arg.find('=');
            if (equalsPos != std::string::npos) {
                std::string configKey = arg.substr(2, equalsPos - 2);
                std::string configValue = arg.substr(equalsPos + 1);
                set(configKey, configValue, ConfigSource::CommandLine);
            }
        }
        // Handle -key value format
        else if (!arg.empty() && arg[0] == '-' && argIndex + 1 < argc) {
            std::string configKey = arg.substr(1);
            std::string configValue = argv[++argIndex];
            set(configKey, configValue, ConfigSource::CommandLine);
        }
    }
    return true;
}

bool Config::saveToFile(const std::string& filepath) const {
    /*
     * Save configuration to a file in key=value format.
     * 
     * This function writes all configuration entries to a file in a simple
     * key=value format. Each entry is preceded by a comment describing it.
     * Numeric values are written without quotes, while string values are
     * written with double quotes.
     * 
     * @param filepath Path to the configuration file to save.
     * 
     * @return true if the file was successfully written, false otherwise.
     */
    std::ofstream file(filepath);
    if (!file.is_open()) {
        NLM_LOG_ERROR("Failed to open config file for writing: " + filepath);
        return false;
    }
    
    for (const auto& entry : pImpl->entries) {
        file << "# " << entry.description << "\n";
        file << entry.key << " = ";
        
        // Helper lambda to format different value types
        auto formatValue = [&file](const ConfigValue& value) {
            std::visit([&file](const auto& val) {
                using T = std::decay_t<decltype(val)>;
                if constexpr (std::is_same_v<T, std::string>) {
                    file << "\"" << val << "\"";
                } else if constexpr (std::is_same_v<T, std::vector<std::string>>) {
                    file << "[";
                    for (size_t i = 0; i < val.size(); ++i) {
                        if (i > 0) file << ", ";
                        file << "\"" << val[i] << "\"";
                    }
                    file << "]";
                } else {
                    file << val;
                }
            }, value);
        };
        
        formatValue(entry.value);
        file << "\n\n";
    }
    
    return true;
}

template<typename T>
std::optional<T> Config::get(const std::string& configKey) const {
    /*
     * Retrieve a configuration value with type-safe access.
     * 
     * This template method looks up a configuration value by key and returns
     * it if found and of the correct type. This method uses type-safe access
     * to prevent accessing values with incorrect types.
     * 
     * @tparam T The type to retrieve (must be one of the supported types).
     * @param configKey The configuration key to look up.
     * 
     * @return std::optional<T> The value if found and of the correct type,
     *         std::nullopt if the key is not found or the value is of wrong type.
     * 
     * @note This method is exception-safe and never throws.
     * 
     * @see getOr
     * @see set
     */
    auto entryIterator = std::find_if(pImpl->entries.begin(), pImpl->entries.end(),
        [&configKey](const ConfigEntry& entry) { return entry.key == configKey; });
    
    if (entryIterator == pImpl->entries.end()) {
        return std::nullopt;
    }
    
    try {
        return std::get<T>(entryIterator->value);
    } catch (const std::bad_variant_access&) {
        return std::nullopt;
    }
}

template<typename T>
T Config::getOr(const std::string& configKey, const T& defaultValue) const {
    /*
     * Retrieve a configuration value with a default fallback.
     * 
     * This method looks up a configuration value and returns it if found
     * and of the correct type. If the key is not found or the value is
     * of the wrong type, the default value is returned instead.
     * 
     * This is more convenient than get() when a default is always acceptable
     * or when the code should not handle the case of missing configuration.
     * 
     * @tparam T The type to retrieve.
     * @param configKey The configuration key to look up.
     * @param defaultValue The value to return if the key is not found or has wrong type.
     * 
     * @return T The configuration value if found and of correct type,
     *         otherwise the default value.
     * 
     * @note This method is exception-safe and never throws.
     * 
     * @see get
     * @see set
     */
    auto configValueOptional = get<T>(configKey);
    return configValueOptional.has_value() ? configValueOptional.value() : defaultValue;
}

void Config::set(const std::string& configKey, const ConfigValue& configValue, ConfigSource source) {
    /*
     * Set or update a configuration value.
     * 
     * This method sets a configuration value with the specified source. If a
     * key already exists in the configuration, its value and source are
     * updated. Otherwise, a new entry is added to the configuration.
     * 
     * The source parameter helps track where configuration values come from
     * and resolve conflicts when the same key is set from multiple sources.
     * 
     * @param configKey The configuration key.
     * @param configValue The configuration value.
     * @param source The source of this configuration value.
     * 
     * @see ConfigSource
     * @see get
     */
    auto existingEntryIterator = std::find_if(pImpl->entries.begin(), pImpl->entries.end(),
        [&configKey](const ConfigEntry& entry) { return entry.key == configKey; });
    
    if (existingEntryIterator != pImpl->entries.end()) {
        existingEntryIterator->value = configValue;
        existingEntryIterator->source = source;
    } else {
        pImpl->entries.emplace_back(configKey, configValue, source);
    }
}

void Config::set(const std::string& configKey, const std::string& configValue, ConfigSource source) {
    set(configKey, ConfigValue(configValue), source);
}

void Config::set(const std::string& configKey, int intValue, ConfigSource source) {
    set(configKey, ConfigValue(intValue), source);
}

void Config::set(const std::string& configKey, double doubleValue, ConfigSource source) {
    set(configKey, ConfigValue(doubleValue), source);
}

void Config::set(const std::string& configKey, bool boolValue, ConfigSource source) {
    set(configKey, ConfigValue(boolValue), source);
}

bool Config::has(const std::string& configKey) const {
    /*
     * Check if a configuration key exists.
     * 
     * This method checks whether a configuration key has been set in the
     * configuration, regardless of its value.
     * 
     * @param configKey The configuration key to check.
     * 
     * @return true if the key exists in the configuration, false otherwise.
     */
    return std::any_of(pImpl->entries.begin(), pImpl->entries.end(),
        [&configKey](const ConfigEntry& entry) { return entry.key == configKey; });
}

void Config::remove(const std::string& configKey) {
    /*
     * Remove a configuration entry.
     * 
     * This method removes a configuration entry and its value from the
     * configuration if it exists. If the key doesn't exist, this is a no-op.
     * 
     * @param configKey The configuration key to remove.
     */
    pImpl->entries.erase(
        std::remove_if(pImpl->entries.begin(), pImpl->entries.end(),
            [&configKey](const ConfigEntry& entry) { return entry.key == configKey; }),
        pImpl->entries.end()
    );
}

std::vector<std::string> Config::getKeys() const {
    /*
     * Get all configuration keys.
     * 
     * This method returns a list of all configuration keys that have been set.
     * The returned vector contains unique keys in the order they were inserted.
     * 
     * @return std::vector<std::string> Vector containing all configuration keys.
     */
    std::vector<std::string> resultKeys;
    resultKeys.reserve(pImpl->entries.size());
    for (const auto& entry : pImpl->entries) {
        resultKeys.push_back(entry.key);
    }
    return resultKeys;
}

void Config::clear() {
    /*
     * Clear all configuration values.
     * 
     * This method removes all configuration entries, leaving the configuration
     * in a clean state as if it were just constructed.
     */
    pImpl->entries.clear();
}

std::string Config::summary() const {
    /*
     * Generate a human-readable configuration summary.
     * 
     * This method creates a formatted string containing all configuration
     * entries with their values and sources. The output is suitable for
     * debugging and logging purposes.
     * 
     * @return std::string Human-readable configuration summary.
     */
    std::ostringstream outputStream;
    outputStream << "Configuration (" << pImpl->entries.size() << " entries):\n";
    
    for (const auto& entry : pImpl->entries) {
        outputStream << "  " << entry.key << " = [";
        
        std::visit([&outputStream](const auto& value) {
            using T = std::decay_t<decltype(value)>;
            if constexpr (std::is_same_v<T, std::string>) {
                outputStream << "\"" << value << "\"";
            } else {
                outputStream << value;
            }
        }, entry.value);
        
        outputStream << "] (" << static_cast<int>(entry.source) << ")\n";
    }
    
    return outputStream.str();
}

std::string Config::trim(const std::string& inputString) {
    /*
     * Trim whitespace from both ends of a string.
     * 
     * This function removes leading and trailing whitespace characters
     * (spaces, tabs, carriage returns, and newlines) from the input string.
     * 
     * @param inputString The string to trim.
     * @return std::string The trimmed string.
     */
    size_t firstCharacterPosition = inputString.find_first_not_of(" \t\r\n");
    if (firstCharacterPosition == std::string::npos) return "";
    
    size_t lastCharacterPosition = inputString.find_last_not_of(" \t\r\n");
    return inputString.substr(firstCharacterPosition, 
                              lastCharacterPosition - firstCharacterPosition + 1);
}

std::string Config::toLower(const std::string& inputString) {
    /*
     * Convert a string to lowercase.
     * 
     * This function creates a lowercase version of the input string using
     * the standard library tolower function. The original string is not modified.
     * 
     * @param inputString The string to convert.
     * @return std::string The lowercase version of the input string.
     */
    std::string lowercaseString = inputString;
    std::transform(lowercaseString.begin(), lowercaseString.end(), 
                   lowercaseString.begin(), ::tolower);
    return lowercaseString;
}

// Explicit template instantiations for the public API
// These declarations force the compiler to generate code for these templates,
// ensuring they are available in the final binary and preventing linker errors.
//
// The following instantiations cover all supported configuration types:
// - int, int64_t: 64-bit integers
// - double: Floating-point values
// - bool: Boolean flags
// - std::string: Text values
//
// These enable users to call get<T>() and getOr<T>() with these types.

template std::optional<int> Config::get<int>(const std::string&) const;
template std::optional<int64_t> Config::get<int64_t>(const std::string&) const;
template std::optional<double> Config::get<double>(const std::string&) const;
template std::optional<bool> Config::get<bool>(const std::string&) const;
template std::optional<std::string> Config::get<std::string>(const std::string&) const;

template int Config::getOr<int>(const std::string&, const int&) const;
template int64_t Config::getOr<int64_t>(const std::string&, const int64_t&) const;
template double Config::getOr<double>(const std::string&, const double&) const;
template bool Config::getOr<bool>(const std::string&, const bool&) const;
template std::string Config::getOr<std::string>(const std::string&, const std::string&) const;

} // namespace nlm
