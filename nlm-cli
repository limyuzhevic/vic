#!/usr/bin/env bash

# NLM Command Line Interface
# Provides user-friendly commands for NLM (Neural Learning Machine) operations

NLM_CLI_VERSION="1.0.0"

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

print_header() {
    echo -e "${CYAN}=============================================${NC}"
    echo -e "${CYAN}   NLM - Neural Learning Machine CLI${NC}"
    echo -e "${CYAN}   Version $NLM_CLI_VERSION${NC}"
    echo -e "${CYAN}=============================================${NC}"
    echo -e "${NC}"
}

print_help() {
    print_header
    echo -e "${BLUE}Usage:${NC} nlm-cli <command> [options]"
    echo -e "${NC}"
    echo -e "${YELLOW}Commands:${NC}"
    echo -e "  ${GREEN}run${NC}              Run an NLM simulation/experiment"
    echo -e "  ${GREEN}config${NC}            Configure NLM settings"
    echo -e "  ${GREEN}save${NC}             Save brain state to file"
    echo -e "  ${GREEN}load${NC}             Load brain state from file"
    echo -e "  ${GREEN}status${NC}            Show current brain status"
    echo -e "  ${GREEN}test${NC}             Run system tests"
    echo -e "  ${GREEN}explore${NC}          Interactive exploration mode"
    echo -e "  ${GREEN}info${NC}             Show system information"
    echo -e "${NC}"
    echo -e "${YELLOW}Global Options:${NC}"
    echo -e "  ${GREEN}--help${NC}            Show help information"
    echo -e "  ${GREEN}--version${NC}         Show version information"
    echo -e "  ${GREEN}--verbose${NC}         Enable verbose output"
    echo -e "  ${GREEN}--quiet${NC}           Suppress output"
    echo -e "${NC}"
}

print_version() {
    echo -e "NLM CLI Version $NLM_CLI_VERSION"
    echo -e "Based on NLM (熙然) - Neural Learning Machine"
    echo -e "Phase 6: Final Integration"
}

run_experiment() {
    local experiment_type="${1:-quick}"
    local steps="${2:-1000}"
    local neurons="${3:-500}"
    local config_file="${4:-}"
    
    print_header
    echo -e "${YELLOW}Running Experiment: $experiment_type${NC}"
    echo -e "Steps: $steps, Neurons: $neurons"
    
    # Build command for the NLM executable
    local cmd="${BUILD_DIR}/nlm"
    if [ "$experiment_type" = "phase2" ]; then
        cmd="${BUILD_DIR}/nlm_phase2_demo"
    elif [ "$experiment_type" = "phase6" ]; then
        cmd="${BUILD_DIR}/nlm_phase6_demo"
    fi
    
    # Add common arguments
    cmd="$cmd --neuron_count=$neurons --max_steps=$steps --random_seed=$RANDOM"
    
    if [ -n "$config_file" ]; then
        cmd="$cmd --config=$config_file"
    fi
    
    echo -e "${BLUE}Command: $cmd${NC}"
    echo -e "${YELLOW}Starting experiment...${NC}"
    echo -e "${NC}"
    
    # Run the experiment
    if [ "$VERBOSE" = "true" ]; then
        $cmd
    else
        $cmd 2>&1 | tail -50
    fi
    
    local exit_code=$?
    if [ $exit_code -eq 0 ]; then
        echo -e "${GREEN}Experiment completed successfully!${NC}"
    else
        echo -e "${RED}Experiment failed with exit code: $exit_code${NC}"
    fi
    
    return $exit_code
}

configure_nlm() {
    local config_file="${1:-./config/nlm_config.json}"
    
    print_header
    echo -e "${YELLOW}Configuring NLM...${NC}"
    echo -e "Config file: $config_file"
    
    if [ ! -f "$config_file" ]; then
        echo -e "${YELLOW}Creating default config file...${NC}"
        mkdir -p "$(dirname "$config_file")"
        cat > "$config_file" << 'EOF'
{
    "version": "1.0.0",
    "brain": {
        "neuron_count": 1000,
        "region_count": 1,
        "connection_probability": 0.1,
        "simulation_timestep": 0.001,
        "random_seed": 42
    },
    "plasticity": {
        "stdp_ltp_weight": 0.01,
        "stdp_ltd_weight": 0.012,
        "stdp_tau": 20.0,
        "synaptogenesis_rate": 0.0001,
        "pruning_rate": 0.00001
    },
    "memory": {
        "working_memory_capacity": 100,
        "episodic_max_episodes": 1000,
        "replay_interval": 100,
        "consolidation_interval": 1000
    },
    "neuromodulation": {
        "curiosity_enabled": true,
        "reward_modulation_enabled": true,
        "novelty_decay_rate": 0.99
    }
}
EOF
        echo -e "${GREEN}Default config created at: $config_file${NC}"
    else
        echo -e "${GREEN}Config file already exists: $config_file${NC}"
    fi
    
    echo -e "${YELLOW}Configuration complete.${NC}"
}

save_brain_state() {
    local filepath="${1:-./brain_state.checkpoint}"
    
    print_header
    echo -e "${YELLOW}Saving brain state...${NC}"
    echo -e "File: $filepath"
    
    # Create a simple brain state using Python bindings
    local python_cmd="python3 -c \"
import sys
sys.path.insert(0, 'python')
try:
    from pynlm import createBrain, createDefaultConfig
    
    config = createDefaultConfig()
    config.set('neuron_count', 500, 0)
    config.set('random_seed', 12345, 0)
    
    brain = createBrain(config)
    if brain.initialize():
        if brain.save('$filepath'):
            print('Brain state saved successfully to: $filepath')
        else:
            print('Failed to save brain state', file=sys.stderr)
            sys.exit(1)
    else:
        print('Failed to initialize brain', file=sys.stderr)
        sys.exit(1)
except ImportError as e:
    print('Python bindings not available:', str(e), file=sys.stderr)
    sys.exit(1)
except Exception as e:
    print('Error:', str(e), file=sys.stderr)
    sys.exit(1)
    \"
    
    echo -e "${BLUE}Running: $python_cmd${NC}"
    eval $python_cmd
    
    local exit_code=$?
    if [ $exit_code -eq 0 ]; then
        echo -e "${GREEN}Brain state saved successfully!${NC}"
    else
        echo -e "${RED}Failed to save brain state${NC}"
    fi
    
    return $exit_code
}

load_brain_state() {
    local filepath="${1:-./brain_state.checkpoint}"
    
    print_header
    echo -e "${YELLOW}Loading brain state...${NC}"
    echo -e "File: $filepath"
    
    if [ ! -f "$filepath" ]; then
        echo -e "${RED}Error: File not found: $filepath${NC}"
        return 1
    fi
    
    # Create a simple brain state using Python bindings
    local python_cmd="python3 -c \"
import sys
sys.path.insert(0, 'python')
try:
    from pynlm import createBrain, createDefaultConfig
    
    config = createDefaultConfig()
    brain = createBrain(config)
    if brain.load('$filepath'):
        print('Brain state loaded successfully from: $filepath')
        brain.logStatus()
    else:
        print('Failed to load brain state', file=sys.stderr)
        sys.exit(1)
except ImportError as e:
    print('Python bindings not available:', str(e), file=sys.stderr)
    sys.exit(1)
except Exception as e:
    print('Error:', str(e), file=sys.stderr)
    sys.exit(1)
    \"
    
    echo -e "${BLUE}Running: $python_cmd${NC}"
    eval $python_cmd
    
    local exit_code=$?$}
    if [ $exit_code -eq 0 ]; then
        echo -e "${GREEN}Brain state loaded successfully!${NC}"
    else
        echo -e "${RED}Failed to load brain state${NC}"
    fi
    
    return $exit_code
}

show_status() {
    print_header
    echo -e "${YELLOW}Current NLM System Status${NC}"
    echo -e "${NC}"
    
    # Check if executables exist
    if [ -f "${BUILD_DIR}/nlm" ]; then
        echo -e "${GREEN}✓ Core NLM executable: ${BUILD_DIR}/nlm${NC}"
    else
        echo -e "${YELLOW}✗ Core NLM executable not found${NC}"
    fi
    
    if [ -f "${BUILD_DIR}/nlm_phase6_demo" ]; then
        echo -e "${GREEN}✓ Phase 6 demo: ${BUILD_DIR}/nlm_phase6_demo${NC}"
    else
        echo -e "${YELLOW}✗ Phase 6 demo not found${NC}"
    fi
    
    if [ -d "python" ]; then
        echo -e "${GREEN}✓ Python bindings directory exists${NC}"
        if [ -f "python/bindings.cpp" ]; then
            echo -e "${GREEN}✓ Python bindings source file${NC}"
        fi
    else
        echo -e "${YELLOW}✗ Python bindings not found${NC}"
    fi
    
    # Check configuration
    if [ -f "./config/nlm_config.json" ]; then
        echo -e "${GREEN}✓ Configuration file exists: ./config/nlm_config.json${NC}"
    else
        echo -e "${YELLOW}✗ Configuration file not found${NC}"
    fi
    
    # Check checkpoint directory
    if [ -d "./checkpoints" ]; then
        echo -e "${GREEN}✓ Checkpoints directory exists: ./checkpoints${NC}"
        local checkpoint_count=$(find "./checkpoints" -name "*.checkpoint" | wc -l)
        echo -e "  ($checkpoint_count checkpoint files)"
    else
        echo -e "${YELLOW}✗ Checkpoints directory not found${NC}"
    fi
    
    echo -e "${NC}"
    echo -e "${YELLOW}System information:${NC}"
    echo -e "  Build directory: ${BUILD_DIR}"
    echo -e "  Working directory: $(pwd)"
    echo -e "  NLM CLI version: $NLM_CLI_VERSION"
    echo -e "${NC}"
}

run_tests() {
    print_header
    echo -e "${YELLOW}Running NLM System Tests...${NC}"
    echo -e "${NC}"
    
    if [ ! -d "tests" ]; then
        echo -e "${RED}Error: tests directory not found${NC}"
        return 1
    fi
    
    # List available tests
    echo -e "${YELLOW}Available tests:${NC}"
    for test_file in tests/*.cpp; do
        test_name=$(basename "$test_file" .cpp)
        echo -e "  • $test_name"
    done
    
    echo -e "${NC}"
    echo -e "${YELLOW}Test execution requires a test runner (e.g., make test or cmake --build . --target test)${NC}"
    echo -e "${NC}"
    
    return 0
}

main() {
    # Parse global options
    VERBOSE=false
    BUILD_DIR="./build"
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --help|-h)
                print_help
                exit 0
                ;;
            --version)
                print_version
                exit 0
                ;;
            --verbose)
                VERBOSE=true
                shift
                ;;
            --quiet)
                VERBOSE=false
                shift
                ;;
            --build-dir)
                BUILD_DIR="$2"
                shift 2
                ;;
            -*)
                echo -e "${RED}Unknown option: $1${NC}"
                print_help
                exit 1
                ;;
            *)
                break
                ;;
        esac
    done
    
    # Set command and options
    local command="${1:-help}"
    shift
    
    case $command in
        run|start)
            local experiment_type="quick"
            local steps="1000"
            local neurons="500"
            local config_file=""
            
            # Parse experiment-specific options
            while [[ $# -gt 0 ]]; do
                case $1 in
                    --type|-t)
                        experiment_type="$2"
                        shift 2
                        ;;
                    --steps|-s)
                        steps="$2"
                        shift 2
                        ;;
                    --neurons|-n)
                        neurons="$2"
                        shift 2
                        ;;
                    --config|-c)
                        config_file="$2"
                        shift 2
                        ;;
                    --help|-h)
                        echo -e "${YELLOW}Usage: nlm-cli run [options]${NC}"
                        echo -e "Options:"
                        echo -e "  ${GREEN}--type, -t <type>    Experiment type: quick|phase2|phase6 (default: quick)"
                        echo -e "  ${GREEN}--steps, -s <num>      Number of simulation steps (default: 1000)"
                        echo -e "  ${GREEN}--neurons, -n <num>   Number of neurons (default: 500)"
                        echo -e "  ${GREEN}--config, -c <file>    Configuration file (default: auto)"
                        return 0
                        ;;
                    *)
                        echo -e "${RED}Unknown option for run command: $1${NC}"
                        echo -e "${YELLOW}Use 'nlm-cli run --help' for more information${NC}"
                        return 1
                        ;;
                esac
            done
            
            run_experiment "$experiment_type" "$steps" "$neurons" "$config_file"
            ;;
        
        config)
            local config_file="${1:-.config/nlm_config.json}"
            
            # Parse config-specific options
            while [[ $# -gt 0 ]]; do
                case $1 in
                    --help|-h)
                        echo -e "${YELLOW}Usage: nlm-cli config [config-file]${NC}"
                        echo -e "Creates or displays configuration information"
                        echo -e "${NC}"
                        echo -e "${YELLOW}Arguments:${NC}"
                        echo -e "  ${GREEN}config-file${NC}  Path to configuration file (default: ./config/nlm_config.json)"
                        return 0
                        ;;
                    *)
                        config_file="$1"
                        shift
                        ;;
                esac
            done
            
            configure_nlm "$config_file"
            ;;
        
        save)
            local filepath="${1:-./brain_state.checkpoint}"
            
            # Parse save-specific options
            while [[ $# -gt 0 ]]; do
                case $1 in
                    --help|-h)
                        echo -e "${YELLOW}Usage: nlm-cli save <filepath>${NC}"
                        echo -e "Saves current brain state to a file"
                        echo -e "${NC}"
                        echo -e "${YELLOW}Arguments:${NC}"
                        echo -e "  ${GREEN}filepath${NC}  Output file path (default: ./brain_state.checkpoint)"
                        return 0
                        ;;
                    *)
                        filepath="$1"
                        shift
                        ;;
                esac
            done
            
            save_brain_state "$filepath"
            ;;
        
        load)
            local filepath="${1:-.config/nlm_config.json}"
            
            # Parse load-specific options
            while [[ $# -gt 0 ]]; do
                case $1 in
                    --help|-h)
                        echo -e "${YELLOW}Usage: nlm-cli load <filepath>${NC}"
                        echo -e "Loads brain state from a file"
                        echo -e "${NC}"
                        echo -e "${YELLOW}Arguments:${NC}"
                        echo -e "  ${GREEN}filepath${NC}  Input file path (default: ./brain_state.checkpoint)"
                        return 0
                        ;;
                    *)
                        filepath="$1"
                        shift
                        ;;
                esac
            done
            
            load_brain_state "$filepath"
            ;;
        
        status|stats)
            show_status
            ;;
        
        test|tests)
            run_tests
            ;;
        
        explore)
            print_header
            echo -e "${YELLOW}Interactive exploration mode${NC}"
            echo -e "${YELLOW}Not yet implemented - coming soon!${NC}"
            echo -e "${NC}"
            echo -e "${YELLOW}For now, use individual commands like:${NC}"
            echo -e "  ${GREEN}nlm-cli status${NC}"
            echo -e "  ${GREEN}nlm-cli config${NC}"
            echo -e "  ${GREEN}nlm-cli run --help${NC}"
            ;;
        
        info)
            print_header
            print_version
            echo -e "${NC}"
            echo -e "${YELLOW}NLM (熙然) - Neural Learning Machine${NC}"
            echo -e "${YELLOW}Version: $NLM_CLI_VERSION${NC}"
            echo -e "${YELLOW}Phase: 6 - Final Integration${NC}"
            echo -e "${YELLOW}Description: An experimental artificial developmental brain${NC}"
            echo -e "${NC}"
            echo -e "${YELLOW}Core Features:${NC}"
            echo -e "  • Real spiking neural computation with LIF neurons"
            echo -e "  • Event-driven spike propagation with synaptic delays"
            echo -e "  • STDP and Hebbian plasticity rules"
            echo -e "  • Structural plasticity (synaptogenesis/pruning)"
            echo -e "  • Memory systems: working, episodic, and associative memory"
            echo -e "  • Neuromodulation: dopamine, curiosity, novelty"
            echo -e "  • Prediction systems with error computation"
            echo -e "  • Cognitive mechanisms: planning, attention, concept formation"
            echo -e "  • Developmental system with stage transitions"
            echo -e "  • Checkpoint save/load functionality"
            echo -e "  • Memory replay and consolidation"
            echo -e "${NC}"
            echo -e "${YELLOW}Python Bindings:${NC}"
            echo -e "  • Access to core NLM classes from Python"
            echo -e "  • Brain simulation control"
            echo -e "  • Configuration and state management"
            echo -e "  • Integration with existing C++ codebase"
            echo -e "${NC}"
            echo -e "${YELLOW}CLI Commands:${NC}"
            echo -e "  • ${GREEN}run${NC}    - Run experiments"
            echo -e "  • ${GREEN}config${NC}  - Configure NLM settings"
            echo -e "  • ${GREEN}save${NC}   - Save brain state"
            echo -e "  • ${GREEN}load${NC}   - Load brain state"
            echo -e "  • ${GREEN}status${NC} - Show system status"
            echo -e "  • ${GREEN}test${NC}   - Run tests"
            echo -e "  • ${GREEN}explore${NC} - Interactive mode"
            echo -e "  • ${GREEN}info${NC}   - System information"
            ;;
        
        *)
            echo -e "${RED}Unknown command: $command${NC}"
            print_help
            exit 1
            ;;
    esac
}

# Entry point
main "$@"