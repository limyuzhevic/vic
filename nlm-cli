#!/usr/bin/env python3
"""
NLM Command Line Interface

This provides a command-line interface for controlling the NLM brain simulation.
It includes commands for controlling simulation, checkpointing, and monitoring.
"""

import argparse
import subprocess
import sys
import os
from pathlib import Path

class NLMCLI:
    def __init__(self):
        self.build_dir = Path("build")
        self.nlm_executable = self.build_dir / "nlm"
        self.phase6_demo_executable = self.build_dir / "nlm_phase6_demo"
    
    def run_command(self, command, args=None):
        """Run a command and return the result."""
        cmd = [command] + (args if args else [])
        try:
            result = subprocess.run(cmd, capture_output=True, text=True, check=True)
            return result.returncode, result.stdout, result.stderr
        except subprocess.CalledProcessError as e:
            return e.returncode, e.stdout, e.stderr
        except FileNotFoundError:
            return -1, "", f"Command '{command}' not found"
    
    def build_nlm(self):
        """Build the NLM project."""
        print("Building NLM project...")
        self.build_dir.mkdir(exist_ok=True)
        
        # Configure with CMake
        configure_cmd = [
            "cmake", "..", "-DCMAKE_BUILD_TYPE=Release"
        ]
        retcode, stdout, stderr = self.run_command("cmake", configure_cmd)
        if retcode != 0:
            print(f"CMake configuration failed: {stderr}")
            return False
        
        # Build with make
        build_cmd = ["make", "-j4"]
        retcode, stdout, stderr = self.run_command("make", build_cmd)
        if retcode != 0:
            print(f"Build failed: {stderr}")
            return False
        
        print("Build successful!")
        return True
    
    def run_phase6_demo(self, neuron_count=500, max_steps=2000):
        """Run the Phase 6 integration demo."""
        if not self.phase6_demo_executable.exists():
            print("Phase 6 demo executable not found. Building first...")
            if not self.build_nlm():
                return False
        
        print(f"Running Phase 6 demo with {neuron_count} neurons for {max_steps} steps...")
        cmd = [
            str(self.phase6_demo_executable),
            "--neuron_count", str(neuron_count),
            "--max_steps", str(max_steps)
        ]
        
        retcode, stdout, stderr = self.run_command(str(self.phase6_demo_executable), None)
        if retcode != 0:
            print(f"Phase 6 demo failed: {stderr}")
            return False
        
        print("Phase 6 demo completed successfully!")
        return True
    
    def run_phase2_demo(self):
        """Run the Phase 2 basic demo."""
        if not self.nlm_executable.exists():
            print("NLM executable not found. Building first...")
            if not self.build_nlm():
                return False
        
        print("Running Phase 2 basic demo...")
        retcode, stdout, stderr = self.run_command(str(self.nlm_executable), None)
        if retcode != 0:
            print(f"Phase 2 demo failed: {stderr}")
            return False
        
        print("Phase 2 demo completed successfully!")
        return True
    
    def save_checkpoint(self, brain_name="checkpoint"):
        """Save a checkpoint using the checkpoint system."""
        print(f"Saving checkpoint to {brain_name}...")
        # This would typically use the Brain checkpoint system
        # For now, just log the action
        print(f"Checkpoint saved: {brain_name}")
        return True
    
    def load_checkpoint(self, checkpoint_name):
        """Load a checkpoint from disk."""
        print(f"Loading checkpoint: {checkpoint_name}")
        # This would typically use the Brain checkpoint system
        # For now, just log the action
        print(f"Checkpoint loaded: {checkpoint_name}")
        return True
    
    def show_status(self):
        """Show current system status."""
        print("=== NLM System Status ===")
        print("NLM - Neural Learning Machine")
        print("Version: 0.1.0 (Phase 6: Final Integration)")
        print("Status: Operational")
        print("Available commands:")
        print("  build          - Build the NLM project")
        print("  phase6-demo    - Run Phase 6 integration demo")
        print("  phase2-demo    - Run Phase 2 basic demo")
        print("  save-checkpoint <name> - Save a checkpoint")
        print("  load-checkpoint <name> - Load a checkpoint")
        print("  status         - Show system status")
        print("  help           - Show this help message")
        return True
    
    def help(self):
        """Show help information."""
        print("=== NLM Command Line Interface Help ===")
        print("\nOverview:")
        print("This CLI provides commands for controlling the NLM brain simulation.")
        print("\nCommands:")
        print("  build                    Build the NLM project")
        print("  phase6-demo [neurons] [steps]  Run Phase 6 integration demo")
        print("  phase2-demo              Run Phase 2 basic demo")
        print("  save-checkpoint <name>   Save a checkpoint")
        print("  load-checkpoint <name>   Load a checkpoint")
        print("  status                   Show system status")
        print("  help                     Show this help message")
        print("\nExamples:")
        print("  nlm-cli build")
        print("  nlm-cli phase6-demo --neuron_count 1000 --max_steps 5000")
        print("  nlm-cli save-checkpoint my_checkpoint")
        print("  nlm-cli load-checkpoint my_checkpoint")
        return True

def main():
    cli = NLMCLI()
    
    parser = argparse.ArgumentParser(
        description="NLM Command Line Interface",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    
    parser.add_argument(
        'command',
        nargs='?',
        default='help',
        help='Command to execute'
    )
    
    parser.add_argument(
        '--neuron_count',
        type=int,
        default=500,
        help='Number of neurons for Phase 6 demo (default: 500)'
    )
    
    parser.add_argument(
        '--max_steps',
        type=int,
        default=2000,
        help='Maximum simulation steps for Phase 6 demo (default: 2000)'
    )
    
    parser.add_argument(
        '--checkpoint_name',
        type=str,
        default='checkpoint',
        help='Name for checkpoint file (default: checkpoint)'
    )
    
    args = parser.parse_args()
    
    # Map commands to methods
    commands = {
        'build': cli.build_nlm,
        'phase6-demo': lambda: cli.run_phase6_demo(args.neuron_count, args.max_steps),
        'phase2-demo': cli.run_phase2_demo,
        'save-checkpoint': lambda: cli.save_checkpoint(args.checkpoint_name),
        'load-checkpoint': lambda: cli.load_checkpoint(args.checkpoint_name),
        'status': cli.show_status,
        'help': cli.help,
    }
    
    # Execute the command
    if args.command in commands:
        try:
            commands[args.command]()
        except Exception as e:
            print(f"Error executing command '{args.command}': {e}")
            sys.exit(1)
    else:
        print(f"Unknown command: {args.command}")
        print("Run 'nlm-cli help' for more information")
        sys.exit(1)

if __name__ == "__main__":
    main()