#!/bin/bash

# NLM Command Line Interface (CLI)
# Provides convenient commands for working with NLM simulations

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Default configuration
DEFAULT_CONFIG="configs/default.cfg"
BUILD_DIR="build"
NLM_EXECUTABLE="$BUILD_DIR/nlm"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging functions
log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_debug() {
    echo -e "${BLUE}[DEBUG]${NC} $1"
}

# Check if build directory exists
check_build() {
    if [ ! -d "$BUILD_DIR" ]; then
        log_error "Build directory not found. Please run 'mkdir build && cd build && cmake .. -DCMAKE_BUILD_TYPE=Release' first."
        exit 1
    fi
}

# Check if NLM executable exists
check_nlm() {
    if [ ! -f "$NLM_EXECUTABLE" ]; then
        log_error "NLM executable not found. Please build the project first."
        exit 1
    fi
}

# Show help
show_help() {
    cat << EOF
NLM (熙然) - Neural Learning Machine - Command Line Interface

USAGE: ./nlm-cli [COMMAND] [OPTIONS]

COMMANDS:
    run [CONFIG]               Run the main NLM simulation
    run-phase6 [CONFIG]         Run Phase 6 integration demo
    run-phase2 [CONFIG]         Run Phase 2 neural computation demo
    run-benchmark               Run performance benchmarks
    config [KEY] [VALUE]        Set/alter configuration values
    stats [FILE]                Display brain statistics from checkpoint
    checkpoint [FILE] [OPERATION] Save/load brain state (save/load)
    experiment [TYPE] [STEPS]   Run specific experiment (phase2/phase3/phase4/phase5/phase6)
    visualize [FILE]            Start visualization (requires visualization support)
    help                       Show this help message

OPTIONS:
    --config FILE              Use specific configuration file
    --steps N                  Number of simulation steps (default: 1000)
    --neurons N                Number of neurons (overrides config)
    --regions N                Number of regions (overrides config)
    --quiet                    Quiet mode (less output)
    --verbose                  Verbose mode (more output)

EXAMPLES:
    ./nlm-cli run --config configs/default.cfg
    ./nlm-cli run-phase6 --steps 500
    ./nlm-cli checkpoint save my_brain.bin
    ./nlm-cli checkpoint load my_brain.bin
    ./nlm-cli stats my_brain.bin
    ./nlm-cli experiment phase6 --steps 200

For more detailed information, see the documentation in docs/ and README.md
EOF
}

# Command: run
command_run() {
    local config="$DEFAULT_CONFIG"
    local steps=1000
    local neurons=""
    local regions=""
    local quiet=false
    local verbose=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --config)
                config="$2"
                shift 2
                ;;
            --steps)
                steps="$2"
                shift 2
                ;;
            --neurons)
                neurons="$2"
                shift 2
                ;;
            --regions)
                regions="$2"
                shift 2
                ;;
            --quiet)
                quiet=true
                shift
                ;;
            --verbose)
                verbose=true
                shift
                ;;
            *)
                log_error "Unknown option: $1"
                show_help
                exit 1
                ;;
        esac
    done

    check_build
    check_nlm

    log_info "Running NLM simulation with config: $config"
    log_info "Steps: $steps"

    # Set up environment variables for config overrides
    export NLM_CONFIG_FILE="$config"
    export NLM_SIMULATION_STEPS="$steps"

    # Pass additional parameters via command line
    local cmd_args="$NLM_EXECUTABLE"
    if [ -n "$neurons" ]; then
        cmd_args+=" --neuron_count=$neurons"
    fi
    if [ -n "$regions" ]; then
        cmd_args+=" --region_count=$regions"
    fi

    if [ "$verbose" = true ]; then
        log_debug "Executing: $cmd_args"
    fi

    # Run NLM
    if [ "$quiet" = false ]; then
        log_info "Starting simulation..."
    fi

    eval "$cmd_args"

    if [ $? -eq 0 ]; then
        log_info "Simulation completed successfully"
    else
        log_error "Simulation failed"
        exit 1
    fi
}

# Command: run-phase6
command_run_phase6() {
    local config="$DEFAULT_CONFIG"
    local steps=1000
    local quiet=false
    local verbose=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --config)
                config="$2"
                shift 2
                ;;
            --steps)
                steps="$2"
                shift 2
                ;;
            --quiet)
                quiet=true
                shift
                ;;
            --verbose)
                verbose=true
                shift
                ;;
            *)
                log_error "Unknown option: $1"
                show_help
                exit 1
                ;;
        esac
    done

    check_build
    check_nlm

    log_info "Running NLM Phase 6 Integration Demo"
    log_info "Steps: $steps"

    # For Phase 6 demo, we use the main executable with specific configuration
    local cmd_args="$NLM_EXECUTABLE --steps $steps"

    if [ "$verbose" = true ]; then
        log_debug "Executing: $cmd_args"
    fi

    # Run Phase 6 demo (main executable)
    if [ "$quiet" = false ]; then
        log_info "Starting Phase 6 integration demo..."
    fi

    eval "$cmd_args"

    if [ $? -eq 0 ]; then
        log_info "Phase 6 integration demo completed successfully"
    else
        log_error "Phase 6 integration demo failed"
        exit 1
    fi
}

# Command: config
command_config() {
    local key="$1"
    local value="$2"

    if [ -z "$key" ]; then
        log_error "Missing configuration key"
        echo "Usage: ./nlm-cli config [KEY] [VALUE]"
        exit 1
    fi

    log_info "Setting configuration: $key = $value"

    # Update the default config file
    if [ -f "$DEFAULT_CONFIG" ]; then
        # Simple line replacement for key=value pairs
        if grep -q "^$key\s*=" "$DEFAULT_CONFIG"; then
            sed -i "s/^\($key\s*\)=.*$/\1$value/" "$DEFAULT_CONFIG"
            log_info "Updated configuration in $DEFAULT_CONFIG"
        else
            echo "$key = $value" >> "$DEFAULT_CONFIG"
            log_info "Added new configuration to $DEFAULT_CONFIG"
        fi
    else
        log_error "Configuration file $DEFAULT_CONFIG not found"
        exit 1
    fi
}

# Command: stats
command_stats() {
    local filepath="$1"

    if [ -z "$filepath" ]; then
        log_error "Missing checkpoint file path"
        echo "Usage: ./nlm-cli stats [CHECKPOINT_FILE]"
        exit 1
    fi

    if [ ! -f "$filepath" ]; then
        log_error "Checkpoint file not found: $filepath"
        exit 1
    fi

    check_build
    check_nlm

    log_info "Displaying statistics for checkpoint: $filepath"

    # Use the stats command if available, otherwise extract basic info
    # For now, just show basic file information
    local size=$(stat -c%s "$filepath" 2>/dev/null || stat -f%z "$filepath" 2>/dev/null || echo "unknown")
    local modified=$(stat -c%y "$filepath" 2>/dev/null || stat -f%m "$filepath" 2>/dev/null || echo "unknown")

    echo "=== Checkpoint Statistics ==="
    echo "File: $filepath"
    echo "Size: $size bytes"
    echo "Last modified: $modified"
    echo ""
    echo "To extract detailed brain statistics, use:"
    echo "  ./nlm-cli run --steps 0 --config $filepath"
}

# Command: checkpoint
command_checkpoint() {
    local operation="$1"
    local filepath="$2"

    if [ -z "$operation" ]; then
        log_error "Missing operation (save/load)"
        echo "Usage: ./nlm-cli checkpoint [save|load] [FILE]"
        exit 1
    fi

    if [ -z "$filepath" ]; then
        log_error "Missing file path"
        echo "Usage: ./nlm-cli checkpoint $operation [FILE]"
        exit 1
    fi

    check_build
    check_nlm

    case $operation in
        save)
            log_info "Saving brain state to: $filepath"
            # For now, just a placeholder - actual checkpointing is handled by the main executable
            log_warning "Checkpoint saving is handled by the main NLM executable"
            log_info "Run ./nlm-cli run --config $filepath to save checkpoints"
            ;;
        load)
            log_info "Loading brain state from: $filepath"
            # For now, just a placeholder
            log_warning "Checkpoint loading is handled by the main NLM executable"
            log_info "Run ./nlm-cli run --config $filepath to load checkpoints"
            ;;
        *)
            log_error "Unknown operation: $operation"
            log_info "Supported operations: save, load"
            exit 1
            ;;
    esac
}

# Command: experiment
command_experiment() {
    local experiment_type="$1"
    local steps=1000
    local quiet=false
    local verbose=false

    # Parse arguments
    while [[ $# -gt 1 ]]; do
        case $1 in
            --steps)
                steps="$2"
                shift 2
                ;;
            --quiet)
                quiet=true
                shift
                ;;
            --verbose)
                verbose=true
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    case $experiment_type in
        phase2)
            log_info "Running Phase 2 Neural Computation Experiment"
            log_info "Steps: $steps"
            # Phase 2 demo (legacy)
            ;;
        phase3)
            log_info "Running Phase 3 Synaptic Learning Experiment"
            log_info "Steps: $steps"
            ;;
        phase4)
            log_info "Running Phase 4 Cognitive Learning Experiment"
            log_info "Steps: $steps"
            ;;
        phase5)
            log_info "Running Phase 5 Performance Optimization Experiment"
            log_info "Steps: $steps"
            ;;
        phase6)
            log_info "Running Phase 6 Integration Experiment"
            log_info "Steps: $steps"
            command_run_phase6 "--steps $steps" "--quiet $quiet" "--verbose $verbose"
            return
            ;;
        *)
            log_error "Unknown experiment type: $experiment_type"
            log_info "Supported types: phase2, phase3, phase4, phase5, phase6"
            exit 1
            ;;
    esac

    log_warning "Experiment $experiment_type is not yet fully implemented"
    log_info "For now, use ./nlm-cli run-phase6 for Phase 6 experiments"
}

# Main command dispatcher
main() {
    if [ $# -eq 0 ]; then
        show_help
        exit 1
    fi

    local command="$1"
    shift

    case $command in
        run)
            command_run "$@"
            ;;
        run-phase6)
            command_run_phase6 "$@"
            ;;
        run-phase2)
            command_run "$@"
            ;;
        config)
            command_config "$@"
            ;;
        stats)
            command_stats "$@"
            ;;
        checkpoint)
            command_checkpoint "$@"
            ;;
        experiment)
            command_experiment "$@"
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            log_error "Unknown command: $command"
            show_help
            exit 1
            ;;
    esac
}

# Script entry point
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
