@cli.command()
@click.option("--steps", default=1000, help="Number of steps to run")
@click.option("--world-size", nargs=2, default=(DEFAULT_WORLD_WIDTH, DEFAULT_WORLD_HEIGHT), help="World dimensions")
@click.option("--verbose", is_flag=True, help="Verbose output")
@click.pass_context
def benchmark(ctx, steps, world_size, verbose):
    """Run a benchmark simulation."""
    try:
        if verbose:
            click.echo("Running benchmark simulation...")
            click.echo(f"Steps: {steps}")
            click.echo(f"World size: {world_size[0]}x{world_size[1]}")
        
        # Create brain and world
        brain = createBrain()
        brain.initialize()
        
        world = createSimpleWorld()
        world.configure(world_size[0], world_size[1], 8, 8)
        world.reset()
        
        # Create agent
        agent = createAgentBrain(brain)
        agent.initialize(world)
        
        # Enable learning
        agent.enable_reward_modulation(True)
        agent.enable_curiosity(True)
        
        # Run benchmark
        import time
        start_time = time.time()
        results = nlm.runAgentSimulation(brain, world, agent, steps)
        end_time = time.time()
        
        duration = end_time - start_time
        steps_per_second = steps / duration if duration > 0 else 0
        
        # Print benchmark results
        click.echo(f"\n=== Benchmark Results ===")
        click.echo(f"Duration: {duration:.2f} seconds")
        click.echo(f"Steps per second: {steps_per_second:.2f}")
        click.echo(f"World size: {world_size[0]}x{world_size[1]}")
        click.echo(f"Total neurons: {brain.get_neuron_count()}")
        
        status = brain.get_brain_status()
        click.echo(f"\nPerformance:")
        click.echo(f"  Neurons: {status['neuron_count']}")
        click.echo(f"  Synapses: {status['synapse_count']}")
        click.echo(f"  Total spikes: {status['total_spike_count']}")
        click.echo(f"  Average firing rate: {status['average_firing_rate']:.2f}")
        
        click.echo("\n✓ Benchmark completed successfully")
        
    except Exception as e:
        click.echo(f"Error: {e}", err=True)
        sys.exit(1)

# Helper functions for CLI
def execute_experiment_step(step: Dict[str, Any], verbose: bool) -> Dict[str, Any]:
    """Execute a single experiment step."""
    step_type = step.get('type', 'unknown')
    step_name = step.get('name', f"{step_type}_step")
    
    if verbose:
        click.echo(f"  Executing step: {step_name} ({step_type})")
    
    result = {
        'step_name': step_name,
        'step_type': step_type,
        'status': 'completed',
        'outputs': {}
    }
    
    if step_type == 'create_brain':
        config = createDefaultConfig()
        for key, value in step.get('config', {}).items():
            config.set(key, value)
        
        brain = createBrain(config)
        brain.initialize()
        
        result['outputs']['neuron_count'] = brain.get_neuron_count()
        result['outputs']['synapse_count'] = brain.get_synapse_count()
    
    elif step_type == 'train':
        # This would need a brain instance from previous step
        result['outputs']['message'] = f"Would train for {step.get('steps', 0)} steps"
    
    elif step_type == 'evaluate':
        result['outputs']['message'] = "Would evaluate brain performance"
    
    elif step_type == 'checkpoint':
        result['outputs']['message'] = f"Would save checkpoint to {step.get('filepath', 'unknown')}"
    
    else:
        result['status'] = 'unknown'
        result['outputs']['message'] = f"Unknown step type: {step_type}"
    
    return result


def get_system_recommendations(status: Dict[str, Any]) -> List[str]:
    """Get system recommendations based on brain status."""
    recommendations = []
    
    if status['neuron_count'] < 500:
        recommendations.append("Consider increasing neuron count for more complex behavior")
    
    if not status['has_working_memory']:
        recommendations.append("Enable working memory system for better information retention")
    
    if not status['has_prediction_system']:
        recommendations.append("Enable prediction system for anticipatory behavior")
    
    if not status['has_planner']:
        recommendations.append("Enable neural planner for action planning")
    
    if status['average_firing_rate'] < 0.1:
        recommendations.append("Brain activity is low. Consider increasing input or reducing threshold")
    
    if status['average_firing_rate'] > 10:
        recommendations.append("Brain activity is very high. Consider reducing input or increasing threshold")
    
    return recommendations


def main():
    """Main CLI entry point."""
    # Set up Click
    try:
        cli()
    except ImportError as e:
        click.echo(f"Error importing required modules: {e}", err=True)
        sys.exit(1)


if __name__ == "__main__":
    main()