#!/usr/bin/env python3

import argparse
import json
import os
import sys
import time
import pynlm
from typing import Dict, Any, Optional

# Set this to make the file executable
# When running, use: python nlm-cli [args] instead of ./nlm-cli [args]
# Or install with: pip install -e . to get nlm-cli command

class NLMCommandLineInterface:
    """Command-line interface for NLM (Neural Learning Machine)"""
    
    def __init__(self):
        self.version = "0.1.0"
        self.brain = None
        self.agent = None
        self.world = None
        self.config = None
    
    def create_demo_brain(self, config_file: Optional[str] = None) -> pynlm.Brain:
        """Create a demo brain with optional custom configuration"""
        if config_file and os.path.exists(config_file):
            self.config = pynlm.createDefaultConfig()
            self.config.loadFromFile(config_file)
        else:
            self.config = pynlm.createDefaultConfig()
            # Use enhanced default configuration
            self.config.set("brain.neuron_count", 500)
            self.config.set("brain.synapse_density", 0.15)
            self.config.set("brain.connection_probability", 0.1)
            self.config.set("plasticity.stdp.learning_rate", 0.002)
            self.config.set("plasticity.hebbian.enable", True)
            self.config.set("neuromod.curiosity.enable", True)
            self.config.set("neuromod.novelty.enable", True)
        
        brain = pynlm.createBrain(self.config)
        brain.initialize()
        return brain
    
    def create_complete_demo(self, config_file: Optional[str] = None) -> tuple:
        """Create a complete agent demo setup"""
        brain = self.create_demo_brain(config_file)
        
        # Create agent and world
        self.agent = pynlm.createAgentBrain(brain)
        self.world = pynlm.createSimpleWorld()
        self.world.configure(width=20, height=20, visionWidth=8, visionHeight=8)
        self.world.reset()
        self.world.setAgentStart(10.0, 10.0)
        
        # Initialize agent with world
        self.agent.initialize(self.world)
        
        # Enable all learning subsystems for comprehensive demo
        self.agent.enableRewardModulation(True)
        self.agent.enableCuriosity(True)
        self.agent.enableStructuralPlasticity(True)
        self.agent.enableDevelopment(True)
        
        return brain, self.agent, self.world
    
    def run_basic_demo(self, steps: int = 100) -> Dict[str, Any]:
        """Run basic neural connectivity demo"""
        print("=== NLM Basic Demo ===")
        print(f"Running {steps} simulation steps...")
        
        brain, agent, world = self.create_complete_demo()
        
        stats = {
            "steps": steps,
            "neurons": brain.getTotalNeuronCount(),
            "synapses": brain.getTotalSynapseCount(),
            "initial_spikes": 0,
            "max_firing": 0,
            "avg_firing": 0,
            "total_spikes": 0
        }
        
        max_firing = 0
        for step in range(steps):
            # Update world
            world.update(0.1)
            
            # Process sensory input
            percept = world.getSensoryPercept()
            agent.processSensoryInput(percept)
            
            # Brain thinks
            brain.step(step)
            
            # Decode action
            action = agent.decodeMotorCommand()
            
            # Apply action to world
            world.applyMotorCommand(action, world.getSimulationTime())
            
            # Apply learning
            reward = 0.0  # Simple reward for demo
            agent.applyRewardModulation(reward, 0.0)
            agent.updateDevelopment(0.1)
            
            # Collect statistics
            current_firing = brain.getFiringNeuronCount()
            max_firing = max(max_firing, current_firing)
            
            if step % 50 == 0:
                print(f"  Step {step}: {current_firing} neurons firing")
        
        stats["max_firing"] = max_firing
        stats["avg_firing"] = max_firing / steps if steps > 0 else 0
        stats["total_spikes"] = brain.getTotalSpikeCount()
        
        print(f"\n=== Demo Complete ===")
        print(f"Total spikes: {stats['total_spikes']}")
        print(f"Max firing rate: {stats['max_firing']} neurons")
        print(f"Average firing rate: {stats['avg_firing']:.2f} neurons/step")
        
        return stats
    
    def run_learning_demo(self, steps: int = 500) -> Dict[str, Any]:
        """Run advanced learning demo with all features enabled"""
        print("=== NLM Learning Demo ===")
        print(f"Running {steps} steps with advanced learning...")
        
        brain, agent, world = self.create_complete_demo()
        
        # Enable more advanced learning
        config = pynlm.createDefaultConfig()
        config.set("plasticity.stdp.tau_plus", 25.0)
        config.set("plasticity.stdp.tau_minus", 25.0)
        config.set("neuromod.dopamine.scale", 1.5)
        config.set("brain.neuron_count", 1000)
        
        stats = {
            "steps": steps,
            "neurons": brain.getTotalNeuronCount(),
            "development_stage": brain.getDevelopmentalStage(),
            "curiosity_levels": [],
            "novelty_levels": [],
            "rewards": []
        }
        
        # Create a more interesting world pattern
        obstacle_positions = [(5,5), (15,8), (8,15)]
        goal_position = (17,17)
        
        for step in range(steps):
            # Update world with obstacles and goal
            world.update(0.1)
            
            # Add environmental features
            if step < 200:
                # Create moving obstacles
                if step % 50 == 0:
                    for x, y in obstacle_positions:
                        world.addObject(pynlm.WorldObject(x, y, pynlm.WorldObjectType.Hazard, radius=0.3))
            
            if step == 300:
                # Place goal
                world.addObject(pynlm.WorldObject(goal_position[0], goal_position[1], 
                                                 pynlm.WorldObjectType.Resource, radius=0.5))
            
            # Get sensory input
            percept = world.getSensoryPercept()
            
            # Add text for text-as-a-sense demo
            if step % 100 == 0:
                # Create sensory percept with text
                percept.setText(f"step_{step}")
                agent.processSensoryInput(percept)
            else:
                agent.processSensoryInput(percept)
            
            # Brain processes
            brain.step(step)
            
            # Decode action
            action = agent.decodeMotorCommand()
            
            # Apply action with environmental interaction
            action_result = world.applyMotorCommand(action, world.getSimulationTime())
            
            # Calculate reward based on environment interaction
            reward = 0.0
            body = world.getAgentBody()
            
            # Reward for reaching goal
            if abs(body.x - goal_position[0]) < 1.0 and abs(body.y - goal_position[1]) < 1.0:
                reward += 10.0
                # Remove goal after first contact
                if step > 300:
                    world.removeObject(goal_position[0], goal_position[1])
            
            # Penalty for hitting hazards
            for x, y in obstacle_positions:
                if abs(body.x - x) < 1.0 and abs(body.y - y) < 1.0:
                    reward -= 5.0
            
            # Apply reward modulation with prediction
            agent.applyRewardModulation(reward, 0.0)
            agent.updateDevelopment(0.1)
            
            # Collect statistics
            stats["curiosity_levels"].append(agent.getCuriosityLevel())
            stats["novelty_levels"].append(agent.getNoveltyLevel())
            stats["rewards"].append(reward)
            
            if step % 100 == 0:
                print(f"  Step {step}: curiosity={agent.getCuriosityLevel():.3f}, "
                      f"novelty={agent.getNoveltyLevel():.3f}, reward={reward:.2f}")
                print(f"    Position: ({body.x:.1f}, {body.y:.1f})")
                print(f"    Action: {self._action_to_string(action)}")
                print(f"    Development stage: {brain.getDevelopmentalStage()}")
                print(f"    Learned preference: {agent.getLearnedPreference():.3f}")
        
        # Calculate final statistics
        stats["final_curiosity"] = agent.getCuriosityLevel()
        stats["final_novelty"] = agent.getNoveltyLevel()
        stats["final_stage"] = brain.getDevelopmentalStage()
        stats["mean_reward"] = sum(stats["rewards"]) / len(stats["rewards"]) if stats["rewards"] else 0
        stats["max_curiosity"] = max(stats["curiosity_levels"]) if stats["curiosity_levels"] else 0
        
        print(f"\n=== Learning Demo Complete ===")
        print(f"Final development stage: {stats['final_stage']}")
        print(f"Average curiosity: {stats['final_curiosity']:.3f}")
        print(f"Average novelty: {stats['final_novelty']:.3f}")
        print(f"Mean reward per step: {stats['mean_reward']:.3f}")
        print(f"Peak curiosity: {stats['max_curiosity']:.3f}")
        print(f"Final learned preference: {agent.getLearnedPreference():.3f}")
        
        return stats
    
    def _action_to_string(self, action: pynlm.MotorCommand) -> str:
        """Convert MotorCommand to readable string"""
        action_names = {
            pynlm.MotorCommand.MoveForward: "MoveForward",
            pynlm.MotorCommand.MoveBackward: "MoveBackward",
            pynlm.MotorCommand.TurnLeft: "TurnLeft",
            pynlm.MotorCommand.TurnRight: "TurnRight",
            pynlm.MotorCommand.LookLeft: "LookLeft",
            pynlm.MotorCommand.LookRight: "LookRight",
            pynlm.MotorCommand.Interact: "Interact",
            pynlm.MotorCommand.Wait: "Wait"
        }
        return action_names.get(action, f"Unknown({action})")
    
    def run_checkpoint_demo(self, steps: int = 300) -> Dict[str, Any]:
        """Demonstrate checkpoint functionality"""
        print("=== NLM Checkpoint Demo ===")
        
        brain, agent, world = self.create_complete_demo()
        
        # Initial run
        print("Running initial simulation...")
        for step in range(steps // 2):
            world.update(0.1)
            agent.processSensoryInput(world.getSensoryPercept())
            brain.step(step)
            action = agent.decodeMotorCommand()
            world.applyMotorCommand(action, world.getSimulationTime())
            agent.applyRewardModulation(0.1, 0.0)
            agent.updateDevelopment(0.1)
        
        # Save checkpoint
        checkpoint_file = "nlm_checkpoint.dat"
        brain.save(checkpoint_file)
        print(f"Brain state saved to {checkpoint_file}")
        
        # Print brain statistics before checkpoint
        print(f"Before checkpoint:")
        print(f"  Neurons: {brain.getTotalNeuronCount()}")
        print(f"  Spikes: {brain.getTotalSpikeCount()}")
        print(f"  Development: {brain.getDevelopmentalStage()}")
        print(f"  Curiosity: {agent.getCuriosityLevel():.3f}")
        
        # Simulate time passing (brain continues learning)
        print(f"Simulating additional learning...")
        for step in range(steps // 2):
            world.update(0.1)
            agent.processSensoryInput(world.getSensoryPercept())
            brain.step(step + steps // 2)
            action = agent.decodeMotorCommand()
            world.applyMotorCommand(action, world.getSimulationTime())
            # Different reward pattern
            reward = 0.05 + (step % 3) * 0.02  # Variable reward
            agent.applyRewardModulation(reward, 0.0)
            agent.updateDevelopment(0.1)
        
        # Load checkpoint
        brain.reset()
        brain.load(checkpoint_file)
        # Recreate agent and world for reload demo
        agent = pynlm.createAgentBrain(brain)
        world = pynlm.createSimpleWorld()
        world.configure(width=20, height=20, visionWidth=8, visionHeight=8)
        world.reset()
        agent.initialize(world)
        
        print(f"\nAfter checkpoint reload:")
        print(f"  Neurons: {brain.getTotalNeuronCount()}")
        print(f"  Spikes: {brain.getTotalSpikeCount()}")
        print(f"  Development: {brain.getDevelopmentalStage()}")
        print(f"  Curiosity: {agent.getCuriosityLevel():.3f}")
        print(f"  Learned preference: {agent.getLearnedPreference():.3f}")
        
        # Verify checkpoint integrity
        os.remove(checkpoint_file)
        print(f"Checkpoint file cleaned up")
        
        return {
            "checkpoint_saved": True,
            "checkpoint_loaded": True,
            "spike_consistency": brain.getTotalSpikeCount() > 0,
            "neuron_consistency": brain.getTotalNeuronCount() == 500
        }
    
    def run_text_demo(self, steps: int = 200) -> Dict[str, Any]:
        """Demonstrate text-as-a-sense feature"""
        print("=== NLM Text-as-a-Sense Demo ===")
        
        brain, agent, world = self.create_complete_demo()
        
        # Create multiple text messages to demonstrate learning
        text_messages = [
            "hello",
            "world", 
            "nlm",
            "neural",
            "learning",
            "machine"
        ]
        
        stats = {
            "text_messages": text_messages,
            "thought_traces": [],
            "encoding_success": 0,
            "total_steps": steps
        }
        
        for step in range(steps):
            # Update world
            world.update(0.1)
            
            # Show a text message every 50 steps
            if step % 50 == 0 and step > 0:
                message = text_messages[(step // 50) % len(text_messages)]
                percept = world.getSensoryPercept()
                percept.setText(message)
                agent.processSensoryInput(percept)
                print(f"  Text input: '{message}'")
                
                # Record thought trace
                stats["thought_traces"].append(agent.getThoughtTrace())
                stats["encoding_success"] += 1
            else:
                agent.processSensoryInput(world.getSensoryPercept())
            
            # Brain processes
            brain.step(step)
            
            # Simple action
            action = agent.decodeMotorCommand()
            world.applyMotorCommand(action, world.getSimulationTime())
            
            if step % 50 == 0:
                print(f"  Step {step}: curiosity={agent.getCuriosityLevel():.3f}")
        
        print(f"\n=== Text Demo Complete ===")
        print(f"Successfully encoded {stats['encoding_success']} text messages")
        print(f"Sample thought trace: {stats['thought_traces'][0] if stats['thought_traces'] else 'N/A'}")
        
        return stats
    
    def run_config_demo(self, config_type: str = "advanced") -> Dict[str, Any]:
        """Demonstrate different configuration options"""
        print(f"=== NLM Configuration Demo ({config_type}) ===")
        
        configs = {
            "basic": {
                "brain.neuron_count": 200,
                "brain.synapse_density": 0.05,
                "plasticity.stdp.enable": True,
                "neuromod.curiosity.enable": False
            },
            "balanced": {
                "brain.neuron_count": 500,
                "brain.synapse_density": 0.1,
                "plasticity.stdp.learning_rate": 0.001,
                "plasticity.hebbian.enable": True,
                "neuromod.curiosity.enable": True,
                "neuromod.novelty.enable": True
            },
            "advanced": {
                "brain.neuron_count": 1000,
                "brain.synapse_density": 0.15,
                "plasticity.stdp.tau_plus": 30.0,
                "plasticity.stdp.tau_minus": 30.0,
                "plasticity.hebbian.enable": True,
                "plasticity.structural.enable": True,
                "neuromod.curiosity.enable": True,
                "neuromod.novelty.enable": True,
                "neuromod.dopamine.scale": 1.5,
                "brain.initial_weight_mean": 0.6,
                "brain.initial_weight_std": 0.15
            }
        }
        
        if config_type not in configs:
            print(f"Available config types: {list(configs.keys())}")
            return {"error": f"Unknown config type: {config_type}"}
        
        # Create configuration
        config = pynlm.createDefaultConfig()
        for key, value in configs[config_type].items():
            config.set(key, value)
        
        # Create brain with custom config
        brain = pynlm.createBrain(config)
        brain.initialize()
        
        agent = pynlm.createAgentBrain(brain)
        world = pynlm.createSimpleWorld()
        world.configure(width=15, height=15, visionWidth=6, visionHeight=6)
        world.reset()
        agent.initialize(world)
        
        # Run demo
        print(f"Configuration applied:")
        for key, value in configs[config_type].items():
            print(f"  {key}: {value}")
        
        print(f"\nBrain statistics:")
        print(f"  Neurons: {brain.getTotalNeuronCount()}")
        print(f"  Synapses: {brain.getTotalSynapseCount()}")
        print(f"  Expected initial weights: mean={configs[config_type]['brain.initial_weight_mean']}, "
              f"std={configs[config_type]['brain.initial_weight_std']}")
        
        return {
            "config_type": config_type,
            "neurons": brain.getTotalNeuronCount(),
            "synapses": brain.getTotalSynapseCount(),
            "configuration_applied": True
        }
    
    def print_help(self):
        """Print help information"""
        print("=== NLM Command-Line Interface ===")
        print(f"Version: {self.version}")
        print()
        print("Available commands:")
        print("  demo --type [basic|learning|checkpoint|text|config]")
        print("  benchmark --type [spiking|memory|plasticity]")
        print("  experiment --type [custom] --config <file>")
        print("  config --action [list|show|save|load] --name <name>")
        print("  help --show this help")
        print()
        print("Examples:")
        print("  nlm-cli demo --type basic --steps 100")
        print("  nlm-cli demo --type learning --steps 500")
        print("  nlm-cli demo --type checkpoint")
        print("  nlm-cli demo --type text")
        print("  nlm-cli config --action list")
        print()

def main():
    parser = argparse.ArgumentParser(
        description="NLM (Neural Learning Machine) Command-Line Interface",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  nlm-cli demo --type basic --steps 100
  nlm-cli demo --type learning --steps 500
  nlm-cli demo --type checkpoint
  nlm-cli config --action list

For more help: nlm-cli help
        ""
    )
    
    parser.add_argument('--version', action='version', 
                       version='NLM CLI %(version)s')
    
    subparsers = parser.add_subparsers(dest='command', help='Available commands')
    
    # Demo command
    demo_parser = subparsers.add_parser('demo', help='Run NLM demos')
    demo_parser.add_argument('--type', choices=['basic', 'learning', 'checkpoint', 'text', 'config'],
                           default='basic', help='Demo type')
    demo_parser.add_argument('--steps', type=int, default=100, help='Number of simulation steps')
    demo_parser.add_argument('--config', help='Configuration file path')
    demo_parser.add_argument('--output', help='Output file for results')
    
    # Benchmark command
    benchmark_parser = subparsers.add_parser('benchmark', help='Run benchmarks')
    benchmark_parser.add_argument('--type', choices=['spiking', 'memory', 'plasticity'],
                               default='spiking', help='Benchmark type')
    benchmark_parser.add_argument('--iterations', type=int, default=10, help='Number of iterations')
    benchmark_parser.add_argument('--output', help='Output file for benchmark results')
    
    # Experiment command
    experiment_parser = subparsers.add_parser('experiment', help='Run custom experiments')
    experiment_parser.add_argument('--type', default='custom', help='Experiment type')
    experiment_parser.add_argument('--config', required=True, help='Experiment configuration file')
    experiment_parser.add_argument('--output', help='Output file for experiment results')
    
    # Config command
    config_parser = subparsers.add_parser('config', help='Manage configurations')
    config_parser.add_argument('--action', choices=['list', 'show', 'save', 'load'],
                            default='list', help='Configuration action')
    config_parser.add_argument('--name', help='Configuration name')
    config_parser.add_argument('--output', help='Output file')
    
    # Help command
    help_parser = subparsers.add_parser('help', help='Show help information')
    
    args = parser.parse_args()
    
    if not args.command:
        parser.print_help()
        return
    
    cli = NLMCommandLineInterface()
    
    try:
        if args.command == 'demo':
            if args.type == 'basic':
                result = cli.run_basic_demo(args.steps)
            elif args.type == 'learning':
                result = cli.run_learning_demo(args.steps)
            elif args.type == 'checkpoint':
                result = cli.run_checkpoint_demo(args.steps)
            elif args.type == 'text':
                result = cli.run_text_demo(args.steps)
            elif args.type == 'config':
                result = cli.run_config_demo(args.config if args.config else 'advanced')
            
            if args.output:
                with open(args.output, 'w') as f:
                    json.dump(result, f, indent=2)
                print(f"Results saved to {args.output}")
            
        elif args.command == 'benchmark':
            print(f"Benchmark command not yet implemented: {args.type}")
            result = {"status": "not_implemented", "type": args.type}
            
            if args.output:
                with open(args.output, 'w') as f:
                    json.dump(result, f, indent=2)
        
        elif args.command == 'experiment':
            print(f"Experiment command not yet implemented: {args.type}")
            result = {"status": "not_implemented", "type": args.type, "config": args.config}
            
            if args.output:
                with open(args.output, 'w') as f:
                    json.dump(result, f, indent=2)
        
        elif args.command == 'config':
            if args.action == 'list':
                print("Available configurations:")
                print("  - basic: Minimal setup with 200 neurons")
                print("  - balanced: Standard setup with 500 neurons")
                print("  - advanced: Full-featured setup with 1000 neurons")
                print("  - custom: User-defined configuration")
                result = {"action": "list", "configs": ["basic", "balanced", "advanced", "custom"]}
            
            elif args.action == 'show':
                if args.name == 'basic':
                    print("Basic configuration:")
                    print("  - Neurons: 200")
                    print("  - Synapse density: 0.05")
                    print("  - Plasticity: STDP enabled")
                    print("  - Curiosity: Disabled")
                elif args.name == 'balanced':
                    print("Balanced configuration:")
                    print("  - Neurons: 500")
                    print("  - Synapse density: 0.1")
                    print("  - Plasticity: STDP + Hebbian enabled")
                    print("  - Curiosity: Enabled")
                elif args.name == 'advanced':
                    print("Advanced configuration:")
                    print("  - Neurons: 1000")
                    print("  - Synapse density: 0.15")
                    print("  - Plasticity: All features enabled")
                    print("  - Neuromodulation: Full set enabled")
                else:
                    print(f"Configuration '{args.name}' not found")
                    result = {"action": "show", "error": f"Unknown configuration: {args.name}"}
            
            result = {"status": "completed", "action": args.action}
        
        elif args.command == 'help':
            cli.print_help()
            result = {"action": "help", "status": "displayed"}
        
        print(f"\nCommand '{args.command}' completed successfully!")
        
    except Exception as e:
        print(f"Error: {str(e)}")
        import traceback
        traceback.print_exc()
        sys.exit(1)

if __name__ == '__main__':
    main()

__all__ = ['NLMCommandLineInterface', 'main']
