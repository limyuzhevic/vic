#!/usr/bin/env bash

# NLM Command Line Interface
# Comprehensive interface for controlling and configuring the NLM (Neural Learning Machine)

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Configuration file
CONFIG_FILE="configs/default.cfg"

# Logging
LOG_LEVEL="INFO"
LOG_FILE="nlm.log"

