# NLM Environment Configuration
# This file provides example environment variables for NLM configuration

# === Core Configuration ===
NLM_SIMULATION_TIMESTEP=0.001
NLM_NEURON_COUNT=1000
NLM_REGION_COUNT=2
NLM_RANDOM_SEED=42

# === Neural Dynamics ===
NLM_NEURON_RESTING_POTENTIAL=-70.0
NLM_NEURON_THRESHOLD=-55.0
NLM_NEURON_REFACTORY_PERIOD=9

# === Plasticity ===
NLM_PLASTICITY_LEARNING_RATE=0.01
NLM_STDP_LTP_WEIGHT=0.01
NLM_STDP_LTD_WEIGHT=0.012
NLM_STDP_TIME_CONSTANT=20.0

# === Neuromodulation ===
NLM_DOPAMINE_BASELINE=0.1
NLM_CURIOUSITY_BASELINE=0.0
NLM_NOVELTY_BASELINE=0.0

# === Logging ===
NLM_LOG_LEVEL=INFO
NLM_LOG_TO_FILE=false
NLM_LOG_FILENAME=nlm.log

# === Performance ===
NLM_USE_SIMD=true
NLM_USE_PARALLEL=false
NLM_THREAD_COUNT=0

# === Development ===
NLM_DEVELOPMENT_STAGE=Adult
NLM_CRITICAL_PERIOD_START=100
NLM_CRITICAL_PERIOD_DURATION=500

# === Environment ===
NLM_ENVIRONMENT_NAME=GridWorld
NLM_ENVIRONMENT_WIDTH=10
NLM_ENVIRONMENT_HEIGHT=10