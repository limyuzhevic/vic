```python
import pynlm
import time
import statistics

def optimization_comparison():
    """Compare different optimization strategies and configurations."""
    
    print("=== NLM Optimization Comparison ===\n")
    
    # Test different configurations
    test_configs = [
        {
            "name": "Standard",
            "config": {
                "brain.neuron_count": 2000,
                "brain.synapse_density": 0.1,
                "plasticity.stdp.learning_rate": 0.001,
                "plasticity.hebbian.enable": True,
                "plasticity.structural.enable": True,
                "neuromod.curiosity.enable": True,
                "neuromod.novelty.enable": True
            }
        },
        {
            "name": "High Performance",
            "config": {
                "brain.neuron_count": 3000,
                "brain.synapse_density": 0.15,
                "plasticity.stdp.learning_rate": 0.002,
                "plasticity.hebbian.enable": True,
                "plasticity.structural.enable": True,
                "neuromod.curiosity.enable": True,
                "neuromod.novelty.enable": True,
                "simulation_timestep": 0.0005
            }
        },
        {
            "name": "Memory Efficient",
            "config": {
                "brain.neuron_count": 1500,
                "brain.synapse_density": 0.08,
                "plasticity.stdp.learning_rate": 0.0005,
                "plasticity.hebbian.enable": True,
                "plasticity.structural.enable": False,
                "neuromod.curiosity.enable": False,
                "neuromod.novelty.enable": False
            }
        }
    ]
    
    results = {}
    
    for test_case in test_configs:
        print(f"Testing {test_case['name']} configuration...")
        
        # Create config
        config_json = json.dumps(test_case['config'])
        config = pynlm.createDefaultConfig()
        config.loadJson(config_json)
        
        # Create world and agent
        world = pynlm.createSimpleWorld()
        world.configure(width=20, height=20, visionWidth=8, visionHeight=8)
        world.reset()
        
        brain = pynlm.createBrain(config)
        agent = pynlm.createAgentBrain(brain)
        
        # Configure agent learning
        agent.enableRewardModulation(True)
        agent.enableStructuralPlasticity(test_case['config'].get("plasticity.structural.enable", False))
        agent.enableDevelopment(True)
        agent.enableCuriosity(test_case['config'].get("neuromod.curiosity.enable", True))
        
        # Run multiple test sessions
        session_results = []
        for session in range(5):
            print(f"  Session {session + 1}/5...")
            
            start_time = time.time()
            
            # Run session
            for step in range(500):
                world.update(0.1)
                agent.processSensoryInput(world.getSensoryPercept())
                brain.step(step)
                world.applyMotorCommand(agent.decodeMotorCommand(), world.getSimulationTime())
                agent.applyRewardModulation(world.getSensoryPercept().getInternal()[0], 0.0)
                agent.updateDevelopment(0.1)
            
            duration = time.time() - start_time
            
            session_data = {
                "session": session + 1,
                "duration": duration,
                "steps_per_second": 500 / duration,
                "final_curiosity": agent.getCuriosityLevel(),
                "final_concepts": agent.getConceptCount(),
                "final_prediction_error": agent.getPredictionError(),
                "total_spikes": brain.getTotalSpikeCount()
            }
            
            session_results.append(session_data)
            
            # Reset for next session
            agent.reset()
            brain.reset()
            world.reset()
        
        # Calculate statistics for this configuration
        durations = [s['duration'] for s in session_results]
        speeds = [s['steps_per_second'] for s in session_results]
        curiosity_levels = [s['final_curiosity'] for s in session_results]
        concept_counts = [s['final_concepts'] for s in session_results]
        
        config_stats = {
            "name": test_case['name'],
            "sessions": 5,
            "avg_duration": statistics.mean(durations),
            "avg_speed": statistics.mean(speeds),
            "speed_std": statistics.stdev(speeds) if len(speeds) > 1 else 0,
            "avg_curiosity": statistics.mean(curiosity_levels),
            "avg_concepts": statistics.mean(concept_counts),
            "min_concepts": min(concept_counts),
            "max_concepts": max(concept_counts),
            "avg_prediction_error": statistics.mean([s['final_prediction_error'] for s in session_results])
        }
        
        results[test_case['name']] = config_stats
        
        print(f"    Average duration: {config_stats['avg_duration']:.2f}s")
        print(f"    Average speed: {config_stats['avg_speed']:.0f} ± {config_stats['speed_std']:.0f} steps/s")
        print(f"    Average concepts: {config_stats['avg_concepts']:.1f}")
        print(f"    Average curiosity: {config_stats['avg_curiosity']:.3f}")
        print()
    
    # Comparative analysis
    print("=== Optimization Analysis ===")
    
    print("\nPerformance Comparison:")
    for name, stats in results.items():
        print(f"  {name:15s}: {stats['avg_speed']:8.0f} ± {stats['speed_std']:6.0f} steps/s, "
              f"{stats['avg_concepts']:5.1f} ± {((stats['max_concepts'] - stats['min_concepts'])/2):5.1f} concepts")
    
    print("\nLearning Effectiveness:")
    for name, stats in results.items():
        print(f"  {name:15s}: {stats['avg_concepts']:5.1f} concepts, "
              f"{stats['avg_curiosity']:5.3f} curiosity, "
              f"{stats['avg_prediction_error']:6.3f} prediction error")
    
    # Determine best configuration
    best_speed = max(results.keys(), key=lambda k: results[k]['avg_speed'])
    best_concepts = max(results.keys(), key=lambda k: results[k]['avg_concepts'])
    
    print(f"\nBest Configuration:")
    print(f"  Best speed: {best_speed} ({results[best_speed]['avg_speed']:.0f} steps/s)")
    print(f"  Best concepts: {best_concepts} ({results[best_concepts]['avg_concepts']:.1f} concepts)")
    
    # Save comparison results
    comparison_results = {
        "configurations": list(results.keys()),
        "stats": results,
        "best_speed": best_speed,
        "best_concepts": best_concepts
    }
    
    with open('optimization_comparison_results.json', 'w') as f:
        json.dump(comparison_results, f, indent=2)
    
    print(f"\nComparison results saved to 'optimization_comparison_results.json'")
    
    return results

if __name__ == "__main__":
    import json
    results = optimization_comparison()
