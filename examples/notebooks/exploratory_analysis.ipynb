import sys
import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from datetime import datetime
import json
import pickle
from pathlib import Path
import warnings
warnings.filterwarnings('ignore')

# Import NLM modules
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

class NLMDataExplorer:
    """Class for exploring NLM simulation data."""
    
    def __init__(self, data_directory="data"):
        """Initialize NLM data explorer.
        
        Args:
            data_directory: Directory containing NLM simulation data
        """
        self.data_directory = Path(data_directory)
        self.data_files = []
        self.metadata = {}
        self.analysis_results = {}
        
    def discover_data_files(self):
        """Discover NLM data files in the data directory."""
        self.data_files = []
        
        # Find all data files
        for file_path in self.data_directory.rglob("*.nld"):
            self.data_files.append(file_path)
            
        for file_path in self.data_directory.rglob("*.json"):
            self.data_files.append(file_path)
            
        for file_path in self.data_directory.rglob("*.csv"):
            self.data_files.append(file_path)
            
        for file_path in self.data_directory.rglob("*.pkl"):
            self.data_files.append(file_path)
            
        print(f"Discovered {len(self.data_files)} data files")
        return self.data_files
        
    def load_metadata(self):
        """Load metadata from data files."""
        self.metadata = {}
        
        for file_path in self.data_files:
            try:
                if file_path.suffix == ".json":
                    with open(file_path, 'r') as f:
                        metadata = json.load(f)
                        self.metadata[str(file_path)] = metadata
                elif file_path.suffix == ".nld":
                    # Load NLM brain data
                    import pynlm
                    brain = pynlm.createBrain(pynlm.createDefaultConfig())
                    brain.load(str(file_path))
                    
                    self.metadata[str(file_path)] = {
                        'neuron_count': brain.getTotalNeuronCount(),
                        'synapse_count': brain.getTotalSynapseCount(),
                        'firing_count': brain.getFiringNeuronCount(),
                        'avg_firing_rate': brain.getAverageFiringRate(),
                        'total_spikes': brain.getTotalSpikeCount(),
                        'developmental_stage': brain.getDevelopmentalStage()
                    }
            except Exception as e:
                print(f"Error loading metadata from {file_path}: {e}")
                
        return self.metadata
        
    def explore_data_files(self):
        """Explore data files and provide summary statistics."""
        print("\n" + "="*60)
        print("NLM DATA EXPLORATION")
        print("="*60)
        
        if not self.data_files:
            print("No data files found. Run discover_data_files() first.")
            return
            
        print(f"\nFound {len(self.data_files)} data files:")
        for i, file_path in enumerate(self.data_files, 1):
            print(f"  {i}. {file_path.name}")
            
        print(f"\nMetadata Summary:")
        for file_path, meta in self.metadata.items():
            filename = Path(file_path).name
            print(f"\n  {filename}:")
            for key, value in meta.items():
                print(f"    {key}: {value}")
                
    def plot_neuron_distribution(self):
        """Plot neuron count distribution across data files."""
        if not self.metadata:
            print("Load metadata first. Run load_metadata().")
            return
            
        fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 5))
        
        # Neuron count histogram
        neuron_counts = [meta.get('neuron_count', 0) for meta in self.metadata.values()]
        ax1.hist(neuron_counts, bins=10, alpha=0.7, color='skyblue', edgecolor='black')
        ax1.set_xlabel('Neuron Count')
        ax1.set_ylabel('Frequency')
        ax1.set_title('Neuron Count Distribution')
        ax1.axvline(np.mean(neuron_counts), color='red', linestyle='--', label=f'Mean: {np.mean(neuron_counts):.1f}')
        ax1.legend()
        
        # Synapse-to-neuron ratio
        ratios = []
        for meta in self.metadata.values():
            neuron_count = meta.get('neuron_count', 1)
            synapse_count = meta.get('synapse_count', 0)
            ratio = synapse_count / neuron_count
            ratios.append(ratio)
            
        ax2.hist(ratios, bins=10, alpha=0.7, color='lightgreen', edgecolor='black')
        ax2.set_xlabel('Synapse-to-Neuron Ratio')
        ax2.set_ylabel('Frequency')
        ax2.set_title('Connectivity Distribution')
        ax2.axvline(np.mean(ratios), color='red', linestyle='--', label=f'Mean: {np.mean(ratios):.3f}')
        ax2.legend()
        
        plt.tight_layout()
        plt.show()
        
    def plot_firing_statistics(self):
        """Plot firing statistics across data files."""
        if not self.metadata:
            print("Load metadata first. Run load_metadata().")
            return
            
        fig, ((ax1, ax2), (ax3, ax4)) = plt.subplots(2, 2, figsize=(16, 12))
        
        # Active neuron count
        active_counts = [meta.get('firing_count', 0) for meta in self.metadata.values()]
        ax1.hist(active_counts, bins=10, alpha=0.7, color='salmon', edgecolor='black')
        ax1.set_xlabel('Active Neuron Count')
        ax1.set_ylabel('Frequency')
        ax1.set_title('Active Neuron Distribution')
        ax1.axvline(np.mean(active_counts), color='red', linestyle='--', label=f'Mean: {np.mean(active_counts):.1f}')
        ax1.legend()
        
        # Average firing rate
        avg_rates = [meta.get('avg_firing_rate', 0) for meta in self.metadata.values()]
        ax2.hist(avg_rates, bins=10, alpha=0.7, color='gold', edgecolor='black')
        ax2.set_xlabel('Average Firing Rate (Hz)')
        ax2.set_ylabel('Frequency')
        ax2.set_title('Firing Rate Distribution')
        ax2.axvline(np.mean(avg_rates), color='red', linestyle='--', label=f'Mean: {np.mean(avg_rates):.3f}')
        ax2.legend()
        
        # Total spike count
        total_spikes = [meta.get('total_spikes', 0) for meta in self.metadata.values()]
        ax3.hist(total_spikes, bins=10, alpha=0.7, color='plum', edgecolor='black')
        ax3.set_xlabel('Total Spike Count')
        ax3.set_ylabel('Frequency')
        ax3.set_title('Spike Count Distribution')
        ax3.axvline(np.mean(total_spikes), color='red', linestyle='--', label=f'Mean: {np.mean(total_spikes):.1f}')
        ax3.legend()
        
        # E/I ratio
        ei_ratios = [meta.get('ei_ratio', 1.0) for meta in self.metadata.values() if 'ei_ratio' in meta]
        if ei_ratios:
            ax4.hist(ei_ratios, bins=10, alpha=0.7, color='cyan', edgecolor='black')
            ax4.set_xlabel('Excitation-Inhibition Ratio')
            ax4.set_ylabel('Frequency')
            ax4.set_title('E/I Ratio Distribution')
            ax4.axvline(np.mean(ei_ratios), color='red', linestyle='--', label=f'Mean: {np.mean(ei_ratios):.3f}')
            ax4.legend()
        else:
            ax4.text(0.5, 0.5, 'E/I ratio not available\nin metadata', 
                    ha='center', va='center', transform=ax4.transAxes)
            ax4.set_title('E/I Ratio Distribution')
        
        plt.tight_layout()
        plt.show()
        
    def plot_development_analysis(self):
        """Plot developmental stage analysis."""
        if not self.metadata:
            print("Load metadata first. Run load_metadata().")
            return
            
        fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 5))
        
        # Developmental stage distribution
        developmental_stages = []
        for meta in self.metadata.values():
            if 'developmental_stage' in meta:
                developmental_stages.append(meta['developmental_stage'])
                
        if developmental_stages:
            stage_counts = {}
            for stage in developmental_stages:
                stage_counts[str(stage)] = stage_counts.get(str(stage), 0) + 1
                
            ax1.bar(stage_counts.keys(), stage_counts.values(), alpha=0.7, color='lightblue', edgecolor='black')
            ax1.set_xlabel('Developmental Stage')
            ax1.set_ylabel('Count')
            ax1.set_title('Developmental Stage Distribution')
        else:
            ax1.text(0.5, 0.5, 'Developmental stage data\nnot available in metadata', 
                    ha='center', va='center', transform=ax1.transAxes)
            ax1.set_title('Developmental Stage Distribution')
        
        # Correlation between neuron count and developmental stage
        if developmental_stages:
            neuron_counts = [meta.get('neuron_count', 0) for meta in self.metadata.values()]
            
            # Create correlation matrix
            data = np.column_stack([neuron_counts, developmental_stages])
            corr_matrix = np.corrcoef(data.T)
            
            im = ax2.imshow(corr_matrix, cmap='RdBu', vmin=-1, vmax=1, aspect='auto')
            ax2.set_xticks([0, 1])
            ax2.set_xticklabels(['Neuron Count', 'Dev Stage'])
            ax2.set_yticks([0, 1])
            ax2.set_yticklabels(['Neuron Count', 'Dev Stage'])
            ax2.set_title('Correlation Matrix')
            
            # Add correlation values
            for i in range(len(corr_matrix)):
                for j in range(len(corr_matrix[i])):
                    ax2.text(j, i, f'{corr_matrix[i, j]:.2f}', 
                            ha='center', va='center', color='black')
            
            plt.colorbar(im, ax=ax2)
        else:
            ax2.text(0.5, 0.5, 'Correlation analysis\nrequires developmental data', 
                    ha='center', va='center', transform=ax2.transAxes)
            ax2.set_title('Correlation Analysis')
        
        plt.tight_layout()
        plt.show()
        
    def analyze_similarities(self, file1_index, file2_index):
        """Analyze similarities between two data files."""
        if file1_index >= len(self.data_files) or file2_index >= len(self.data_files):
            print(f"Invalid file indices. Available files: 0-{len(self.data_files)-1}")
            return
            
        file1 = self.data_files[file1_index]
        file2 = self.data_files[file2_index]
        
        print(f"\nAnalyzing similarities between:")
        print(f"  File 1: {file1.name}")
        print(f"  File 2: {file2.name}")
        
        # Get metadata for both files
        meta1 = self.metadata.get(str(file1), {})
        meta2 = self.metadata.get(str(file2), {})
        
        print(f"\nMetadata Comparison:")
        print(f"  File 1:")
        for key, value in meta1.items():
            print(f"    {key}: {value}")
            
        print(f"  File 2:")
        for key, value in meta2.items():
            print(f"    {key}: {value}")
            
        # Calculate similarity metrics
        similarities = {}
        for key in set(meta1.keys()) | set(meta2.keys()):
            val1 = meta1.get(key, 0)
            val2 = meta2.get(key, 0)
            
            if isinstance(val1, (int, float)) and isinstance(val2, (int, float)):
                # Normalize values
                max_val = max(val1, val2, 1)
                norm1 = val1 / max_val
                norm2 = val2 / max_val
                similarity = 1 - abs(norm1 - norm2)
                similarities[key] = similarity
                
        print(f"\nSimilarity Scores:")
        for key, similarity in similarities.items():
            print(f"  {key}: {similarity:.3f}")
            
        if similarities:
            overall_similarity = np.mean(list(similarities.values()))
            print(f"\nOverall Similarity: {overall_similarity:.3f}")
            
            # Plot similarity radar chart
            self.plot_similarity_radar(similarities)
            
    def plot_similarity_radar(self, similarities):
        """Plot similarity radar chart."""
        categories = list(similarities.keys())
        values = list(similarities.values())
        
        # Complete the radar chart
        values += values[:1]
        categories += categories[:1]
        
        angles = np.linspace(0, 2 * np.pi, len(categories), endpoint=False)
        angles += np.pi / 2
        
        fig, ax = plt.subplots(figsize=(10, 8), subplot_kw={'projection': 'polar'})
        
        # Plot radar chart
        ax.plot(angles, values, 'o-', linewidth=2, label='Similarity')
        ax.fill(angles, values, alpha=0.25)
        
        # Set category labels
        ax.set_xticks(angles[:-1])
        ax.set_xticklabels(categories)
        
        ax.set_ylim(0, 1)
        ax.set_title('Similarity Analysis Radar Chart', fontsize=14, pad=20)
        ax.legend(loc='upper right', bbox_to_anchor=(1.3, 1.3))
        
        plt.tight_layout()
        plt.show()
        
    def generate_data_summary_report(self):
        """Generate comprehensive data summary report."""
        print("\n" + "="*60)
        print("NLM DATA EXPLORATION SUMMARY REPORT")
        print("="*60)
        
        if not self.data_files:
            print("No data files found.")
            return
            
        print(f"\nDataset Overview:")
        print(f"  Number of data files: {len(self.data_files)}")
        print(f"  Data file types: {
            len([f for f in self.data_files if f.suffix == '.nld'])},
            {len([f for f in self.data_files if f.suffix == '.json'])},
            {len([f for f in self.data_files if f.suffix == '.csv'])},
            {len([f for f in self.data_files if f.suffix == '.pkl'])}
        }")
        
        if self.metadata:
            print(f"\nNeural Network Statistics:")
            neuron_counts = [meta.get('neuron_count', 0) for meta in self.metadata.values()]
            if neuron_counts:
                print(f"    Neuron count range: {min(neuron_counts)} - {max(neuron_counts)}")
                print(f"    Average neuron count: {np.mean(neuron_counts):.1f}")
                print(f"    Median neuron count: {np.median(neuron_counts):.1f}")
                print(f"    Neuron count std: {np.std(neuron_counts):.1f}")
                
            synapse_counts = [meta.get('synapse_count', 0) for meta in self.metadata.values()]
            if synapse_counts:
                print(f"    Synapse count range: {min(synapse_counts)} - {max(synapse_counts)}")
                print(f"    Average synapse count: {np.mean(synapse_counts):.1f}")
                print(f"    Synapse-to-neuron ratio: {np.mean([s/n for s, n in zip(synapse_counts, neuron_counts) if n > 0]):.3f}")
                
            active_counts = [meta.get('firing_count', 0) for meta in self.metadata.values()]
            if active_counts:
                print(f"    Active neuron count range: {min(active_counts)} - {max(active_counts)}")
                print(f"    Average active neuron count: {np.mean(active_counts):.1f}")
                
            avg_rates = [meta.get('avg_firing_rate', 0) for meta in self.metadata.values()]
            if avg_rates:
                print(f"    Average firing rate range: {min(avg_rates):.3f} - {max(avg_rates):.3f}")
                print(f"    Average firing rate: {np.mean(avg_rates):.3f} Hz")
                print(f"    Firing rate std: {np.std(avg_rates):.3f} Hz")
                
            total_spikes = [meta.get('total_spikes', 0) for meta in self.metadata.values()]
            if total_spikes:
                print(f"    Total spike count range: {min(total_spikes)} - {max(total_spikes)}")
                print(f"    Average total spikes: {np.mean(total_spikes):.1f}")
                
        print(f"\nData Quality Assessment:")
        missing_metadata = 0
        for file_path, meta in self.metadata.items():
            if not meta:
                missing_metadata += 1
                
        print(f"    Files with missing metadata: {missing_metadata}")
        print(f"    Files with complete metadata: {len(self.metadata) - missing_metadata}")
        
        print(f"\nRecommendations:")
        print(f"  1. Standardize data collection methods for consistent comparisons")
        print(f"  2. Include developmental stage information for age-related analysis")
        print(f"  3. Record environmental conditions for context")
        print(f"  4. Implement quality control checks for data validation")
        
    def save_analysis_results(self, filename="nlm_analysis_results.json"):
        """Save analysis results to file."""
        results = {
            'data_files': [str(f) for f in self.data_files],
            'metadata': self.metadata,
            'analysis_results': self.analysis_results,
            'timestamp': datetime.now().isoformat()
        }
        
        with open(filename, 'w') as f:
            json.dump(results, f, indent=2)
            
        print(f"Analysis results saved to {filename}")
        
    def load_analysis_results(self, filename="nlm_analysis_results.json"):
        """Load analysis results from file."""
        try:
            with open(filename, 'r') as f:
                results = json.load(f)
                
            self.data_files = [Path(f) for f in results['data_files']]
            self.metadata = results['metadata']
            self.analysis_results = results.get('analysis_results', {})
            
            print(f"Analysis results loaded from {filename}")
            return True
        except Exception as e:
            print(f"Error loading analysis results: {e}")
            return False


