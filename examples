# NLM Analysis Tool - Example Usage Script
# Demonstrates the use of the NLM analysis tools for common tasks

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $*"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $*"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $*" >&2
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $*"
}

# Display usage information
show_usage() {
    cat << EOF
NLM Analysis Tool - Example Usage
==================================

This script demonstrates common usage patterns for the NLM analysis tools.

Usage: $0 [OPTIONS]

Options:
  --help, -h              Show this help message
  --version, -v           Show version information
  --demo                  Run demo examples
  --quickstats            Show quick statistics for brain files
  --connectivty          Analyze connectivity
  --visualize             Generate visualizations

Examples:
  $0 --demo                    Run demo examples
  $0 --quickstats brain.ncl     Show quick stats
  $0 --connectivity brain.ncl  Analyze connectivity
  $0 --visualize brain.ncl      Generate visualizations

EOF
}

# Show version information
