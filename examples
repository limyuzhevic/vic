### 3. Advanced Examples

#### 3.1 Multi-Agent System
```python
"""NLM Advanced Example 1: Multi-Agent System"""

import pynlm
import random

def multi_agent_example():
    """Create a system with multiple interacting agents"""
    print("=== NLM Advanced Example 1: Multi-Agent System ===")
    
    # Create multiple brains with different configurations
    num_agents = 5
    brains = []
    worlds = []
    agents = []
    
    for i in range(num_agents):
        # Vary brain sizes and configurations
        config = pynlm.createDefaultConfig()
        config.set("neuron_count", 200 + i * 100)  # Different sizes
        config.set("region_count", 2)
        
        brain = pynlm.createBrain(config)
        brain.initialize()
        
        world = pynlm.createSimpleWorld()
        world.configure(width=30, height=30, visionWidth=10, visionHeight=10)
        world.reset()
        
        agent = pynlm.createAgentBrain(brain)
        agent.initialize(world)
        
        # Enable learning for all agents
        agent.enableRewardModulation(True)
        agent.enableCuriosity(True)
        
        brains.append(brain)
        worlds.append(world)
        agents.append(agent)
    
    print(f"Created multi-agent system with {num_agents} agents")
    
    # Set different starting positions for each agent
    for i, world in enumerate(worlds):
        world.setAgentStart(random.uniform(5, 25), random.uniform(5, 25))
    
    # Run parallel simulation
    num_steps = 100
    print(f"Running parallel simulation for {num_steps} steps...")
    
    for step in range(num_steps):
        for i, (brain, world, agent) in enumerate(zip(brains, worlds, agents)):
            # Each agent can have different behaviors
            if step % 3 == 0:  # Every 3rd step, try different action
                action = agent.decodeMotorCommand()
            else:
                action = agent.decodeMotorCommand()
            
            # Apply action
            world.applyMotorCommand(action, world.getSimulationTime())
            
            # Update world
            world.update(0.1)
            
            # Process sensory input
            percept = world.getSensoryPercept()
            agent.processSensoryInput(percept)
            
            # Brain thinks
            brain.step(step)
    
    # Analyze multi-agent results
    print(f"\n=== Multi-Agent Results ===")
    total_neurons = sum(b.getTotalNeuronCount() for b in brains)
    total_spikes = sum(b.getTotalSpikeCount() for b in brains)
    
    print(f"✓ Multi-agent simulation completed!")
    print(f"  - Agents: {num_agents}")
    print(f"  - Total neurons: {total_neurons}")
    print(f"  - Total spikes: {total_spikes}")
    print(f"  - Average firing rate: {total_spikes/max(100, num_steps):.1f} Hz per agent")
    
    # Show individual agent statistics
    print(f"\nIndividual agent statistics:")
    for i, (brain, agent) in enumerate(zip(brains, agents)):
        print(f"  Agent {i+1}: {brain.getTotalNeuronCount()} neurons, "
              f"stage={brain.getDevelopmentalStage().name}, "
              f"curiosity={agent.getCuriosityLevel():.2f}")
    
    print("\n✓ Multi-agent system example completed successfully!")
    print()

if __name__ == "__main__":
    multi_agent_example()
```

