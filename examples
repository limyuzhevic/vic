import pynlm
import time
import statistics

def benchmark_configuration(name, config_dict, steps=100):
    """Benchmark a single configuration."""
    print(f"Benchmarking {name}...")
    
    # Create configuration
    config = pynlm.createDefaultConfig()
    for key, value in config_dict.items():
        if isinstance(value, int):
            config.setInt(key, value)
        elif isinstance(value, float):
            config.setFloat(key, value)
        elif isinstance(value, bool):
            config.setBool(key, value)
    
    # Create and initialize brain
    brain = pynlm.createBrain(config)
    brain.initialize()
    
    # Run benchmark
    times = []
    for step in range(steps):
        step_start = time.time()
        brain.step(step)
        times.append(time.time() - step_start)
    
    # Calculate metrics
    avg_time = statistics.mean(times)
    steps_per_second = steps / sum(times)
    
    return {
        'name': name,
        'avg_step_time': avg_time,
        'steps_per_second': steps_per_second,
        'total_spikes': brain.getTotalSpikeCount(),
        'firing_rate': brain.getAverageFiringRate()
    }

def main():
    print("Running Performance Benchmarks")
    
    # Define configurations to benchmark
    configurations = [
        {'name': 'Small', 'brain.neuron_count': 200, 'brain.connection_probability': 0.05},
        {'name': 'Medium', 'brain.neuron_count': 1000, 'brain.connection_probability': 0.1},
        {'name': 'Large', 'brain.neuron_count': 2000, 'brain.connection_probability': 0.15}
    ]
    
    # Run benchmarks
    results = []
    for config_dict in configurations:
        result = benchmark_configuration(config_dict['name'], config_dict)
        results.append(result)
        print(f"  {result['name']}: {result['steps_per_second']:.1f} steps/sec, "
              f"avg {result['avg_step_time']*1000:.2f} ms/step, "
              f"{result['total_spikes']} spikes")
    
    # Print summary
    print(f"\nBenchmark Summary:")
    fastest = max(results, key=lambda x: x['steps_per_second'])
    most_spikes = max(results, key=lambda x: x['total_spikes'])
    
    print(f"Fastest: {fastest['name']} ({fastest['steps_per_second']:.1f} steps/sec)")
    print(f"Most spikes: {most_spikes['name']} ({most_spikes['total_spikes']} spikes)")

if __name__ == "__main__":
    main()
