### Template 1: Simple Simulation

```python
"""
Simple Neural Network Simulation

This example demonstrates the basic steps of NLM simulation:
1. Create and configure a brain
2. Initialize the brain
3. Run simulation steps
4. Analyze results
"""

import pynlm

def simple_simulation(neuron_count=1000, steps=100):
    """Run a simple simulation with specified parameters."""
    print(f"Running simple simulation with {neuron_count} neurons for {steps} steps")
    
    # Create configuration
    config = pynlm.createDefaultConfig()
    config.setInt("brain.neuron_count", neuron_count)
    
    # Create and initialize brain
    brain = pynlm.createBrain(config)
    brain.initialize()
    
    # Run simulation
    for step in range(steps):
        brain.step(step)
    
    # Analyze results
    return {
        'total_neurons': brain.getTotalNeuronCount(),
        'total_spikes': brain.getTotalSpikeCount(),
        'firing_neurons': brain.getFiringNeuronCount(),
        'average_firing_rate': brain.getAverageFiringRate(),
        'e_i_ratio': brain.getExcitationInhibitionRatio()
    }

if __name__ == "__main__":
    results = simple_simulation()
    print("Simulation Results:")
    for key, value in results.items():
        print(f"  {key}: {value}")
```

### Template 2: Agent Simulation

```python
"""
Complete Agent-Environment Simulation

This example demonstrates a complete agent simulation with:
- Brain with neural processing
- World environment for interaction
- Agent interface between brain and world
- Learning and adaptation capabilities
"""

import pynlm

def run_agent_simulation(world_config=None, brain_config=None, steps=500):
    """Run a complete agent simulation."""
    print(f"Running agent simulation for {steps} steps")
    
    # Setup world
    world = pynlm.createSimpleWorld()
    if world_config:
        world.configure(**world_config)
    else:
        world.configure(width=20, height=20, visionWidth=8, visionHeight=8)
    world.reset()
    world.setAgentStart(10.0, 10.0)
    
    # Setup brain
    config = pynlm.createDefaultConfig()
    if brain_config:
        for key, value in brain_config.items():
            if isinstance(value, int):
                config.setInt(key, value)
            elif isinstance(value, float):
                config.setFloat(key, value)
            elif isinstance(value, bool):
                config.setBool(key, value)
    
    brain = pynlm.createBrain(config)
    brain.initialize()
    
    # Setup agent
    agent = pynlm.createAgentBrain(brain)
    agent.initialize(world)
    
    # Enable learning capabilities
    agent.enableRewardModulation(True)
    agent.enableCuriosity(True)
    agent.enableDevelopment(True)
    
    # Run simulation
    for step in range(steps):
        world.update(0.1)
        
        # Get sensory input
        percept = world.getSensoryPercept()
        
        # Process sensory input
        agent.processSensoryInput(percept)
        
        # Brain processes input and produces output
        brain.step(step)
        
        # Agent decides on action
        action = agent.decodeMotorCommand()
        
        # Apply action in world
        world.applyMotorCommand(action, world.getSimulationTime())
        
        # Apply reward modulation
        reward = 0.0  # Could be computed from percept
        agent.applyRewardModulation(reward, 0.0)
        
        # Update development
        agent.updateDevelopment(0.1)
        
        # Log progress
        if step % 100 == 0:
            print(f"Step {step}:")
            print(f"  Firing neurons: {brain.getFiringNeuronCount()}")
            print(f"  Curiosity level: {agent.getCuriosityLevel():.3f}")
            print(f"  Novelty level: {agent.getNoveltyLevel():.3f}")
            print(f"  Dev stage: {brain.getDevelopmentalStage()}")
    
    return {
        'world_stats': {
            'width': world.getWidth(),
            'height': world.getHeight(),
            'simulation_time': world.getSimulationTime()
        },
        'brain_stats': {
            'total_neurons': brain.getTotalNeuronCount(),
            'total_spikes': brain.getTotalSpikeCount(),
            'firing_rate': brain.getAverageFiringRate(),
            'e_i_ratio': brain.getExcitationInhibitionRatio(),
            'development_stage': brain.getDevelopmentalStage()
        },
        'agent_stats': {
            'curiosity': agent.getCuriosityLevel(),
            'novelty': agent.getNoveltyLevel(),
            'prediction_error': agent.getPredictionError(),
            'neuromodulation': agent.getNeuromodulationLevel()
        }
    }

if __name__ == "__main__":
    # Run with custom configurations
    world_config = {
        'width': 30,
        'height': 30,
        'visionWidth': 12,
        'visionHeight': 12
    }
    
    brain_config = {
        'brain.neuron_count': 2000,
        'plasticity.stdp.learning_rate': 0.01,
        'neuromod.curiosity.scale': 1.5
    }
    
    results = run_agent_simulation(world_config, brain_config, steps=500)
    
    print("\nFinal Results:")
    print(f"World: {results['world_stats']['width']}x{results['world_stats']['height']}")
    print(f"Neurons: {results['brain_stats']['total_neurons']}")
    print(f"Spikes: {results['brain_stats']['total_spikes']}")
    print(f"Firing rate: {results['brain_stats']['firing_rate']:.3f}")
    print(f"Curiosity: {results['agent_stats']['curiosity']:.3f}")
```

### Template 3: Learning Example

```python
"""
Learning and Plasticity Example

This example demonstrates how NLM learns through:
- Spike-Timing-Dependent Plasticity (STDP)
- Reward-modulated learning
- Developmental changes over time
- Memory consolidation
"""

import pynlm
import numpy as np

def learning_example():
    """Run learning example with measurable results."""
    print("Running learning example...")
    
    # Create configuration optimized for learning
    config = pynlm.createDefaultConfig()
    config.setInt("brain.neuron_count", 1000)
    config.setFloat("plasticity.stdp.learning_rate", 0.005)
    config.setFloat("neuromod.dopamine.scale", 1.0)
    config.setFloat("neuromod.curiosity.scale", 1.0)
    
    # Create brain
    brain = pynlm.createBrain(config)
    brain.initialize()
    
    # Create agent
    agent = pynlm.createAgentBrain(brain)
    world = pynlm.createSimpleWorld()
    world.configure(width=10, height=10, visionWidth=6, visionHeight=6)
    world.setAgentStart(5.0, 5.0)
    agent.initialize(world)
    
    # Enable all learning mechanisms
    agent.enableRewardModulation(True)
    agent.enableStructuralPlasticity(True)
    agent.enableDevelopment(True)
    agent.enableCuriosity(True)
    
    # Record initial state
    initial_spikes = brain.getTotalSpikeCount()
    initial_neurons = brain.getTotalNeuronCount()
    
    print(f"Initial state: {initial_spikes} spikes, {initial_neurons} neurons")
    
    # Run learning simulation
    learning_curve = []
    for episode in range(10):
        world.reset()
        agent.reset()
        
        episode_spikes = 0
        for step in range(100):
            world.update(0.1)
            
            # Get sensory input
            percept = world.getSensoryPercept()
            
            # Process and learn
            agent.processSensoryInput(percept)
            brain.step(step)
            
            # Act and learn from results
            action = agent.decodeMotorCommand()
            world.applyMotorCommand(action, world.getSimulationTime())
            
            # Get reward (simplified)
            reward = 1.0 if np.random.random() < 0.3 else 0.0
            agent.applyRewardModulation(reward, 0.0)
            
            # Update development
            agent.updateDevelopment(0.1)
            
            episode_spikes += brain.getTotalSpikeCount() - initial_spikes
        
        # Record learning metrics
        learning_curve.append({
            'episode': episode,
            'total_spikes': brain.getTotalSpikeCount(),
            'firing_rate': brain.getAverageFiringRate(),
            'curiosity': agent.getCuriosityLevel(),
            'novelty': agent.getNoveltyLevel(),
            'prediction_error': agent.getPredictionError()
        }n        
        print(f"Episode {episode}: {brain.getTotalSpikeCount()} spikes, "
              f"curiosity={agent.getCuriosityLevel():.3f}, "
              f"novelty={agent.getNoveltyLevel():.3f}")
    
    # Analyze learning results
    final_spikes = brain.getTotalSpikeCount() - initial_spikes
    spike_increase = final_spikes > 0
    
    print(f"\nLearning Results:")
    print(f"Total spike increase: {final_spikes}")
    print(f"Spike increase achieved: {spike_increase}")
    print(f"Average curiosity level: {np.mean([x['curiosity'] for x in learning_curve]):.3f}")
    print(f"Average novelty level: {np.mean([x['novelty'] for x in learning_curve]):.3f}")
    
    # Check if learning occurred
    learning_occurred = (
        spike_increase or 
        np.mean([x['curiosity'] for x in learning_curve]) > 0.1 or
        np.mean([x['novelty'] for x in learning_curve]) > 0.1
    )
    
    return {
        'learning_occurred': learning_occurred,
        'learning_curve': learning_curve,
        'final_spike_increase': final_spikes,
        'average_curiosity': np.mean([x['curiosity'] for x in learning_curve]),
        'average_novelty': np.mean([x['novelty'] for x in learning_curve])
    }

if __name__ == "__main__":
    learning_results = learning_example()
    
    if learning_results['learning_occurred']:
        print("\n✓ Learning successfully demonstrated!")
    else:
        print("\n⚠ Limited learning observed - may need more episodes or different configuration")
```

### Template 4: Performance Benchmark

```python
"""
Performance Benchmark Example

This example benchmarks NLM performance with different configurations:
- Measures simulation speed
- Tests memory efficiency
- Compares different parameter sets
- Identifies performance bottlenecks
"""

import pynlm
import time
import statistics
from typing import Dict, List

def benchmark_performance(configurations: List[Dict], steps: int = 100):
    """Benchmark NLM performance with different configurations."""
    print(f"Benchmarking NLM performance with {len(configurations)} configurations for {steps} steps")
    
    results = []
    
    for i, config_dict in enumerate(configurations):
        print(f"\nConfiguration {i+1}: {config_dict.get('name', 'unnamed')}")
        
        # Create configuration
        config = pynlm.createDefaultConfig()
        for key, value in config_dict.items():
            if key != 'name' and isinstance(value, int):
                config.setInt(key, value)
            elif key != 'name' and isinstance(value, float):
                config.setFloat(key, value)
            elif key != 'name' and isinstance(value, bool):
                config.setBool(key, value)
        
        # Create brain
        brain = pynlm.createBrain(config)
        brain.initialize()
        
        # Run benchmark
        times = []
        for step in range(steps):
            step_start = time.time()
            brain.step(step)
            step_time = time.time() - step_start
            times.append(step_time)
        
        # Calculate statistics
        avg_time = statistics.mean(times)
        min_time = min(times)
        max_time = max(times)
        std_time = statistics.stdev(times) if len(times) > 1 else 0.0
        
        # Performance metrics
        steps_per_second = steps / sum(times)
        neurons_per_ms = config_dict.get('brain.neuron_count', 0) / (sum(times) * 1000)
        
        result = {
            'name': config_dict.get('name', f'config_{i+1}'),
            'neuron_count': config_dict.get('brain.neuron_count', 0),
            'connection_probability': config_dict.get('brain.connection_probability', 0.0),
            'learning_rate': config_dict.get('plasticity.stdp.learning_rate', 0.0),
            'avg_step_time': avg_time,
            'min_step_time': min_time,
            'max_step_time': max_time,
            'std_step_time': std_time,
            'steps_per_second': steps_per_second,
            'neurons_per_ms': neurons_per_ms,
            'total_spikes': brain.getTotalSpikeCount(),
            'firing_rate': brain.getAverageFiringRate()
        }
        
        print(f"  Neurons: {result['neuron_count']}")
        print(f"  Steps/sec: {result['steps_per_second']:.1f}")
        print(f"  Avg step time: {result['avg_step_time']*1000:.2f} ms")
        print(f"  Total spikes: {result['total_spikes']}")
        
        results.append(result)
    
    return results

def print_benchmark_summary(results: List[Dict]):
    """Print benchmark summary."""
    if not results:
        return
    
    print(f"\n{'Benchmark Summary':^60}")
    print("=" * 60)
    print(f"{'Configuration':<20} {'Neurons':<10} {'Steps/sec':<12} {'Avg Time (ms)':<15} {'Total Spikes':<12}")
    print("-" * 60)
    
    for result in results:
        print(f"{result['name']:<20} {result['neuron_count']:<10} "
              f"{result['steps_per_second']:<12.1f} {result['avg_step_time']*1000:<15.2f} {result['total_spikes']:<12}")
    
    # Find best performer
    fastest = max(results, key=lambda x: x['steps_per_second'])
    most_neurons = max(results, key=lambda x: x['neuron_count'])
    
    print(f"\nBest Performance:")
    print(f"  Fastest: {fastest['name']} ({fastest['steps_per_second']:.1f} steps/sec)")
    print(f"  Most neurons: {most_neurons['name']} ({most_neurons['neuron_count']} neurons)")

if __name__ == "__main__":
    # Define configurations to benchmark
    configurations = [
        {
            'name': 'Small_Brain',
            'brain.neuron_count': 500,
            'brain.connection_probability': 0.05,
            'plasticity.stdp.learning_rate': 0.001
        },
        {
            'name': 'Medium_Brain',
            'brain.neuron_count': 1000,
            'brain.connection_probability': 0.1,
            'plasticity.stdp.learning_rate': 0.005
        },
        {
            'name': 'Large_Brain',
            'brain.neuron_count': 2000,
            'brain.connection_probability': 0.15,
            'plasticity.stdp.learning_rate': 0.01
        },
        {
            'name': 'High_Plasticity',
            'brain.neuron_count': 1000,
            'brain.connection_probability': 0.2,
            'plasticity.stdp.learning_rate': 0.02
        }
    ]
    
    # Run benchmark
    benchmark_results = benchmark_performance(configurations, steps=200)
    
    # Print summary
    print_benchmark_summary(benchmark_results)
```

