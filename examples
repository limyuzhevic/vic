"""NLM Beginner Example 1: Basic Brain Creation"""

import pynlm

def basic_brain_example():
    """Create and initialize a brain with default settings"""
    print("=== NLM Beginner Example 1: Basic Brain Creation ===")
    
    # Create brain with default configuration
    brain = pynlm.createBrain(pynlm.createDefaultConfig())
    
    # Always initialize before use
    brain.initialize()
    
    print(f"Created brain with {brain.getTotalNeuronCount()} neurons")
    print(f"Brain has {brain.getTotalSynapseCount()} synapses")
    print(f"Region count: {brain.getRegionCount()}")
    
    # Make brain think for several steps
    for step in range(10):
        brain.step(step)
        
        # Monitor brain activity
        if step % 5 == 0:
            print(f"Step {step}: {brain.getFiringNeuronCount()} neurons firing")
    
    print("✓ Basic brain creation example completed successfully!")
    print()

if __name__ == "__main__":
