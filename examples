  "test-type": "developmental-progression",
  "plasticity-modifiers": [1.5, 1.0, 0.5, 0.2],
  "development-stages": ["accelerated", "normal", "delayed"],
  "observation-frequency": 50,
  "output-format": "developmental-curve"
}
EOF

# Run development tests
./development_tester --config dev_test_config.json
```

