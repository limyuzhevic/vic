### Your First Brain Simulation

```python
# First Example: Basic Brain Simulation
# File: examples/basic_example.py

import pynlm
import time

def basic_brain_example():
    """Create and run a basic brain simulation."""
    
    print("=== NLM Basic Brain Simulation Example ===")
    
    # 1. Create configuration
    print("Creating brain configuration...")
    config = pynlm.createDefaultConfig()
    
    # 2. Create and initialize brain
    print("Creating and initializing brain...")
    brain = pynlm.createBrain(config)
    brain.initialize()
    
    # 3. Print initial statistics
    print(f"\nInitial brain statistics:")
    print(f"  Neurons: {brain.getTotalNeuronCount()}")
    print(f"  Synapses: {brain.getTotalSynapseCount()}")
    print(f"  Firing rate: {brain.getAverageFiringRate():.3f}")
    
    # 4. Run simulation
    print(f"\nRunning simulation for 100 steps...")
    start_time = time.time()
    
    for step in range(100):
        brain.step(step)
        
        # Log progress every 20 steps
        if step % 20 == 0:
            print(f"  Step {step}: {brain.getFiringNeuronCount()} firing neurons")
    
    end_time = time.time()
    
    # 5. Print final statistics
    print(f"\nSimulation completed in {end_time - start_time:.3f} seconds")
    print(f"\nFinal brain statistics:")
    print(f"  Total spikes: {brain.getTotalSpikeCount()}")
    print(f"  Average firing rate: {brain.getAverageFiringRate():.3f}")
    print(f"  E/I ratio: {brain.getExcitationInhibitionRatio():.3f}")
    
    # 6. Save brain state
    brain.save("basic_brain_checkpoint.bin")
    print(f"\nBrain state saved to 'basic_brain_checkpoint.bin'")
    
    print("\n=== Example Complete ===\n")

if __name__ == "__main__":
    basic_brain_example()
```

## Basic Brain Simulation

This example demonstrates the fundamental workflow of creating and using an NLM brain:

1. **Configuration**: Create and customize the brain's configuration
2. **Initialization**: Set up the neural network with specified parameters
3. **Simulation**: Run time steps to simulate neural activity
4. **Analysis**: Monitor and analyze brain activity statistics
5. **Persistence**: Save brain state for later use

## Agent-Based Learning

### Complete Agent Simulation

```python
# Second Example: Complete Agent Simulation
# File: examples/agent_example.py

import pynlm
import time

def agent_simulation_example():
    """Run a complete agent simulation with world interaction."""
    
    print("=== NLM Agent Simulation Example ===")
    
    # 1. Create configuration
    print("Creating brain configuration...")
    config = pynlm.createDefaultConfig()
    
    # 2. Create brain and agent
    print("Creating brain and agent brain interface...")
    brain = pynlm.createBrain(config)
    agent = pynlm.createAgentBrain(brain)
    
    # 3. Create and configure world
    print("Creating and configuring world...")
    world = pynlm.createSimpleWorld()
    world.configure(width=20, height=20, visionWidth=8, visionHeight=8)
    world.reset()
    world.setAgentStart(10.0, 10.0)
    
    # 4. Initialize agent with world
    print("Initializing agent with world...")
    agent.initialize(world)
    
    # 5. Enable subsystems
    print("Enabling agent subsystems...")
    agent.enableRewardModulation(True)
    agent.enableStructuralPlasticity(True)
    agent.enableDevelopment(True)
    agent.enableCuriosity(True)
    
    # 6. Print initial status
    print(f"\nInitial agent status:")
    print(f"  Reward modulation: {agent.isRewardModulationEnabled()}")
    print(f"  Structural plasticity: {agent.isStructuralPlasticityEnabled()}")
    print(f"  Development: {agent.isDevelopmentEnabled()}")
    print(f"  Curiosity: {agent.isCuriosityEnabled()}")
    print(f"  Developmental stage: {agent.getDevelopmentalStage()}")
    
    # 7. Run simulation
    print(f"\nRunning agent simulation for 500 steps...")
    start_time = time.time()
    
    for step in range(500):
        # Update world
        world.update(timestep=0.1)
        
        # Get sensory input from world
        percept = world.getSensoryPercept()
        
        # Process sensory input in brain
        agent.processSensoryInput(percept)
        
        # Run brain step
        brain.step(step)
        
        # Decode motor command from brain activity
        motor_cmd = agent.decodeMotorCommand()
        
        # Apply motor command to world
        world.applyMotorCommand(motor_cmd, world.getSimulationTime())
        
        # Apply reward modulation
        reward = world.getSensoryPercept().getInternal()[0] if world.getSensoryPercept().getInternal() else 0.0
        agent.applyRewardModulation(reward, 0.0)
        
        # Update development
        agent.updateDevelopment(0.1)
        
        # Print progress every 100 steps
        if step % 100 == 0:
            print(f"\nStep {step}:")
            print(f"  Firing neurons: {brain.getFiringNeuronCount()}")
            print(f"  Curiosity level: {agent.getCuriosityLevel():.3f}")
            print(f"  Novelty level: {agent.getNoveltyLevel():.3f}")
            print(f"  Prediction error: {agent.getPredictionError():.3f}")
            print(f"  Developmental stage: {agent.getDevelopmentalStage()}")
    
    end_time = time.time()
    
    # 8. Print final status
    print(f"\nSimulation completed in {end_time - start_time:.3f} seconds")
    print(f"\nFinal agent status:")
    print(f"  Total curiosity: {agent.getCuriosityLevel():.3f}")
    print(f"  Total novelty: {agent.getNoveltyLevel():.3f}")
    print(f"  Final prediction error: {agent.getPredictionError():.3f}")
    print(f"  Final developmental stage: {agent.getDevelopmentalStage()}")
    print(f"  Final firing neurons: {brain.getFiringNeuronCount()}")
    
    print("\n=== Agent Simulation Complete ===\n")

if __name__ == "__main__":
    agent_simulation_example()
```

## Advanced Features

### Advanced Learning with Batch Operations

```python
# Third Example: Advanced Learning Features
# File: examples/advanced_example.py

import pynlm
import time

def advanced_features_example():
    """Demonstrate advanced NLM features."""
    
    print("=== NLM Advanced Features Example ===")
    
    # 1. Create configuration with advanced settings
    print("Creating advanced configuration...")
    config = pynlm.createDefaultConfig()
    
    # 2. Create brain
    brain = pynlm.createBrain(config)
    brain.initialize()
    
    # 3. Demonstrate batch operations
    print("\n1. Demonstrating batch operations...")
    
    # Batch current injection
    injections = [
        (pynlm.INVALID_NEURON_ID, 10.0f),  # Skip invalid ID
        (pynlm.INVALID_NEURON_ID, 15.0f),  # Skip invalid ID
    ]
    # Add some valid injections (we'll need to get actual neuron IDs)
    if brain.getTotalNeuronCount() > 0:
        # Get first region's neurons
        for region_id in brain.getRegionIds():
            region = brain.getRegion(region_id)
            if region:
                neurons = region->getAllNeurons();
                if (!neurons.empty()) {
                    injections.push_back({neurons[0]->getId(), 20.0f});
                    break;
                }
            }
        }
    
    successful_injections = brain.injectCurrentSafe(injections)
    print(f"   Successfully injected current into {successful_injections} neurons")
    
    # 4. Run batch steps
    print("\n2. Running batch simulation steps...")
    start_time = time.time()
    brain.runBatchSteps(1000, 0.001f)
    end_time = time.time()
    print(f"   Completed 1000 steps in {end_time - start_time:.3f} seconds")
    
    # 5. Demonstrate learning rate control
    print("\n3. Demonstrating learning rate control...")
    brain.setLearningRate(0.02, 0.01, 0.005)
    print("   Set learning rates for STDP, Hebbian, and structural plasticity")
    
    # 6. Enable/disable plasticity
    print("\n4. Demonstrating plasticity control...")
    brain.enableAllPlasticity()
    print("   Enabled all plasticity mechanisms")
    
    brain.disableAllPlasticity()
    print("   Disabled all plasticity mechanisms")
    
    # 7. Performance optimization
    print("\n5. Demonstrating performance optimization...")
    brain.optimizeConfiguration()
    print("   Optimized brain configuration for balanced learning")
    
    # 8. Get comprehensive statistics
    print("\n6. Getting comprehensive statistics...")
    stats = brain.getNeuronStats()
    print("   Neuron statistics:")
    for key, value in stats.items():
        print(f"     {key}: {value}")
    
    # 9. Configuration validation
    print("\n7. Demonstrating configuration validation...")
    validation_errors = brain.getConfig().validate()
    if validation_errors.empty():
        print("   Configuration is valid")
    else {
        print("   Configuration validation errors:")
        for error in validation_errors:
            print(f"     - {error}")
    
    print("\n=== Advanced Features Complete ===\n")

if __name__ == "__main__":
    advanced_features_example()
```

## Performance Optimization

### High-Performance Simulation

```python
# Fourth Example: Performance Optimization
# File: examples/performance_example.py

import pynlm
import time

def performance_optimization_example():
    """Demonstrate performance optimization techniques."""
    
    print("=== NLM Performance Optimization Example ===")
    
    # 1. Create optimized configuration
    print("Creating performance-optimized configuration...")
    config = pynlm.createDefaultConfig()
    
    # Optimize for performance
    config.set("neuron_count", 2000)
    config.set("connection_probability", 0.05)
    config.set("plasticity_learning_rate", 0.001)
    
    # 2. Create brain and enable optimizations
    brain = pynlm.createBrain(config)
    brain.initialize()
    
    # 3. Measure performance
    print("\nMeasuring simulation performance...")
    
    # Warm-up run
    print("  Warming up...")
    brain.runBatchSteps(100, 0.001f)
    
    # Performance test
    print("  Running performance test (5000 steps)...")
    start_time = time.time()
    brain.runBatchSteps(5000, 0.001f)
    end_time = time.time()
    
    elapsed = end_time - start_time
    steps_per_second = 5000 / elapsed
    
    print(f"  Completed 5000 steps in {elapsed:.3f} seconds")
    print(f"  Performance: {steps_per_second:.0f} steps/second")
    print(f"  Average step time: {elapsed/5000*1000:.3f} ms")
    
    # 4. Memory efficiency demonstration
    print("\nMemory efficiency demonstration...")
    stats = brain.getNeuronStats()
    memory_efficiency = stats["total_synapses"] / brain.getTotalNeuronCount()
    print(f"  Synapses per neuron: {memory_efficiency:.2f}")
    
    # 5. Scaling demonstration
    print("\nScaling demonstration...")
    brain_sizes = [500, 1000, 2000]
    times = []
    
    for size in brain_sizes:
        print(f"  Testing with {size} neurons...")
        test_config = pynlm.createDefaultConfig()
        test_config.set("neuron_count", size)
        
        test_brain = pynlm.createBrain(test_config)
        test_brain.initialize()
        
        test_start = time.time()
        test_brain.runBatchSteps(1000, 0.001f)
        test_end = time.time()
        
        test_time = test_end - test_start
        times.append(test_time)
        print(f"    Completed in {test_time:.3f} seconds")
    
    # 6. Performance summary
    print("\nPerformance Summary:")
    print("  Step execution time (ms):")
    for i, size in enumerate(brain_sizes):
        step_time_ms = times[i] / 1000 * 1000
        print(f"    {size} neurons: {step_time_ms:.3f} ms/step")
    
    print("\n=== Performance Optimization Complete ===\n")

if __name__ == "__main__":
    performance_optimization_example()
```

## Configuration Management

### Custom Configuration Examples

```python
# Fifth Example: Custom Configuration
# File: examples/custom_config.py

import pynlm
import json

def custom_configuration_example():
    """Demonstrate custom configuration management."""
    
    print("=== NLM Custom Configuration Example ===")
    
    # 1. Create configuration from scratch
    print("1. Creating configuration from scratch...")
    config = pynlm.createDefaultConfig()
    
    # Customize configuration
    config.set("neuron_count", 1500)
    config.set("connection_probability", 0.08)
    config.set("plasticity_learning_rate", 0.005)
    config.set("stdp_ltp_weight", 0.03)
    config.set("stdp_ltd_weight", 0.025)
    config.set("development_synaptogenesis_rate", 0.002)
    
    print(f"   Created custom config with {config.get("neuron_count"):,} neurons")
    
    # 2. Save configuration to file
    print("\n2. Saving configuration to file...")
    config.saveToFile("custom_config.json")
    print("   Configuration saved to 'custom_config.json'")
    
    # 3. Load configuration from file
    print("\n3. Loading configuration from file...")
    loaded_config = pynlm.createDefaultConfig()
    if loaded_config.loadFromFile("custom_config.json"):
        print("   Configuration loaded successfully")
        print(f"   Loaded neuron count: {loaded_config.get("neuron_count"):,}")
    
    # 4. Merge configurations
    print("\n4. Merging configurations...")
    base_config = pynlm.createDefaultConfig()
    base_config.set("neuron_count", 1000)
    
    # Add some values from loaded config
    if loaded_config.has("connection_probability") {
        base_config.set("connection_probability", loaded_config.get("connection_probability")));
    }
    
    print("   Configurations merged")
    
    # 5. Configuration validation
    print("\n5. Validating configurations...")
    
    # Validate custom config
    errors = config.validate()
    if errors.empty():
        print("   Custom configuration is valid")
    else {
        print("   Custom configuration errors:")
        for error in errors:
            print(f"     - {error}")
    }
    
    # Validate loaded config
    errors = loaded_config.validate()
    if errors.empty():
        print("   Loaded configuration is valid")
    else {
        print("   Loaded configuration errors:")
        for error in errors:
            print(f"     - {error}")
    
    # 6. Convert to dictionary
    print("\n6. Converting configuration to dictionary...")
    config_dict = config.toDict()
    print(f"   Configuration has {len(config_dict)} keys")
    print("   Sample keys:", list(config_dict.keys())[:5])
    
    # 7. Load from dictionary
    print("\n7. Loading configuration from dictionary...")
    dict_config = pynlm.createDefaultConfig()
    dict_config.fromDict(config_dict)
    print(f"   Successfully loaded {len(config_dict)} configuration values")
    
    # 8. Configuration summary
    print("\n8. Configuration summary...")
    print(config.summary())
    
    print("\n=== Custom Configuration Complete ===\n")

if __name__ == "__main__":
    custom_configuration_example()
```

## Troubleshooting

### Common Issues and Solutions

#### Example 1: Brain Initialization Error

```python
# File: examples/troubleshooting_example.py

import pynlm
import sys

def troubleshoot_initialization():
    """Troubleshoot brain initialization issues."""
    
    print("=== NLM Troubleshooting Example ===")
    
    # 1. Try different configuration approaches
    print("1. Testing different configuration approaches...")
    
    # Approach 1: Use default config
    print("   Approach 1: Using default config...")
    try:
        config1 = pynlm.createDefaultConfig()
        brain1 = pynlm.createBrain(config1)
        if brain1.initialize()) {
            print("   ✓ Success with default config")
            brain1.logStatus();
        }
    } catch (const std::exception& e) {
        print(f"   ✗ Error with default config: {e.what()}")
    }
    
    # Approach 2: Create minimal config
    print("\n   Approach 2: Creating minimal config...")
    try {
        config2 = pynlm.createDefaultConfig()
        config2.set("neuron_count", 100);
        config2.set("region_count", 1);
        
        brain2 = pynlm.createBrain(config2);
        if (brain2.initialize()) {
            print("   ✓ Success with minimal config");
            brain2.logStatus();
        }
    } catch (const std::exception& e) {
        print(f"   ✗ Error with minimal config: {e.what()}")
    }
    
    # Approach 3: Check configuration validity
    print("\n   Approach 3: Checking configuration validity...")
    try {
        config3 = pynlm.createDefaultConfig()
        validation_errors = config3.validate()
        if (!validation_errors.empty()) {
            print("   Configuration validation errors:")
            for error in validation_errors:
                print(f"     - {error}")
        } else {
            print("   Configuration is valid")
            
            brain3 = pynlm.createBrain(config3);
            if (brain3.initialize()) {
                print("   ✓ Success with valid config");
            } else {
                print("   ✗ Initialization failed despite valid config");
            }
        }
    } catch (const std::exception& e) {
        print(f"   ✗ Error checking config: {e.what()}")
    }
    
    # 2. Demonstrate safe operations
    print("\n2. Demonstrating safe operations...")
    try {
        config4 = pynlm.createDefaultConfig()
        brain4 = pynlm.createBrain(config4);
        brain4.initialize();
        
        print("   Testing safe step execution...")
        brain4.runBatchSteps(100, 0.001f);
        print("   ✓ Safe step execution completed")
        
        print("   Testing safe current injection...")
        injections = [];
        successful = brain4.injectCurrentSafe(injections);
        print(f"   ✓ Safe current injection completed ({successful} successful injections)");
        
    } catch (const std::exception& e) {
        print(f"   ✗ Error in safe operations: {e.what()}")
    }
    
    # 3. Demonstrate recovery mechanisms
    print("\n3. Demonstrating recovery mechanisms...")
    try {
        config5 = pynlm.createDefaultConfig()
        brain5 = pynlm.createBrain(config5);
        brain5.initialize();
        
        // Simulate reset error
        print("   Testing reset with recovery...")
        // In a real implementation, we would simulate a reset error
        brain5.resetWithRecovery();
        print("   ✓ Reset with recovery completed")
        
    } catch (const std::exception& e) {
        print(f"   ✗ Error in recovery mechanisms: {e.what()}")
    }
    
    print("\n=== Troubleshooting Complete ===\n")

if __name__ == "__main__":
    troubleshoot_initialization()
```

## API Reference

### Core Classes

#### Brain Class
- **Methods**: `initialize()`, `initializeWithValidation()`, `step()`, `stepSafe()`
- **Properties**: `neuron_count`, `synapse_count`, `firing_rate`, `total_spikes`
- **Advanced**: `runBatchSteps()`, `getNeuronStats()`, `enableAllPlasticity()`, `disableAllPlasticity()`

#### Config Class
- **Methods**: `loadFromFile()`, `saveToFile()`, `has()`, `getKeys()`
- **Advanced**: `validate()`, `validateAndThrow()`, `getWithDefault()`

#### AgentBrain Class
- **Methods**: `initialize()`, `processSensoryInput()`, `decodeMotorCommand()`
- **Properties**: `curiosity_level`, `novelty_level`, `prediction_error`
- **Advanced**: `enableAllSystems()`, `disableAllSystems()`, `updateAllSystems()`

### Helper Classes

#### SimpleWorld Class
- **Methods**: `configure()`, `reset()`, `update()`, `applyMotorCommand()`
- **Properties**: `width`, `height`, `simulation_time`

