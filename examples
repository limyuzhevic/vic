# Parse command line arguments
parse_args() {
    while [ $# -gt 0 ]; do
        case $1 in
            --help|-h)
                show_usage
                exit 0
                ;;
            --version|-v)
                show_version
                exit 0
                ;;
            --demo)
                shift
                run_demo
                exit 0
                ;;
            --quickstats)
                shift
                if [ $# -eq 0 ]; then
                    echo "Error: Brain file required for --quickstats" >&2
                    show_usage >&2
                    exit 1
                fi
                show_quick_stats "$1"
                shift
                exit 0
                ;;
            --connectivity)
                shift
                if [ $# -eq 0 ]; then
                    echo "Error: Brain file required for --connectivity" >&2
                    show_usage >&2
                    exit 1
                fi
                show_connectivity_analysis "$1"
                shift
                exit 0
                ;;
            --visualize)
                shift
                if [ $# -eq 0 ]; then
                    echo "Error: Brain file required for --visualize" >&2
                    show_usage >&2
                    exit 1
                fi
                local output_dir="./visualizations"
                if [ $# -ge 2 ]; then
                    output_dir="$2"
                fi
                generate_visualizations "$1" "$output_dir"
                shift
                if [ $# -ge 2 ]; then
                    shift
                fi
                exit 0
                ;;
            *)
                echo "Error: Unknown option: $1" >&2
                show_usage >&2
                exit 1
                ;;
        esac
    done
    
    show_usage
}

# Main function
main() {
    # Parse arguments
    parse_args "$@"
}

# Execute main function
main "$@"