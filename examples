#### 1.2 First Complete Simulation
```python
"""NLM Beginner Example 2: First Complete Simulation"""

import pynlm

def complete_simulation_example():
    """Run a complete brain-in-world simulation"""
    print("=== NLM Beginner Example 2: First Complete Simulation ===")
    
    # Create all components
    brain = pynlm.createBrain(pynlm.createDefaultConfig())
    brain.initialize()
    
    world = pynlm.createSimpleWorld()
    world.configure(width=15, height=15, visionWidth=6, visionHeight=6)
    world.reset()
    
    agent = pynlm.createAgentBrain(brain)
    agent.initialize(world)
    
    print(f"Setup complete:")
    print(f"  - Brain: {brain.getTotalNeuronCount()} neurons")
    print(f"  - World: {world.getWidth()}x{world.getHeight()} grid")
    print(f"  - Agent: Connected to brain and world")
    
    # Run the simulation loop
    num_steps = 100
    print(f"\nRunning simulation for {num_steps} steps...")
    
    for step in range(num_steps):
        # 1. Update world state
        world.update(0.1)
        
        # 2. Get sensory input
        percept = world.getSensoryPercept()
        
        # 3. Process sensory input
        agent.processSensoryInput(percept)
        
        # 4. Brain thinks
        brain.step(step)
        
        # 5. Brain produces action
        action = agent.decodeMotorCommand()
        
        # 6. Apply action in world
        world.applyMotorCommand(action, world.getSimulationTime())
        
        # Optional: monitor progress
        if (step + 1) % 25 == 0:
            print(f"  Step {step + 1}/{num_steps}: "
                  f"{brain.getFiringNeuronCount()} neurons firing, "
                  f"{brain.getTotalSpikeCount()} total spikes")
    
    # Final results
    print(f"\n=== Simulation Results ===")
    print(f"✓ Simulation completed successfully!")
    print(f"  - Total steps: {num_steps}")
    print(f"  - Neurons firing: {brain.getFiringNeuronCount()}")
    print(f"  - Total spikes: {brain.getTotalSpikeCount()}")
    print(f"  - Average firing rate: {brain.getAverageFiringRate():.2f} Hz")
    print(f"  - Development stage: {brain.getDevelopmentalStage().name}")
    print()

if __name__ == "__main__":
    complete_simulation_example()
```

### 2. Intermediate Examples

#### 2.1 Learning Agent
```python
"""NLM Intermediate Example 1: Learning Agent"""

import pynlm

def learning_agent_example():
    """Create an agent that learns from experience"""
    print("=== NLM Intermediate Example 1: Learning Agent ===")
    
    # Setup brain with learning capabilities
    config = pynlm.createDefaultConfig()
    brain = pynlm.createBrain(config)
    brain.initialize()
    
    # Setup world
    world = pynlm.createSimpleWorld()
    world.configure(width=20, height=20, visionWidth=8, visionHeight=8)
    world.reset()
    
    # Create agent and enable learning
    agent = pynlm.createAgentBrain(brain)
    agent.initialize(world)
    
    # Enable all learning features
    agent.enableRewardModulation(True)
    agent.enableCuriosity(True)
    agent.enableStructuralPlasticity(True)
    agent.enableDevelopment(True)
    
    print("Learning agent initialized with:")
    print("  - Reward modulation: enabled")
    print("  - Curiosity-driven exploration: enabled")
    print("  - Structural plasticity: enabled")
    print("  - Developmental progression: enabled")
    
    # Extended simulation with learning
    num_steps = 300
    print(f"\nRunning learning simulation for {num_steps} steps...")
    
    for step in range(num_steps):
        world.update(0.1)
        agent.processSensoryInput(world.getSensoryPercept())
        brain.step(step)
        action = agent.decodeMotorCommand()
        world.applyMotorCommand(action, world.getSimulationTime())
        
        # Monitor learning progress
        if step % 50 == 0:
            stage = brain.getDevelopmentalStage()
            curiosity = agent.getCuriosityLevel()
            novelty = agent.getNoveltyLevel()
            print(f"  Step {step}: Stage={stage.name}, "
                  f"Curiosity={curiosity:.2f}, Novelty={novelty:.2f}")
    
    # Learning analysis
    print(f"\n=== Learning Results ===")
    print(f"✓ Learning agent completed {num_steps} steps of experience!")
    print(f"  - Final development stage: {brain.getDevelopmentalStage().name}")
    print(f"  - Final curiosity level: {agent.getCuriosityLevel():.2f}")
    print(f"  - Final novelty level: {agent.getNoveltyLevel():.2f}")
    print(f"  - Final prediction error: {agent.getPredictionError():.2f}")
    print(f"  - Learning occurred: {'Yes' if brain.getDevelopmentalStage().value > 0 else 'No'}")
    print()

if __name__ == "__main__":
    learning_agent_example()
```

#### 2.2 Brain State Management
```python
"""NLM Intermediate Example 2: Brain State Management"""

import pynlm
import time
import os

def brain_state_management_example():
    """Save and load brain states for persistent learning"""
    print("=== NLM Intermediate Example 2: Brain State Management ===")
    
    # Create and train a brain
    brain = pynlm.createBrain(pynlm.createDefaultConfig())
    brain.initialize()
    
    world = pynlm.createSimpleWorld()
    world.configure(width=10, height=10, visionWidth=6, visionHeight=6)
    world.reset()
    
    agent = pynlm.createAgentBrain(brain)
    agent.initialize(world)
    
    # Enable learning for this example
    agent.enableRewardModulation(True)
    
    print("Training brain for 200 steps...")
    for step in range(200):
        world.update(0.1)
        agent.processSensoryInput(world.getSensoryPercept())
        brain.step(step)
        action = agent.decodeMotorCommand()
        world.applyMotorCommand(action, world.getSimulationTime())
    
    # Save brain state
    save_path = "trained_brain.nlm"
    brain.save(save_path)
    print(f"✓ Brain state saved to: {save_path}")
    
    # Show brain statistics before reset
    print(f"\nBrain statistics before reset:")
    print(f"  - Total neurons: {brain.getTotalNeuronCount()}")
    print(f"  - Total synapses: {brain.getTotalSynapseCount()}")
    print(f"  - Total spikes: {brain.getTotalSpikeCount()}")
    print(f"  - Development stage: {brain.getDevelopmentalStage().name}")
    
    # Reset brain and load saved state
    brain.reset()
    brain.load(save_path)
    
    print(f"\nAfter loading saved brain:")
    print(f"  - Brain state restored from file")
    print(f"  - Development stage preserved: {brain.getDevelopmentalStage().name}")
    
    # Clean up
    if os.path.exists(save_path):
        os.remove(save_path)
        print(f"✓ Temporary brain file cleaned up")
    
    print("\n✓ Brain state management example completed successfully!")
    print()

if __name__ == "__main__":
    brain_state_management_example()
