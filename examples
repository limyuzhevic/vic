### 4. Performance and Benchmarking

#### 4.1 Performance Test
```python
"""NLM Performance Benchmark Example"""

import pynlm
import time

def performance_benchmark_example():
    """Benchmark different brain configurations for performance"""
    print("=== NLM Performance Benchmark Example ===")
    
    # Test configurations
    test_configs = [
        {"name": "Small", "neurons": 100, "regions": 1},
        {"name": "Medium", "neurons": 500, "regions": 2},
        {"name": "Large", "neurons": 1000, "regions": 3},
    ]
    
    results = []
    
    for config_spec in test_configs:
        print(f"\nTesting {config_spec['name']} brain ({config_spec['neurons']} neurons)...")
        
        # Create configuration
        config = pynlm.createDefaultConfig()
        config.set("neuron_count", config_spec['neurons'])
        config.set("region_count", config_spec['regions'])
        
        # Time brain creation
        start_time = time.time()
        brain = pynlm.createBrain(config)
        init_time = time.time()
        
        brain.initialize()
        init_total_time = time.time()
        
        # Create world and agent
        world = pynlm.createSimpleWorld()
        world.configure(width=20, height=20, visionWidth=8, visionHeight=8)
        world.reset()
        
        agent = pynlm.createAgentBrain(brain)
        agent.initialize(world)
        
        # Time simulation
        steps = 50
        sim_start = time.time()
        
        for step in range(steps):
            world.update(0.1)
            agent.processSensoryInput(world.getSensoryPercept())
            brain.step(step)
            action = agent.decodeMotorCommand()
            world.applyMotorCommand(action, world.getSimulationTime())
        
        sim_time = time.time() - sim_start
        
        # Record results
        total_time = time.time() - start_time
        results.append({
            'name': config_spec['name'],
            'neurons': config_spec['neurons'],
            'regions': config_spec['regions'],
            'creation_time': init_time - start_time,
            'init_total_time': init_total_time - start_time,
            'simulation_time': sim_time,
            'steps': steps,
            'spikes': brain.getTotalSpikeCount(),
            'avg_firing_rate': brain.getAverageFiringRate()
        })
        
        print(f"  ✓ {config_spec['name']} brain completed in {total_time:.2f}s")
        print(f"    - Creation: {results[-1]['creation_time']:.3f}s")
        print(f"    - Init: {results[-1]['init_total_time'] - results[-1]['creation_time']:.3f}s")
        print(f"    - Simulation: {results[-1]['simulation_time']:.3f}s ({steps/results[-1]['simulation_time']:.1f} steps/s)")
    
    # Performance analysis
    print(f"\n=== Performance Analysis ===")
    print(f"{'Configuration':<12} {'Neurons':<8} {'Steps/s':<10} {'Firing Rate':<12} {'Efficiency':<12}")
    print(f"{'-'*66}")
    
    for result in results:
        steps_per_sec = result['steps'] / result['simulation_time']
        efficiency = (result['spikes'] / result['neurons']) / (result['steps'] / 100)  # spikes per neuron per 100 steps
        print(f"{result['name']:<12} {result['neurons']:<8} {steps_per_sec:<10.1f} "
              f"{result['avg_firing_rate']:<12.2f} {efficiency:<12.3f}")
    
    # Performance recommendations
    best_efficiency = max(results, key=lambda x: (x['steps']/x['simulation_time']))
    print(f"\nPerformance recommendation: Use {best_efficiency['name']} brain "
          f"for best performance ({best_efficiency['steps']/best_efficiency['simulation_time']:.1f} steps/s)")
    
    print("\n✓ Performance benchmark completed successfully!")
    print()

if __name__ == "__main__":
    performance_benchmark_example()
```

