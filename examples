### Troubleshooting Guide

```python
# Troubleshooting helper

def troubleshoot_simulation_error(error, brain=None, world=None):
    """Troubleshoot simulation errors."""
    if "not initialized" in str(error):
        print("Error: Brain not initialized")
        if brain:
            print("Solution: Call brain.initialize()")
    
    elif "neuron_count" in str(error):
        print("Error: Invalid neuron count")
        if brain:
            print(f"Solution: Current neuron count: {brain.getTotalNeuronCount()}")
    
    elif "step" in str(error):
        print("Error: Simulation step failed")
        if brain:
            print("Solution: Check brain state and configuration")
    
    elif world and world.getSimulationTime() > 1000:
        print("Warning: Long simulation time may cause performance issues")
    
    return "Troubleshooting complete"
```

