# Advanced CLI Configuration
# This file contains the build configuration for the AdvancedCLI target

# Add the advanced CLI executable
add_executable(nlm_advanced_cli
    src/CLI/AdvancedCLI.cpp
    src/CLI/AdvancedCLI.hpp
)

target_link_libraries(nlm_advanced_cli
    nlm_core
    nlm_agent
    nlm_world
)

target_include_directories(nlm_advanced_cli PRIVATE
    ${CMAKE_CURRENT_SOURCE_DIR}/src
    ${CMAKE_CURRENT_SOURCE_DIR}/src/CLI
)

# Add dependencies
add_dependencies(nlm_advanced_cli nlm_core nlm_agent nlm_world)

# Set target properties
set_target_properties(nlm_advanced_cli PROPERTIES
    OUTPUT_NAME "nlm_advanced"
    RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/bin
    DEBUG_POSTFIX "_d"
)

# Install the advanced CLI
install(TARGETS nlm_advanced_cli
    RUNTIME DESTINATION bin
)

# Create alias for easier access
add_custom_target(nlm_cli_all
    DEPENDS nlm nlm_advanced_cli
    COMMENT "Build all NLM executables"
)

# Create a benchmark target
add_executable(nlm_benchmark
    src/benchmarks/Benchmark.cpp
)

target_link_libraries(nlm_benchmark
    nlm_core
    nlm_agent
    nlm_world
)

# Add benchmark tests
enable_testing()
add_test(NAME nlm_benchmark
    COMMAND nlm_benchmark
    WORKING_DIRECTORY ${CMAKE_BINARY_DIR}/bin
)

# Create a validation target
add_executable(nlm_validate
    src/validation/ValidateConfig.cpp
)

target_link_libraries(nlm_validate
    nlm_core
)

# Add validation tests
add_test(NAME nlm_validate
    COMMAND nlm_validate
    WORKING_DIRECTORY ${CMAKE_BINARY_DIR}/bin
)

# Create a visualization target
add_executable(nlm_visualize
    src/visualization/Visualization.cpp
)

target_link_libraries(nlm_visualize
    nlm_core
    nlm_agent
    nlm_world
)

# Add visualization tests
add_test(NAME nlm_visualize
    COMMAND nlm_visualize
    WORKING_DIRECTORY ${CMAKE_BINARY_DIR}/bin
)