// Error categories for better error classification
enum class ErrorCategory {
    Configuration,      // Configuration loading/validation errors
    Resource,          // Memory, file, or other resource errors
    Network,           // Network or communication errors
    Simulation,        // Neural simulation or computation errors
    Integration,       // System integration or component interaction errors
    Performance,       // Performance or timing-related errors
    User,              // User input or interface errors
    Unknown            // Unclassified errors
};

// Error severity levels
enum class ErrorSeverity {
    Debug,             // Low impact, informational
    Info,              // Minor impact, system continues
    Warning,           // Significant impact, but recovery possible
    Error,             // Major impact, recovery attempted
    Critical,          // Severe impact, system may continue in degraded mode
    Fatal              // Catastrophic impact, system must halt
};

// Error recovery strategies
enum class RecoveryStrategy {
    None,              // No recovery attempt
    Retry,             // Retry operation (with exponential backoff)
    Fallback,          // Use alternative implementation or configuration
    Restore,           // Restore from checkpoint
    Degrade,           // Continue with reduced functionality
    Shutdown,          // Graceful shutdown
    Ignore             // Log but continue
};

// Error classification for better handling
struct ErrorInfo {
    ErrorCategory category;
    ErrorSeverity severity;
    std::string message;
    std::string source;
    std::string file;
    int line;
    std::string function;
    std::chrono::system_clock::time_point timestamp;
    std::map<std::string, std::string> context;
    std::exception_ptr exception;
    
    ErrorInfo() : category(ErrorCategory::Unknown), severity(ErrorSeverity::Debug),
                  message(), source(), file(), line(0), function(),
                  timestamp(std::chrono::system_clock::now()),
                  exception(nullptr) {}
    
    ErrorInfo(ErrorCategory cat, ErrorSeverity sev, const std::string& msg,
              const std::string& src = "", const std::string& file = "",
              int lineNum = 0, const std::string& func = "")
        : category(cat), severity(sev), message(msg), source(src), file(file),
          line(lineNum), function(func), timestamp(std::chrono::system_clock::now()),
          exception(nullptr) {}
};

// Recovery action result
struct RecoveryResult {
    bool success;
    std::string message;
    RecoveryStrategy strategy; // Strategy used
    size_t retryCount;          // Number of retry attempts
    double recoveryTime;        // Time taken for recovery (seconds)
    std::map<std::string, std::string> metadata; // Additional recovery info
    
    RecoveryResult() : success(false), strategy(RecoveryStrategy::None),
                      retryCount(0), recoveryTime(0.0) {}
    
    RecoveryResult(bool s, const std::string& msg, RecoveryStrategy strat = RecoveryStrategy::None)
        : success(s), message(msg), strategy(strat), retryCount(0), recoveryTime(0.0) {}
};

// Error handler interface
class IErrorHandler {
public:
    virtual ~IErrorHandler() = default;
    virtual void handleError(const ErrorInfo& error) = 0;
    virtual bool canHandleError(const ErrorInfo& error) const = 0;
    virtual RecoveryResult recoverFromError(const ErrorInfo& error) = 0;
    virtual void logError(const ErrorInfo& error) = 0;
};

// Error recovery manager
class ErrorRecoveryManager {
public:
    struct RecoveryPolicy {
        ErrorCategory category;
        ErrorSeverity severity;
        RecoveryStrategy strategy;
        size_t maxRetries;
        double timeout;           // Maximum recovery time (seconds)
        double backoffFactor;      // Exponential backoff factor
        bool shouldLog;            // Whether to log recovery attempts
        std::function<bool(const ErrorInfo&)> canRecover;
    };
    
    ErrorRecoveryManager() : enabled(true), globalTimeout(300.0) {  // 5 minutes default
        initializeDefaultPolicies();
    }
    
    void setEnabled(bool enabled) {
        std::lock_guard<std::mutex> lock(mutex);
        this->enabled = enabled;
    }
    
    void setGlobalTimeout(double timeout) {
        std::lock_guard<std::mutex> lock(mutex);
        globalTimeout = timeout;
    }
    
    void addPolicy(const RecoveryPolicy& policy) {
        std::lock_guard<std::mutex> lock(mutex);
        policies.push_back(policy);
    }
    
    RecoveryResult attemptRecovery(const ErrorInfo& error) {
        if (!enabled) {
            return RecoveryResult(false, "Error recovery disabled", RecoveryStrategy::None);
        }
        
        std::lock_guard<std::mutex> lock(mutex);
        
        // Find applicable policy
        RecoveryPolicy* applicablePolicy = nullptr;
        for (auto& policy : policies) {
            if (error.category == policy.category && 
                error.severity >= policy.severity &&
                (!policy.canRecover || policy.canRecover(error))) {
                applicablePolicy = &policy;
                break;
            }
        }
        
        if (!applicablePolicy) {
            return RecoveryResult(false, "No applicable recovery policy", RecoveryStrategy::None);
        }
        
        return executeRecovery(error, *applicablePolicy);
    }
    
    void registerErrorHandler(std::shared_ptr<IErrorHandler> handler) {
        std::lock_guard<std::mutex> lock(mutex);
        errorHandlers.push_back(handler);
    }
    
    size_t getActiveErrors() const {
        std::lock_guard<std::mutex> lock(mutex);
        return activeErrors.size();
    }
    
    std::vector<ErrorInfo> getActiveErrorsList() const {
        std::lock_guard<std::mutex> lock(mutex);
        return std::vector<ErrorInfo>(activeErrors.begin(), activeErrors.end());
    }
    
    void clearErrorHistory() {
        std::lock_guard<std::mutex> lock(mutex);
        activeErrors.clear();
    }
    
    std::string getErrorSummary() const {
        std::lock_guard<std::mutex> lock(mutex);
        std::stringstream ss;
        ss << "Active Errors: " << activeErrors.size() << std::endl;
        
        std::map<ErrorCategory, size_t> categoryCount;
        for (const auto& error : activeErrors) {
            categoryCount[error.category]++;
        }
        
        for (const auto& pair : categoryCount) {
            ss << "  " << errorCategoryToString(pair.first) << ": " << pair.second << std::endl;
        }
        
        return ss.str();
    }
    
protected:
    RecoveryResult executeRecovery(const ErrorInfo& error, const RecoveryPolicy& policy) {
        auto startTime = system_clock::now();
        
        RecoveryResult result;
        result.strategy = policy.strategy;
        
        try {
            switch (policy.strategy) {
                case RecoveryStrategy::None:
                    result.success = false;
                    result.message = "No recovery strategy available";
                    break;
                
                case RecoveryStrategy::Retry:
                    result = executeWithRetry(error, policy);
                    break;
                
                case RecoveryStrategy::Fallback:
                    result = executeFallback(error, policy);
                    break;
                
                case RecoveryStrategy::Restore:
                    result = executeRestore(error, policy);
                    break;
                
                case RecoveryStrategy::Degrade:
                    result = executeDegrade(error, policy);
                    break;
                
                case RecoveryStrategy::Shutdown:
                    result = executeShutdown(error, policy);
                    break;
                
                case RecoveryStrategy::Ignore:
                    result = executeIgnore(error, policy);
                    break;
            }
        } catch (const std::exception& e) {
            result.success = false;
            result.message = std::string("Recovery failed with exception: ") + e.what();
        }
        
        auto endTime = system_clock::now();
        result.recoveryTime = duration<double>(endTime - startTime).count();
        
        if (result.success) {
            NLM_LOG_INFO(std::string("Recovery successful: ") + result.message);
        } else {
            NLM_LOG_ERROR(std::string("Recovery failed: ") + result.message);
        }
        
        return result;
    }
    
    RecoveryResult executeWithRetry(const ErrorInfo& error, const RecoveryPolicy& policy) {
        RecoveryResult result;
        result.strategy = RecoveryStrategy::Retry;
        
        for (size_t attempt = 0; attempt < policy.maxRetries; ++attempt) {
            NLM_LOG_INFO(std::string("Recovery attempt " + std::to_string(attempt + 1) + 
                         "/" + std::to_string(policy.maxRetries) + " for error: ") + error.message);
            
            try {
                // Execute recovery action
                bool success = performRecoveryAction(error, policy);
                
                if (success) {
                    result.success = true;
                    result.message = "Recovered successfully after " + std::to_string(attempt + 1) + " attempts";
                    result.retryCount = attempt + 1;
                    return result;
                }
                
                // Exponential backoff
                double backoffTime = policy.backoffFactor * std::pow(2.0, static_cast<double>(attempt));
                if (attempt < policy.maxRetries - 1) {
                    std::this_thread::sleep_for(std::chrono::duration<double>(backoffTime));
                }
                
            } catch (const std::exception& e) {
                NLM_LOG_ERROR(std::string("Recovery attempt " + std::to_string(attempt + 1) + 
                             " failed: ") + e.what());
            }
        }
        
        result.success = false;
        result.message = "All recovery attempts failed";
        result.retryCount = policy.maxRetries;
        return result;
    }
    
    bool performRecoveryAction(const ErrorInfo& error, const RecoveryPolicy& policy) {
        // In a real implementation, this would perform the actual recovery
        // For now, we'll just return true for demonstration
        return true;
    }
    
    RecoveryResult executeFallback(const ErrorInfo& error, const RecoveryPolicy& policy) {
        RecoveryResult result;
        result.strategy = RecoveryStrategy::Fallback;
        result.success = true;
        result.message = "Using fallback implementation";
        return result;
    }
    
    RecoveryResult executeRestore(const ErrorInfo& error, const RecoveryPolicy& policy) {
        RecoveryResult result;
        result.strategy = RecoveryStrategy::Restore;
        result.success = true;
        result.message = "Restoring from checkpoint";
        return result;
    }
    
    RecoveryResult executeDegrade(const ErrorInfo& error, const RecoveryPolicy& policy) {
        RecoveryResult result;
        result.strategy = RecoveryStrategy::Degrade;
        result.success = true;
        result.message = "Continuing with reduced functionality";
        return result;
    }
    
    RecoveryResult executeShutdown(const ErrorInfo& error, const RecoveryPolicy& policy) {
        RecoveryResult result;
        result.strategy = RecoveryStrategy::Shutdown;
        result.success = true;
        result.message = "Shutting down gracefully";
        // In a real implementation, this would initiate shutdown
        return result;
    }
    
    RecoveryResult executeIgnore(const ErrorInfo& error, const RecoveryPolicy& policy) {
        RecoveryResult result;
        result.strategy = RecoveryStrategy::Ignore;
        result.success = true;
        result.message = "Ignoring error and continuing";
        return result;
    }
    
    void initializeDefaultPolicies() {
        // Default recovery policies for common error scenarios
        policies.push_back({
            ErrorCategory::Configuration,
            ErrorSeverity::Error,
            RecoveryStrategy::Retry,
            3,
            30.0,
            1.0,
            true,
            [](const ErrorInfo& error) { return true; }
        });
        
        policies.push_back({
            ErrorCategory::Resource,
            ErrorSeverity::Critical,
            RecoveryStrategy::Fallback,
            2,
            60.0,
            1.5,
            true,
            [](const ErrorInfo& error) { return error.message.find("memory") != std::string::npos; }
        });
        
        policies.push_back({
            ErrorCategory::Simulation,
            ErrorSeverity::Warning,
            RecoveryStrategy::Retry,
            5,
            120.0,
            2.0,
            true,
            [](const ErrorInfo& error) { return error.message.find("step") != std::string::npos; }
        });
        
        policies.push_back({
            ErrorCategory::Integration,
            ErrorSeverity::Error,
            RecoveryStrategy::Degrade,
            1,
            90.0,
            1.0,
            true,
            [](const ErrorInfo& error) { return error.message.find("integration") != std::string::npos; }
        });
    }
    
    std::string errorCategoryToString(ErrorCategory category) {
        switch (category) {
            case ErrorCategory::Configuration: return "Configuration";
            case ErrorCategory::Resource: return "Resource";
            case ErrorCategory::Network: return "Network";
            case ErrorCategory::Simulation: return "Simulation";
            case ErrorCategory::Integration: return "Integration";
            case ErrorCategory::Performance: return "Performance";
            case ErrorCategory::User: return "User";
            case ErrorCategory::Unknown: return "Unknown";
            default: return "Unknown";
        }
    }
    
    std::mutex mutex;
    bool enabled;
    double globalTimeout;
    std::vector<RecoveryPolicy> policies;
    std::vector<std::shared_ptr<IErrorHandler>> errorHandlers;
    std::map<std::string, ErrorInfo> activeErrors;
};

// Centralized error logging
class ErrorLogger : public IErrorHandler {
public:
    ErrorLogger() : logFile("nlm_errors.log"), maxErrorsToStore(1000) {}
    
    void setLogFile(const std::string& filepath) {
        std::lock_guard<std::mutex> lock(mutex);
        logFile = filepath;
    }
    
    void setMaxErrorsToStore(size_t maxErrors) {
        std::lock_guard<std::mutex> lock(mutex);
        maxErrorsToStore = maxErrors;
    }
    
    void log(const ErrorInfo& error) override {
        std::lock_guard<std::mutex> lock(mutex);
        
        // Store error
        errorHistory.push_back(error);
        
        // Trim error history if too large
        if (errorHistory.size() > maxErrorsToStore) {
            errorHistory.erase(errorHistory.begin(), 
                             errorHistory.begin() + (errorHistory.size() - maxErrorsToStore));
        }
        
        // Log to file
        logToFile(error);
        
        // Log to console (using existing NLM logging)
        logToConsole(error);
    }
    
    void handleError(const ErrorInfo& error) override {
        log(error);
        
        // Notify registered handlers
        for (auto& handler : registeredHandlers) {
            if (handler->canHandleError(error)) {
                handler->handleError(error);
            }
        }
    }
    
    bool canHandleError(const ErrorInfo& error) const override {
        return true;  // We handle all errors
    }
    
    RecoveryResult recoverFromError(const ErrorInfo& error) override {
        // For error logging, we just acknowledge the error
        RecoveryResult result;
        result.success = true;
        result.message = "Error logged and acknowledged";
        result.strategy = RecoveryStrategy::Ignore;
        return result;
    }
    
    void logError(const ErrorInfo& error) override {
        log(error);
    }
    
    void registerHandler(std::shared_ptr<IErrorHandler> handler) {
        std::lock_guard<std::mutex> lock(mutex);
        registeredHandlers.push_back(handler);
    }
    
    std::vector<ErrorInfo> getErrorHistory() const {
        std::lock_guard<std::mutex> lock(mutex);
        return errorHistory;
    }
    
    std::string getErrorReport() const {
        std::lock_guard<std::mutex> lock(mutex);
        std::stringstream ss;
        ss << "NLM Error Report" << std::endl;
        ss << "===============" << std::endl;
        ss << "Total errors: " << errorHistory.size() << std::endl;
        ss << "Log file: " << logFile << std::endl;
        ss << std::endl;
        
        if (errorHistory.empty()) {
            ss << "No errors recorded." << std::endl;
            return ss.str();
        }
        
        // Group errors by category and severity
        std::map<ErrorCategory, size_t> categoryCount;
        std::map<ErrorSeverity, size_t> severityCount;
        
        for (const auto& error : errorHistory) {
            categoryCount[error.category]++;
            severityCount[error.severity]++;
        }
        
        ss << "Errors by category:" << std::endl;
        for (const auto& pair : categoryCount) {
            ss << "  " << errorCategoryToString(pair.first) << ": " << pair.second << std::endl;
        }
        
        ss << std::endl << "Errors by severity:" << std::endl;
        for (const auto& pair : severityCount) {
            ss << "  " << errorSeverityToString(pair.first) << ": " << pair.second << std::endl;
        }
        
        return ss.str();
    }
    
private:
    void logToFile(const ErrorInfo& error) {
        std::ofstream file(logFile, std::ios::app);
        if (!file.is_open()) {
            return; // Silently fail if can't write to error log
        }
        
        file << "[" << errorTimestampToString(error.timestamp) << "] "
             << errorSeverityToString(error.severity) << " "
             << errorCategoryToString(error.category) << ": "
             << error.message << std::endl;
        
        if (!error.file.empty() && error.line > 0) {
            file << "  File: " << error.file << ":" << error.line << std::endl;
        }
        
        if (!error.function.empty()) {
            file << "  Function: " << error.function << std::endl;
        }
        
        if (!error.source.empty()) {
            file << "  Source: " << error.source << std::endl;
        }
        
        if (!error.context.empty()) {
            file << "  Context:" << std::endl;
            for (const auto& pair : error.context) {
                file << "    " << pair.first << ": " << pair.second << std::endl;
            }
        }
        
        file << std::endl;
        file.close();
    }
    
    void logToConsole(const ErrorInfo& error) {
        // Use existing NLM logging system for error output
        std::string logMessage = errorCategoryToString(error.category) + ": " + error.message;
        
        switch (error.severity) {
            case ErrorSeverity::Debug:
                NLM_LOG_DEBUG(logMessage);
                break;
            case ErrorSeverity::Info:
                NLM_LOG_INFO(logMessage);
                break;
            case ErrorSeverity::Warning:
                NLM_LOG_WARNING(logMessage);
                break;
            case ErrorSeverity::Error:
                NLM_LOG_ERROR(logMessage);
                break;
            case ErrorSeverity::Critical:
                NLM_LOG_CRITICAL(logMessage);
                break;
            case ErrorSeverity::Fatal:
                NLM_LOG_CRITICAL(logMessage + " (FATAL - system may be unstable)");
                break;
        }
    }
    
    std::string errorSeverityToString(ErrorSeverity severity) {
        switch (severity) {
            case ErrorSeverity::Debug: return "DEBUG";
            case ErrorSeverity::Info: return "INFO";
            case ErrorSeverity::Warning: return "WARN";
            case ErrorSeverity::Error: return "ERROR";
            case ErrorSeverity::Critical: return "CRIT";
            case ErrorSeverity::Fatal: return "FATAL";
            default: return "UNKNOWN";
        }
    }
    
    std::string errorCategoryToString(ErrorCategory category) {
        switch (category) {
            case ErrorCategory::Configuration: return "CONFIG";
            case ErrorCategory::Resource: return "RESOURCE";
            case ErrorCategory::Network: return "NETWORK";
            case ErrorCategory::Simulation: return "SIMULATION";
            case ErrorCategory::Integration: return "INTEGRATION";
            case ErrorCategory::Performance: return "PERFORMANCE";
            case ErrorCategory::User: return "USER";
            case ErrorCategory::Unknown: return "UNKNOWN";
            default: return "UNKNOWN";
        }
    }
    
    std::string errorTimestampToString(const std::chrono::system_clock::time_point& timestamp) {
        auto time = std::chrono::system_clock::to_time_t(timestamp);
        std::stringstream ss;
        ss << std::put_time(std::localtime(&time), "%Y-%m-%d %H:%M:%S");
        return ss.str();
    }
    
    std::mutex mutex;
    std::string logFile;
    size_t maxErrorsToStore;
    std::vector<ErrorInfo> errorHistory;
    std::vector<std::shared_ptr<IErrorHandler>> registeredHandlers;
};

// Enhanced error handling for Brain class
class BrainErrorHandler : public IErrorHandler {
public:
    BrainErrorHandler(std::shared_ptr<Brain> brain) : brain(brain) {}
    
    void handleError(const ErrorInfo& error) override {
        // Log the error
        NLM_LOG_ERROR(std::string("Brain error: ") + error.message);
        
        // Check if error is recoverable
        if (isRecoverable(error)) {
            NLM_LOG_INFO("Attempting to recover from brain error...");
            // In a real implementation, this would attempt recovery
        } else {
            NLM_LOG_CRITICAL(std::string("Brain error is not recoverable: ") + error.message);
        }
    }
    
    bool canHandleError(const ErrorInfo& error) const override {
        // Handle all brain-related errors
        return error.category == ErrorCategory::Simulation ||
               error.category == ErrorCategory::Integration ||
               error.category == ErrorCategory::Resource;
    }
    
    RecoveryResult recoverFromError(const ErrorInfo& error) override {
        RecoveryResult result;
        
        if (!isRecoverable(error)) {
            result.success = false;
            result.message = "Error is not recoverable";
            result.strategy = RecoveryStrategy::None;
            return result;
        }
        
        // Attempt to recover
        try {
            if (error.message.find("step") != std::string::npos) {
                // Simulation step error - try to continue with alternative parameters
                NLM_LOG_INFO("Attempting to recover from simulation step error");
                // In a real implementation, this would attempt to recover
                result.success = true;
                result.message = "Recovered from simulation error";
                result.strategy = RecoveryStrategy::Degrade;
            } else if (error.message.find("memory") != std::string::npos) {
                // Memory error - try to free resources
                NLM_LOG_INFO("Attempting to recover from memory error");
                // In a real implementation, this would attempt to free resources
                result.success = true;
                result.message = "Recovered from memory error";
                result.strategy = RecoveryStrategy::Degrade;
            } else {
                // Generic error recovery
                NLM_LOG_INFO("Attempting generic error recovery");
                // In a real implementation, this would attempt generic recovery
                result.success = true;
                result.message = "Recovered from generic error";
                result.strategy = RecoveryStrategy::Degrade;
            }
        } catch (const std::exception& e) {
            result.success = false;
            result.message = std::string("Recovery failed: ") + e.what();
            result.strategy = RecoveryStrategy::None;
        }
        
        return result;
    }
    
    void logError(const ErrorInfo& error) override {
        handleError(error);
    }
    
private:
    bool isRecoverable(const ErrorInfo& error) const {
        // Determine if an error can be recovered from
        // This is a simplified implementation
        if (error.severity >= ErrorSeverity::Fatal) {
            return false;
        }
        
        if (error.message.find("step") != std::string::npos) {
            return true; // Simulation step errors are recoverable
        }
        
        if (error.message.find("memory") != std::string::npos) {
            return true; // Memory errors are recoverable
        }
        
        if (error.message.find("connection") != std::string::npos) {
            return true; // Connection errors are recoverable
        }
        
        return error.severity < ErrorSeverity::Critical;
    }
    
    std::shared_ptr<Brain> brain;
};

// Global error handling framework
class GlobalErrorHandling {
public:
    static GlobalErrorHandling& getInstance() {
        static GlobalErrorHandling instance;
        return instance;
    }
    
    void initialize() {
        // Initialize global error handling components
        errorLogger = std::make_shared<ErrorLogger>();
        errorRecoveryManager = std::make_shared<ErrorRecoveryManager>();
        
        // Register error logger
        errorRecoveryManager->registerErrorHandler(errorLogger);
        
        // Enable error handling
        errorRecoveryManager->setEnabled(true);
        
        NLM_LOG_INFO("Global error handling initialized");
    }
    
    void shutdown() {
        // Clean up error handling components
        errorLogger.reset();
        errorRecoveryManager.reset();
        
        NLM_LOG_INFO("Global error handling shutdown complete");
    }
    
    void logError(ErrorCategory category, ErrorSeverity severity, 
                  const std::string& message, const std::string& source = "",
                  const std::string& file = "", int line = 0,
                  const std::string& function = "") {
        ErrorInfo error;
        error.category = category;
        error.severity = severity;
        error.message = message;
        error.source = source;
        error.file = file;
        error.line = line;
        error.function = function;
        
        if (errorLogger) {
            errorLogger->handleError(error);
        }
    }
    
    void logError(const ErrorInfo& error) {
        if (errorLogger) {
            errorLogger->handleError(error);
        }
    }
    
    RecoveryResult attemptRecovery(const ErrorInfo& error) {
        if (errorRecoveryManager) {
            return errorRecoveryManager->attemptRecovery(error);
        }
        
        RecoveryResult result;
        result.success = false;
        result.message = "Error recovery manager not available";
        return result;
    }
    
    size_t getActiveErrorCount() const {
        if (errorRecoveryManager) {
            return errorRecoveryManager->getActiveErrors();
        }
        return 0;
    }
    
    std::string getErrorReport() const {
        std::stringstream ss;
        
        if (errorLogger) {
            ss << errorLogger->getErrorReport();
        }
        
        if (errorRecoveryManager) {
            ss << errorRecoveryManager->getErrorSummary();
        }
        
        return ss.str();
    }
    
    void enableErrorRecovery(bool enabled) {
        if (errorRecoveryManager) {
            errorRecoveryManager->setEnabled(enabled);
        }
    }
    
    void configureErrorRecovery(double timeout) {
        if (errorRecoveryManager) {
            errorRecoveryManager->setGlobalTimeout(timeout);
        }
    }
    
    void registerBrainErrorHandler(std::shared_ptr<Brain> brain) {
        if (errorLogger) {
            auto brainHandler = std::make_shared<BrainErrorHandler>(brain);
            errorLogger->registerHandler(brainHandler);
        }
    }
    
private:
    GlobalErrorHandling() = default;
    ~GlobalErrorHandling() = default;
    
    std::shared_ptr<ErrorLogger> errorLogger;
