cmake_minimum_required(VERSION 3.16)
project(ConfigValidationTest VERSION 0.1.0 LANGUAGES CXX)

# C++20 standard
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

# Enable warnings
if(MSVC)
    add_compile_options(/W4)
else()
    add_compile_options(-Wall -Wextra -Wpedantic)
endif()

# Find packages
find_package(nlohmann_json REQUIRED)
find_package(yaml-cpp REQUIRED)

# Test executable
add_executable(test_validation test_validation.cpp src/core/Config/Config.cpp)

# Include directories
target_include_directories(test_validation PRIVATE .)

# Link libraries
target_link_libraries(test_validation PRIVATE nlohmann_json::nlohmann_json yaml-cpp)