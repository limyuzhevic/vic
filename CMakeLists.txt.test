cmake_minimum_required(VERSION 3.16)
project(EnhancedConfigTest VERSION 1.0.0 LANGUAGES CXX)

# Enable C++20
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

# Enable warnings
if(MSVC)
    add_compile_options(/W4)
else()
    add_compile_options(-Wall -Wextra -Wpedantic -Werror)
endif()

# Find dependencies
set(JSON_REQUIRED "nlohmann/json")
set(YAML_REQUIRED "yaml-cpp")

# Try to find nlohmann/json
try_find_package("nlohmann/json" JSON)
if(JSON_FOUND)
    message(STATUS "Found nlohmann/json: ${JSON_VERSION}")
else()
    message(WARNING "nlohmann/json not found - some functionality may be limited")
endif()

# Try to find yaml-cpp
try_find_package("yaml-cpp" YAML)
if(YAML_FOUND)
    message(STATUS "Found yaml-cpp: ${YAML_VERSION}")
else()
    message(WARNING "yaml-cpp not found - YAML support will be limited")
endif()

# Enhanced Config test executable
add_executable(test_enhanced_config
    example_enhanced_config.cpp
)

# Include directories
target_include_directories(test_enhanced_config PRIVATE
    ${CMAKE_CURRENT_SOURCE_DIR}/src
)

# Link dependencies
if(JSON_FOUND)
    target_link_libraries(test_enhanced_config PRIVATE ${JSON_LIBRARIES})
endif()

if(YAML_FOUND)
    target_link_libraries(test_enhanced_config PRIVATE ${YAML_LIBRARIES})
endif()

# Add dependencies
find_package(Threads REQUIRED)
target_link_libraries(test_enhanced_config PRIVATE Threads::Threads)

# Test target
enable_testing()
add_test(NAME test_enhanced_config
    COMMAND test_enhanced_config
)

# Installation (optional)
install(TARGETS test_enhanced_config
    RUNTIME DESTINATION bin
)

# Custom CMake function to try to find packages
get_property(DEFINED_CMAKE_FUNCTIONS GLOBAL_PROPERTIES DEFINED_CMAKE_FUNCTIONS)
foreach(var ${DEFINED_CMAKE_FUNCTIONS})
    if("TRY_FIND_PACKAGE" STREQUAL "${var}")
        set(HAS_TRY_FIND_PACKAGE TRUE)
    endif()
endforeach()

if(NOT HAS_TRY_FIND_PACKAGE)
    # Create try_find_package function
    function(try_find_package PACKAGE_NAME PACKAGE_VAR)
        find_package(${PACKAGE_NAME} QUIET COMPONENTS ${PACKAGE_NAME})
        if(${PACKAGE_NAME}_FOUND)
            set(${PACKAGE_VAR}_FOUND TRUE PARENT_SCOPE)
            set(${PACKAGE_VAR}_VERSION "${${PACKAGE_NAME}_VERSION}" PARENT_SCOPE)
            set(${PACKAGE_VAR}_INCLUDE_DIRS "${${PACKAGE_NAME}_INCLUDE_DIRS}" PARENT_SCOPE)
            set(${PACKAGE_VAR}_LIBRARIES "${${PACKAGE_NAME}_LIBRARIES}" PARENT_SCOPE)
        else()
            set(${PACKAGE_VAR}_FOUND FALSE PARENT_SCOPE)
        endif()
    endfunction()
endif()

message(STATUS "Enhanced Config test project configured")
