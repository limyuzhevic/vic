                "timeout": 30.0,
                "expected_systems": ["memory", "neuromodulation", "prediction", "development"]
            },
            
            "memory_integration": {
                "working_memory_neuron_count": 50,
                "episodic_memory_episode_count": 10,
                "consolidation_threshold": 0.8
            },
            
            "neuromodulation_integration": {
                "dopamine_sensitivity": 0.5,
                "curiosity_threshold": 0.3,
                "novelty_sensitivity": 0.7
            },
            
            "checkpointing_test": {
                "checkpoint_interval": 100,
                "max_checkpoints": 5,
                "restore_after_save": true
            },
            
            "replay_test": {
                "replay_steps": 50,
                "replay_accuracy_threshold": 0.9,
                "consolidation_strength": 0.8
            }
        }
    },
    
    "output_format": {
        "text_summary": true,
        "json_detailed": true,
        "csv_metrics": true,
        "html_report": true,
        
        "report_sections": [
            "executive_summary",
            "system_status",
            "performance_metrics",
            "integration_results",
            "recommendations"
        ],
        
        "chart_options": {
            "include_firing_rate_graph": true,
            "include_memory_usage_chart": true,
            "include_system_performance_graph": true,
            "chart_width": 800,
            "chart_height": 600
        }
    },
    
    "advanced_features": {
        "machine_learning_integration": false,
        "genetic_algorithm": false,
        "neural_architectural_search": false,
        
        "distributed_computing": {
            "enabled": false,
            "worker_nodes": 1,
            "task_distribution": "static"
        },
        
        "cloud_compatibility": {
            "aws_integration": false,
            "gcp_integration": false,
            "azure_integration": false
        }
    },
    
    "quality_assurance": {
        "unit_tests": true,
        "integration_tests": true,
        "performance_tests": true,
        "stress_tests": true,
        
        "quality_thresholds": {
            "integration_success_rate": 0.95,
            "performance_response_time": 1000.0,
            "memory_usage_limit": 1024.0,
            "cpu_usage_limit": 90.0
        }
