    "logging_config": {
        "log_file": "demo.log",
        "max_log_size": 10485760,
        "log_rotation": "daily",
        "include_timestamps": true,
        "include_thread_ids": true,
        "log_colors": true,
        
        "log_levels": {
            "default": "info",
            "experiments": "debug",
            "performance": "warning",
            "errors": "error"
