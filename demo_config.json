// Enhanced Demo Configuration Example
// This JSON file demonstrates the advanced configuration options for NLM demos

{
    "demo_name": "Enhanced Phase 6 Demo",
    
    "configuration": {
        "random_seed": 42,
        "simulation_timestep": 0.001,
        "neuron_count": 500,
        "region_count": 1,
        "connection_probability": 0.15,
        
        "stdp_ltp_weight": 0.02,
        "stdp_ltd_weight": 0.015,
        "stdp_tau": 20.0,
        
        "synaptogenesis_rate": 0.0001,
        "pruning_rate": 0.00001,
        
        "enable_checkpointing": true,
        "enable_replay": true,
        "enable_development": true,
        
        "enable_curiosity": true,
        "curiosity_strength": 1.0,
        
        "enable_reward_modulation": true,
        "reward_scaling": 1.0,
        
        "max_steps": 2000,
        "enable_visualization": false,
        
        "memory_capacity": 1000,
        "episodic_memory_capacity": 100,
        
        "planning_horizon": 10,
        "attention_window": 20
    },
    
    "demo_settings": {
        "verbose_logging": false,
        "quiet_mode": false,
        "json_output": true,
        "output_file": "demo_results.json",
        "log_level": "info",
        
        "progress_tracking": true,
        "metrics_collection": true,
        "performance_monitoring": true,
        
        "enable_network_stimulation": true,
        "stimulation_pattern": "sensory_sequence",
        "stimulation_strength": 40.0,
        
