target_link_libraries(nlm PUBLIC nlm_core)

# Phase 3 demo executable
add_executable(nlm_phase3_demo src/experiments/Phase3Demo.cpp)
target_link_libraries(nlm_phase3_demo PUBLIC nlm_core nlm_agent nlm_world nlm_phase3)

# Phase 4 demo executable
add_executable(nlm_phase4_demo src/experiments/Phase4Demo.cpp)
target_link_libraries(nlm_phase4_demo PUBLIC nlm_core nlm_agent nlm_world nlm_phase3 nlm_phase4)

# Testing framework with modern CTest integration
if(NLM_ENABLE_TESTS)
    enable_testing()
    
    # Configure test options
    set(TEST_TIMEOUT 300 CACHE STRING "Default timeout for tests in seconds")
    set(NLM_TEST_SEED 42 CACHE STRING "Default random seed for tests")
    
    # Create unified test runner with modern CMake
    add_executable(test_runner
        tests/test_runner.cpp
        tests/TestBase.hpp
        tests/test_core.cpp
        tests/test_brain_integration.cpp
        tests/test_memory_system.cpp
        tests/test_neuromodulation.cpp
        tests/test_plasticity.cpp
        tests/test_prediction.cpp
        tests/test_integration.cpp
        tests/test_performance.cpp
        tests/test_config_main.cpp
        tests/test_plasticity_implementation.cpp
    )
    
    target_link_libraries(test_runner PUBLIC nlm_core)
    
    # Add test cases to CTest with modern CMake
    add_test(NAME unified_test_suite
        COMMAND test_runner
        WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}
    )
    
    set_tests_properties(unified_test_suite PROPERTIES
        TIMEOUT ${TEST_TIMEOUT}
        LABELS "integration;performance;functional"
    )
    
    # Add individual test targets for granular execution
    if(EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/test_dopamine.cpp)
        add_executable(test_dopamine test_dopamine.cpp)
        target_link_libraries(test_dopamine PUBLIC nlm_core)
        add_test(NAME test_dopamine COMMAND test_dopamine)
    endif()
    
    if(EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/test_plasticity_implementation.cpp)
        add_executable(test_plasticity_implementation test_plasticity_implementation.cpp)
        target_link_libraries(test_plasticity_implementation PUBLIC nlm_core)
        add_test(NAME test_plasticity_implementation COMMAND test_plasticity_implementation)
    endif()
    
    if(EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/test_config.cpp)
        add_executable(test_config test_config.cpp)
        target_link_libraries(test_config PUBLIC nlm_core)
        add_test(NAME test_config COMMAND test_config)
    endif()
    
    # Add test categories
    add_custom_target(coverage ALL
        COMMAND ${CMAKE_CTEST_COMMAND} --output-on-failure
        COMMAND $<TARGET_FILE:test_runner> --coverage
        DEPENDS test_runner
        COMMENT "Running coverage analysis"
    )
    
    add_custom_target(performance_tests
        COMMAND ${CMAKE_CTEST_COMMAND} -L performance
        DEPENDS test_runner
        COMMENT "Running performance tests"
    )
    
    add_custom_target(integration_tests
        COMMAND ${CMAKE_CTEST_COMMAND} -L integration
        DEPENDS test_runner
        COMMENT "Running integration tests"
    )
endif()

# Installation rules for development
install(TARGETS nlm nlm_core nlm_agent nlm_world
    EXPORT NLMTargets
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
)

# Install executables
install(TARGETS nlm nlm_phase3_demo nlm_phase4_demo
    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
)

# Install header files
install(DIRECTORY src/
    DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/nlm
    FILES_MATCHING PATTERN "*.hpp"
    PATTERN ".*" EXCLUDE
)

# Generate and install package configuration
write_basic_package_version_file(
    ${CMAKE_CURRENT_BINARY_DIR}/NLMConfigVersion.cmake
    VERSION ${PROJECT_VERSION}
    COMPATIBILITY AnyNewerVersion
)

# Create config file for find_package support
configure_package_config_file(
    ${CMAKE_CURRENT_SOURCE_DIR}/cmake/NLMConfig.cmake.in
    ${CMAKE_CURRENT_BINARY_DIR}/NLMConfig.cmake
    INSTALL_DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/NLM
)

install(FILES
    ${CMAKE_CURRENT_BINARY_DIR}/NLMConfig.cmake
    ${CMAKE_CURRENT_BINARY_DIR}/NLMConfigVersion.cmake
    DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/NLM
)

install(EXPORT NLMTargets
    FILE NLMTargets.cmake
    NAMESPACE nlm::
    DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/NLM
)

# Build configuration summaries
if(NOT CMAKE_BUILD_TYPE)
    message(WARNING "Build type not specified. Defaulting to Release with optimizations.")
    set(CMAKE_BUILD_TYPE Release CACHE STRING "Build type" FORCE)
endif()

# Print build configuration summary
message(STATUS "=== NLM Build Configuration ===")
message(STATUS "Project: ${PROJECT_NAME} ${PROJECT_VERSION}")
message(STATUS "Build type: ${CMAKE_BUILD_TYPE}")
message(STATUS "C++ standard: ${CMAKE_CXX_STANDARD}")
message(STATUS "Build shared libraries: ${NLM_BUILD_SHARED_LIBS}")
message(STATUS "Enable tests: ${NLM_ENABLE_TESTS}")
message(STATUS "Enable experiments: ${NLM_ENABLE_EXPERIMENTS}")
message(STATUS "Enable visualization: ${NLM_ENABLE_VISUALIZATION}")
message(STATUS "Enable performance optimizations: ${NLM_ENABLE_PERFORMANCE}")
message(STATUS "Enable LTO: ${NLM_LTO_ENABLE}")
message(STATUS "Enable PGO: ${NLM_PGO_ENABLE}")
message(STATUS "Components: ${NLM_COMPONENTS}")
message(STATUS "===============================")

# Export compile commands for IDE integration
if(CMAKE_EXPORT_COMPILE_COMMANDS)
    file(WRITE ${CMAKE_BINARY_DIR}/compile_commands.json "{}")
endif()
