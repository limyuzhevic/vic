cmake_minimum_required(VERSION 3.20)

# NLM - Neural Learning Machine
# Modern CMake build system with modular dependency management

project(NLM
    VERSION 0.1.0
    LANGUAGES CXX
    DESCRIPTION "An Experimental Artificial Developmental Brain"
)

# Policy settings for modern CMake behavior
cmake_policy(SET CMP0091 NEW) # MSVC runtime library flags

cmake_minimum_required(VERSION 3.20)

# Basic C++ configuration
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

# Project metadata
set(NLM_VERSION_MAJOR ${PROJECT_VERSION_MAJOR})
set(NLM_VERSION_MINOR ${PROJECT_VERSION_MINOR})
set(NLM_VERSION_PATCH ${PROJECT_VERSION_PATCH})

# Build type configuration
set(CMAKE_BUILD_TYPE "Release" CACHE STRING "Build type (Debug, Release, RelWithDebInfo, MinSizeRel)")
set_property(CACHE CMAKE_BUILD_TYPE PROPERTY STRINGS "Debug" "Release" "RelWithDebInfo" "MinSizeRel")

# Platform detection
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(NLM_PLATFORM_LINUX 1)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Windows")
    set(NLM_PLATFORM_WINDOWS 1)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    set(NLM_PLATFORM_MACOS 1)
endif()

# Feature options
option(NLM_ENABLE_TESTS "Enable testing framework" ON)
option(NLM_ENABLE_EXPERIMENTS "Enable experiment libraries" ON)
option(NLM_ENABLE_VISUALIZATION "Enable visualization subsystem" ON)
option(NLM_ENABLE_PERFORMANCE "Enable performance optimizations" ON)
option(NLM_ENABLE_PARALLEL "Enable parallel processing support" ON)
option(NLM_BUILD_SHARED_LIBS "Build shared libraries" OFF)
option(NLM_BUILD_STATIC_LIBS "Build static libraries" ON)
option(NLM_LTO_ENABLE "Enable link-time optimization" OFF)
option(NLM_PGO_ENABLE "Enable profile-guided optimization" OFF)

# Compiler-specific optimizations
if(MSVC)
    add_compile_options(/W4 /permissive-)
    add_definitions(-D_CRT_SECURE_NO_WARNINGS)
else()
    add_compile_options(-Wall -Wextra -Wpedantic -Werror)
endif()

# Modern CMake target properties
include(GNUInstallDirs)

# Package configuration for dependency management
include(CMakePackageConfigHelpers)
include(CMakeFindDependencyMacro)

# Forward declaration of components
set(NLM_COMPONENTS)

# Create interface library for core headers and configuration
add_library(nlm_interface INTERFACE)
target_include_directories(nlm_interface INTERFACE
    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src>
    $<INSTALL_INTERFACE:include>
)

# Create interface library for debugging utilities
add_library(nlm_debug_interface INTERFACE)
target_compile_definitions(nlm_debug_interface INTERFACE NLM_DEBUG)
target_compile_options(nlm_debug_interface INTERFACE -g -O0)

# Include dependency management module
include(${CMAKE_CURRENT_SOURCE_DIR}/cmake/Dependencies.cmake)

# Simplified modern CMake structure for NLM
# Focus on working build system first, then enhance features

cmake_minimum_required(VERSION 3.20)

project(NLM VERSION 0.1.0 LANGUAGES CXX DESCRIPTION "An Experimental Artificial Developmental Brain")

# Basic C++ configuration
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

# Build type configuration
set(CMAKE_BUILD_TYPE Release CACHE STRING "Build type (Debug, Release, RelWithDebInfo, MinSizeRel)")
set_property(CACHE CMAKE_BUILD_TYPE PROPERTY STRINGS "Debug" "Release" "RelWithDebInfo" "MinSizeRel")

# Feature options
option(NLM_ENABLE_TESTS "Enable testing framework" ON)
option(NLM_ENABLE_EXPERIMENTS "Enable experiment libraries" ON)
option(NLM_ENABLE_VISUALIZATION "Enable visualization subsystem" ON)
option(NLM_ENABLE_PERFORMANCE "Enable performance optimizations" ON)

# Compiler-specific optimizations
if(MSVC)
    add_compile_options(/W4 /permissive-)
    add_definitions(-D_CRT_SECURE_NO_WARNINGS)
else()
    add_compile_options(-Wall -Wextra -Wpedantic -Werror)
endif()

# Core module: nlm_core_basic
add_library(nlm_core_basic
    src/core/Types/Types.cpp
    src/core/Config/Config.cpp
    src/core/Random/Random.cpp
    src/core/Logger/Logger.cpp
    src/core/SimulationClock/SimulationClock.cpp
)

target_include_directories(nlm_core_basic PUBLIC
    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src/core>
    $<INSTALL_INTERFACE:include/core>
)

target_compile_features(nlm_core_basic PUBLIC cxx_std_20)

set_target_properties(nlm_core_basic PROPERTIES
    POSITION_INDEPENDENT_CODE ON
    CXX_VISIBILITY_PRESET hidden
    VISIBILITY_INLINES_HIDDEN ON
    DEBUG_POSTFIX "_d"
)

# Core module: nlm_core_neural
add_library(nlm_core_neural
    src/brain/Neuron.cpp
    src/brain/Synapse.cpp
    src/brain/NeuralPopulation.cpp
    src/brain/NeuralRegion.cpp
    src/brain/Brain.cpp
)

target_include_directories(nlm_core_neural PUBLIC
    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src/brain>
    $<INSTALL_INTERFACE:include/brain>
)

target_link_libraries(nlm_core_neural PUBLIC nlm_core_basic)

set_target_properties(nlm_core_neural PROPERTIES
    POSITION_INDEPENDENT_CODE ON
    CXX_VISIBILITY_PRESET hidden
)

# Core module: nlm_core_dynamics
add_library(nlm_core_dynamics
    src/dynamics/NeuralDynamics.cpp
    src/dynamics/SpikeSystem.cpp
)

target_include_directories(nlm_core_dynamics PUBLIC
    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src/dynamics>
    $<INSTALL_INTERFACE:include/dynamics>
)

target_link_libraries(nlm_core_dynamics PUBLIC nlm_core_neural)

# Core module: nlm_core_plasticity
add_library(nlm_core_plasticity
    src/plasticity/PlasticityRule.cpp
    src/plasticity/Hebbian.cpp
    src/plasticity/STDP.cpp
    src/plasticity/StructuralPlasticity.cpp
)

target_include_directories(nlm_core_plasticity PUBLIC
    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src/plasticity>
    $<INSTALL_INTERFACE:include/plasticity>
)

target_link_libraries(nlm_core_plasticity PUBLIC nlm_core_dynamics)

# Core module: nlm_core_memory
add_library(nlm_core_memory
    src/memory/WorkingMemory.cpp
    src/memory/EpisodicMemory.cpp
    src/memory/SemanticMemory.cpp
    src/memory/ProceduralMemory.cpp
    src/memory/AssociativeMemory.cpp
    src/memory/NeuralWorkingMemory.cpp
    src/memory/NeuralEpisodicMemory.cpp
)

target_include_directories(nlm_core_memory PUBLIC
    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src/memory>
    $<INSTALL_INTERFACE:include/memory>
)

target_link_libraries(nlm_core_memory PUBLIC nlm_core_plasticity)

# Core module: nlm_core_cognition
add_library(nlm_core_cognition
    src/cognition/ConceptFormation.cpp
    src/cognition/NeuralPlanner.cpp
)

target_include_directories(nlm_core_cognition PUBLIC
    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src/cognition>
    $<INSTALL_INTERFACE:include/cognition>
)

target_link_libraries(nlm_core_cognition PUBLIC nlm_core_memory)

# Core module: nlm_core_neuromod
add_library(nlm_core_neuromod
    src/neuromodulation/Neuromodulator.cpp
    src/neuromodulation/Reward.cpp
    src/neuromodulation/PredictionError.cpp
    src/neuromodulation/Novelty.cpp
    src/neuromodulation/Curiosity.cpp
)

target_include_directories(nlm_core_neuromod PUBLIC
    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src/neuromodulation>
    $<INSTALL_INTERFACE:include/neuromodulation>
)

target_link_libraries(nlm_core_neuromod PUBLIC nlm_core_cognition)

# Main NLM library that includes all core components
add_library(nlm_core
    nlm_core_basic
    nlm_core_neural
    nlm_core_dynamics
    nlm_core_plasticity
    nlm_core_memory
    nlm_core_cognition
    nlm_core_neuromod
)

target_include_directories(nlm_core PUBLIC
    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src>
    $<INSTALL_INTERFACE:include>
)

# Agent system
add_library(nlm_agent
    src/agent/SensoryPercept.cpp
    src/agent/AgentBrain.cpp
    src/agent/NeuromodulatorManager.cpp
)

target_include_directories(nlm_agent PUBLIC src)
target_link_libraries(nlm_agent PUBLIC nlm_core)

# World system
add_library(nlm_world
    src/world/SimpleWorld.cpp
)

target_include_directories(nlm_world PUBLIC src)
target_link_libraries(nlm_world PUBLIC nlm_core)

# Phase 3 experiments
add_library(nlm_phase3
    src/experiments/Phase3Experiment.cpp
)

target_include_directories(nlm_phase3 PUBLIC src)
target_link_libraries(nlm_phase3 PUBLIC nlm_core nlm_agent nlm_world)

# Phase 4 experiments
add_library(nlm_phase4
    src/experiments/Phase4Experiment.cpp
)

target_include_directories(nlm_phase4 PUBLIC src)
target_link_libraries(nlm_phase4 PUBLIC nlm_core nlm_agent nlm_world)

# Performance module (if enabled)
if(NLM_ENABLE_PERFORMANCE)
    add_library(nlm_performance
        src/performance/Performance.cpp
        src/performance/ParallelProcessing.cpp
        src/performance/MemoryPool.cpp
        src/performance/SIMDVectorization.cpp
        src/performance/EventQueue.cpp
        src/performance/OptimizedBrain.cpp
    )

    target_include_directories(nlm_performance PUBLIC
        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src/performance>
    )

    if(MSVC)
        target_compile_options(nlm_performance PRIVATE /O2 /fp:fast)
    else()
        target_compile_options(nlm_performance PRIVATE -O3 -march=native)
    endif()
endif()

# Main executable
add_executable(nlm src/main.cpp)
target_link_libraries(nlm PUBLIC nlm_core)

# Phase 3 demo executable
add_executable(nlm_phase3_demo src/experiments/Phase3Demo.cpp)
target_link_libraries(nlm_phase3_demo PUBLIC nlm_core nlm_agent nlm_world nlm_phase3)

# Phase 4 demo executable
add_executable(nlm_phase4_demo src/experiments/Phase4Demo.cpp)
target_link_libraries(nlm_phase4_demo PUBLIC nlm_core nlm_agent nlm_world nlm_phase3 nlm_phase4)

# Testing framework
if(NLM_ENABLE_TESTS)
    enable_testing()
    
    # Create unified test runner
    add_executable(test_runner
        tests/test_runner.cpp
        tests/TestBase.hpp
        tests/test_core.cpp
        tests/test_brain_integration.cpp
        tests/test_memory_system.cpp
        tests/test_neuromodulation.cpp
        tests/test_plasticity.cpp
        tests/test_prediction.cpp
        tests/test_integration.cpp
        tests/test_performance.cpp
        tests/test_config_main.cpp
        tests/test_plasticity_implementation.cpp
    )
    
    target_link_libraries(test_runner PUBLIC nlm_core)
    
    # Add tests to CTest
    add_test(NAME unified_test_suite
        COMMAND test_runner
        WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}
    )
    
    # Individual test targets
    if(EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/test_dopamine.cpp)
        add_executable(test_dopamine test_dopamine.cpp)
        target_link_libraries(test_dopamine PUBLIC nlm_core)
        add_test(NAME test_dopamine COMMAND test_dopamine)
    endif()
    
    if(EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/test_plasticity_implementation.cpp)
        add_executable(test_plasticity_implementation test_plasticity_implementation.cpp)
        target_link_libraries(test_plasticity_implementation PUBLIC nlm_core)
        add_test(NAME test_plasticity_implementation COMMAND test_plasticity_implementation)
    endif()
    
    if(EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/test_config.cpp)
        add_executable(test_config test_config.cpp)
        target_link_libraries(test_config PUBLIC nlm_core)
        add_test(NAME test_config COMMAND test_config)
    endif()
endif()

# Installation rules
install(TARGETS nlm nlm_core nlm_agent nlm_world nlm_phase3 nlm_phase4 nlm_phase3_demo nlm_phase4_demo
    ARCHIVE DESTINATION lib
    LIBRARY DESTINATION lib
    RUNTIME DESTINATION bin
)

install(DIRECTORY src/
    DESTINATION include/nlm
    FILES_MATCHING PATTERN "*.hpp"
)

# Build configuration summary
message(STATUS "=== NLM Build Configuration ===")
message(STATUS "Project: ${PROJECT_NAME} ${PROJECT_VERSION}")
message(STATUS "Build type: ${CMAKE_BUILD_TYPE}")
message(STATUS "C++ standard: ${CMAKE_CXX_STANDARD}")
message(STATUS "Enable tests: ${NLM_ENABLE_TESTS}")
message(STATUS "Enable experiments: ${NLM_ENABLE_EXPERIMENTS}")
message(STATUS "Enable visualization: ${NLM_ENABLE_VISUALIZATION}")
message(STATUS "Enable performance optimizations: ${NLM_ENABLE_PERFORMANCE}")
message(STATUS "===============================")

