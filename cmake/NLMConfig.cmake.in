@PACKAGE_INIT@

# NLM Package Configuration
# Generated by CMake for find_package support

include(CMakeFindDependencyMacro)

# Load component targets
include("${CMAKE_CURRENT_LIST_DIR}/NLMTargets.cmake")

# Provide legacy compatibility targets
add_library(nlm::nlm ALIAS nlm_core)
add_library(nlm::agent ALIAS nlm_agent)
add_library(nlm::world ALIAS nlm_world)
add_library(nlm::phase3 ALIAS nlm_phase3)
add_library(nlm::phase4 ALIAS nlm_phase4)

# Define configuration variables for downstream projects
if(NOT TARGET nlm::core_basic)
    add_library(nlm::core_basic ALIAS nlm_core_basic)
endif()

if(NOT TARGET nlm::core_neural)
    add_library(nlm::core_neural ALIAS nlm_core_neural)
endif()

if(NOT TARGET nlm::core_dynamics)
    add_library(nlm::core_dynamics ALIAS nlm_core_dynamics)
endif()

if(NOT TARGET nlm::core_plasticity)
    add_library(nlm::core_plasticity ALIAS nlm_core_plasticity)
endif()

if(NOT TARGET nlm::core_memory)
    add_library(nlm::core_memory ALIAS nlm_core_memory)
endif()

if(NOT TARGET nlm::core_cognition)
    add_library(nlm::core_cognition ALIAS nlm_core_cognition)
endif()

if(NOT TARGET nlm::core_neuromod)
    add_library(nlm::core_neuromod ALIAS nlm_core_neuromod)
endif()

if(NLM_ENABLE_PERFORMANCE AND NOT TARGET nlm::performance)
    add_library(nlm::performance ALIAS nlm_performance)
endif()

if(NLM_ENABLE_VISUALIZATION AND NOT TARGET nlm::visualization)
    add_library(nlm::visualization ALIAS nlm_visualization)
endif()

# Provide version and component information
set(NLM_VERSION_MAJOR @PROJECT_VERSION_MAJOR@)
set(NLM_VERSION_MINOR @PROJECT_VERSION_MINOR@)

set(NLM_INCLUDE_DIRS ${NLM_INCLUDE_PATH})

# Export NLM component dependencies for downstream usage
if(NLM_HAS_OPENMP)
    find_dependency(OpenMP REQUIRED)
endif()

if(NLM_HAS_FFMPEG)
    find_dependency(FFMPEG REQUIRED)
endif()

if(NLM_HAS_SDL2)
    find_dependency(SDL2 REQUIRED)
endif()

# Provide usage documentation
configure_file(
    ${CMAKE_CURRENT_SOURCE_DIR}/docs/cmake/Usage.cmake.in
    ${CMAKE_CURRENT_BINARY_DIR}/NLMUsage.cmake
    @ONLY
)

# Legacy support for pre-CMake 3.20 users
if(NOT TARGET nlm::core_basic AND TARGET nlm_core_basic)
    add_library(nlm::core_basic ALIAS nlm_core_basic)
    add_library(nlm::core_neural ALIAS nlm_core_neural)
    add_library(nlm::core_dynamics ALIAS nlm_core_dynamics)
    add_library(nlm::core_plasticity ALIAS nlm_core_plasticity)
    add_library(nlm::core_memory ALIAS nlm_core_memory)
    add_library(nlm::core_cognition ALIAS nlm_core_cognition)
    add_library(nlm::core_neuromod ALIAS nlm_core_neuromod)
    add_library(nlm::agent ALIAS nlm_agent)
    add_library(nlm::world ALIAS nlm_world)
endif()

message(STATUS "NLM package loaded successfully")
