# NLM CMake Configuration File
# Generated by CMake for installation

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find dependencies
find_dependency(Python ${NLM_PYTHON_VERSION} REQUIRED COMPONENTS Interpreter Development)

if(NLM_BUILD_PYTHON_BINDINGS)
    find_dependency(pybind11 CONFIG REQUIRED)
endif()

# Import targets
include(${CMAKE_CURRENT_LIST_DIR}/NLMTargets.cmake)

# Package configuration for NLM

# Add executable targets to package
include(GNUInstallDirs)

# Add NLM executables
add_executable(nlm-imported IMPORTED)

# Create imported executables for the package
foreach(exec_name nlm nlm_phase3_demo nlm_phase4_demo nlm_phase6_demo)
    add_executable(${exec_name}-imported IMPORTED)
    set_target_properties(${exec_name}-imported PROPERTIES
        IMPORTED_LOCATION "${CMAKE_INSTALL_BINDIR}/${exec_name}"
        RUNTIME_ONLY TRUE
    )
endforeach()

# Add library targets to package
foreach(lib_name nlm_core nlm_brain nlm_cognition nlm_memory nlm_sensory nlm_motor nlm_visualization nlm_agent nlm_world nlm_experiments)
    add_library(${lib_name}-imported IMPORTED)
    set_target_properties(${lib_name}-imported PROPERTIES
        IMPORTED_LOCATION "${CMAKE_INSTALL_LIBDIR}/${lib_name}${CMAKE_STATIC_LIBRARY_SUFFIX}"
        IMPORTED_LINK_INTERFACE_LIBRARIES ""
        INTERFACE_INCLUDE_DIRECTORIES "${CMAKE_INSTALL_INCLUDEDIR}"
        POSITION_INDEPENDENT_CODE ON
    )
endforeach()

# Python bindings
if(NLM_BUILD_PYTHON_BINDINGS)
    add_library(pynlm-imported IMPORTED)
    set_target_properties(pynlm-imported PROPERTIES
        IMPORTED_LOCATION "${PYTHON_SITE_PACKAGES}/pynlm.so"
        IMPORTED_LINK_INTERFACE_LIBRARIES ""
        INTERFACE_INCLUDE_DIRECTORIES "${CMAKE_INSTALL_INCLUDEDIR}"
        CXX_VISIBILITY_PRESET "hidden"
        VISIBILITY_INLINES_HIDDEN ON
    )
endif()

# Convenience functions for finding NLM
function(find_nlm)
    find_package(NLM REQUIRED)
endfunction()

macro(nlm_add_executable target name)
    add_executable(${target} ${name})
    target_link_libraries(${target} PRIVATE NLM::nlm_core NLM::nlm_agent NLM::nlm_world NLM::nlm_experiments)
endmacro()

macro(nlm_add_component_library target name components)
    add_library(${target} STATIC ${components})
    target_link_libraries(${target} PUBLIC NLM::nlm_core)
endmacro()
