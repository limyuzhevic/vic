# NLM Modern CMake Configuration

# This file provides configuration options for the NLM project
# It includes modern CMake features and best practices

# Project-wide configuration options

set(NLM_VERSION_MAJOR 0)
set(NLM_VERSION_MINOR 1)
set(NLM_VERSION_PATCH 0)

# Feature flags
option(NLM_BUILD_TESTS "Build unit tests" ON)
option(NLM_BUILD_EXAMPLES "Build example applications" ON)
option(NLM_ENABLE_PROFILING "Enable profiling support" ON)
option(NLM_ENABLE_COVERAGE "Enable code coverage reporting" OFF)
option(NLM_ENABLE_ASAN "Enable AddressSanitizer" OFF)
option(NLM_ENABLE_MSAN "Enable MemorySanitizer" OFF)
option(NLM_ENABLE_TSAN "Enable ThreadSanitizer" OFF)

# Build type configuration
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

# Default build type
if(NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE "RelWithDebInfo" CACHE STRING "Build type" FORCE)
endif()

# Compiler flags
set(CMAKE_CXX_FLAGS_DEBUG "${CMAKE_CXX_FLAGS_DEBUG} -g -O0 -DDEBUG=1")
set(CMAKE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS_RELEASE} -O3 -DNDEBUG=1")
set(CMAKE_CXX_FLAGS_RELWITHDEBINFO "${CMAKE_CXX_FLAGS_RELWITHDEBINFO} -O2 -g")

# Installation directories
set(NLM_INCLUDE_INSTALL_DIR "include" CACHE PATH "Installation directory for headers")
set(NLM_LIB_INSTALL_DIR "lib" CACHE PATH "Installation directory for libraries")
set(NLM_BIN_INSTALL_DIR "bin" CACHE PATH "Installation directory for executables")

# Package configuration
set(NLM_PACKAGE_NAME "nlm")
set(NLM_PACKAGE_VERSION "${NLM_VERSION_MAJOR}.${NLM_VERSION_MINOR}.${NLM_VERSION_PATCH}")

# Target exports
export(TARGETS nlm_core nlm_neural nlm_plasticity nlm_memory nlm_neuromodulation
              nlm_development nlm_cognition nlm_sensory nlm_prediction nlm_motor
              nlm_environment nlm_experiment nlm_agent
        FILE "${CMAKE_CURRENT_BINARY_DIR}/NLMTargets.cmake")

# Documentation configuration
set(DOXYGEN_INPUT "${CMAKE_CURRENT_SOURCE_DIR}/src")
set(DOXYGEN_OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/docs")
