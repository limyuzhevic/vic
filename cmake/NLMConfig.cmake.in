# NLM Package Configuration File for CMake
# This file is generated automatically by CMake and installed with the project

@PACKAGE_INIT@

# Include the targets file for modern CMake consumption
include("${CMAKE_CURRENT_LIST_DIR}/NLMTargets.cmake")

# Find dependencies
find_package(Threads REQUIRED)

# Create imported target for core library
if(NOT TARGET nlm_core)
    include("${CMAKE_CURRENT_LIST_DIR}/nlm_coreTargets.cmake")
endif()

# Version information
set(NLM_VERSION_MAJOR @PROJECT_VERSION_MAJOR@)
set(NLM_VERSION_MINOR @PROJECT_VERSION_MINOR@)
set(NLM_VERSION_PATCH @PROJECT_VERSION_PATCH@)
set(NLM_VERSION ${NLM_VERSION_MAJOR}.${NLM_VERSION_MINOR}.${NLM_VERSION_PATCH})

# Provide variables for finding the package
set(NLM_INCLUDE_DIR "@CMAKE_INSTALL_INCLUDEDIR@")
set(NLM_LIBRARY_DIR "@CMAKE_INSTALL_LIBDIR@")
set(NLM_BIN_DIR "@CMAKE_INSTALL_BINDIR@")

# Function to find NLM package
function(find_nlm)
    if(NOT NLM_FOUND)
        find_package(nlm REQUIRED)
    endif()
    if(TARGET nlm::nlm_core)
        return()
    endif()
    
    # Create alias targets for modern CMake usage
    if(NOT TARGET nlm::nlm_core)
        add_library(nlm::nlm_core ALIAS nlm_core)
    endif()
    
    if(NOT TARGET nlm::nlm_agent)
        add_library(nlm::nlm_agent ALIAS nlm_agent)
    endif()
    
    if(NOT TARGET nlm::nlm_world)
        add_library(nlm::nlm_world ALIAS nlm_world)
    endif()
    
    set(NLM_FOUND TRUE PARENT_SCOPE)
endfunction()
