#pragma once

# NLM Configuration File
# This file is generated by CMake and provides configuration variables for NLM

# Core library dependencies
find_package(nlm_core REQUIRED)

# Phase 2 neural computation
find_package(nlm_phase2 REQUIRED)

# Phase 3 experiments
find_package(nlm_phase3 REQUIRED)

# Phase 4 experiments
find_package(nlm_phase4 REQUIRED)

# Phase 5 performance optimizations
find_package(nlm_phase5 REQUIRED)

# Agent system
find_package(nlm_agent REQUIRED)

# World system
find_package(nlm_world REQUIRED)

# Include configuration macros
include("${CMAKE_CURRENT_LIST_DIR}/NLMConfigMacros.cmake")

# Create imported targets for NLM components
if(NOT TARGET nlm::core)
    add_library(nlm::core ALIAS nlm_core)
endif()

if(NOT TARGET nlm::phase2)
    add_library(nlm::phase2 ALIAS nlm_phase2)
endif()

if(NOT TARGET nlm::phase3)
    add_library(nlm::phase3 ALIAS nlm_phase3)
endif()

if(NOT TARGET nlm::phase4)
    add_library(nlm::phase4 ALIAS nlm_phase4)
endif()

if(NOT TARGET nlm::phase5)
    add_library(nlm::phase5 ALIAS nlm_phase5)
endif()

if(NOT TARGET nlm::agent)
    add_library(nlm::agent ALIAS nlm_agent)
endif()

if(NOT TARGET nlm::world)
    add_library(nlm::world ALIAS nlm_world)
endif()

# Provide configuration variables
set(NLM_VERSION ${PROJECT_VERSION})
set(NLM_INCLUDE_DIR "${CMAKE_CURRENT_LIST_DIR}/../../include")
set(NLM_LIBRARY_DIR "${CMAKE_CURRENT_LIST_DIR}/../lib")

# Check if features are enabled
include("${CMAKE_CURRENT_LIST_DIR}/FeatureDetection.cmake")

# Create package configuration for find_package
configure_package_config_file(
    "${CMAKE_CURRENT_LIST_DIR}/NLMConfig.cmake.in"
    "${CMAKE_CURRENT_BINARY_DIR}/NLMConfig.cmake"
    INSTALL_DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/NLM"
)

write_basic_package_version_file(
    "${CMAKE_CURRENT_BINARY_DIR}/NLMConfigVersion.cmake"
    VERSION ${PROJECT_VERSION}
    COMPATIBILITY AnyNewerVersion
)

# Install configuration files
install(FILES
    "${CMAKE_CURRENT_BINARY_DIR}/NLMConfig.cmake"
    "${CMAKE_CURRENT_BINARY_DIR}/NLMConfigVersion.cmake"
    DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/NLM"
)