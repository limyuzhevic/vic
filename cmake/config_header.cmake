# Configuration header generation for NLM project

# Generate configuration header from template
function(generate_config_header)
    # Set up configuration header generation
    set(NLM_CONFIG_HEADER "${CMAKE_CURRENT_BINARY_DIR}/nlm_config.h")
    set(NLM_CONFIG_HEADER_SOURCE "${CMAKE_CURRENT_SOURCE_DIR}/config/nlm_config.h.in")
    
    # Configure project information
    configure_file(
        "${NLM_CONFIG_HEADER_SOURCE}"
        "${NLM_CONFIG_HEADER}"
        @ONLY
    )
    
    # Create directory for generated headers
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}")
    
    # Add custom target for regeneration
    add_custom_target(generate_config_header
        COMMAND ${CMAKE_COMMAND} -D CONFIG_HEADER_SOURCE="${NLM_CONFIG_HEADER_SOURCE}"
                -D CONFIG_HEADER_OUTPUT="${NLM_CONFIG_HEADER}"
                -P ${CMAKE_CURRENT_SOURCE_DIR}/cmake/config_header_generation.cmake
        COMMENT "Generate configuration header"
        VERBATIM
    )
    
    message(STATUS "Configuration header will be generated at: ${NLM_CONFIG_HEADER}")
endfunction()

# Generate version information
function(generate_version_info)
    # Generate version header
    set(NLM_VERSION_HEADER "${CMAKE_CURRENT_BINARY_DIR}/nlm_version.h")
    set(NLM_VERSION_SOURCE "${CMAKE_CURRENT_SOURCE_DIR}/cmake/version.h.in")
    
    # Read version from CMake project
    set(NLM_VERSION_MAJOR "${PROJECT_VERSION_MAJOR}")
    set(NLM_VERSION_MINOR "${PROJECT_VERSION_MINOR}")
    set(NLM_VERSION_PATCH "${PROJECT_VERSION_PATCH}")
    set(NLM_VERSION_TWEAK "${PROJECT_VERSION_TWEAK}")
    
    # Get current date and time
    string(TIMESTAMP NLM_BUILD_DATE "%Y-%m-%d")
    string(TIMESTAMP NLM_BUILD_TIME "%H:%M:%S")
    
    # Configure version header
    configure_file(
        "${NLM_VERSION_SOURCE}"
        "${NLM_VERSION_HEADER}"
        @ONLY
    )
    
    # Create version information target
    add_custom_target(version_info
        COMMAND echo "NLM Version: ${PROJECT_VERSION}"
        COMMAND echo "Build date: ${NLM_BUILD_DATE}"
        COMMAND echo "Build time: ${NLM_BUILD_TIME}"
        COMMENT "Display version information"
        VERBATIM
    )
endfunction()

# Generate build configuration summary
function(generate_build_summary)
    # Create build summary file
    set(BUILD_SUMMARY "${CMAKE_CURRENT_BINARY_DIR}/BUILD_SUMMARY.txt")
    
    file(WRITE "${BUILD_SUMMARY}"
        "NLM Build Summary\n"
        "==================\n\n"
        "Project: NLM ${PROJECT_VERSION}\n"
        "Build type: ${CMAKE_BUILD_TYPE}\n"
        "Compiler: ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}\n"
        "Architecture: ${CMAKE_SYSTEM_PROCESSOR}\n"
        "Build directory: ${CMAKE_CURRENT_BINARY_DIR}\n"
        "Source directory: ${CMAKE_CURRENT_SOURCE_DIR}\n\n"
    )
    
    # Add summary to targets
    add_custom_target(build_summary
        COMMAND cat "${BUILD_SUMMARY}"
        COMMENT "Display build summary"
        VERBATIM
    )
endfunction()

# Generate configuration for different build types
function(generate_build_config)
    # Create build configuration files
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/config.h"
        "#pragma once\n"
        "// Build configuration generated by CMake\n\n"
        "#define NLM_BUILD_TYPE \"${CMAKE_BUILD_TYPE}\"\n"
        "#define NLM_CXX_STANDARD ${CMAKE_CXX_STANDARD}\n"
        "#define NLM_COMPILER_ID \"${CMAKE_CXX_COMPILER_ID}\"\n\n"
        "#ifdef _WIN32\n"
        "#define NLM_PLATFORM \"Windows\"\n"
        "#elif __APPLE__\n"
        "#define NLM_PLATFORM \"macOS\"\n"
        "#elif __linux__\n"
        "#define NLM_PLATFORM \"Linux\"\n"
        "#else\n"
        "#define NLM_PLATFORM \"Unknown\"\n"
        "#endif\n\n"
        "// Generated by CMake ${CMAKE_VERSION}\n"
    )
    
    # Install build configuration
    install(FILES "${CMAKE_CURRENT_BINARY_DIR}/config.h"
        DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/nlm
    )
endfunction()

# Generate dependency information
function(generate_dependency_info)
    # Create dependency information file
    set(DEPENDENCY_INFO "${CMAKE_CURRENT_BINARY_DIR}/DEPENDENCIES.txt")
    
    file(WRITE "${DEPENDENCY_INFO}"
        "NLM Dependencies\n"
        "=================\n\n"
        "Python: ${Python_FOUND}\n"
        "pybind11: ${pybind11_FOUND}\n"
        "Doxygen: ${DOXYGEN_FOUND}\n"
        "Graphviz: ${GRAPHVIZ_FOUND}\n\n"
    )
    
    # Add dependency analysis target
    add_custom_target(dependency_info
        COMMAND cat "${DEPENDENCY_INFO}"
        COMMENT "Display dependency information"
        VERBATIM
    )
endfunction()

# Configuration file generation
function(generate_configuration_files)
    # Generate CMake configuration for different build types
    foreach(build_type "Debug" "Release" "RelWithDebInfo" "MinSizeRel")
        set(CONFIG_FILE "${CMAKE_CURRENT_BINARY_DIR}/config_${build_type}.cmake")
        
        file(WRITE "${CONFIG_FILE}"
            "# CMake configuration for ${build_type} build\n"
            "set(CMAKE_BUILD_TYPE ${build_type})\n\n"
            "# Build-specific settings\n"
        )
        
        if(${build_type} STREQUAL "Debug")
            file(APPEND "${CONFIG_FILE}" "add_compile_options(-g -O0 -DDEBUG)\n")
        elseif(${build_type} STREQUAL "Release")
            file(APPEND "${CONFIG_FILE}" "add_compile_options(-O3 -DNDEBUG)\n")
        elseif(${build_type} STREQUAL "RelWithDebInfo")
            file(APPEND "${CONFIG_FILE}" "add_compile_options(-O2 -g -DNDEBUG)\n")
        elseif(${build_type} STREQUAL "MinSizeRel")
            file(APPEND "${CONFIG_FILE}" "add_compile_options(-Os -DNDEBUG)\n")
        endif()
    endforeach()
endfunction()

# Generate comprehensive build system report
function(generate_build_report)
    # Create comprehensive build report
    set(BUILD_REPORT "${CMAKE_CURRENT_BINARY_DIR}/BUILD_REPORT.md")
    
    file(WRITE "${BUILD_REPORT}"
        "# NLM Build Report\n"
        "==================\n\n"
        "## Build Configuration\n\n"
        "- **Project Version**: ${PROJECT_VERSION}\n"
        "- **Build Type**: ${CMAKE_BUILD_TYPE}\n"
        "- **Compiler**: ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}\n"
        "- **Architecture**: ${CMAKE_SYSTEM_PROCESSOR}\n"
        "- **Build Directory**: ${CMAKE_CURRENT_BINARY_DIR}\n"
        "- **Source Directory**: ${CMAKE_CURRENT_SOURCE_DIR}\n\n"
        "## Targets\n\n"
        "### Libraries\n\n"
        "- nlm_core (core neural network library)\n"
        "- nlm_agent (agent system)\n"
        "- nlm_world (world simulation)\n"
        "- nlm_phase3 (Phase 3 experiments)\n"
        "- nlm_phase4 (Phase 4 experiments)\n\n"
        "### Executables\n\n"
        "- nlm (main demo)\n"
        "- nlm_phase3_demo (Phase 3 demo)\n"
        "- nlm_phase4_demo (Phase 4 demo)\n\n"
        "## Dependencies\n\n"
    )
    
    # Add report generation target
    add_custom_target(build_report
        COMMAND cat "${BUILD_REPORT}"
        COMMENT "Generate build report"
        VERBATIM
    )
endfunction()

# Main configuration generation entry point
function(generate_all_configurations)
    # Generate all configuration files
    generate_config_header()
    generate_version_info()
    generate_build_summary()
    generate_build_config()
    generate_dependency_info()
    generate_configuration_files()
    generate_build_report()
    
    # Create main config generation target
    add_custom_target(config_generation
        COMMAND ${CMAKE_COMMAND} -P ${CMAKE_CURRENT_SOURCE_DIR}/cmake/configure_all.cmake
        COMMENT "Generate all configuration files"
        VERBATIM
    )
endfunction()