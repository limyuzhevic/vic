# Documentation generation script
# This script generates documentation for NLM project

# Find Doxygen
find_package(Doxygen QUIET)

if (DOXYGEN_FOUND)
    message(STATUS "Doxygen found: ${DOXYGEN_VERSION}")
    
    # Set up Doxygen configuration
    set(DOXYGEN_IN ${CMAKE_CURRENT_SOURCE_DIR}/docs/Doxygen.in)
    set(DOXYGEN_OUT ${CMAKE_CURRENT_BINARY_DIR}/docs)
    
    # Configure Doxygen input file
    if (EXISTS "${DOXYGEN_IN}")
        configure_file(
            "${DOXYGEN_IN}"
            "${DOXYGEN_OUT}/Doxygen.cfg"
            @ONLY
        )
    endif()
    
    # Generate documentation using Doxygen
    add_custom_target(docs_generation
        COMMAND ${DOXYGEN_EXECUTABLE} "${DOXYGEN_OUT}/Doxygen.cfg"
        WORKING_DIRECTORY "${DOXYGEN_OUT}"
        COMMENT "Generate Doxygen documentation"
        VERBATIM
    )
    
    # Install documentation
    install(DIRECTORY ${DOXYGEN_OUT}/html/
        DESTINATION ${CMAKE_INSTALL_DOCDIR}/html
        COMPONENT docs
    )
    
    # Generate API documentation index
    add_custom_target(api_index
        COMMAND ${CMAKE_COMMAND} -E echo "# NLM API Documentation\n"
                ${CMAKE_COMMAND} -E echo "Generated by Doxygen ${DOXYGEN_VERSION}" > ${CMAKE_CURRENT_BINARY_DIR}/docs/API_INDEX.html
        COMMAND echo "<a href=\"html/index.html\">Full API Documentation</a>" >> ${CMAKE_CURRENT_BINARY_DIR}/docs/API_INDEX.html
        COMMENT "Generate API documentation index"
        VERBATIM
    )
    
    # Add dependencies
    add_dependencies(docs_generation api_index)
    
else()
    message(WARNING "Doxygen not found. Documentation generation disabled.")
    
    # Create dummy documentation target
    add_custom_target(docs_generation
        COMMAND ${CMAKE_COMMAND} -E echo "Doxygen not found. Install doxygen to generate documentation."
        COMMENT "Generate placeholder documentation"
        VERBATIM
    )
endif()

# Generate project documentation
function(generate_project_docs)
    # Create project documentation directory
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/docs/project")
    
    # Generate project structure documentation
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/docs/project/STRUCTURE.md"
        "# NLM Project Structure\n"
        "=========================\n\n"
        "## Overview\n\n"
        "The NLM (Neural Learning Machine) project is an experimental artificial \n"
        "developmental brain project that implements neural systems capable of \n"
        "learning from experience.\n\n"
        "## Main Components\n\n"
        "### Core Libraries\n\n"
        "- `nlm_core`: Core neural network library with neurons, synapses, and dynamics\n"
        "- `nlm_agent`: Agent system for sensory perception and action\n"
        "- `nlm_world`: World simulation environment\n"
        "- `nlm_phase3`: Phase 3 experiments (world interaction)\n"
        "- `nlm_phase4`: Phase 4 experiments (cognition and memory)\n\n"
        "### Executables\n\n"
        "- `nlm`: Main demonstration with real neural computation\n"
        "- `nlm_phase3_demo`: Phase 3 world interaction demo\n"
        "- `nlm_phase4_demo`: Phase 4 cognition demo\n\n"
        "## Build System\n\n"
        "The project uses modern CMake with target-based library organization.\n"
        "Key features include:\n\n"
        "- Modular CMake architecture with external modules\n"
        "- Comprehensive dependency management\n"
        "- Advanced build configurations\n"
        "- Package export system\n"
        "- Documentation generation\n"
        "- Comprehensive testing framework\n\n"
    )
    
    # Generate build system documentation
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/docs/project/BUILD_SYSTEM.md"
        "# NLM Build System\n"
        "===================\n\n"
        "## CMake Version\n\n"
        "Requires CMake 3.16 or higher.\n\n"
        "## Build Types\n\n"
        "### Debug\n\n"
        "Optimized for debugging with symbols and minimal optimizations.\n\n"
        "### Release\n\n"
        "Optimized for performance with maximum optimizations.\n\n"
        "### RelWithDebInfo\n\n"
        "Balanced build with debug symbols and optimizations.\n\n"
        "### MinSizeRel\n\n"
        "Optimized for minimum binary size.\n\n"
        "## Configuration Options\n\n"
        "### NLM_ENABLE_TESTS\n\n"
        "Enable/disable testing framework.\n\n"
        "### NLM_ENABLE_PERFORMANCE_ANALYSIS\n\n"
        "Enable performance analysis and profiling.\n\n"
        "## Installation\n\n"
        "```bash\n"
        "mkdir build && cd build\n"
        "cmake .. -DCMAKE_BUILD_TYPE=Release\n"
        "make -j4\n"
        "sudo make install\n"
        "```\n\n"
    )
    
    # Generate development documentation
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/docs/project/DEVELOPMENT.md"
        "# NLM Development\n"
        "=================\n\n"
        "## Building for Development\n\n"
        "```bash\nmkdir build && cd build\n"
        "cmake .. -DCMAKE_BUILD_TYPE=Debug\n"
        "make -j4\n"
        "```\n\n"
        "## Running Tests\n\n"
        "```bash\nmake test_all\n"
        "```\n\n"
        "## Adding New Components\n\n"
        "1. Add new source files to `src/` directory\n"
        "2. Create appropriate CMakeLists.txt in subsystem directories\n"
        "3. Link new targets with existing dependencies\n"
        "4. Update documentation as needed\n\n"
        "## Contributing\n\n"
        "- Follow existing code style and conventions\n"
        "- Add tests for new functionality\n"
        "- Update documentation\n"
        "- Ensure backward compatibility\n\n"
    )
endfunction()

# Call project documentation generation
generate_project_docs()

# Create documentation generation target
add_custom_target(docs_generation_all
    COMMAND ${CMAKE_COMMAND} -P ${CMAKE_CURRENT_SOURCE_DIR}/cmake/docs_generation.cmake
    COMMENT "Generate all project documentation"
    VERBATIM
)

# Add documentation installation
install(DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/docs/project/
    DESTINATION ${CMAKE_INSTALL_DOCDIR}/project
    FILES_MATCHING PATTERN "*.md"
)

message(STATUS "Documentation generation configuration complete")