# Test configuration generation script
# This script generates comprehensive test configuration for NLM project

# Include testing helpers
include(cmake/testing.cmake)

# Set up test environment
function(setup_test_environment)
    # Create test directories
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/test_data")
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/test_results")
    
    # Set test-specific variables
    set(TEST_RANDOM_SEED 12345 CACHE STRING "Random seed for reproducible tests")
    set(TEST_TIMEOUT 300 CACHE STRING "Default test timeout in seconds")
    set(TEST_PARALLEL_JOBS 4 CACHE STRING "Number of parallel test jobs")
    
    # Enable test coverage if available
    if (CMAKE_BUILD_TYPE STREQUAL "Debug")
        if (CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
            set(TEST_COVERAGE TRUE)
        endif()
    endif()
    
    # Configure test framework
    configure_test_framework()
endfunction()

# Configure test framework
function(configure_test_framework)
    # Find and configure Google Test
    include(FetchContent)
    FetchContent_Declare(
        googletest
        GIT_REPOSITORY https://github.com/google/googletest.git
        GIT_TAG release-1.12.1
    )
    
    FetchContent_MakeAvailable(googletest)
    
    # Enable testing
    enable_testing()
endfunction()

# Generate test configuration
function(generate_test_configuration)
    # Create test configuration file
    set(TEST_CONFIG "${CMAKE_CURRENT_BINARY_DIR}/test_config.cmake")
    
    file(WRITE "${TEST_CONFIG}"
        "# NLM Test Configuration\n"
        "# Generated by CMake ${PROJECT_VERSION}\n\n"
        "# Test settings\n"
        "set(TEST_RANDOM_SEED ${TEST_RANDOM_SEED})\n"
        "set(TEST_TIMEOUT ${TEST_TIMEOUT})\n"
        "set(TEST_PARALLEL_JOBS ${TEST_PARALLEL_JOBS})\n\n"
        "# Test framework configuration\n"
        "if (TEST_COVERAGE)\n"
        "    add_compile_options(--coverage)\n"
        "    add_link_options(--coverage)\n"
        "endif()\n\n"
        "# Test target definitions\n"
        "add_executable(nlm_test_all\n"
        "    tests/test_main.cpp\n"
        "    tests/test_types.cpp\n"
        "    tests/test_config.cpp\n"
        "    tests/test_random.cpp\n"
        "    tests/test_clock.cpp\n"
        "    tests/test_neuron.cpp\n"
        "    tests/test_synapse.cpp\n"
        "    tests/test_stdp.cpp\n"
        "    tests/test_brain.cpp\n"
        ")\n\n"
        "target_link_libraries(nlm_test_all PRIVATE nlm_core GTest::gtest_main)\n"
        "add_test(NAME nlm_test_all COMMAND nlm_test_all)\n\n"
    )
    
    # Create unit tests configuration
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/unit_tests.cmake"
        "# Unit tests configuration\n\n"
        "add_executable(nlm_unit_tests\n"
        "    tests/unit/core_types_test.cpp\n"
        "    tests/unit/config_test.cpp\n"
        "    tests/unit/random_test.cpp\n"
        ")\n\n"
        "target_link_libraries(nlm_unit_tests PRIVATE nlm_core GTest::gtest_main)\n"
    )
    
    # Create integration tests configuration
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/integration_tests.cmake"
        "# Integration tests configuration\n\n"
        "add_executable(nlm_integration_tests\n"
        "    tests/integration/brain_integration_test.cpp\n"
        "    tests/integration/memory_integration_test.cpp\n"
        "    tests/integration/plasticity_integration_test.cpp\n"
        ")\n\n"
        "target_link_libraries(nlm_integration_tests PRIVATE nlm_core nlm_agent nlm_world GTest::gtest_main)\n"
    )
endfunction()

# Generate benchmark configuration
function(generate_benchmark_configuration)
    # Create benchmark configuration
    set(BENCHMARK_CONFIG "${CMAKE_CURRENT_BINARY_DIR}/benchmark_config.cmake")
    
    file(WRITE "${BENCHMARK_CONFIG}"
        "# NLM Benchmark Configuration\n"
        "# Generated by CMake ${PROJECT_VERSION}\n\n"
        "# Benchmark targets\n"
        "add_executable(nlm_benchmark_core\n"
        "    tests/benchmark/core_performance.cpp\n"
        ")\n\n"
        "target_link_libraries(nlm_benchmark_core PRIVATE nlm_core)\n\n"
        "add_executable(nlm_benchmark_plasticity\n"
        "    tests/benchmark/plasticity_performance.cpp\n"
        ")\n\n"
        "target_link_libraries(nlm_benchmark_plasticity PRIVATE nlm_core)\n\n"
        "add_executable(nlm_benchmark_memory\n"
        "    tests/benchmark/memory_performance.cpp\n"
        ")\n\n"
        "target_link_libraries(nlm_benchmark_memory PRIVATE nlm_core)\n\n"
        "# Add benchmarks to CTest\n"
        "add_test(NAME nlm_benchmark_core COMMAND nlm_benchmark_core)\n"
        "add_test(NAME nlm_benchmark_plasticity COMMAND nlm_benchmark_plasticity)\n"
        "add_test(NAME nlm_benchmark_memory COMMAND nlm_benchmark_memory)\n"
    )
endfunction()

# Generate test documentation
function(generate_test_documentation)
    # Create test documentation directory
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/docs/test")
    
    # Generate test framework documentation
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/docs/test/TEST_FRAMEWORK.md"
        "# NLM Test Framework\n"
        "===================\n\n"
        "## Overview\n\n"
        "The NLM test framework is based on Google Test (gtest) and provides \n"
        "comprehensive testing capabilities for the neural learning machine.\n\n"
        "## Test Categories\n\n"
        "### Unit Tests\n\n"
        "- `nlm_unit_tests`: Core unit tests for individual components\n"
        "  - Core types (neurons, synapses, etc.)\n"
        "  - Configuration system\n"
        "  - Random number generation\n\n"
        "### Integration Tests\n\n"
        "- `nlm_integration_tests`: System integration tests\n"
        "  - Brain system integration\n"
        "  - Memory system integration\n"
        "  - Plasticity system integration\n\n"
        "### Performance Tests\n\n"
        "- Benchmark tests for performance analysis\n"
        "  - Core performance benchmarks\n"
        "  - Plasticity performance benchmarks\n"
        "  - Memory performance benchmarks\n\n"
        "## Running Tests\n\n"
        "```bash\n"
        "# Run all tests
        make test_all
        
        # Run unit tests only
        make test_unit
        
        # Run integration tests only
        make test_integration
        
        # Run benchmark tests only
        make test_benchmark
        ```\n\n"
    )
    
    # Generate test API documentation
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/docs/test/TEST_API.md"
        "# NLM Test API\n"
        "============\n\n"
        "## Test Macros\n\n"
        "```cpp\n"
        "// Test fixture definition\n"
        "class TestName : public ::testing::Test {\n"
        "protected:\n"
        "    void SetUp() override { /* setup code */ }\n"
        "    void TearDown() override { /* cleanup code */ }\n"
        "};\n\n"
        "// Test case\n"
        "TEST_F(TestName, TestCaseName) {\n"
        "    // Test code\n"
        "    EXPECT_EQ(actual, expected);\n"
        "}\n"
        "```\n\n"
    )
endfunction()

# Generate test analysis
function(generate_test_analysis)
    # Create test analysis directory
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/analysis")
    
    # Generate test coverage analysis
    add_custom_target(test_coverage_analysis
        COMMAND gcovr --exclude test_*.cpp --exclude *gtest* --print-summary
        WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}
        COMMENT "Generate test coverage analysis"
        VERBATIM
    )
    
    # Generate test performance analysis
    add_custom_target(test_performance_analysis
        COMMAND echo "Test performance analysis requires additional tools"
        COMMENT "Generate test performance analysis"
        VERBATIM
    )
endfunction()

# Main test configuration generation
function(generate_complete_test_configuration)
    # Set up test environment
    setup_test_environment()
    
    # Generate test configuration
    generate_test_configuration()
    
    # Generate benchmark configuration
    generate_benchmark_configuration()
    
    # Generate test documentation
    generate_test_documentation()
    
    # Generate test analysis
    generate_test_analysis()
    
    # Create main test configuration target
    add_custom_target(test_configuration
        COMMAND ${CMAKE_COMMAND} -P ${CMAKE_CURRENT_SOURCE_DIR}/cmake/test_configuration.cmake
        COMMENT "Generate complete test configuration"
        VERBATIM
    )
endfunction()

# Execute complete test configuration
generate_complete_test_configuration()

# Print test configuration summary
