# pkg-config file for NLM neural simulation framework
# Generated by CMake for package management and build systems

prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=@CMAKE_INSTALL_PREFIX@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: nlm
Description: NLM - Neural Learning Machine (熙然): An experimental artificial developmental brain
Version:@PROJECT_VERSION@
Libs: -L${libdir} -lnlm_core -lnlm_agent -lnlm_world
Cflags: -I${includedir}

# Additional component libraries
Requires: ${libdir}/libnlm_phase3.a ${libdir}/libnlm_phase4.a

# Provides for find_package compatibility
Provides: nlm-core nlm-agent nlm-world

# Development package dependencies
Requires.private: 

# Build requirements
Requires.build: cmake >=3.16
