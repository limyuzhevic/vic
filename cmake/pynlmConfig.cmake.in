@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/pynlmTargets.cmake")

# Add find_package dependencies for Python and pybind11
find_dependency(Python REQUIRED COMPONENTS Interpreter Development)
find_dependency(pybind11 REQUIRED)

# Provide Python-specific configuration
configure_file(
    "${CMAKE_CURRENT_LIST_DIR}/pynlmConfig.cmake.in"
    "${CMAKE_CURRENT_LIST_DIR}/pynlmConfig.cmake"
    COPYONLY
)
