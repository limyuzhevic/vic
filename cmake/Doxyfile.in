# Doxyfile template for NLM documentation generation
# Customize this template for your project needs

# Doxygen configuration file generated by cmake

DOXYGEN_EXECUTABLE @DOXYGEN_EXECUTABLE@

# Project configuration
PROJECT_NAME     = "NLM"
PROJECT_NUMBER   = "@PROJECT_VERSION@"
PROJECT_BRIEF    = "Neuromorphic Learning Machine library"
PROJECT_LOGO     = ""
INPUT            = @DOXYGEN_INPUT_DIR@
OUTPUT_DIRECTORY = @DOXYGEN_OUTPUT_DIR@

# File filtering
FILTER_PATTERNS = *.h;*.hpp

# Include files
INCLUDE_PATH     = src

# Documentation generation options
GENERATE_HTML     = YES
GENERATE_LATEX    = NO
GENERATE_MAN      = NO
GENERATE_RTF      = NO
GENERATE_XML      = NO
GENERATE_DOCBOOK  = NO
GENERATE_CHI      = NO
GENERATE_PHPWORD  = NO

# Index options
GENERATE_INDEX   = YES
GENERATE_TREEGEN = NO
GENERATE_PERLMOD = NO

# Cross-references
CASE_SENSITIVE_NAMES = NO
HIDE_SCOPE_NAMES     = YES
HIDE_COMPOUND_NAMES  = NO
HIDE_IN_BODY_DOCS   = NO
INTERNAL_DOCS       = YES
CASE_SENSE_NAMES     = YES

# Source browsing
SOURCE_BROWSER   = YES
INLINE_SOURCES   = YES
REFERENCED_BY_ATTR = YES
REFERENCES_ATTR   = YES

# Call graphs and inheritance
CALL_GRAPH        = YES
CALLER_GRAPH      = NO
GRAPHICAL_HIERARCHY = YES
INCLUDED_BY_GRAPH = YES
INCLUDE_GRAPH     = YES

# Documentation formatting
JAVADOC_AS_RTL    = NO
ALPHABETICAL_INDEX = YES
SORT_MEMBERS_CONSISTENTLY = YES

# Code formatting
INDENT_STYLE     = 2
METHOD_SEPARATOR = " "

# Other options
INLINE_INHERITED = YES
MATCH_COMMENTS    = YES
EXCLUDE_PATTERNS = "*/tests/*" "*/examples/*" "*/docs/*"
EXCLUDE_SYMBOLS  = "*demo*" "*test*"

# Output options
GENERATE_TAGFILE    = "NLM.tag"
GENERATE_HTMLHELP   = NO
CHM_FILE            = "NLM.chm"
HHC_LOCATION        = ""
WINDOW_TITLE        = "NLM Documentation"

# Indexing
GENERATE_LAM      = NO
FORMULA_FONTSIZE  = 10
FORMULA_NUMBERING = ALL

# Customizations
CPLUSPLUS         = YES
EXTENDED_SYNTAX  = YES

# Resources
TEMPLATE_REL_PATH = ""
IMAGE_PATH        = ""
