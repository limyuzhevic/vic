cmake/nlm-config.cmake.in
nlm-config.cmake
# File automatically generated by CMake configuration system

@PACKAGE_INIT@

# Import target configurations
include("${CMAKE_CURRENT_LIST_DIR}/nlm-config.cmake")

# Provide find_package compatibility
set(NLM_FOUND TRUE)
set(NLM_VERSION ${PROJECT_VERSION})

# Define imported targets for CMake package management
if(NOT TARGET nlm::nlm_core)
    add_library(nlm::nlm_core INTERFACE IMPORTED)
    set_target_properties(nlm::nlm_core PROPERTIES
        INTERFACE_LINK_LIBRARIES "nlm_core"
    )
endif()

if(NOT TARGET nlm::nlm_agent)
    add_library(nlm::nlm_agent INTERFACE IMPORTED)
    set_target_properties(nlm::nlm_agent PROPERTIES
        INTERFACE_LINK_LIBRARIES "nlm_agent"
    )
endif()

# Export function for component-based usage
macro(nlm_add_component component_name target_name)
    add_library(${component_name} INTERFACE)
    target_link_libraries(${component_name} INTERFACE ${target_name})
    export(TARGETS ${target_name} FILE "${CMAKE_CURRENT_LIST_DIR}/${component_name}Targets.cmake")
endmacro()
