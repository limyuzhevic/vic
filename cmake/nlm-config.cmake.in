@PACKAGE_INIT@

# Version compatibility
set_and_check(NLM_INCLUDE_DIR "${NLM_INSTALL_PREFIX}/include")

# Find dependencies
include(CMakeFindDependencyMacro)

# Import targets
include("${CMAKE_CURRENT_LIST_DIR}/nlmTargets.cmake")

# Provide legacy variables for backward compatibility
set(NLM_FOUND TRUE)
set(NLM_LIBRARIES nlm_core nlm_agent nlm_world)
set(NLM_INCLUDE_DIRS "${NLM_INSTALL_PREFIX}/include")

# Provide export-style variables
set(NLM_VERSION_MAJOR @PROJECT_VERSION_MAJOR@)
set(NLM_VERSION_MINOR @PROJECT_VERSION_MINOR@)
set(NLM_VERSION_PATCH @PROJECT_VERSION_PATCH@)
set(NLM_VERSION "${PROJECT_VERSION}")

# Message for users
message(STATUS "NLM ${NLM_VERSION} configuration loaded")

# Provide FindNLM.cmake file for compatibility
configure_file(
    "${CMAKE_CURRENT_LIST_DIR}/FindNLM.cmake.in"
    "${CMAKE_CURRENT_LIST_DIR}/FindNLM.cmake"
    @ONLY
)

# Documentation message
message(STATUS "Use find_package(NLM REQUIRED) for modern CMake usage")
message(STATUS "Or include ${NLM_INSTALL_PREFIX}/include/nlm/nlm.hpp for direct inclusion")