#pragma once

# NLM CMake Package Configuration
# This file is generated by CMake's package configuration system

include(CMakeFindDependencyMacro)

# Include the library targets
include("${CMAKE_CURRENT_LIST_DIR}/nlm-targets.cmake")

# Create imported targets for backward compatibility
add_library(nlm::core ALIAS nlm_core)
add_library(nlm::agent ALIAS nlm_agent)
add_library(nlm::world ALIAS nlm_world)
add_library(nlm::framework ALIAS nlm_framework)
add_library(nlm::phase3 ALIAS nlm_phase3)
add_library(nlm::phase4 ALIAS nlm_phase4)
add_library(nlm::phase5 ALIAS nlm_phase5)
add_library(nlm::phase6 ALIAS nlm_phase6)

# Create convenience executables
add_executable(nlm::nlm_main ALIAS nlm_main)
add_executable(nlm::nlm_phase3_demo ALIAS nlm_phase3_demo)
add_executable(nlm::nlm_phase4_demo ALIAS nlm_phase4_demo)
add_executable(nlm::nlm_phase6_demo ALIAS nlm_phase6_demo)
add_executable(nlm::nlm_benchmark ALIAS nlm_benchmark)

# NLM configuration variables
set(NLM_VERSION ${NLM_VERSION})
set(NLM_VERSION_MAJOR ${NLM_VERSION_MAJOR})
set(NLM_VERSION_MINOR ${NLM_VERSION_MINOR})
set(NLM_VERSION_PATCH ${NLM_VERSION_PATCH})

# Find NLM and make available to other CMake projects
function(find_nlm)
    find_package(nlm REQUIRED)
endfunction()

# NLM helper functions
function(nlm_add_test test_name test_target)
    add_test(NAME ${test_name} COMMAND ${test_target})
    set_tests_properties(${test_name} PROPERTIES
        LABELS "neural;network;simulation"
        TIMEOUT 300
    )
endfunction()

function(nlm_add_example example_name example_target)
    add_executable(${example_name} ${example_target})
    target_link_libraries(${example_name} PUBLIC nlm::core)
    add_custom_target(run_${example_name}
        COMMAND ${example_name}
        DEPENDS ${example_name}
        COMMENT "Running ${example_name} example"
    )
endfunction()