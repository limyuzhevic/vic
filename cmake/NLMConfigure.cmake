# NLM Development Configuration
# Create directories and setup basic development structure

# Create common directories
file(MAKE_DIRECTORY ${CMAKE_BINARY_DIR}/configs)
file(MAKE_DIRECTORY ${CMAKE_BINARY_DIR}/logs)
file(MAKE_DIRECTORY ${CMAKE_BINARY_DIR}/output)
file(MAKE_DIRECTORY ${CMAKE_BINARY_DIR}/checkpoints)
file(MAKE_DIRECTORY ${CMAKE_BINARY_DIR}/tests)

# Copy default configuration if it doesn't exist
if(NOT EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/configs/default.cfg)
    file(WRITE ${CMAKE_CURRENT_SOURCE_DIR}/configs/default.cfg
        "# Default NLM Configuration\n"
        "# Generated by CMake\n\n"
        "; Core settings\n"
        "[CORE]\n"
        "neuron_count=1000\n"
        "region_count=1\n\n"
        "; Plasticity settings\n"
        "[PLASTICITY]\n"
        "stdp_ltp_weight=0.02\n"
        "stdp_ltd_weight=0.015\n"
        "stdp_tau=20.0\n"
        "synaptogenesis_rate=0.0001\n"
        "pruning_rate=0.00001\n\n"
        "; Simulation settings\n"
        "[SIMULATION]\n"
        "simulation_timestep=0.001\n"
        "random_seed=42\n"
        "connection_probability=0.1\n\n"
        "; Logging settings\n"
        "[LOGGING]\n"
        "log_level=info\n"
        "log_file=logs/nlm.log\n"
    )
endif()

# Display configuration summary
message(STATUS "NLM Configuration:")
message(STATUS "  Source directory: ${NLM_SOURCE_DIR}")
message(STATUS "  Build type: ${CMAKE_BUILD_TYPE}")
message(STATUS "  C++ standard: ${CMAKE_CXX_STANDARD}")
message(STATUS "  Threads max: ${NLM_THREADS_MAX}")
message(STATUS "  Log level: ${NLM_LOG_LEVEL}")
