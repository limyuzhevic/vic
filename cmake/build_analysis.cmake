# Build analysis orchestration script
# This script orchestrates the generation of build analysis for NLM project

# Include build analysis helpers
include(cmake/build_analysis.cmake)

# Set up build analysis environment
if (NOT DEFINED NLM_BUILD_ANALYSIS_CONFIGURED)
    cmake_minimum_required(VERSION 3.16)
    project(NLM VERSION 0.1.0 LANGUAGES CXX)
    set(NLM_BUILD_ANALYSIS_CONFIGURED TRUE)
endif()

# Generate build timing analysis
function(generate_build_timing_analysis)
    # Create timing analysis file
    set(BUILD_TIMING_FILE "${CMAKE_CURRENT_BINARY_DIR}/analysis/build_timing.txt")
    
    file(WRITE "${BUILD_TIMING_FILE}"
        "# NLM Build Timing Analysis\n"
        "# Generated by CMake ${PROJECT_VERSION}\n\n"
        "## Build Configuration\n\n"
        "### CMake Version\n"
        "CMake ${CMAKE_VERSION}\n\n"
        "### Build Type\n"
        "${CMAKE_BUILD_TYPE}\n\n"
        "### Compiler\n"
        "${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}\n\n"
        "### System\n"
        "${CMAKE_SYSTEM_NAME} ${CMAKE_SYSTEM_PROCESSOR}\n\n"
        "## Build Targets\n\n"
    )
    
    # List all targets
    get_property(all_targets GLOBAL PROPERTY GLOBAL_TARGETS)
    foreach(target ${all_targets})
        get_target_property(target_type ${target} TYPE)
        if (target_type)
            file(APPEND "${BUILD_TIMING_FILE}"
                "- ${target} (${target_type})\n"
            )
        endif()
    endforeach()
    
    file(APPEND "${BUILD_TIMING_FILE}" "\n")
endfunction()

# Generate dependency analysis
function(generate_dependency_analysis)
    # Generate dependency graph
    add_custom_target(dependency_analysis
        COMMAND ${CMAKE_COMMAND} --graphviz=${CMAKE_BINARY_DIR}/dependency_graph.dot
            ${CMAKE_BINARY_DIR}/CMakeCache.txt
        COMMENT "Generate dependency graph"
        VERBATIM
    )
    
    # Generate detailed dependency information
    set(DEPENDENCY_INFO "${CMAKE_CURRENT_BINARY_DIR}/analysis/dependencies.txt")
    
    file(WRITE "${DEPENDENCY_INFO}"
        "# NLM Dependency Analysis\n"
        "# Generated by CMake ${PROJECT_VERSION}\n\n"
        "## Core Dependencies\n\n"
        "### Core Libraries\n"
        "- nlm_core: All core neural network functionality\n"
        "- nlm_agent: Agent system for sensory perception\n"
        "- nlm_world: World simulation environment\n"
        "- nlm_phase3: Phase 3 experiments (world interaction)\n"
        "- nlm_phase4: Phase 4 experiments (cognition and memory)\n\n"
    )
endfunction()

# Generate memory usage analysis
function(generate_memory_usage_analysis)
    # Create memory usage analysis file
    set(MEMORY_ANALYSIS "${CMAKE_CURRENT_BINARY_DIR}/analysis/memory_usage.txt")
    
    file(WRITE "${MEMORY_ANALYSIS}"
        "# NLM Memory Usage Analysis\n"
        "# Generated by CMake ${PROJECT_VERSION}\n\n"
        "## Memory Configuration\n\n"
        "### Position Independent Code\n"
        "Enabled: ${CMAKE_POSITION_INDEPENDENT_CODE}\n\n"
    )
endfunction()

# Generate build performance analysis
function(generate_build_performance_analysis)
    # Create performance analysis file
    set(PERFORMANCE_ANALYSIS "${CMAKE_CURRENT_BINARY_DIR}/analysis/performance.txt")
    
    file(WRITE "${PERFORMANCE_ANALYSIS}"
        "# NLM Build Performance Analysis\n"
        "# Generated by CMake ${PROJECT_VERSION}\n\n"
        "## Build Configuration\n\n"
        "### Compiler Optimizations\n"
    )
    
    if (CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
        file(APPEND "${PERFORMANCE_ANALYSIS}"
            "- GCC/Clang optimizations enabled\n"
        )
    elseif(MSVC)
        file(APPEND "${PERFORMANCE_ANALYSIS}"
            "- MSVC optimizations enabled\n"
        )
    endif()
endfunction()

# Generate comprehensive build analysis report
function(generate_build_analysis_report)
    # Create main build analysis report
    set(BUILD_ANALYSIS_REPORT "${CMAKE_CURRENT_BINARY_DIR}/BUILD_ANALYSIS.md")
    
    file(WRITE "${BUILD_ANALYSIS_REPORT}"
        "# NLM Build Analysis Report\n"
        "==========================\n\n"
        "## Overview\n\n"
        "This report provides comprehensive analysis of the NLM (Neural Learning Machine) \n"
        "project build configuration, dependencies, and performance characteristics.\n\n"
    )
endfunction()

# Generate optimization recommendations
function(generate_optimization_recommendations)
    # Create optimization recommendations file
    set(OPTIMIZATION_RECOMMENDATIONS "${CMAKE_CURRENT_BINARY_DIR}/analysis/optimization_recommendations.txt")
    
    file(WRITE "${OPTIMIZATION_RECOMMENDATIONS}"
        "# NLM Build Optimization Recommendations\n"
        "# Generated by CMake ${PROJECT_VERSION}\n\n"
        "## General Recommendations\n\n"
    )
endfunction()

# Main build analysis orchestration
function(orchestrate_build_analysis)
    # Execute all build analysis functions
    generate_build_timing_analysis()
    generate_dependency_analysis()
    generate_memory_usage_analysis()
    generate_build_performance_analysis()
    generate_build_analysis_report()
    generate_optimization_recommendations()
    
    # Create main build analysis target
    add_custom_target(build_analysis
        COMMAND ${CMAKE_COMMAND} -P ${CMAKE_CURRENT_SOURCE_DIR}/cmake/build_analysis.cmake
        COMMENT "Generate complete build analysis"
        VERBATIM
    )
endfunction()

# Execute build analysis orchestration
orchestrate_build_analysis()

# Print build analysis summary
message(STATUS "\nBuild Analysis Summary")
message(STATUS "=====================")
message(STATUS "Build analysis orchestration completed successfully!")

# Display next steps
message(STATUS "\nNext Steps:")
message(STATUS "1. Run 'cmake --build . --target build_analysis' to generate build analysis")
message(STATUS "2. Check generated analysis files in ${CMAKE_CURRENT_BINARY_DIR}/analysis/")
message(STATUS "3. Review BUILD_ANALYSIS.md for comprehensive report")
message(STATUS "4. Use optimization recommendations to improve build performance")

message(STATUS "\nBuild analysis orchestration completed successfully!")