# Package configuration generation script
# This script generates CMake package configuration files

# Include CMake package configuration helpers
include(CMakePackageConfigHelpers)

# Generate package version file
generate_package_version_file(
    "${CMAKE_CURRENT_BINARY_DIR}/NLMConfigVersion.cmake"
    VERSION ${PROJECT_VERSION}
    COMPATIBILITY AnyNewerVersion
    ARCH_INDEPENDENT OFF
)

# Generate package configuration file
set(NLM_CONFIG_IN "${CMAKE_CURRENT_SOURCE_DIR}/cmake/NLMConfig.cmake.in")

if (EXISTS "${NLM_CONFIG_IN}")
    configure_package_config_file(
        "${NLM_CONFIG_IN}"
        "${CMAKE_CURRENT_BINARY_DIR}/NLMConfig.cmake"
        INSTALL_DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/NLM
        NO_SET_AND_CHECK_MACRO
        NO_CHECK_REQUIRED_COMPONENTS_MACRO
    )
else()
    # Create minimal package config if template doesn't exist
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/NLMConfig.cmake"
        "# NLM Package Configuration\n"
        "# Generated by CMake ${PROJECT_VERSION}\n\n"
        "# Include all targets\n"
        "include(\"${CMAKE_CURRENT_BINARY_DIR}/NLMTargets.cmake\")\n\n"
        "# Package-specific macros\n"
        "macro(nlm_add_executable target_name src_file)\n"
        "    add_executable(${target_name} ${src_file})\n"
        "    target_link_libraries(${target_name} PRIVATE nlm_core)\n"
        "endmacro()\n\n"
        "macro(nlm_add_library target_name src_files)\n"
        "    add_library(${target_name} STATIC ${src_files})\n"
        "    target_link_libraries(${target_name} PUBLIC nlm_core)\n"
        "endmacro()\n"
    )
endif()

# Generate export set
export(TARGETS nlm_core nlm_agent nlm_world nlm_phase3 nlm_phase4
       FILE "${CMAKE_CURRENT_BINARY_DIR}/NLMTargets.cmake"
       NAMESPACE NLM::)

# Create package directory
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/cmake")

# Install package files
install(FILES
    "${CMAKE_CURRENT_BINARY_DIR}/NLMConfig.cmake"
    "${CMAKE_CURRENT_BINARY_DIR}/NLMConfigVersion.cmake"
    DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/NLM
)

# Install export file
install(EXPORT NLMTargets
    FILE NLMTargets.cmake
    NAMESPACE NLM::
    DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/NLM
)

# Generate package README
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/README.md"
    "# NLM Package\n"
    "===========\n\n"
    "This package contains the NLM (Neural Learning Machine) libraries.\n\n"
    "## Usage\n\n"
    "```cmake\n"
    "find_package(NLM REQUIRED)\n\n"
    "# Use NLM::nlm_core target\n"
    "target_link_libraries(your_target PRIVATE NLM::nlm_core)\n"
    "```\n\n"
    "## Components\n\n"
    "- `NLM::nlm_core`: Core neural network library\n"
    "- `NLM::nlm_agent`: Agent system\n"
    "- `NLM::nlm_world`: World simulation\n"
    "- `NLM::nlm_phase3`: Phase 3 experiments\n"
    "- `NLM::nlm_phase4`: Phase 4 experiments\n\n"
    "## Targets\n\n"
    "- `nlm`: Main executable\n"
    "- `nlm_phase3_demo`: Phase 3 demonstration\n"
    "- `nlm_phase4_demo`: Phase 4 demonstration\n"
    "\n"
    "Generated by CMake ${PROJECT_VERSION}\n"
)

# Install README
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/README.md"
    DESTINATION ${CMAKE_INSTALL_DOCDIR}/nlm
)

message(STATUS "Package configuration generated:")
message(STATUS "  - ${CMAKE_CURRENT_BINARY_DIR}/NLMConfig.cmake")
message(STATUS "  - ${CMAKE_CURRENT_BINARY_DIR}/NLMConfigVersion.cmake")
message(STATUS "  - ${CMAKE_CURRENT_BINARY_DIR}/NLMTargets.cmake")
message(STATUS "  - ${CMAKE_CURRENT_BINARY_DIR}/README.md")

# Create package generation target
add_custom_target(package_generation
    COMMAND ${CMAKE_COMMAND} -P ${CMAKE_CURRENT_SOURCE_DIR}/cmake/package_config.cmake
    COMMENT "Generate package configuration"
    VERBATIM
)