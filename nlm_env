#!/usr/bin/env bash

# NLM Environment Creation Tools
# Advanced tools for creating custom environments and visualization
    
    echo -e "${BLUE}Creating NLM Environment: $env_name${NC}"
    echo -e "Environment type: $env_type"
    
    # Generate environment based on type
    case "$env_type" in
        "simple")
            create_simple_environment "$env_name" "$output_file"
            ;;
        "complex")
            create_complex_environment "$env_name" "$output_file"
            ;;
        "custom")
            create_custom_environment "$env_name" "$output_file"
            ;;
        *)
            echo -e "${RED}Unknown environment type: $env_type${NC}"
            echo -e "Available types: simple, complex, custom"
            exit 1
            ;;
    esac
}

# Create simple environment
create_simple_environment() {
    local env_name="$1"
    local output_file="$2"
    
    cat > "$output_file" << EOF
{
    "environment_name": "$env_name",
    "environment_type": "simple",
    "world_size": {
        "width": 20,
        "height": 20
    },
    "agents": [
        {
            "id": "agent_1",
            "start_position": {"x": 5, "y": 5},
            "brain_config": "default"
        }
    ],
    "objects": [
        {
            "id": "food",
            "type": "resource",
            "value": 1.0,
            "spawn_rate": 0.1
        },
        {
            "id": "obstacle",
            "type": "static",
            "size": {"width": 2, "height": 2}
        }
    ],
    "sensory_parameters": {
        "vision_range": 10,
        "vision_angles": ["N", "NE", "E", "SE", "S", "SW", "W", "NW"],
        "vision_resolution": 72
    },
    "action_parameters": {
        "movements": ["stay", "north", "south", "east", "west"],
        "max_steps": 1000
    },
    "reward_parameters": {
        "food_reward": 1.0,
        "obstacle_penalty": -0.5,
        "time_decay": 0.01
    },
    "metadata": {
        "created": "$(date -Iseconds)",
        "version": "1.0",
        "description": "Simple grid-based environment for NLM experiments"
    }
}
EOF
    
    echo -e "${GREEN}Simple environment created: $output_file${NC}"
}

