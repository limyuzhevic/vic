void NLMTestSuite::printResults() const {
    std::cout << "=== Test Results Summary ===" << std::endl;
    
    for (const auto& result : testResults_) {
        std::cout << "  " << (result.passed ? "PASS" : "FAIL") << ": " << result.name 
                  << " (" << result.duration << "s) - " << result.message << std::endl;
    }
}

bool NLMTestSuite::saveResults(const std::string& filename) const {
    try {
        std::ofstream file(filename);
        if (!file.is_open()) {
            return false;
        }
        
        file << "=== NLM Improvements Test Results ===" << std::endl;
        file << std::endl;
        
        for (const auto& result : testResults_) {
            file << result.name << "," << (result.passed ? "PASS" : "FAIL") 
                 << "," << result.duration << "," << result.message << std::endl;
        }
        
        file << std::endl;
        file << "Statistics:" << std::endl;
        file << "  Total tests: " << stats_.totalTests << std::endl;
        file << "  Passed: " << stats_.passedTests << std::endl;
        file << "  Failed: " << stats_.failedTests << std::endl;
        file << "  Duration: " << stats_.totalDuration << " seconds" << std::endl;
        
        file.close();
        
        return true;
    } catch (const std::exception& e) {
        return false;
    }
}

