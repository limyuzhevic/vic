bool NLMTestSuite::runTestSuite(bool quick) {
    quick_ = quick;
    
    std::cout << "=== NLM Improvements Test Suite ===" << std::endl;
    std::cout << "Starting comprehensive test suite..." << std::endl;
    std::cout << "Mode: " << (quick_ ? "Quick" : "Full") << std::endl;
    std::cout << std::endl;
    
    auto startTime = std::chrono::steady_clock::now();
    
    bool success = true;
    
    // Run unit tests (always)
    if (!runUnitTests()) {
        success = false;
    }
    
    // Run integration tests
    if (!runIntegrationTests()) {
        success = false;
    }
    
    // Run performance tests (not in quick mode)
    if (!quick_) {
        if (!runPerformanceTests()) {
            success = false;
        }
    }
    
    // Run documentation tests
    if (!runDocumentationTests()) {
        success = false;
    }
    
    auto endTime = std::chrono::steady_clock::now();
    auto duration = std::chrono::duration_cast<std::chrono::seconds>(endTime - startTime);
    
    calculateStatistics();
    generateSummary();
    
    std::cout << std::endl;
    std::cout << "=== Test Suite Complete ===" << std::endl;
    std::cout << "Total duration: " << duration.count() << " seconds" << std::endl;
    std::cout << "Tests passed: " << stats_.passedTests << "/" << stats_.totalTests << std::endl;
    std::cout << "Success: " << (success ? "Yes" : "No") << std::endl;
    
    if (!success) {
        std::cerr << "Test suite completed with failures" << std::endl;
        return false;
    }
    
    return true;
}

bool NLMTestSuite::runTest(const std::string& testName, std::function<bool()> testFunction) {
    bool passed = false;
    double duration = 0.0;
    std::string message;
    
    auto startTime = std::chrono::steady_clock::now();
    
    try {
        passed = testFunction();
        if (passed) {
            message = "PASSED";
        } else {
            message = "FAILED";
        }
    } catch (const std::exception& e) {
        passed = false;
        message = "EXCEPTION: " + std::string(e.what());
    } catch (...) {
        passed = false;
        message = "UNKNOWN EXCEPTION";
    }
    
    auto endTime = std::chrono::steady_clock::now();
    duration = std::chrono::duration_cast<std::chrono::seconds>(endTime - startTime).count();
    
    TestResult result(testName, passed, duration, message);
    testResults_.push_back(result);
    
    if (verbose_) {
        std::cout << "  " << (passed ? "PASS" : "FAIL") << ": " << testName << " (" << duration << "s) - " << message << std::endl;
    }
    
    return passed;
}

bool NLMTestSuite::runTestWithTiming(const std::string& testName, std::function<bool()> testFunction) {
    // Similar to runTest but with more detailed timing
    return runTest(testName, testFunction);
}

