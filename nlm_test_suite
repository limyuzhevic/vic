void NLMTestSuite::calculateStatistics() {
    stats_.totalTests = testResults_.size();
    stats_.passedTests = 0;
    stats_.failedTests = 0;
    stats_.totalDuration = 0.0;
    
    for (const auto& result : testResults_) {
        if (result.passed) {
            stats_.passedTests++;
        } else {
            stats_.failedTests++;
        }
        stats_.totalDuration += result.duration;
    }
}

void NLMTestSuite::generateSummary() {
    std::cout << std::endl;
    std::cout << "=== Test Summary ===" << std::endl;
    std::cout << "Total tests: " << stats_.totalTests << std::endl;
    std::cout << "Passed: " << stats_.passedTests << std::endl;
    std::cout << "Failed: " << stats_.failedTests << std::endl;
    std::cout << "Success rate: " << (stats_.totalTests > 0 ? 
                                  (static_cast<double>(stats_.passedTests) / stats_.totalTests) * 100.0 : 0.0) << "%" << std::endl;
}

int main(int argc, char* argv[]) {
    bool quick = false;
    bool verbose = false;
    bool debug = false;
    bool performance = false;
    bool integration = false;
    bool unit = false;
    bool help = false;
    
    // Parse command line arguments
    for (int i = 1; i < argc; ++i) {
        std::string arg = argv[i];
        
        if (arg == "--help" || arg == "-h") {
            help = true;
        } else if (arg == "--quick") {
            quick = true;
        } else if (arg == "--verbose" || arg == "-v") {
            verbose = true;
        } else if (arg == "--debug") {
            debug = true;
        } else if (arg == "--performance") {
            performance = true;
        } else if (arg == "--integration") {
            integration = true;
        } else if (arg == "--unit") {
            unit = true;
        } else if (arg == "--full") {
            // Use full test suite
        } else {
            std::cerr << "Unknown argument: " << arg << std::endl;
        }
    }
    
    if (help) {
        std::cout << "=== NLM Improvements Test Suite ===" << std::endl;
        std::cout << std::endl;
        std::cout << "Usage: ./nlm_test_suite [options]" << std::endl;
        std::cout << std::endl;
        std::cout << "Options:" << std::endl;
        std::cout << "  --help, -h              Show help message" << std::endl;
        std::cout << "  --quick                 Run quick tests only" << std::endl;
        std::cout << "  --verbose, -v           Enable verbose output" << std::endl;
        std::cout << "  --debug                 Run with debug output" << std::endl;
        std::cout << "  --full                  Run full test suite (default)" << std::endl;
        std::cout << "  --performance           Run performance benchmarks" << std::endl;
        std::cout << "  --integration           Run integration tests" << std::endl;
        std::cout << "  --unit                  Run unit tests" << std::endl;
        std::cout << std::endl;
        std::cout << "Examples:" << std::endl;
        std::cout << "  ./nlm_test_suite --help" << std::endl;
        std::cout << "  ./nlm_test_suite --quick" << std::endl;
        std::cout << "  ./nlm_test_suite --verbose --debug" << std::endl;
        return 0;
    }
    
    NLMTestSuite testSuite;
    testSuite.setVerbose(verbose);
    testSuite.setDebug(debug);
    
    if (unit && integration && performance) {
        std::cout << "Running all tests (unit, integration, performance)" << std::endl;
    } else if (unit) {
        std::cout << "Running unit tests only" << std::endl;
    } else if (integration) {
        std::cout << "Running integration tests only" << std::endl;
    } else if (performance) {
        std::cout << "Running performance tests only" << std::endl;
    } else {
        std::cout << "Running all tests" << std::endl;
    }
    
    bool success = testSuite.runTestSuite(quick);
    
    if (!success) {
        std::cout << std::endl;
        std::cout << "=== Test Suite Failed ===" << std::endl;
        testSuite.printResults();
        return 1;
    }
    
    std::cout << std::endl;
    std::cout << "=== Test Suite Complete ===" << std::endl;
    testSuite.printResults();
    
    // Save results if requested
    if (!debug) {
        std::string outputFile = "/tmp/nlm_test_results.txt";
        testSuite.saveResults(outputFile);
        std::cout << std::endl;
        std::cout << "Results saved to: " << outputFile << std::endl;
    }
    
    return 0;
}
