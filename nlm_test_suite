bool NLMImprovementsDemo::saveResults(const std::string& filename) const {
    try {
        std::ofstream file(filename);
        if (!file.is_open()) {
            return false;
        }
        
        file << "=== NLM Improvements Demonstration Results ===" << std::endl;
        file << std::endl;
        
        for (const auto& result : demoResults_) {
            file << result.name << "," << (result.passed ? "PASS" : "FAIL") 
                 << "," << result.duration << "," << result.message << std::endl;
        }
        
        file << std::endl;
        file << "Statistics:" << std::endl;
        file << "  Total demonstrations: " << demoResults_.size() << std::endl;
        
        size_t passedCount = 0;
        for (const auto& result : demoResults_) {
            if (result.passed) passedCount++;
        }
        file << "  Passed: " << passedCount << std::endl;
        file << "  Failed: " << (demoResults_.size() - passedCount) << std::endl;
        
        file.close();
        
        return true;
    } catch (const std::exception& e) {
        return false;
    }
}

