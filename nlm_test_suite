void NLMImprovementsDemo::calculateStatistics() {
    size_t total = demoResults_.size();
    size_t passed = 0;
    size_t failed = 0;
    double totalDuration = 0.0;
    
    for (const auto& result : demoResults_) {
        if (result.passed) {
            passed++;
        } else {
            failed++;
        }
        totalDuration += result.duration;
    }
    
    std::cout << std::endl;
    std::cout << "=== Statistics ===" << std::endl;
    std::cout << "Total demonstrations: " << total << std::endl;
    std::cout << "Passed: " << passed << std::endl;
    std::cout << "Failed: " << failed << std::endl;
    std::cout << "Success rate: " << (total > 0 ? (static_cast<double>(passed) / total) * 100.0 : 0.0) << "%" << std::endl;
    std::cout << "Total duration: " << totalDuration << " seconds" << std::endl;
}

