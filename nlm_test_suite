int main(int argc, char* argv[]) {
    bool verbose = false;
    bool debug = false;
    bool help = false;
    
    // Parse command line arguments
    for (int i = 1; i < argc; ++i) {
        std::string arg = argv[i];
        
        if (arg == "--help" || arg == "-h") {
            help = true;
        } else if (arg == "--verbose" || arg == "-v") {
            verbose = true;
        } else if (arg == "--debug") {
            debug = true;
        } else {
            std::cerr << "Unknown argument: " << arg << std::endl;
        }
    }
    
    if (help) {
        std::cout << "=== NLM Improvements Demonstration ===" << std::endl;
        std::cout << std::endl;
        std::cout << "Usage: ./nlm_demo [options]" << std::endl;
        std::cout << std::endl;
        std::cout << "Options:" << std::endl;
        std::cout << "  --help, -h              Show help message" << std::endl;
        std::cout << "  --verbose, -v           Enable verbose output" << std::endl;
        std::cout << "  --debug                 Run with debug output" << std::endl;
        std::cout << std::endl;
        std::cout << "This program demonstrates all improvements made to the NLM codebase." << std::endl;
        return 0;
    }
    
    NLMImprovementsDemo demo;
    demo.setVerbose(verbose);
    demo.setDebug(debug);
    
    if (!demo.validateRequiredFiles()) {
        std::cerr << "ERROR: Missing required files for demonstration" << std::endl;
        return 1;
    }
    
    if (!demo.checkImprovementFiles()) {
        std::cerr << "ERROR: Missing improvement files" << std::endl;
        return 1;
    }
    
    std::cout << "Starting NLM Improvements Demonstration..." << std::endl;
    bool success = demo.runDemonstration();
    
    if (!success) {
        std::cerr << std::endl;
        std::cerr << "=== Demonstration Failed ===" << std::endl;
        demo.printResults();
        return 1;
    }
    
    std::cout << std::endl;
    std::cout << "=== Demonstration Complete ===" << std::endl;
    demo.printResults();
    
    // Save results if requested
    if (!debug) {
        std::string outputFile = "/tmp/nlm_improvements_demo_results.txt";
        demo.saveResults(outputFile);
        std::cout << std::endl;
        std::cout << "Results saved to: " << outputFile << std::endl;
    }
    
    return 0;
}

