# Doxygen configuration for NLM neural simulation project
# Use this with: doxygen Doxyfile.in

PROJECT_NAME           = "NLM (熙然) Neural Learning Machine"
PROJECT_NUMBER         = "Phase 6 Final Integration"
PROJECT_LOGO           = "docs/logo.png"
OUTPUT_DIRECTORY       = "docs/api"
GENERATE_LATEX         = NO
GENERATE_RTF          = NO
GENERATE_XML          = YES
GENERATE_HTML         = YES
GENERATE_CHI          = NO
GENERATE_MAN          = NO
GENERATE_TESTLIST     = NO
GENERATE_DOT          = YES
HAVE_DOT             = YES
DOT_FONTSIZE         = 10
CLASS_DIAGRAMS       = YES
HIDE_UNDOC_CLASSES    = NO
HIDE_UNDOC_MEMBERS    = NO
INLINE_INHERITS       = YES
SORT_MEMBER_DOCS      = NO
SORT_BRIEF_DOCS       = NO
SORT_BY_SCOPE_NAME    = YES
GENERATE_BUGLIST      = NO
GENERATE_TODOLIST     = YES
GENERATE_TESTLIST     = NO
GENERATE_ANNOTATION_DIRS = NO
EXTERNAL_GROUPS       = YES
PERL_PATH             = "/usr/bin/perl"
EXCLUDE_PATTERNS      = "*/build/*" "*/.git/*" "*/tests/*"
EXCLUDE_SYMBOLS       = "test_*
MACRO_EXPANSION     = YES
EXPAND_AS_DEFINED     = "NeuralNetwork" "SpikingNeuron" "SynapseMatrix"
EXPAND_PREDEFINED     = "#ifdef _WIN32\n#define DLL_EXPORT __declspec(dllexport)\n#endif\n"
SEARCHENGINE         = YES
SEARCHENGINE_URL     = "https://github.com/nlm-project/nlm"
USE_HTAGS            = YES
TAGFILES              = "nlm.tag=external/nlm.tag"
GENERATE_XML          = YES
XML_OUTPUT           = "xml"
XML_PROGRAMLISTING  = NO
ALLEXTERN_FILES       = "README.md" "LICENSE" "CHANGELOG.md"
OPTIMIZE_OUTPUT_FOR_C = NO
OPTIMIZE_OUTPUT_JAVA = NO
BUILTIN_STL_SUPPORT   = YES
CPP_REPOSITORY_URL   = "https://github.com/nlm-project/nlm.git"
CLANG_ASSISTED_PARSING = YES
CLANG_OPTIONS        = "-std=c++20 -I. -I./src"
QHP_FILE             = "nlm.qhp"
QTGIF_OUTDIR         = "qtgraph-output"
LAYOUT_FILE          = "docs/doxygen-layout.xml"
GENERATE_CUSTOM_LINKS = "NLM GitHub=https://github.com/nlm-project/nlm"
HTML_COLOR_STYLE     = "auto"
HTML_EXTRA_STYLESHEET = "docs/doxygen_custom.css"
HTML_EXTRA_FILES     = "docs/doxygen_custom.js" "docs/figures/*.png" "docs/figures/*.svg"
HTML_OUTPUT          = "html"
HTML_INDEX_NUM_ENTRIES = 100
GENERATE_HTML_HELP    = NO
CHM_FILE              = "nlm.chm"
HHC_LOCATION         = "C:/Program Files (x86)/HTML Help Workshop/hhc.exe"
GENERATE_CHI_HELP     = NO
CHM_INDEX_ENCODING   = "UTF-8"
ENCODE_FOR_EUC       = NO
ENCODE_FOR_MAC       = NO
EXPERIMENTAL_RTF     = NO
RESOLVE_SYMLINKS     = YES
REFERENCES_LINKED_TEXTS = "MathJax=https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"
MATHJAX_VERSION      = "3.0"
MATHJAX_FORMAT       = "HTML-CSS"
MATHJAX_RELPATH      = "https://cdn.jsdelivr.net/npm/mathjax@3/es5/"
SEARCHBOX_HTML_URL   = "https://google.com/search"
SEARCHBOX_DATABASE  = "https://www.google.com/cse/cseexample.html"
SEARCHBOX_CSP       = "default-src 'unsafe-inline' 'self' https://cdn.jsdelivr.net/ https://www.google.com/ https://www.gstatic.com/"
GENERATE_TODOLIST   = YES
TODO_TITLE          = "Todo list"
TODO_LIST_LIMIT     = 20
GENERATE_TESTLIST   = YES
TEST_LIST_LIMIT      = 20
FILE_PATTERNS        = "*.cpp" "*.hpp" "*.h" "*.py"
PRIVATE_MEMBER_DOCS  = NO
PROTECTED_MEMBER_DOCS = YES
PACKAGED_PRIVATE_SCOPS = YES

# Doxygen helper file generation
GENERATE_XML          = YES
GENERATE_HTML         = YES
GENERATE_LATEX        = NO
GENERATE_RTF         = NO
GENERATE_DOCSET      = YES
GENERATE_BRIEF_MEMBER_DOCS = YES
GENERATE_MEMBER_DOCS = YES
SEPARATE_MEMBER_PAGES = NO
INLINE_SOURCES       = NO
GENERATE_HTML         = YES
GENERATE_MAN         = NO
GENERATE_DOCSET      = YES
DOCSET_FEEDNAME      = "NLM Documentation"
DOCSET_FEEDURL       = "https://nlm.readthedocs.io"
DOCSET_PID_NAME      = "org.nlm.neural"
DOCSET_BUNDLE_ID     = "org.nlm.neural"
GENERATE_QHP         = YES
QHP_NAMESPACE        = "org.nlm.neural"
QHP_VIRTUAL_FOLDER   = "nlm"
QHP_CUST_OUTPUT_EXTENSION = ".html"
QHP_FILE             = "docs/api/nlm.qhp"
EXTERNAL_TOOLS_PATH = "C:/Program Files (x86)/Qt/bin"
EXTERNAL_TOOLS_TIMEOUT = 10
