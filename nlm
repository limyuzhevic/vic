#!/bin/bash

# NLM Command Line Interface
# Provides easy access to NLM demos and configuration management

cd "$(dirname "$0")"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Default configuration file
CONFIG_FILE="configs/default.cfg"

# Print help message
print_help() {
    cat << EOF
NLM - Neural Learning Machine Command Line Interface

USAGE: nlm [OPTIONS]

OPTIONS:
  -h, --help                    Show this help message
  -c, --config CONFIG_FILE      Specify configuration file (default: configs/default.cfg)
  --phase3-demo                 Run Phase 3 demo
  --phase4-demo                 Run Phase 4 demo
  --phase6-demo                 Run Phase 6 integration demo
  --benchmark                   Run benchmark suite
  --version                     Show version information

EXAMPLES:
  nlm --phase6-demo              Run Phase 6 integration demo with default config
  nlm -c custom.cfg --phase3-demo Run Phase 3 demo with custom config

For more information about using NLM, see HOW_TO_USE.md
EOF
}

# Print version information
print_version() {
    cat << EOF
NLM - Neural Learning Machine v0.1.0
Phase 2: Real Neural Computation
Built with C++20
EOF
}

# Run a demo with specified configuration
run_demo() {
    local demo_name="$1"
    local config_arg=""
    
    if [[ -n "$CONFIG_FILE" ]]; then
        config_arg="--config $CONFIG_FILE"
    fi
    
    echo -e "${BLUE}=== Running $demo_name ===${NC}"
    echo -e "Configuration file: $CONFIG_FILE"
    echo -e "Command: ./nlm $config_arg --phase6-demo"
    echo -e "Note: nlm is the main executable (built in the build directory)"
    echo
    
    # Check if build directory exists
    if [[ -d "build" ]]; then
        cd build
        echo -e "${YELLOW}Build directory found.${NC}"
        
        # Try to run the demo
        if [[ -f "nlm" ]]; then
            echo -e "${GREEN}Successfully running nlm ...${NC}"
        fi
    else
        echo -e "${RED}Error: Build directory not found.${NC}"
        echo -e "${YELLOW}Please run: mkdir build && cd build && cmake .. && make${NC}"
        return 1
    fi
    
    return 0
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            print_help
            exit 0
            ;;
        -c|--config)
            if [[ -n "$2" ]]; then
                CONFIG_FILE="$2"
                shift 2
            else
                echo -e "${RED}Error: --config requires a file argument${NC}"
                exit 1
            fi
            ;;
        --phase3-demo)
            run_demo "Phase 3 Demo"
            exit $?
            ;;
        --phase4-demo)
            run_demo "Phase 4 Demo"
            exit $?
            ;;
        --phase6-demo)
            run_demo "Phase 6 Integration Demo"
            exit $?
            ;;
        --benchmark)
            run_demo "Benchmark Suite"
            exit $?
            ;;
        --version)
            print_version
            exit 0
            ;;
        *)
            echo -e "${RED}Error: Unknown option: $1${NC}"
            echo -e "Use -h or --help for help"
            exit 1
            ;;
    esac
done

# If no arguments provided, show help
if [[ $# -eq 0 ]]; then
    print_help
fi
