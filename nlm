class NLMEnvironment:
    """High-level environment for NLM agent training."""
    
    def __init__(self, brain: NLMBrain, world: NLMWorld):
        """
        Initialize NLM environment.
        
        Args:
            brain: NLM brain instance
            world: NLM world instance
        """
        self.brain = brain
        self.world = world
        self._agent_brain = _pynlm.createAgentBrain(brain.brain)
        self._agent_brain.initialize(world.world)
    
    def run_episode(self, max_steps: int = 1000, enable_learning: bool = True) -> Dict[str, Any]:
        """
        Run a complete episode in the environment.
        
        Args:
            max_steps: Maximum number of steps per episode
            enable_learning: Enable learning mechanisms
        """
        if max_steps < 1:
            raise ValidationError(f"max_steps must be positive, got {max_steps}")
        
        # Enable learning subsystems
        if enable_learning:
            self._agent_brain.enableRewardModulation(True)
            self._agent_brain.enableCuriosity(True)
            self._agent_brain.enableDevelopment(True)
        
        # Reset environment
        self.world.reset()
        self.brain.reset()
        self._agent_brain.reset()
        
        # Initialize agent with world
        self._agent_brain.initialize(self.world.world)
        
        # Episode statistics
        episode_stats = EpisodeStats()
        
        try:
            # Run episode
            for step in range(max_steps):
                # Update world
                self.world.update(0.1)
                
                # Get sensory input
                percept = self.world.getSensoryPercept()
                
                # Process sensory input
                self._agent_brain.processSensoryInput(percept)
                
                # Run brain step
                self.brain.step(step)
                
                # Decode motor command
                motor_cmd = self._agent_brain.decodeMotorCommand()
                
                # Apply motor command
                self.world.applyMotorCommand(motor_cmd, self.world.getSimulationTime())
                
                # Apply reward modulation
                reward = percept.getInternal()[0] if percept.getInternal() else 0.0
                self._agent_brain.applyRewardModulation(reward, 0.0)
                
                # Update development
                self._agent_brain.updateDevelopment(0.1)
                
                # Collect statistics
                episode_stats.add_step_stats(
                    reward=reward,
                    firing_count=self.brain.getStats().get_firing_count(),
                    curiosity=self._agent_brain.getCuriosityLevel(),
                    novelty=self._agent_brain.getNoveltyLevel(),
                    prediction_error=self._agent_brain.getPredictionError()
                )
            
            # Episode completed successfully
            summary = episode_stats.get_summary()
            summary.update({
                'status': 'completed',
                'max_steps': max_steps,
                'brain_stats': self.brain.get_stats().get_activity_summary(),
                'environment_stats': {
                    'world_width': self.world.world.getWidth(),
                    'world_height': self.world.world.getHeight(),
                    'simulation_time': self.world.getSimulationTime()
                }
            })
            
            return summary
            
        except Exception as e:
            # Episode failed
            summary = episode_stats.get_summary()
            summary.update({
                'status': 'failed',
                'error': str(e),
                'error_type': type(e).__name__
            })
            return summary

# High-level convenience functions

def create_brain(config=None) -> NLMBrain:
    """Create a new NLM brain with default configuration."""
    return NLMBrain(config)

def create_world(width: int = 20, height: int = 20, 
                 vision_width: int = 8, vision_height: int = 8) -> NLMWorld:
    """Create a new NLM world."""
    return NLMWorld(width, height, vision_width, vision_height)

def create_agent_brain(brain: Union[NLMBrain, Any]) -> Any:
    """Create an agent brain interface for the given brain."""
    if isinstance(brain, NLMBrain):
        return brain.agent
    elif PYNLM_AVAILABLE and hasattr(brain, 'getBrain'):
        return _pynlm.createAgentBrain(brain.getBrain())
    else:
        raise InitializationError("Invalid brain object for agent creation")

def create_environment(brain: NLMBrain, world: NLMWorld) -> NLMEnvironment:
    """Create an environment for agent training."""
    return NLMEnvironment(brain, world)

def run_demo(config=None, world_size=15, max_steps=500):
    """
    Run a complete demonstration of NLM agent in world.
    
    This is a high-level convenience function that demonstrates
    the typical usage pattern for NLM agents in interactive environments.
    
    Args:
        config: Optional configuration
        world_size: Size of square world
        max_steps: Maximum simulation steps
    
    Returns:
        Dictionary with complete demonstration results
    """
    print(f"Starting NLM demonstration with {world_size}x{world_size} world...")
    print(f"Running up to {max_steps} simulation steps...")
    
    try:
        # Create components
        brain = create_brain(config)
        world = create_world(world_size, world_size, world_size//2, world_size//2)
        agent_brain = create_agent_brain(brain)
        
        # Initialize agent with world
        agent_brain.initialize(world.world)
        
        # Configure subsystems
        agent_brain.enableRewardModulation(True)
        agent_brain.enableCuriosity(True)
        agent_brain.enableDevelopment(True)
        
        # Set agent start position
        world.set_agent_start(world_size//2, world_size//2)
        
        # Run demonstration
        results = {
            'steps_completed': 0,
            'status': 'running',
            'brain_stats': [],
            'environment_stats': [],
            'learning_enabled': True
        }
        
        for step in range(max_steps):
            # Update world
            world.update(0.1)
            
            # Get sensory input
            percept = world.getSensoryPercept()
            
            # Process sensory input
            agent_brain.processSensoryInput(percept)
            
            # Run brain step
            brain.step(step)
            
            # Decode motor command
            motor_cmd = agent_brain.decodeMotorCommand()
            
            # Apply motor command
            world.applyMotorCommand(motor_cmd, world.getSimulationTime())
            
            # Apply reward modulation
            reward = percept.getInternal()[0] if percept.getInternal() else 0.0
            agent_brain.applyRewardModulation(reward, 0.0)
            
            # Update development
            agent_brain.updateDevelopment(0.1)
            
            # Collect statistics
            results['steps_completed'] = step + 1
            results['brain_stats'].append(brain.get_stats().get_activity_summary())
            results['environment_stats'].append({
                'time': world.getSimulationTime(),
                'position': world.getAgentBody().getPosition(),
                'reward': reward,
                'curiosity': agent_brain.getCuriosityLevel()
            })
            
            # Print progress periodically
            if (step + 1) % 100 == 0:
                print(f"  Step {step + 1}/{max_steps}: "
                      f"Reward={reward:.3f}, "
                      f"Curiosity={agent_brain.getCuriosityLevel():.3f}, "
                      f"Firing={brain.get_stats().get_firing_count()}")
        
        # Demonstration completed
        results.update({
            'status': 'completed',
            'final_brain_stats': brain.get_stats().get_activity_summary(),
            'final_environment_stats': results['environment_stats'][-1] if results['environment_stats'] else None,
            'brain': brain,
            'world': world,
            'agent_brain': agent_brain
        })
        
        print(f"\nDemo completed successfully!")
        print(f"Total steps: {results['steps_completed']}")
        print(f"Final brain stats: {brain}")
        
        return results
        
    except Exception as e:
        print(f"\nDemo failed with error: {e}")
        import traceback
        traceback.print_exc()
        return {'status': 'error', 'error': str(e), 'error_type': type(e).__name__}

