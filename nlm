#!/bin/bash

# NLM Command Line Interface
# Enhanced CLI for Neural Learning Machine (Phase 6)

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration file paths
DEFAULT_CONFIG="configs/default.cfg"
CONFIG_DIR="configs"

# Global configuration
VERBOSE=false
DRY_RUN=false
CONFIG_FILE="$DEFAULT_CONFIG"

# Print usage information
usage() {
    cat << EOF
$NLM Command Line Interface - Neural Learning Machine

USAGE:
    $0 [OPTIONS] [COMMAND] [ARGS...]

COMMANDS:
    run                Run the NLM simulation
    config             Configuration management
    debug              Debugging and analysis tools
    benchmark          Performance benchmarking
    help               Show this help message

OPTIONS:
    -h, --help         Show help message
    -v, --verbose      Enable verbose output
    -c, --config FILE  Configuration file (default: $DEFAULT_CONFIG)
    --dry-run          Validate configuration without running
    --version          Show version information

CONFIGURATION COMMANDS:
    config list        List all configuration keys
    config get KEY     Get configuration value for KEY
    config set KEY VALUE  Set configuration value
    config validate    Validate current configuration
    config export [FORMAT]  Export configuration to file
    config import FILE [FORMAT]  Import configuration from file

DEBUGGING COMMANDS:
    debug neurons      Analyze neuron population statistics
    debug synapses    Analyze synaptic connectivity
    debug plasticity  Check plasticity rule effectiveness
    debug memory      Analyze memory system state
    debug neuromod     Analyze neuromodulatory signals

BENCHMARK COMMANDS:
    benchmark run [STEPS]     Run performance benchmark
    benchmark compare         Compare performance across configurations
    benchmark profile         Generate performance profile

EXAMPLES:
    $0 run --config my_config.json
    $0 config set neuron_count 2000
    $0 debug neurons --verbose
    $0 benchmark run --steps 1000
EOF
}

# Initialize configuration
init_config() {
    CONFIG_FILE="$DEFAULT_CONFIG"
    VERBOSE=false
    DRY_RUN=false
    
    # Parse command line arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                usage
                exit 0
                ;;
            -v|--verbose)
                VERBOSE=true
                shift
                ;;
            -c|--config)
                CONFIG_FILE="$2"
                shift 2
                ;;
            --dry-run)
                DRY_RUN=true
                shift
                ;;
            --version)
                echo "NLM Command Line Interface v6.0 (Phase 6 Final Integration)"
                exit 0
                ;;
            *)
                break
                ;;
        esac
    done
}

# Log messages
log() {
    if [[ "$VERBOSE" == true ]]; then
        echo -e "${GREEN}[INFO]${NC} $1"
    fi
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1" >&2
}

log_debug() {
    if [[ "$VERBOSE" == true ]]; then
        echo -e "${BLUE}[DEBUG]${NC} $1"
    fi
}

# Configuration management functions
config_list() {
    log "Listing all configuration keys..."
    
    if [[ ! -f "$CONFIG_FILE" ]]; then
        log_error "Configuration file not found: $CONFIG_FILE"
        return 1
    fi
    
    echo "Configuration keys in $CONFIG_FILE:"
    echo "============================================"
    
    if [[ "$CONFIG_FILE" == *.json ]]; then
        if command -v jq &> /dev/null; then
            jq 'keys | map("  \(.): \(. \| tostring)") | join("\\n")' "$CONFIG_FILE" 2>/dev/null || cat "$CONFIG_FILE" | grep -E '^[a-zA-Z_]' | sed 's/^/  /'
        else
            log_warning "jq not found, showing raw configuration"
            cat "$CONFIG_FILE" | grep -E '^[a-zA-Z_]' | sed 's/^/  /'
        fi
    elif [[ "$CONFIG_FILE" == *.yaml || "$CONFIG_FILE" == *.yml ]]; then
        if command -v yq &> /dev/null; then
            yq 'keys | map("  \(.): \(. \| tostring)") | join("\\n")' "$CONFIG_FILE" 2>/dev/null || cat "$CONFIG_FILE" | grep -E '^[a-zA-Z_]' | sed 's/^/  /'
        else
            log_warning "yq not found, showing raw configuration"
            cat "$CONFIG_FILE" | grep -E '^[a-zA-Z_]' | sed 's/^/  /'
        fi
    else
        # Simple key=value format
        cat "$CONFIG_FILE" | grep -E '^[a-zA-Z_][a-zA-Z0-9_]* = ' | sed 's/^/  /'
    fi
}

config_get() {
    local key="$1"
    
    if [[ -z "$key" ]]; then
        log_error "Key required for config get command"
        echo "Usage: $0 config get KEY"
        return 1
    fi
    
    log "Getting configuration value for key: $key"
    
    if [[ ! -f "$CONFIG_FILE" ]]; then
        log_error "Configuration file not found: $CONFIG_FILE"
        return 1
    fi
    
    if [[ "$CONFIG_FILE" == *.json ]]; then
        if command -v jq &> /dev/null; then
            local value=$(jq -r ".\"$key\" // \"\"" "$CONFIG_FILE")
            echo "$key = $value"
        else
            log_error "jq not found for JSON parsing"
            return 1
        fi
    elif [[ "$CONFIG_FILE" == *.yaml || "$CONFIG_FILE" == *.yml ]]; then
        if command -v yq &> /dev/null; then
            local value=$(yq -r ".\"$key\" // \"\"" "$CONFIG_FILE")
            echo "$key = $value"
        else
            log_error "yq not found for YAML parsing"
            return 1
        fi
    else
        # Simple key=value format
        local value=$(grep -E "^$key\s*=" "$CONFIG_FILE" | cut -d'=' -f2 | sed 's/^ *//;s/ *$//' | tr -d '\"' | tr -d "'")
        if [[ -n "$value" ]]; then
            echo "$key = $value"
        else
            log_error "Key not found in configuration: $key"
            return 1
        fi
    fi
}

config_set() {
    local key="$1"
    local value="$2"
    
    if [[ -z "$key" || -z "$value" ]]; then
        log_error "Key and value required for config set command"
        echo "Usage: $0 config set KEY VALUE"
        return 1
    fi
    
    log "Setting configuration key: $key = $value"
    
    if [[ ! -f "$CONFIG_FILE" ]]; then
        log_error "Configuration file not found: $CONFIG_FILE"
        return 1
    fi
    
    local temp_file
    temp_file=$(mktemp)
    
    if [[ "$CONFIG_FILE" == *.json ]]; then
        if command -v jq &> /dev/null; then
            jq ".\"$key\" = \"$value\"" "$CONFIG_FILE" > "$temp_file"
        else
            log_error "jq not found for JSON parsing"
            rm "$temp_file"
            return 1
        fi
    elif [[ "$CONFIG_FILE" == *.yaml || "$CONFIG_FILE" == *.yml ]]; then
        if command -v yq &> /dev/null; then
            yq ".\"$key\" = \"$value\"" "$CONFIG_FILE" > "$temp_file"
        else
            log_error "yq not found for YAML parsing"
            rm "$temp_file"
            return 1
        fi
    else
        # Simple key=value format - create new file
        {
            echo "# Updated configuration"
            echo "# Generated by NLM CLI on $(date)"
            echo ""
            # Keep existing comments and structure, update the key
            sed -n '/^[^#]* = / {s/^[^#]* = */'$key' = '$value'\\n/;p}' "$CONFIG_FILE" >> "$temp_file"
            # Add any remaining content
            sed -n '/^[a-zA-Z_][a-zA-Z0-9_]* = /!p' "$CONFIG_FILE" >> "$temp_file"
        } > "$temp_file"
    fi
    
    mv "$temp_file" "$CONFIG_FILE"
    log "Configuration updated successfully"
}

config_validate() {
    log "Validating configuration..."
    
    if [[ ! -f "$CONFIG_FILE" ]]; then
        log_error "Configuration file not found: $CONFIG_FILE"
        return 1
    fi
    
    local errors=0
    local warnings=0
    
    # Basic validation
    if [[ "$CONFIG_FILE" == *.json ]]; then
        if ! python3 -c "import json; json.load(open('$CONFIG_FILE'))" 2>/dev/null; then
            log_error "Invalid JSON format in configuration file"
            ((errors++))
        fi
        
        # Check for required keys
        local required_keys=("random_seed" "neuron_count" "simulation_timestep")
        for key in "${required_keys[@]}"; do
            if ! python3 -c "import json; data=json.load(open('$CONFIG_FILE')); print(data.get('$key', ''))" | grep -q .; then
                log_warning "Missing recommended configuration key: $key"
                ((warnings++))
            fi
        done
    
    elif [[ "$CONFIG_FILE" == *.yaml || "$CONFIG_FILE" == *.yml ]]; then
        if ! python3 -c "import yaml; yaml.safe_load(open('$CONFIG_FILE'))" 2>/dev/null; then
            log_error "Invalid YAML format in configuration file"
            ((errors++))
        fi
        
        # Check for required keys
        local required_keys=("random_seed" "neuron_count" "simulation_timestep")
        for key in "${required_keys[@]}"; do
            if ! python3 -c "import yaml; data=yaml.safe_load(open('$CONFIG_FILE')); print(data.get('$key', ''))" | grep -q .; then
                log_warning "Missing recommended configuration key: $key"
                ((warnings++))
            fi
        done
    
    else
        # Simple key=value format
        if ! grep -q '^[a-zA-Z_][a-zA-Z0-9_]* = ' "$CONFIG_FILE"; then
            log_error "Invalid simple key=value format in configuration file"
            ((errors++))
        fi
    fi
    
    if [[ $errors -eq 0 ]]; then
        log "Configuration validation passed"
        if [[ $warnings -gt 0 ]]; then
            log_warning "$warnings warnings found (see above)"
        fi
        return 0
    else
        log_error "$errors errors found in configuration"
        return 1
    fi
}

config_export() {
    local format="$1"
    
    if [[ -z "$format" ]]; then
        format="json"
    fi
    
    local export_file
    export_file="configs/exported_config.$format"
    
    log "Exporting configuration to $export_file (format: $format)"
    
    if [[ "$format" == "json" ]]; then
        if command -v jq &> /dev/null; then
            jq . "$CONFIG_FILE" > "$export_file"
        elif [[ "$CONFIG_FILE" == *.yaml || "$CONFIG_FILE" == *.yml ]]; then
            python3 -c "
import yaml, json, sys
with open('$CONFIG_FILE', 'r') as f:
    data = yaml.safe_load(f)
with open('$export_file', 'w') as f:
    json.dump(data, f, indent=2)
" 2>/dev/null || log_error "Failed to export to JSON format"
        else
            log_error "JSON not available for configuration export"
            return 1
        fi
    elif [[ "$format" == "yaml" ]]; then
        if command -v yq &> /dev/null; then
            yq . "$CONFIG_FILE" > "$export_file"
        elif [[ "$CONFIG_FILE" == *.json ]]; then
            python3 -c "
import json, yaml, sys
with open('$CONFIG_FILE', 'r') as f:
    data = json.load(f)
with open('$export_file', 'w') as f:
    yaml.dump(data, f, default_flow_style=False)
" 2>/dev/null || log_error "Failed to export to YAML format"
        else
            log_error "YAML not available for configuration export"
            return 1
        fi
    else
        log_error "Unsupported export format: $format"
        echo "Supported formats: json, yaml"
        return 1
    fi
    
    if [[ -f "$export_file" ]]; then
        log "Configuration exported successfully to $export_file"
        return 0
    else
        log_error "Failed to export configuration"
        return 1
    fi
}

config_import() {
    local source_file="$1"
    local format="$2"
    
    if [[ -z "$source_file" ]]; then
        log_error "Source file required for config import command"
        echo "Usage: $0 config import FILE [FORMAT]"
        return 1
    fi
    
    if [[ ! -f "$source_file" ]]; then
        log_error "Source file not found: $source_file"
        return 1
    fi
    
    if [[ -z "$format" ]]; then
        # Auto-detect format
        if [[ "$source_file" == *.json ]]; then
            format="json"
        elif [[ "$source_file" == *.yaml || "$source_file" == *.yml ]]; then
            format="yaml"
        else
            format="simple"
        fi
    fi
    
    log "Importing configuration from $source_file (format: $format)"
    
    if [[ "$format" == "json" ]]; then
        cp "$source_file" "$CONFIG_FILE"
    elif [[ "$format" == "yaml" ]]; then
        cp "$source_file" "$CONFIG_FILE"
    else
        log_error "Unsupported import format: $format"
        echo "Supported formats: json, yaml, simple"
        return 1
    fi
    
    log "Configuration imported successfully"
    return 0
}

# Debug and analysis functions
debug_neurons() {
    log "Analyzing neuron population statistics..."
    
    # This would call the NLM binary with debug options
    if [[ -x "./nlm" ]]; then
        echo "Neuron Statistics:"
        echo "=================="
        ./nlm --config "$CONFIG_FILE" --debug-neurons 2>/dev/null || echo "Debug mode not available in current build"
    else
        log_error "NLM executable not found"
        return 1
    fi
}

debug_synapses() {
    log "Analyzing synaptic connectivity..."
    
    if [[ -x "./nlm" ]]; then
        echo "Synaptic Connectivity Statistics:"
        echo "================================="
        ./nlm --config "$CONFIG_FILE" --debug-synapses 2>/dev/null || echo "Debug mode not available in current build"
    else
        log_error "NLM executable not found"
        return 1
    fi
}

# Main command dispatcher
main() {
    # Initialize configuration
    init_config "$@"
    
    # Check if we have arguments
    if [[ $# -eq 0 ]]; then
        usage
        return 0
    fi
    
    # Parse command
    local command="$1"
    shift
    
    case "$command" in
        config)
            case "$1" in
                list)
                    config_list
                    ;;
                get)
                    config_get "$2"
                    ;;
                set)
                    config_set "$2" "$3"
                    ;;
                validate)
                    config_validate
                    ;;
                export)
                    config_export "$2"
                    ;;
                import)
                    config_import "$2" "$3"
                    ;;
                *)
                    log_error "Unknown config subcommand: $1"
                    echo "Usage: $0 config [list|get KEY|set KEY VALUE|validate|export [FORMAT]|import FILE [FORMAT]]"
                    return 1
                    ;;
            esac
            ;;
        debug)
            case "$1" in
                neurons)
                    debug_neurons
                    ;;
                synapses)
                    debug_synapses
                    ;;
                *)
                    log_error "Unknown debug command: $1"
                    echo "Usage: $0 debug [neurons|synapses|plasticity|memory|neuromod]"
                    return 1
                    ;;
            esac
            ;;
        *)
            log_error "Unknown command: $command"
            usage
            return 1
            ;;
    esac
}

# Run main function with all arguments
main "$@"
