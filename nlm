#!/bin/bash

# NLM Command Line Interface
# Advanced control for the Neural Learning Machine simulation

NLM_EXECUTABLE="nlm"
PHASE3_DEMO="nlm_phase3_demo"
PHASE4_DEMO="nlm_phase4_demo"
PHASE6_DEMO="nlm_phase6_demo"

# Default configuration
VERBOSE=false
LOG_LEVEL="info"
OUTPUT_DIR="output"
MAX_ITERATIONS=1000
RANDOM_SEED=12345
DEVELOPMENT_STAGES=true
PERFORMANCE_MONITORING=false
VERBOSE_LOGGING=false
ASYNC_LOGGING=true

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m' # No Color

print_usage() {
    cat << EOF
${PURPLE}=== NLM - Neural Learning Machine Command Line Interface ===${NC}

${BLUE}Usage:${NC}
  ${GREEN}nlm [command] [options]${NC}

${BLUE}Commands:${NC}
  ${CYAN}run${NC}                    Run the basic NLM simulation
  ${CYAN}demo${NC}                   Run Phase 6 integration demo
  ${CYAN}experiment [phase]${NC}     Run specific experiment phase
  ${CYAN}configure${NC}              Open interactive configuration
  ${CYAN}stats${NC}                  Show system statistics
  ${CYAN}help${NC}                   Show this help message

${BLUE}Configuration Options:${NC}
  ${YELLOW}--verbose, -v${NC}          Enable verbose output
  ${YELLOW}--log-level LEVEL${NC}     Set log level (debug, info, warning, error, critical)
  ${YELLOW}--output DIR${NC}          Set output directory
  ${YELLOW}--iterations N${NC}         Set maximum iterations
  ${YELLOW}--seed N${NC}              Set random seed for reproducibility
  ${YELLOW}--development${NC}         Enable developmental stages
  ${YELLOW}--no-development${NC}       Disable developmental stages
  ${YELLOW}--performance${NC}         Enable performance monitoring
  ${YELLOW}--sync-logging${NC}        Disable async logging
  ${YELLOW}--version${NC}             Show version information

${BLUE}Advanced Options:${NC}
  ${YELLOW}--enable-feature NAME${NC}     Enable specific feature
  ${YELLOW}--disable-feature NAME${NC}    Disable specific feature
  ${YELLOW}--enable-module MODULE${NC}    Enable specific module
  ${YELLOW}--disable-module MODULE${NC}   Disable specific module

${BLUE}Experiment Phases:${NC}
  ${YELLOW}phase3${NC}                   Run Phase 3 experiment
  ${YELLOW}phase4${NC}                   Run Phase 4 experiment
  ${YELLOW}phase5${NC}                   Run Phase 5 experiment
  ${YELLOW}phase6${NC}                   Run Phase 6 integration demo

${BLUE}Examples:${NC}
  ${GREEN}nlm run --verbose --log-level debug${NC}
  ${GREEN}nlm experiment phase6 --output my_results --performance${NC}
  ${GREEN}nlm configure${NC}
  ${GREEN}nlm stats${NC}
EOF
}

print_info() {
    local message="$1"
    if [ "$VERBOSE" = true ]; then
        echo -e "${CYAN}[INFO]${NC} $message"
    fi
}

print_success() {
    local message="$1"
    echo -e "${GREEN}[SUCCESS]${NC} $message"
}

print_warning() {
    local message="$1"
    echo -e "${YELLOW}[WARNING]${NC} $message"
}

print_error() {
    local message="$1"
    echo -e "${RED}[ERROR]${NC} $message"
}

initialize_logging() {
    local log_file="$OUTPUT_DIR/nlm_$(date +%Y%m%d_%H%M%S).log"
    mkdir -p "$OUTPUT_DIR"
    
    print_info "Logging to $log_file"
    
    # Set log level
    case "$LOG_LEVEL" in
        debug) LOG_LEVEL_VALUE=0;;
        info) LOG_LEVEL_VALUE=1;;
        warning) LOG_LEVEL_VALUE=2;;
        error) LOG_LEVEL_VALUE=3;;
        critical) LOG_LEVEL_VALUE=4;;
        *) LOG_LEVEL_VALUE=1;;
    esac
    
    export NLM_LOG_LEVEL=$LOG_LEVEL_VALUE
    export NLM_LOG_FILE=$log_file
    export NLM_VERBOSE_LOGGING=$VERBOSE
    
    if [ "$ASYNC_LOGGING" = true ]; then
        export NLM_ASYNC_LOGGING=true
    else
        export NLM_ASYNC_LOGGING=false
    fi
}

run_nlm() {
    print_info "Starting NLM simulation with $MAX_ITERATIONS iterations"
    print_info "Random seed: $RANDOM_SEED"
    
    # Build command
    local cmd="$NLM_EXECUTABLE"
    cmd+=" --iterations $MAX_ITERATIONS"
    cmd+=" --seed $RANDOM_SEED"
    
    if [ "$DEVELOPMENT_STAGES" = true ]; then
        cmd+=" --development"
    fi
    
    if [ "$PERFORMANCE_MONITORING" = true ]; then
        cmd+=" --performance-monitoring"
    fi
    
    if [ "$VERBOSE" = true ]; then
        cmd+=" --verbose"
    fi
    
    # Run the simulation
    if [ -f "$NLM_EXECUTABLE" ]; then
        print_info "Executing: $cmd"
        $cmd
        if [ $? -eq 0 ]; then
            print_success "NLM simulation completed successfully"
        else
            print_error "NLM simulation failed with exit code $?"
            return 1
        fi
    else
        print_error "NLM executable not found: $NLM_EXECUTABLE"
        return 1
    fi
}

run_experiment() {
    local phase="$1"
    print_info "Running $phase experiment"
    
    case "$phase" in
        phase3)
            if [ -f "$PHASE3_DEMO" ]; then
                $PHASE3_DEMO --iterations $MAX_ITERATIONS --seed $RANDOM_SEED
            else
                print_error "Phase 3 demo executable not found"
                return 1
            fi
            ;;
        phase4)
            if [ -f "$PHASE4_DEMO" ]; then
                $PHASE4_DEMO --iterations $MAX_ITERATIONS --seed $RANDOM_SEED
            else
                print_error "Phase 4 demo executable not found"
                return 1
            fi
            ;;
        phase5)
            # For phase 5, run a custom experiment with enhanced features
            print_info "Running Phase 5 with advanced features enabled"
            # Implementation for Phase 5
            ;;
        phase6)
            if [ -f "$PHASE6_DEMO" ]; then
                $PHASE6_DEMO --iterations $MAX_ITERATIONS --seed $RANDOM_SEED
            else
                print_error "Phase 6 demo executable not found"
                return 1
            fi
            ;;
        *)
            print_error "Unknown experiment phase: $phase"
            print_usage
            return 1
            ;;
    esac
}

show_stats() {
    print_info "Collecting system statistics..."
    
    # Check if NLM processes are running
    if pgrep -f "$NLM_EXECUTABLE" > /dev/null; then
        echo -e "${GREEN}Running Processes:${NC}"
        pgrep -f "$NLM_EXECUTABLE" | xargs ps -p -o pid,cmd --no-headers
    else
        echo -e "${YELLOW}No NLM processes currently running${NC}"
    fi
    
    # Check memory usage
    if command -v ps > /dev/null; then
        echo -e "${GREEN}Memory Usage:${NC}"
        ps aux | grep "$NLM_EXECUTABLE" | grep -v grep | awk '{sum+=$6} END {printf "Total: %.2f MB\n", sum/1024}'
    fi
    
    # Check log files
    if [ -d "$OUTPUT_DIR" ]; then
        echo -e "${GREEN}Log Files:${NC}"
        find "$OUTPUT_DIR" -name "*.log" -type f | head -10
    fi
    
    # Performance stats if available
    if [ -n "$NLM_PERFORMANCE_STATS" ]; then
        echo -e "${GREEN}NLM Performance Statistics:${NC}"
        echo "$NLM_PERFORMANCE_STATS"
    fi
}

configure_interactive() {
    echo -e "${PURPLE}=== NLM Interactive Configuration ===${NC}"
    
    # Configuration file
    local config_file="~/.nlm_config"
    
    if [ -f "$config_file" ]; then
        echo -e "${GREEN}Found existing configuration: $config_file${NC}"
        echo -e "${CYAN}Current settings:${NC}"
        cat "$config_file"
    fi
    
    echo -e "${YELLOW}Please enter your configuration (or press Enter to keep default):${NC}"
    
    # Interactive prompts (simplified version)
    echo "1. Number of iterations (default: $MAX_ITERATIONS):"
    read -p "   > " new_iterations
    if [ -n "$new_iterations" ]; then
        MAX_ITERATIONS="$new_iterations"
    fi
    
    echo "2. Random seed (default: $RANDOM_SEED):"
    read -p "   > " new_seed
    if [ -n "$new_seed" ]; then
        RANDOM_SEED="$new_seed"
    fi
    
    echo "3. Enable verbose output (y/N):"
    read -p "   > " new_verbose
    if [[ "$new_verbose" =~ ^[Yy]$ ]]; then
        VERBOSE=true
    fi
    
    echo "4. Log level (debug/info/warning/error/critical, default: $LOG_LEVEL):"
    read -p "   > " new_log_level
    if [ -n "$new_log_level" ]; then
        LOG_LEVEL="$new_log_level"
    fi
    
    # Save configuration
    cat > "$config_file" << EOF
NLM Configuration
=================
Generated on: $(date)
Iterations: $MAX_ITERATIONS
Random Seed: $RANDOM_SEED
Verbose: $VERBOSE
Log Level: $LOG_LEVEL
Output Directory: $OUTPUT_DIR
Development Stages: $DEVELOPMENT_STAGES
Performance Monitoring: $PERFORMANCE_MONITORING
Async Logging: $ASYNC_LOGGING

Features Enabled:
- Basic Neural Network
- Memory Systems
- Neuromodulation
- Development Stages
- Prediction Systems
- Cognitive Functions

Modules Enabled:
- Core (Types, Config, Random, Logger)
- Brain (Neurons, Synapses, Regions)
- Dynamics (Spike Processing)
- Plasticity (Learning Rules)
- Memory (Working, Episodic, Semantic)
- Neuromodulation (Dopamine, Novelty, Curiosity)
- Prediction (Forward Model)
- Cognition (Planning, Attention)
- Sensory (Vision, Touch, Internal)
- Motor (Action Selection)
- Environment (World Modeling)
- Experiments (Phase Testing)
EOF
    
    print_success "Configuration saved to $config_file"
}

show_version() {
    echo -e "${PURPLE}NLM - Neural Learning Machine v0.1.0${NC}"
    echo -e "${CYAN}An Experimental Artificial Developmental Brain${NC}"
    echo -e "${YELLOW}Phase 6: Final Integration${NC}"
    echo ""
    echo -e "${GREEN}Key Features:${NC}"
    echo "  • Leaky Integrate-and-Fire (LIF) neurons"
    echo "  • Synaptic plasticity (STDP, Hebbian)"
    echo "  • Neuromodulation (Dopamine, Novelty, Curiosity)"
    echo "  • Multiple memory systems"
    echo "  • Developmental stages"
    echo "  • Predictive processing"
    echo "  • Cognitive functions"
    echo "  • Advanced logging and statistics"
    echo ""
    echo -e "${GREEN}Build Information:${NC}"
    echo "  • C++20 standard"
    echo "  • CMake build system"
    echo "  • Thread-safe operations"
    echo "  • Performance monitoring"
    echo "  • Async logging support"
}

# Parse command line arguments
if [ $# -eq 0 ]; then
    print_usage
    exit 1
fi

command="$1"
shift

# Parse options
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            print_usage
            exit 0
            ;;
        --version)
            show_version
            exit 0
            ;;
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        --log-level)
            LOG_LEVEL="$2"
            shift 2
            ;;
        --output)
            OUTPUT_DIR="$2"
            shift 2
            ;;
        --iterations)
            MAX_ITERATIONS="$2"
            shift 2
            ;;
        --seed)
            RANDOM_SEED="$2"
            shift 2
            ;;
        --development)
            DEVELOPMENT_STAGES=true
            shift
            ;;
        --no-development)
            DEVELOPMENT_STAGES=false
            shift
            ;;
        --performance)
            PERFORMANCE_MONITORING=true
            shift
            ;;
        --sync-logging)
            ASYNC_LOGGING=false
            shift
            ;;
        run)
            initialize_logging
            run_nlm
            exit $?
            ;;
        demo)
            initialize_logging
            if [ -f "$PHASE6_DEMO" ]; then
                print_info "Running Phase 6 demo"
                $PHASE6_DEMO --verbose $MAX_ITERATIONS
            else
                print_error "Phase 6 demo executable not found"
                exit 1
            fi
            exit $?
            ;;
        experiment)
            if [ $# -eq 0 ]; then
                print_error "Experiment phase required"
                print_usage
                exit 1
            fi
            initialize_logging
            run_experiment "$1"
            exit $?
            ;;
        configure)
            configure_interactive
            exit 0
            ;;
        stats)
            initialize_logging
            show_stats
            exit 0
            ;;
        *)
            print_error "Unknown command: $1"
            print_usage
            exit 1
            ;;
    esac
done

# Handle commands without options
if [ "$command" = "run" ]; then
    initialize_logging
    run_nlm
    exit $?
elif [ "$command" = "demo" ]; then
    initialize_logging
    if [ -f "$PHASE6_DEMO" ]; then
        print_info "Running Phase 6 demo"
        $PHASE6_DEMO --verbose $MAX_ITERATIONS
    else
        print_error "Phase 6 demo executable not found"
        exit 1
    fi
    exit $?
elif [ "$command" = "experiment" ]; then
    print_error "Experiment phase required"
    print_usage
    exit 1
elif [ "$command" = "configure" ]; then
    configure_interactive
    exit 0
elif [ "$command" = "stats" ]; then
    initialize_logging
    show_stats
    exit 0
else
    print_error "Unknown command: $command"
    print_usage
    exit 1
fi