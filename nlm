#!/bin/bash

# NLM Command Line Interface - Simple operations for common tasks
# Usage: nlm [command] [options]

# Load shell utilities
if [ -f "shell_utils.sh" ]; then
    source "shell_utils.sh"
else
    echo "Error: shell_utils.sh not found"
    exit 1
fi

# Default configuration
NLM_CONFIG="configs/default.cfg"
NLM_BUILD_DIR="build"

# Color definitions (redundant but safe)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Log function
log() {
    local level="$1"
    shift
    case "$level" in
        INFO) echo -e "${GREEN}[INFO]${NC} $*" ;;
        WARN) echo -e "${YELLOW}[WARN]${NC} $*" ;;
        ERROR) echo -e "${RED}[ERROR]${NC} $*" ;;
        DEBUG) echo -e "${BLUE}[DEBUG]${NC} $*" ;;
        *) echo -e "$*" ;;
    esac
}

# Help message
show_help() {
    cat << EOF
NLM - Neural Learning Machine Command Line Interface

Commands:
  run                    Run a simple neural simulation
  info                   Show brain configuration and status
  create                 Create and initialize a brain
  reset                  Reset brain state
  save [path]            Save brain state to file
  load [path]            Load brain state from file
  test                   Run built-in test suite
  help                   Show this help message

Examples:
  nlm run --steps 100     Run simulation for 100 steps
  nlm info                Show current brain configuration
  nlm create --neurons 500 Create brain with 500 neurons
  nlm save my_brain.bin    Save brain state
  nlm test                Run tests

Options for 'run' command:
  --steps N               Number of simulation steps (default: 100)
  --config PATH            Configuration file (default: configs/default.cfg)

Options for 'create' command:
  --neurons N             Number of neurons (default: 1000)
  --regions N             Number of brain regions (default: 1)
  --density F             Connection probability (default: 0.1)

Options for 'save'/'load':
  --path PATH             File path (default: brain_state.bin)

EOF
}

# Parse command line arguments
parse_args() {
    case "$1" in
        run)
            COMMAND="run"
            shift
            parse_run_args "$@"
            ;;
        info|status|show)
            COMMAND="info"
            shift
            parse_info_args "$@"
            ;;
        create)
            COMMAND="create"
            shift
            parse_create_args "$@"
            ;;
        reset)
            COMMAND="reset"
            shift
            ;;
        save|load)
            COMMAND="$1"
            shift
            parse_save_load_args "$@"
            ;;
        test)
            COMMAND="test"
            shift
            ;;
        help|--help|-h)
            show_help
            exit 0
            ;;
        *)
            log "ERROR" "Unknown command: $1"
            log "INFO" "Run 'nlm help' for usage information."
            exit 1
            ;;
    esac
}

# Parse run command arguments
parse_run_args() {
    STEPS=100
    CONFIG="$NLM_CONFIG"
    
    while [ $# -gt 0 ]; do
        case "$1" in
            --steps)
                STEPS="$2"
                shift 2
                ;;
            --config)
                CONFIG="$2"
                shift 2
                ;;
            *)
                log "ERROR" "Unknown option: $1"
                log "INFO" "Use 'nlm help run' for options."
                exit 1
                ;;
        esac
    done
}

# Parse info command arguments
parse_info_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            *)
                log "ERROR" "Unknown option: $1"
                log "INFO" "Use 'nlm help info' for options."
                exit 1
                ;;
        esac
    done
}

# Parse create command arguments
parse_create_args() {
    NEURONS=1000
    REGIONS=1
    DENSITY=0.1
    
    while [ $# -gt 0 ]; do
        case "$1" in
            --neurons)
                NEURONS="$2"
                shift 2
                ;;
            --regions)
                REGIONS="$2"
                shift 2
                ;;
            --density)
                DENSITY="$2"
                shift 2
                ;;
            *)
                log "ERROR" "Unknown option: $1"
                log "INFO" "Use 'nlm help create' for options."
                exit 1
                ;;
        esac
    done
}

# Parse save/load command arguments
parse_save_load_args() {
    PATH=""
    
    while [ $# -gt 0 ]; do
        case "$1" in
            --path)
                PATH="$2"
                shift 2
                ;;
            *)
                PATH="$1"
                shift
                ;;
        esac
    done
}

# Show command usage
usage() {
    local command="$1"
    case "$command" in
        run)
            echo "Usage: nlm run [--steps N] [--config PATH]"
            echo "  --steps N        Number of simulation steps (default: 100)"
            echo "  --config PATH    Configuration file (default: configs/default.cfg)"
            ;;
        info)
            echo "Usage: nlm info"
            ;;
        create)
            echo "Usage: nlm create [--neurons N] [--regions N] [--density F]"
            echo "  --neurons N      Number of neurons (default: 1000)"
            echo "  --regions N      Number of brain regions (default: 1)"
            echo "  --density F      Connection probability (default: 0.1)"
            ;;
        save|load)
            echo "Usage: nlm $command [--path PATH] [PATH]"
            echo "  --path PATH      File path (default: brain_state.bin)"
            ;;
    esac
}

# Check if build directory exists
check_build() {
    if [ ! -d "$NLM_BUILD_DIR" ]; then
        log "WARN" "Build directory not found. Building NLM..."
        cd "$(dirname "$0")" || exit 1
        
        # Check if CMakeLists.txt exists
        if [ ! -f "CMakeLists.txt" ]; then
            log "ERROR" "CMakeLists.txt not found in project root"
            log "INFO" "Please run this from the project root directory."
            exit 1
        fi
        
        # Try to build
        mkdir -p "$NLM_BUILD_DIR"
        cd "$NLM_BUILD_DIR" || exit 1
        
        if command_exists cmake; then
            log "INFO" "Running cmake..."
            cmake .. -DCMAKE_BUILD_TYPE=Release
            if [ $? -ne 0 ]; then
                log "ERROR" "CMake configuration failed"
                exit 1
            fi
            
            log "INFO" "Building NLM..."
            make -j$(nproc) 2>&1 | tail -20
            if [ $? -ne 0 ]; then
                log "ERROR" "Build failed"
                exit 1
            fi
        else
            log "ERROR" "CMake not found. Please install CMake."
            exit 1
        fi
        cd "$(dirname "$0")" || exit 1
    fi
}

# Run simulation command
run_simulation() {
    check_build
    
    log "INFO" "Running NLM simulation for $STEPS steps..."
    log "INFO" "Using configuration: $CONFIG"
    
    cd "$NLM_BUILD_DIR" || exit 1
    
    # Run the nlm executable with config
    if [ -x "./nlm" ]; then
        ./nlm --config "$CONFIG" --steps "$STEPS" 2>&1
    else
        log "ERROR" "NLM executable not found in build directory"
        log "INFO" "Please ensure the project is properly built."
        exit 1
    fi
    
    EXIT_CODE=$?
    cd "$(dirname "$0")" || exit 1
    return $EXIT_CODE
}

# Show brain info command
show_info() {
    log "INFO" "NLM Brain Information"
    log "INFO" "======================="
    
    check_build
    
    cd "$NLM_BUILD_DIR" || exit 1
    
    # Try to run nlm with --info flag if supported
    if [ -x "./nlm" ]; then
        ./nlm --info 2>&1 | head -50
    else
        log "INFO" "Brain executable not found. Please check build directory."
    fi
    
    cd "$(dirname "$0")" || exit 1
}

# Create brain command
create_brain() {
    log "INFO" "Creating NLM Brain with configuration..."
    log "INFO" "Neurons: $NEURONS"
    log "INFO" "Regions: $REGIONS" 
    log "INFO" "Connection density: $DENSITY"
    
    # Create a simple Python script to create and initialize brain
    cat > "create_brain.py" << EOF
import sys
import os
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import pynlm

# Create configuration
config = pynlm.createDefaultConfig()
config.set("brain.neuron_count", $NEURONS)
config.set("brain.region_count", $REGIONS)
config.set("brain.connection_probability", $DENSITY)
config.set("random_seed", 42)

# Create and initialize brain
brain = pynlm.createBrain(config)
brain.initialize()

print(f"Brain created successfully!")
print(f"Total neurons: {brain.getTotalNeuronCount()}")
print(f"Total synapses: {brain.getTotalSynapseCount()}")
print(f"Regions: {brain.getRegionCount()}")

# Save brain state
brain.save("created_brain.bin")
print("Brain state saved to 'created_brain.bin'")
EOF
    
    # Run the script
    python3 "create_brain.py" 2>&1
    
    if [ $? -eq 0 ]; then
        log "INFO" "Brain created successfully!"
    else
        log "ERROR" "Brain creation failed"
        exit 1
    fi
}

# Reset brain command
reset_brain() {
    log "INFO" "Resetting NLM Brain..."
    
    check_build
    
    cd "$NLM_BUILD_DIR" || exit 1
    
    if [ -x "./nlm" ]; then
        # Check if nlm has reset functionality
        if ./nlm --help 2>&1 | grep -q "reset"; then
            ./nlm --reset 2>&1
        else
            log "WARN" "Reset functionality not available in this build."
            log "INFO" "Please use Python API or rebuild with reset support."
        fi
    fi
    
    cd "$(dirname "$0")" || exit 1
}

# Save/load brain command
save_load_brain() {
    local action="$1"
    local path="${PATH:-brain_state.bin}"
    
    log "INFO" "NLM Brain $action command..."
    log "INFO" "Path: $path"
    
    check_build
    
    cd "$NLM_BUILD_DIR" || exit 1
    
    case "$action" in
        save)
            if [ -x "./nlm" ]; then
                ./nlm --save "$path" 2>&1
                if [ $? -eq 0 ]; then
                    log "INFO" "Brain state saved to $path"
                else
                    log "ERROR" "Failed to save brain state"
                    exit 1
                fi
            fi
            ;;
        load)
            if [ -x "./nlm" ]; then
                ./nlm --load "$path" 2>&1
                if [ $? -eq 0 ]; then
                    log "INFO" "Brain state loaded from $path"
                else
                    log "ERROR" "Failed to load brain state"
                    exit 1
                fi
            fi
            ;;
    esac
    
    cd "$(dirname "$0")" || exit 1
}

# Run tests command
run_tests() {
    log "INFO" "Running NLM Test Suite..."
    
    check_build
    
    cd "$NLM_BUILD_DIR" || exit 1
    
    if command_exists ctest; then
        log "INFO" "Running ctest..."
        ctest --output-on-failure 2>&1 | tail -30
        EXIT_CODE=$?
    else
        log "INFO" "CTest not found. Running Python tests..."
        cd "$(dirname "$0")" || exit 1
        
        if python3 -m pytest tests/ -v 2>&1 | tail -30; then
            log "INFO" "All tests passed!"
        else
            log "ERROR" "Tests failed"
            exit 1
        fi
    fi
    
    cd "$(dirname "$0")" || exit 1
    return $EXIT_CODE
}

# Main command dispatcher
execute_command() {
    case "$COMMAND" in
        run)
            run_simulation
            ;;
        info)
            show_info
            ;;
        create)
            create_brain
            ;;
        reset)
            reset_brain
            ;;
        save)
            save_load_brain "save"
            ;;
        load)
            save_load_brain "load"
            ;;
        test)
            run_tests
            ;;
        *)
            log "ERROR" "Unknown command: $COMMAND"
            show_help
            exit 1
            ;;
    esac
}

# Main script
main() {
    if [ $# -eq 0 ]; then
        show_help
        exit 0
    fi
    
    parse_args "$@"
    execute_command
}

# Run main function
main "$@"