#!/usr/bin/env bash
# NLM Command Line Interface (CLI)

# Make the script executable (shell shebang already makes it executable)
# Add executable permission by modifying the file permissions
chmod +x "$0"

# Color definitions for terminal output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# Default values
DEFAULT_NEURON_COUNT=1000
DEFAULT_REGION_COUNT=2
DEFAULT_SIMULATION_STEPS=1000
DEFAULT_SIMULATION_TIME=1.0
DEFAULT_LOG_LEVEL="INFO"
DEFAULT_ENABLE_PLOT="false"

# Print help message
function show_help() {
    cat << EOF
${BOLD}NLM (Neural Learning Machine) CLI${NC}

${CY}Usage:${NC}
  nlm [OPTIONS] [COMMANDS]

${CY}Core Commands:${NC}
  ${GREEN}run${NC}                    Run a simulation with given configuration
  ${GREEN}experiment${NC}             Run predefined experiment
  ${GREEN}config${NC}                 Manage configuration
  ${GREEN}status${NC}                 Show current system status
  ${GREEN}help${NC}                   Show this help message

${CY}Configuration Options:${NC}
  ${YELLOW}--neurons, -n N${NC}          Number of neurons (default: ${DEFAULT_NEURON_COUNT})
  ${YELLOW}--regions, -r R${NC}         Number of brain regions (default: ${DEFAULT_REGION_COUNT})
  ${YELLOW}--steps, -s S${NC}            Number of simulation steps (default: ${DEFAULT_SIMULATION_STEPS})
  ${YELLOW}--time, -t T${NC}            Simulation time in seconds (default: ${DEFAULT_SIMULATION_TIME})
  ${YELLOW}--log-level L${NC}            Log level: DEBUG, INFO, WARNING, ERROR (default: ${DEFAULT_LOG_LEVEL})
  ${YELLOW}--config-file C${NC}          Path to configuration file
  ${YELLOW}--checkpoint C${NC}           Save checkpoint to file
  ${YELLOW}--load L${NC}                Load checkpoint from file

${CY}Advanced Options:${NC}
  ${YELLOW}--enable-plasticity${NC}     Enable synaptic plasticity (default: enabled)
  ${YELLOW}--disable-plasticity${NC}    Disable synaptic plasticity
  ${YELLOW}--enable-development${NC}    Enable developmental processes
  ${YELLOW}--disable-development${NC}   Disable developmental processes
  ${YELLOW}--enable-curiosity${NC}      Enable curiosity-driven exploration
  ${YELLOW}--disable-curiosity${NC}     Disable curiosity-driven exploration
  ${YELLOW}--enable-reward${NC}         Enable reward modulation
  ${YELLOW}--disable-reward${NC}        Disable reward modulation
  ${YELLOW}--seed S${NC}                Random seed for reproducible results
  ${YELLOW}--verbose${NC}               Enable verbose output
  ${YELLOW}--quiet${NC}                 Suppress output

${CY}Experiment Types:${NC}
  ${YELLOW}--experiment-type T${NC}      Type of experiment:
    ${YELLOW}connectivity${NC}         Neural connectivity analysis
    ${YELLOW}plasticity${NC}           Synaptic plasticity learning
    ${YELLOW}integration${NC}          Full system integration
    ${YELLOW}development${NC}          Developmental processes

${CY}Visualization Options:${NC}
  ${YELLOW}--plot-enable${NC}           Enable real-time plotting (requires external tools)
  ${YELLOW}--plot-type T${NC}           Plot type: neurons, synapses, activity
  ${YELLOW}--plot-output O${NC}         Output directory for plots

${CY}Examples:${NC}
  ${CY}1. Run basic simulation:${NC}
    nlm run --neurons 500 --steps 2000

  ${CY}2. Run with custom configuration:${NC}
    nlm config --load settings.cfg run --neurons 2000 --steps 5000

  ${CY}3. Run integration experiment:${NC}
    nlm experiment integration --neurons 1000 --steps 3000

  ${CY}4. Run with development and plasticity:${NC}
    nlm run --neurons 500 --enable-development --enable-curiosity

  ${CY}5. Batch processing:${NC}
    nlm run --neurons 1000 --steps 5000 > simulation.log 2>&1

${CY}For more information, visit:${NC}
  https://github.com/nlm-project/nlm
EOF
}

# Print error message
function show_error() {
    echo -e "${RED}Error:${NC} $1" >&2
}

# Print success message
function show_success() {
    echo -e "${GREEN}✓${NC} $1"
}

# Print warning message
function show_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

# Print info message
function show_info() {
    echo -e "${CYAN}ℹ${NC} $1"
}

# Print debug message (if verbose)
function show_debug() {
    if [[ "$VERBOSE" == "true" ]]; then
        echo -e "${BLUE}🐛${NC} $1"
    fi
}

# Parse command line arguments
function parse_arguments() {
    # Default values
    NEURON_COUNT=$DEFAULT_NEURON_COUNT
    REGION_COUNT=$DEFAULT_REGION_COUNT
    SIMULATION_STEPS=$DEFAULT_SIMULATION_STEPS
    SIMULATION_TIME=$DEFAULT_SIMULATION_TIME
    LOG_LEVEL=$DEFAULT_LOG_LEVEL
    CONFIG_FILE=""
    CHECKPOINT_FILE=""
    LOAD_FILE=""
    ENABLE_PLASTICITY=true
    ENABLE_DEVELOPMENT=true
    ENABLE_CURIOSITY=true
    ENABLE_REWARD=true
    RANDOM_SEED=""
    VERBOSE=false
    QUIET=false
    EXPERIMENT_TYPE=""
    PLOT_ENABLE=false
    PLOT_TYPE=""
    PLOT_OUTPUT=""
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            # Core commands
            run|experiment|config|status|help)
                COMMAND="$1"
                shift
                break
                ;;
            
            # Configuration options
            --neurons|-n)
                NEURON_COUNT="$2"
                shift 2
                ;;
            --regions|-r)
                REGION_COUNT="$2"
                shift 2
                ;;
            --steps|-s)
                SIMULATION_STEPS="$2"
                shift 2
                ;;
            --time|-t)
                SIMULATION_TIME="$2"
                shift 2
                ;;
            --log-level)
                LOG_LEVEL="$2"
                shift 2
                ;;
            --config-file)
                CONFIG_FILE="$2"
                shift 2
                ;;
            --checkpoint)
                CHECKPOINT_FILE="$2"
                shift 2
                ;;
            --load)
                LOAD_FILE="$2"
                shift 2
                ;;
            
            # Advanced options
            --enable-plasticity)
                ENABLE_PLASTICITY=true
                shift
                ;;
            --disable-plasticity)
                ENABLE_PLASTICITY=false
                shift
                ;;
            --enable-development)
                ENABLE_DEVELOPMENT=true
                shift
                ;;
            --disable-development)
                ENABLE_DEVELOPMENT=false
                shift
                ;;
            --enable-curiosity)
                ENABLE_CURIOSITY=true
                shift
                ;;
            --disable-curiosity)
                ENABLE_CURIOSITY=false
                shift
                ;;
            --enable-reward)
                ENABLE_REWARD=true
                shift
                ;;
            --disable-reward)
                ENABLE_REWARD=false
                shift
                ;;
            --seed)
                RANDOM_SEED="$2"
                shift 2
                ;;
            --verbose)
                VERBOSE=true
                shift
                ;;
            --quiet)
                QUIET=true
                shift
                ;;
            
            # Experiment types
            --experiment-type)
                EXPERIMENT_TYPE="$2"
                shift 2
                ;;
            
            # Visualization options
            --plot-enable)
                PLOT_ENABLE=true
                shift
                ;;
            --plot-type)
                PLOT_TYPE="$2"
                shift 2
                ;;
            --plot-output)
                PLOT_OUTPUT="$2"
                shift 2
                ;;
            
            # Help options
            -h|--help)
                show_help
                exit 0
                ;;
            
            # Unknown option
            *)
                show_error "Unknown option: $1"
                show_help
                exit 1
                ;;
        esac
    done
    
    # If no command provided, show help
    if [[ -z "$COMMAND" ]]; then
        show_help
        exit 0
    fi
}

# Run simulation
function run_simulation() {
    show_info "Starting NLM simulation..."
    show_info "Neurons: $NEURON_COUNT"
    show_info "Regions: $REGION_COUNT"
    show_info "Steps: $SIMULATION_STEPS"
    show_info "Time: ${SIMULATION_TIME}s"
    
    # Build configuration
    CONFIG_ARGS=""
    CONFIG_ARGS+=" --neurons $NEURON_COUNT"
    CONFIG_ARGS+=" --regions $REGION_COUNT"
    CONFIG_ARGS+=" --steps $SIMULATION_STEPS"
    CONFIG_ARGS+=" --time $SIMULATION_TIME"
    
    # Add feature flags
    [[ "$ENABLE_PLASTICITY" == "true" ]] && CONFIG_ARGS+=" --enable-plasticity"
    [[ "$ENABLE_DEVELOPMENT" == "true" ]] && CONFIG_ARGS+=" --enable-development"
    [[ "$ENABLE_CURIOSITY" == "true" ]] && CONFIG_ARGS+=" --enable-curiosity"
    [[ "$ENABLE_REWARD" == "true" ]] && CONFIG_ARGS+=" --enable-reward"
    
    # Add random seed
    [[ -n "$RANDOM_SEED" ]] && CONFIG_ARGS+=" --seed $RANDOM_SEED"
    
    # Add checkpoint options
    [[ -n "$CHECKPOINT_FILE" ]] && CONFIG_ARGS+=" --checkpoint $CHECKPOINT_FILE"
    [[ -n "$LOAD_FILE" ]] && CONFIG_ARGS+=" --load $LOAD_FILE"
    
    # Build command
    CMD="python3 -c \""
    CMD+="import pynlm\n"
    CMD+="import sys\n"
    CMD+="\n"
    CMD+="# Create configuration\n"
    CMD+="config = pynlm.createDefaultConfig()\n"
    CMD+="\n"
    CMD+="# Set basic parameters\n"
    CMD+="config.set('brain.neuron_count', $NEURON_COUNT)\n"
    CMD+="config.set('brain.region_count', $REGION_COUNT)\n"
    CMD+="config.set('brain.simulation_steps', $SIMULATION_STEPS)\n"
    CMD+="config.set('simulation.timestep', ${SIMULATION_TIME}/$SIMULATION_STEPS)\n"
    CMD+="\n"
    CMD+="# Set plasticity settings\n"
    if [[ "$ENABLE_PLASTICITY" == "true" ]]; then
        CMD+="config.set('plasticity.stdp.enable', True)\n"
    else
        CMD+="config.set('plasticity.stdp.enable', False)\n"
    fi
    CMD+="\n"
    CMD+="# Set development settings\n"
    if [[ "$ENABLE_DEVELOPMENT" == "true" ]]; then
        CMD+="config.set('development.enabled', True)\n"
    else
        CMD+="config.set('development.enabled', False)\n"
    fi
    CMD+="\n"
    CMD+="# Set curiosity settings\n"
    if [[ "$ENABLE_CURIOSITY" == "true" ]]; then
        CMD+="config.set('neuromod.curiosity.enable', True)\n"
    else
        CMD+="config.set('neuromod.curiosity.enable', False)\n"
    fi
    CMD+="\n"
    CMD+="# Set reward settings\n"
    if [[ "$ENABLE_REWARD" == "true" ]]; then
        CMD+="config.set('neuromod.reward.enable', True)\n"
    else
        CMD+="config.set('neuromod.reward.enable', False)\n"
    fi
    CMD+="\n"
    CMD+="# Set random seed\n"
    if [[ -n "$RANDOM_SEED" ]]; then
        CMD+="config.set('random.seed', $RANDOM_SEED)\n"
    fi
    CMD+="\n"
    CMD+="# Create and initialize brain\n"
    CMD+="brain = pynlm.createBrain(config)\n"
    CMD+="brain.initialize()\n"
    CMD+="\n"
    CMD+="# Run simulation\n"
    CMD+="for step in range($SIMULATION_STEPS):\n"
    CMD+="    brain.step(step)\n"
    CMD+="    \n"
    CMD+="    # Print progress every 100 steps\n"
    CMD+="    if step % 100 == 0:\n"
    CMD+="        print(f'Step {step}: {brain.getFiringNeuronCount()} firing neurons')\n"
    CMD+="\n"
    CMD+="print('Simulation completed!')\n"
    CMD+="\n"
    CMD+="# Save checkpoint if requested\n"
    if [[ -n "$CHECKPOINT_FILE" ]]; then
        CMD+="brain.save('$CHECKPOINT_FILE')\n"
    fi
    CMD+="\""
    
    # Execute simulation
    show_debug "Executing command: $CMD"
    eval $CMD
}

# Run experiment
function run_experiment() {
    show_info "Starting NLM experiment: ${EXPERIMENT_TYPE:-default}"
    
    case "$EXPERIMENT_TYPE" in
        "connectivity")
            show_info "Running neural connectivity experiment..."
            # Run connectivity experiment
            python3 -c "
import pynlm
import time

config = pynlm.createDefaultConfig()
brain = pynlm.createBrain(config)
brain.initialize()

start_time = time.time()
for step in range($SIMULATION_STEPS):
    brain.step(step)
    if step % 500 == 0:
        print(f'Step {step}: {brain.getFiringNeuronCount()} firing neurons')

end_time = time.time()
print(f'Connectivity experiment completed in {end_time - start_time:.2f}s')
print(f'Final firing rate: {brain.getAverageFiringRate():.3f}')
"
            ;;
        
        "plasticity")
            show_info "Running plasticity learning experiment..."
            python3 -c "
import pynlm
import time

config = pynlm.createDefaultConfig()
brain = pynlm.createBrain(config)
brain.initialize()

# Enable plasticity
agent = pynlm.createAgentBrain(brain)
agent.enableRewardModulation(True)
agent.enableCuriosity(True)

start_time = time.time()
for step in range($SIMULATION_STEPS):
    brain.step(step)
    if step % 500 == 0:
        print(f'Step {step}: {brain.getFiringNeuronCount()} firing neurons')

end_time = time.time()
print(f'Plasticity experiment completed in {end_time - start_time:.2f}s')
print(f'Final curiosity level: {agent.getCuriosityLevel():.3f}')
"
            ;;
        
        "integration")
            show_info "Running system integration experiment..."
            python3 -c "
import pynlm
import time

config = pynlm.createDefaultConfig()
brain = pynlm.createBrain(config)
brain.initialize()

# Create agent and world
agent = pynlm.createAgentBrain(brain)
world = pynlm.createSimpleWorld()
world.configure(width=20, height=20, visionWidth=8, visionHeight=8)
world.reset()

agent.initialize(world)
agent.enableRewardModulation(True)
agent.enableCuriosity(True)

start_time = time.time()
for step in range($SIMULATION_STEPS):
    # Update world
    world.update(0.1)
    
    # Process sensory input
    percept = world.getSensoryPercept()
    agent.processSensoryInput(percept)
    
    # Run brain step
    brain.step(step)
    
    # Get motor command
    action = agent.decodeMotorCommand()
    
    # Apply action to world
    if percept and percept.getInternal():
        reward = percept.getInternal()[0]
        agent.applyRewardModulation(reward, 0.0)
    
    # Update development
    agent.updateDevelopment(0.1)
    
    if step % 500 == 0:
        print(f'Step {step}: {brain.getFiringNeuronCount()} firing neurons, Curiosity: {agent.getCuriosityLevel():.3f}')

end_time = time.time()
print(f'Integration experiment completed in {end_time - start_time:.2f}s')
print(f'Final curiosity level: {agent.getCuriosityLevel():.3f}')
"
            ;;
        
        "development")
            show_info "Running developmental processes experiment..."
            python3 -c "
import pynlm
import time

config = pynlm.createDefaultConfig()
brain = pynlm.createBrain(config)
brain.initialize()

agent = pynlm.createAgentBrain(brain)
agent.enableDevelopment(True)
agent.enableCuriosity(True)

start_time = time.time()
for step in range($SIMULATION_STEPS):
    brain.step(step)
    agent.updateDevelopment(0.1)
    
    if step % 500 == 0:
        print(f'Step {step}: {brain.getFiringNeuronCount()} firing neurons, Dev Stage: {brain.getDevelopmentalStage()}')

end_time = time.time()
print(f'Development experiment completed in {end_time - start_time:.2f}s')
print(f'Final developmental stage: {brain.getDevelopmentalStage()}')
"
            ;;
        
        *)
            show_warning "Unknown experiment type: $EXPERIMENT_TYPE. Running default experiment."
            run_experiment_default
            ;;
    esac
}

# Run default experiment
function run_experiment_default() {
    show_info "Running default experiment..."
    python3 -c "
import pynlm
import time

config = pynlm.createDefaultConfig()
brain = pynlm.createBrain(config)
brain.initialize()

start_time = time.time()
for step in range($SIMULATION_STEPS):
    brain.step(step)
    if step % 500 == 0:
        print(f'Step {step}: {brain.getFiringNeuronCount()} firing neurons')

end_time = time.time()
print(f'Default experiment completed in {end_time - start_time:.2f}s')
print(f'Final firing rate: {brain.getAverageFiringRate():.3f}')
"
}

# Manage configuration
function manage_config() {
    if [[ -n "$LOAD_FILE" ]]; then
        show_info "Loading configuration from $LOAD_FILE"
        python3 -c "
import pynlm
import json

try:
    with open('$LOAD_FILE', 'r') as f:
        config_data = json.load(f)
    
    config = pynlm.createDefaultConfig()
    for key, value in config_data.items():
        config.set(key, value)
    
    print(f'Configuration loaded from $LOAD_FILE')
    print(f'Loaded {len(config_data)} settings')
except Exception as e:
    print(f'Error loading configuration: {e}')
    exit(1)
"
    fi
    
    if [[ "$COMMAND" == "config" && -n "$1" ]]; then
        show_info "Configuration command: $1"
    fi
}

# Show status
function show_system_status() {
    show_info "=== NLM System Status ==="
    echo "Version: NLM Phase 6 Integration"
    echo "Build: $(date)"
    echo "Python bindings: $(python3 -c 'import pynlm; print(pynlm.__version__)' 2>/dev/null || echo 'Unknown')"
    
    # Check system resources
    show_info "Memory: $(free -h | awk 'NR==2{printf \"%s/%s (%.2f%%)\", $3,$2,$3/$2*100.0}')"
    show_info "CPU: $(nproc) cores available"
    
    # Check configuration
    show_info "Configuration: Default"
    
    # Check dependencies
    show_info "Checking dependencies..."
    python3 -c "import pynlm; print('✓ Python bindings available')" 2>/dev/null || echo "✗ Python bindings not available"
    [[ -f "build/nlm" ]] && echo "✓ C++ binary available" || echo "✗ C++ binary not available"
}

# Main function
function main() {
    # Parse command line arguments
    parse_arguments "$@"
    
    # Handle quiet mode
    if [[ "$QUIET" == "true" ]]; then
        # Redirect all output to /dev/null (except errors)
        exec 1>/dev/null 2>&1
    fi
    
    # Execute command
    case "$COMMAND" in
        "run")
            run_simulation
            ;;
        "experiment")
            run_experiment
            ;;
        "config")
            manage_config
            ;;
        "status")
            show_system_status
            ;;
        "help")
            show_help
            ;;
        *)
            show_error "Invalid command: $COMMAND"
            show_help
            exit 1
            ;;
    esac
    
    # Restore stdout if in quiet mode
    if [[ "$QUIET" == "true" ]]; then
        exec 1>/dev/null 2>&1
    fi
}

# Run main function with all arguments
main "$@"