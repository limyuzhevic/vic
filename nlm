#!/usr/bin/env bash

# NLM Command Line Interface
# Enhanced CLI with better help, configuration, and command organization

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

clean() {
    echo -e "${BLUE}Cleaning NLM build...${NC}"
    rm -rf build
    echo -e "${GREEN}Clean complete.${NC}"
}

build() {
    echo -e "${BLUE}Building NLM...${NC}"
    mkdir -p build
    cd build
    cmake .. -DCMAKE_BUILD_TYPE=Release
    make -j$(nproc)
    cd ..
    echo -e "${GREEN}Build complete.${NC}"
}

run() {
    local config_file="configs/default.cfg"
    
    if [[ $# -gt 0 ]]; then
        if [[ "$1" == "--help" || "$1" == "-h" ]]; then
            show_help
            return
        elif [[ -f "$1" ]]; then
            config_file="$1"
        else
            echo -e "${RED}Error: Config file '$1' not found${NC}"
            echo -e "Use 'nlm --help' to see available options"
            return 1
        fi
    fi
    
    echo -e "${BLUE}Running NLM with config: $config_file${NC}"
    
    # Check if executable exists
    if [[ ! -f "./build/nlm" ]]; then
        echo -e "${YELLOW}Building NLM first...${NC}"
        build
    fi
    
    # Run NLM with config
    ./build/nlm --config "$config_file"
    local exit_code=$?
    
    if [[ $exit_code -eq 0 ]]; then
        echo -e "${GREEN}NLM completed successfully${NC}"
    else
        echo -e "${RED}NLM failed with exit code $exit_code${NC}"
    fi
    
    return $exit_code
}

run_phase6() {
    echo -e "${BLUE}Running Phase 6 Integration Demo...${NC}"
    
    # Check if Phase6 demo exists
    if [[ ! -f "./build/nlm_phase6_demo" ]]; then
        echo -e "${YELLOW}Building NLM first...${NC}"
        build
    fi
    
    # Run Phase 6 demo
    ./build/nlm_phase6_demo
    local exit_code=$?
    
    if [[ $exit_code -eq 0 ]]; then
        echo -e "${GREEN}Phase 6 demo completed successfully${NC}"
    else
        echo -e "${RED}Phase 6 demo failed with exit code $exit_code${NC}"
    fi
    
    return $exit_code
}

experiment() {
    echo -e "${BLUE}Running Integration Experiment...${NC}"
    
    if [[ ! -f "./build/nlm_phase6_demo" ]]; then
        echo -e "${YELLOW}Building NLM first...${NC}"
        build
    fi
    
    # Create custom config for experiment
    local config_file="configs/experiment.cfg"
    cat > "$config_file" << EOF
# NLM Experiment Configuration
random_seed = 12345
simulation_timestep = 0.001
neuron_count = 2000
region_count = 2
connection_probability = 0.15
stdp_ltp_weight = 0.02
stdp_ltd_weight = 0.015
synaptogenesis_rate = 0.0001
pruning_rate = 0.00001
replay_interval = 50
consolidation_interval = 500
EOF
    
    echo -e "${BLUE}Running with experiment config: $config_file${NC}"
    ./build/nlm --config "$config_file"
    local exit_code=$?
    
    # Clean up
    rm -f "$config_file"
    
    return $exit_code
}

benchmark() {
    echo -e "${BLUE}Running Performance Benchmarks...${NC}"
    
    if [[ ! -f "./build/benchmark" ]]; then
        echo -e "${YELLOW}Building NLM first...${NC}"
        build
    fi
    
    # Run different benchmark scenarios
    echo -e "${YELLOW}Running small brain benchmark (100 neurons)...${NC}"
    ./build/benchmark --neurons 100 --steps 1000
    
    echo -e "${YELLOW}Running medium brain benchmark (1000 neurons)...${NC}"
    ./build/benchmark --neurons 1000 --steps 5000
    
    echo -e "${GREEN}Benchmarks complete.${NC}"
}

explore() {
    echo -e "${BLUE}Opening NLM documentation and examples...${NC}"
    
    if [[ -f "README.md" ]]; then
        echo -e "${YELLOW}Main README:${NC}"
        cat README.md | head -50
        echo -e "\n${YELLOW}Use 'nlm --help' for more information${NC}"
    fi
    
    if [[ -d "docs" ]]; then
        echo -e "\n${YELLOW}Available documentation:${NC}"
        ls -la docs/
    fi
}

show_help() {
    echo -e "${GREEN}NLM (Neural Learning Machine) Command Line Interface${NC}"
    echo -e "${BLUE}Enhanced CLI for NLM neural simulation framework${NC}"
    echo
    echo -e "${YELLOW}USAGE:${NC}"
    echo -e "  nlm [command] [options]"
    echo
    echo -e "${YELLOW}COMMANDS:${NC}"
    echo -e "  ${GREEN}build${NC}               Build the NLM project (default)"
    echo -e "  ${GREEN}clean${NC}              Clean build artifacts"
    echo -e "  ${GREEN}run${NC} [config]        Run NLM simulation (default config: configs/default.cfg)"
    echo -e "  ${GREEN}run-phase6${NC}         Run Phase 6 integration demo"
    echo -e "  ${GREEN}experiment${NC}         Run integration experiment with custom config"
    echo -e "  ${GREEN}benchmark${NC}          Run performance benchmarks"
    echo -e "  ${GREEN}explore${NC}            Show documentation and examples"
    echo -e "  ${GREEN}help${NC}               Show this help message"
    echo
    echo -e "${YELLOW}OPTIONS:${NC}"
    echo -e "  --help, -h              Show this help message"
    echo -e "  --config <file>          Specify configuration file"
    echo -e "  --neurons <count>       Number of neurons (for benchmarks)"
    echo -e "  --steps <count>         Simulation steps (for benchmarks)"
    echo -e "  --verbose, -v           Enable verbose output"
    echo
    echo -e "${YELLOW}EXAMPLES:${NC}"
    echo -e "  nlm                          # Build and run default simulation"
    echo -e "  nlm run custom.cfg          # Run with custom config"
    echo -e "  nlm run-phase6              # Run Phase 6 integration test"
    echo -e "  nlm benchmark                # Run performance benchmarks"
    echo -e "  nlm explore                  # Show documentation"
    echo
    echo -e "${YELLOW}CONFIGURATION:${NC}"
    echo -e "  Default config: configs/default.cfg"
    echo -e "  Experiment config: configs/experiment.cfg (created by 'nlm experiment')"
    echo
    echo -e "${YELLOW}For more information, visit: https://github.com/nlm-project/nlm${NC}"
}

# Determine which command to run
if [[ $# -eq 0 ]]; then
    # Default command: build
    build
    run
elif [[ "$1" == "--help" || "$1" == "-h" ]]; then
    show_help
else
    # Extract command and remaining arguments
    command="$1"
    shift
    
    # Forward remaining arguments to the command function
    case $command in
        build)
            build
            ;;
        clean)
            clean
            ;;
        run)
            run "$@"
            ;;
        run-phase6)
            run_phase6
            ;;
        experiment)
            experiment
            ;;
        benchmark)
            benchmark "$@"
            ;;
        explore)
            explore
            ;;
        help)
            show_help
            ;;
        *)
            echo -e "${RED}Error: Unknown command '$1'${NC}"
            echo -e "Use 'nlm --help' to see available commands"
            exit 1
            ;;
    esac
fi
