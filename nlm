#!/usr/bin/env bash

# NLM Command Line Interface (CLI)
# Advanced tool for running and managing NLM simulations

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Usage information
function print_usage() {
    echo "Usage: nlm [OPTIONS] [COMMAND] [ARGS]"
    echo ""
    echo "NLM (Neural Learning Machine) - Advanced Brain Simulation Framework"
    echo ""
    echo "Commands:"
    echo "  run              Run a simulation with specified configuration"
    echo "  config           Manage configuration files"
    echo "  checkpoint       Manage brain checkpoints"
    echo "  test             Run tests"
    echo "  info             Display system information"
    echo ""
    echo "Options:"
    echo "  -h, --help       Show this help message"
    echo "  -v, --version    Show version information"
    echo "  -c, --config     Configuration file path"
    echo "  -o, --output     Output file/directory"
    echo "  -d, --debug      Enable debug mode"
    echo "  -p, --profile    Enable profiling"
    echo ""
    echo "Examples:"
    echo "  nlm run --config my_config.json --output results"
    echo "  nlm checkpoint save nlm_brain.bin"
    echo "  nlm checkpoint load nlm_brain.bin --output demo_results"
    echo "  nlm test run --all"
    echo ""
}

function print_version() {
    echo "NLM Phase 6 - Final Integration (Version 0.1.0)"
    echo "Experimental Artificial Developmental Brain"
    echo ""
    echo "Built with C++20 and Python bindings (pynlm)"
    echo "Architecture: Closed-loop neural system with integrated memory,"
    echo "              prediction, cognition, and neuromodulation"
}

function print_info() {
    echo -e "${BLUE}NLM System Information${NC}"
    echo "==========================="
    echo ""
    echo "Project: Neural Learning Machine (熙然)"
    echo "Phase: 6 - Final Integration"
    echo "Version: 0.1.0"
    echo ""
    echo "Key Features:"
    echo "  ✓ Real spiking neural computation (LIF neurons)"
    echo "  ✓ Event-driven spike propagation with delays"
    echo "  ✓ STDP and Hebbian plasticity"
    echo "  ✓ Structural plasticity (synaptogenesis/pruning)"
    echo "  ✓ Integrated memory systems (Working, Episodic, Associative)"
    echo "  ✓ Neuromodulation (Dopamine, Curiosity, Novelty, Prediction Error)"
    echo "  ✓ Prediction system integration"
    echo "  ✓ Neural planning and concept formation"
    echo "  ✓ Developmental stages and maturation"
    echo "  ✓ Checkpoint save/load functionality"
    echo "  ✓ Replay and memory consolidation"
    echo ""
    echo "Available Commands:"
    echo "  run              Run simulation with custom configuration"
    echo "  config            Show current configuration"
    echo "  checkpoint        Save/load brain state"
    echo "  test              Run unit/integration tests"
    echo "  experiment        Run Phase 6 integration experiments"
    echo ""
    echo "Quick start examples:"
    echo "  nlm run                    # Run with default settings"
    echo "  nlm run --neurons 500     # Configure neuron count"
    echo "  nlm experiment phase6      # Run Phase 6 integration demo"
}

# Main CLI command dispatcher
function main() {
    local command="${1:-}"
    shift || true

    case "${command}" in
        "run")
            run_simulation "$@"
            ;;
        "config")
            manage_config "$@"
            ;;
        "checkpoint")
            manage_checkpoint "$@"
            ;;
        "test")
            run_tests "$@"
            ;;
        "experiment")
            run_experiment "$@"
            ;;
        "info")
            print_info
            ;;
        "--help"|-h|"help")
            print_usage
            ;;
        "--version"|-v)
            print_version
            ;;
        *)
            echo -e "${RED}Unknown command: ${command}${NC}"
            echo "Use 'nlm --help' for available commands"
            exit 1
            ;;
    esac
}

# Run simulation with configuration
function run_simulation() {
    echo -e "${BLUE}NLM Simulation Runner${NC}"
    echo "==========================="
    echo ""

    local config_file="configs/default.cfg"
    local output_dir="results"
    local neuron_count=500
    local steps=1000
    local debug=false
    local profile=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --config)
                config_file="$2"
                shift 2
                ;;
            --output|-o)
                output_dir="$2"
                shift 2
                ;;
            --neurons|-n)
                neuron_count="$2"
                shift 2
                ;;
            --steps|-s)
                steps="$2"
                shift 2
                ;;
            --debug|-d)
                debug=true
                shift
                ;;
            --profile|-p)
                profile=true
                shift
                ;;
            --help|-h)
                echo "Simulation options:"
                echo "  --config FILE      Configuration file path"
                echo "  --output DIR      Output directory"
                echo "  --neurons N       Number of neurons"
                echo "  --steps N         Number of simulation steps"
                echo "  --debug           Enable debug mode"
                echo "  --profile         Enable profiling"
                return
                ;;
            *)
                echo -e "${RED}Unknown option: $1${NC}"
                return
                ;;
        esac
    done

    echo "Configuration:"
    echo "  Config file: ${config_file}"
    echo "  Output dir:  ${output_dir}"
    echo "  Neurons:      ${neuron_count}"
    echo "  Steps:        ${steps}"
    echo "  Debug mode:   ${debug}"
    echo "  Profiling:    ${profile}"
    echo ""

    # Create output directory
    mkdir -p "${output_dir}"

    # Build the command
    local cmake_build_dir="build"
    local executable="${cmake_build_dir}/nlm"

    if [[ ! -f "${executable}" ]]; then
        echo -e "${YELLOW}Building NLM executable...${NC}"
        mkdir -p "${cmake_build_dir}"
        cd "${cmake_build_dir}" || exit 1

        if ! cmake .. -DCMAKE_BUILD_TYPE=Release; then
            echo -e "${RED}CMake configuration failed${NC}"
            return 1
        fi

        if ! make -j$(nproc); then
            echo -e "${RED}Build failed${NC}"
            return 1
        fi

        cd .. || exit 1
    fi

    # Run the simulation
    echo -e "${YELLOW}Running simulation...${NC}"

    local simulation_cmd="${executable}"

    if [[ "${debug}" == "true" ]]; then
        simulation_cmd="${simulation_cmd} --debug"
    fi

    # Set environment variables
    export NLM_NEURON_COUNT="${neuron_count}"
    export NLM_SIMULATION_STEPS="${steps}"

    # Run with valgrind if profiling is enabled
    if [[ "${profile}" == "true" ]]; then
        echo -e "${YELLOW}Running with profiling (valgrind)...${NC}"
        valgrind --tool=callgrind --callgrind-out-file="${output_dir}/callgrind.out" "${simulation_cmd}" 2>&1 | tee "${output_dir}/simulation.log"
        echo -e "${YELLOW}Profiling data saved to ${output_dir}/callgrind.out${NC}"
    else
        "${simulation_cmd}" 2>&1 | tee "${output_dir}/simulation.log"
    fi

    echo -e "${GREEN}Simulation complete! Results saved to ${output_dir}${NC}"
}

# Configuration management
function manage_config() {
    echo -e "${BLUE}NLM Configuration Manager${NC}"
    echo "============================"
    echo ""

    local command="${1:-}"
    shift || true

    case "${command}" in
        "show"|"current")
            show_current_config
            ;;
        "load"|"init")
            initialize_config "$@"
            ;;
        "save"|"export")
            export_config "$@"
            ;;
        "create")
            create_config "$@"
            ;;
        *)
            echo -e "${RED}Unknown config command: ${command}${NC}"
            echo "Available commands: show, load, save, create"
            ;;
    esac
}

# Show current configuration
function show_current_config() {
    echo "Current NLM Configuration:"
    echo "=========================="
    echo ""

    if [[ -f "configs/default.cfg" ]]; then
        echo -e "${YELLOW}Current configuration (default.cfg):${NC}"
        cat "configs/default.cfg"
        echo ""
    else
        echo -e "${RED}No configuration file found. Creating default...${NC}"
        cat > "configs/default.cfg" << 'EOF'
# NLM Default Configuration
# ===========================

# Brain Parameters
random_seed = 42
simulation_timestep = 0.001
neuron_count = 500
region_count = 1
connection_probability = 0.1

# STDP Parameters
stdp_ltp_weight = 0.01
stdp_ltd_weight = 0.012
stdp_tau = 20.0

# Structural Plasticity Parameters
synaptogenesis_rate = 0.0001
pruning_rate = 0.00001

# Development Parameters
replay_interval = 100
consolidation_interval = 1000
EOF
        echo -e "${GREEN}Created default configuration.${NC}"
    fi

    echo ""
    echo "Additional configuration options:"
    echo "  neuron_count          - Total number of neurons (default: 500)"
    echo "  region_count          - Number of neural regions (default: 1)"
    echo "  connection_probability - Synapse connection probability (default: 0.1)"
    echo "  simulation_timestep   - Time step duration (default: 0.001s)"
    echo "  random_seed           - Random seed for reproducibility (default: 42)"
    echo ""
    echo "To modify configuration, edit configs/default.cfg"
    echo "Or run: nlm config create <config_file>"
}

# Initialize configuration file
function initialize_config() {
    local config_file="${1:-configs/custom.cfg}"

    echo -e "${YELLOW}Creating configuration: ${config_file}${NC}"

    cat > "${config_file}" << 'EOF'
# NLM Custom Configuration
# =======================

# Brain Parameters
random_seed = 42
simulation_timestep = 0.001
neuron_count = 1000
region_count = 2
connection_probability = 0.15

# STDP Parameters
stdp_ltp_weight = 0.02
stdp_ltd_weight = 0.015
stdp_tau = 30.0

# Structural Plasticity Parameters
synaptogenesis_rate = 0.00015
pruning_rate = 0.000005

# Development Parameters
replay_interval = 200
consolidation_interval = 2000

# Neuromodulation Parameters
dopamine_scale = 1.0
curiosity_enabled = true
novelty_enabled = true

# Memory Parameters
working_memory_capacity = 0.1
max_episodes = 5000
EOF

    echo -e "${GREEN}Configuration created at ${config_file}${NC}"
}

# Export configuration
function export_config() {
    local config_file="${1:-configs/exported.cfg}"

    if [[ -f "configs/default.cfg" ]]; then
        cp "configs/default.cfg" "${config_file}"
        echo -e "${GREEN}Configuration exported to ${config_file}${NC}"
    else
        echo -e "${RED}No configuration to export. Use 'nlm config init' first.${NC}"
    fi
}

# Create configuration file
function create_config() {
    local config_name="${1:?Config name required}"
    local config_file="configs/${config_name}.cfg"

    if [[ -f "${config_file}" ]]; then
        echo -e "${YELLOW}Configuration ${config_name} already exists. Overwrite? (y/n)${NC}"
        read -r answer
        if [[ "${answer}" != "y" && "${answer}" != "Y" ]]; then
            echo "Cancelled."
            return
        fi
    fi

    initialize_config "${config_file}"
}

# Checkpoint management
function manage_checkpoint() {
    echo -e "${BLUE}NLM Checkpoint Manager${NC}"
    echo "=========================="
    echo ""

    local command="${1:-}"
    shift || true

    case "${command}" in
        "save")
            save_checkpoint "$@"
            ;;
        "load")
            load_checkpoint "$@"
            ;;
        "list")
            list_checkpoints
            ;;
        "info")
            checkpoint_info "$@"
            ;;
        *)
            echo -e "${RED}Unknown checkpoint command: ${command}${NC}"
            echo "Available commands: save, load, list, info"
            ;;
    esac
}

# Save checkpoint
function save_checkpoint() {
    local checkpoint_name="${1:-nlm_checkpoint}"
    local output_dir="checkpoints"

    mkdir -p "${output_dir}"

    # Build if necessary
    if [[ ! -f "build/nlm" ]]; then
        echo -e "${YELLOW}Building NLM executable...${NC}"
        mkdir -p build
        cd build || exit 1
        cmake .. -DCMAKE_BUILD_TYPE=Release > /dev/null 2>&1
        make -j$(nproc) > /dev/null 2>&1
        cd .. || exit 1
    fi

    # Run simulation and save checkpoint
    echo -e "${YELLOW}Running simulation and saving checkpoint...${NC}"
    ./build/nlm --config "configs/default.cfg" --checkpoint "${output_dir}/${checkpoint_name}.bin" 2>&1 | tail -20

    if [[ -f "${output_dir}/${checkpoint_name}.bin" ]]; then
        echo -e "${GREEN}Checkpoint saved: ${output_dir}/${checkpoint_name}.bin${NC}"
    else
        echo -e "${RED}Checkpoint save failed!${NC}"
    fi
}

# Load checkpoint
function load_checkpoint() {
    local checkpoint_file="${1:?Checkpoint file required}"
    local output_dir="results"

    if [[ ! -f "${checkpoint_file}" ]]; then
        echo -e "${RED}Checkpoint file not found: ${checkpoint_file}${NC}"
        return 1
    fi

    mkdir -p "${output_dir}"
    echo -e "${YELLOW}Loading checkpoint: ${checkpoint_file}${NC}"

    # Run with checkpoint load command
    ./build/nlm --load "${checkpoint_file}" --output "${output_dir}" 2>&1 | tail -30
}

# List checkpoints
function list_checkpoints() {
    local checkpoint_dir="checkpoints"

    if [[ ! -d "${checkpoint_dir}" ]]; then
        echo -e "${YELLOW}No checkpoints found. Run 'nlm checkpoint save' first.${NC}"
        return
    fi

    echo "Available checkpoints:"
    echo "======================="
    ls -la "${checkpoint_dir}"/*.bin 2>/dev/null || echo "No checkpoint files found"
}

# Checkpoint info
function checkpoint_info() {
    local checkpoint_file="${1:?Checkpoint file required}"

    if [[ ! -f "${checkpoint_file}" ]]; then
        echo -e "${RED}Checkpoint file not found: ${checkpoint_file}${NC}"
        return 1
    fi

    echo -e "${BLUE}Checkpoint Information${NC}"
    echo "========================"
    echo "File: ${checkpoint_file}"
    echo "Size: $(du -h "${checkpoint_file}" | cut -f1)"
    echo "Modified: $(date -r "${checkpoint_file}")"

    # Extract metadata if possible (placeholder for actual implementation)
    echo ""
    echo "Note: Checkpoint contains brain state with neurons, synapses, and memory systems"
}

# Run tests
function run_tests() {
    echo -e "${BLUE}NLM Test Runner${NC}"
    echo "================="
    echo ""

    local test_mode="${1:-quick}"
    shift || true

    case "${test_mode}" in
        "quick")
            quick_tests
            ;;
        "all")
            all_tests
            ;;
        "unit")
            unit_tests
            ;;
        "integration")
            integration_tests
            ;;
        *)
            echo -e "${RED}Unknown test mode: ${test_mode}${NC}"
            echo "Available modes: quick, all, unit, integration"
            ;;
    esac
}

# Quick tests
function quick_tests() {
