class BrainStats:
    """Statistics and metrics for brain simulation."""
    
    def __init__(self, brain):
        self.brain = brain
        self._timestep = 0.0
    
    def get_neuron_count(self) -> int:
        """Get total number of neurons."""
        return self.brain.getTotalNeuronCount()
    
    def get_synapse_count(self) -> int:
        """Get total number of synapses."""
        return self.brain.getTotalSynapseCount()
    
    def get_firing_count(self) -> int:
        """Get number of currently firing neurons."""
        return self.brain.getFiringNeuronCount()
    
    def get_average_firing_rate(self) -> float:
        """Get average firing rate across all neurons."""
        return self.brain.getAverageFiringRate()
    
    def get_excitation_inhibition_ratio(self) -> float:
        """Get excitation/inhibition balance ratio."""
        return self.brain.getExcitationInhibitionRatio()
    
    def get_total_spikes(self) -> int:
        """Get total spike count."""
        return self.brain.getTotalSpikeCount()
    
    def get_developmental_stage(self) -> Any:
        """Get current developmental stage."""
        return self.brain.getDevelopmentalStage()
    
    def get_activity_summary(self) -> Dict[str, Any]:
        """Get a summary of current brain activity."""
        return {
            'neurons': self.get_neuron_count(),
            'synapses': self.get_synapse_count(),
            'firing': self.get_firing_count(),
            'firing_rate': self.get_average_firing_rate(),
            'e_i_ratio': self.get_excitation_inhibition_ratio(),
            'total_spikes': self.get_total_spikes(),
            'development_stage': self.get_developmental_stage(),
            'timestep': self._timestep
        }
    
    def __str__(self):
        return f"BrainStats(neurons={self.get_neuron_count()}, firing={self.get_firing_count()}, " \
               f"rate={self.get_average_firing_rate():.2f}Hz, stage={self.get_developmental_stage()})"

class EpisodeStats:
    """Statistics for an agent episode."""
    
    def __init__(self):
        self.reset()
    
    def reset(self):
        """Reset episode statistics."""
        self.steps = 0
        self.reward = 0.0
        self.max_reward = 0.0
        self.min_reward = 0.0
        self.reward_history = []
        self.firing_history = []
        self.curiosity_history = []
        self.novelty_history = []
        self.prediction_error_history = []
        self.start_time = time.time()
    
    def add_step_stats(self, reward: float, firing_count: int, 
                      curiosity: float = 0.0, novelty: float = 0.0, 
                      prediction_error: float = 0.0):
        """Add statistics for a step."""
        self.steps += 1
        self.reward += reward
        self.max_reward = max(self.max_reward, reward)
        self.min_reward = min(self.min_reward, reward) if self.steps > 1 else reward
        self.reward_history.append(reward)
        self.firing_history.append(firing_count)
        self.curiosity_history.append(curiosity)
        self.novelty_history.append(novelty)
        self.prediction_error_history.append(prediction_error)
    
    def get_total_reward(self) -> float:
        """Get total reward for episode."""
        return self.reward
    
    def get_average_reward(self) -> float:
        """Get average reward per step."""
        return self.reward / self.steps if self.steps > 0 else 0.0
    
    def get_max_reward(self) -> float:
        """Get maximum reward in episode."""
        return self.max_reward
    
    def get_min_reward(self) -> float:
        """Get minimum reward in episode."""
        return self.min_reward
    
    def get_duration(self) -> float:
        """Get episode duration in seconds."""
        return time.time() - self.start_time
    
    def get_average_firing_rate(self) -> float:
        """Get average firing rate across episode."""
        return sum(self.firing_history) / len(self.firing_history) if self.firing_history else 0.0
    
    def get_summary(self) -> Dict[str, Any]:
        """Get summary of episode statistics."""
        return {
            'steps': self.steps,
            'total_reward': self.get_total_reward(),
            'average_reward': self.get_average_reward(),
            'max_reward': self.get_max_reward(),
            'min_reward': self.get_min_reward(),
            'duration_seconds': self.get_duration(),
            'average_firing_rate': self.get_average_firing_rate(),
            'final_curiosity': self.curiosity_history[-1] if self.curiosity_history else 0.0,
            'final_novelty': self.novelty_history[-1] if self.novelty_history else 0.0,
            'final_prediction_error': self.prediction_error_history[-1] if self.prediction_error_history else 0.0
        }
    
    def __str__(self):
        return f"EpisodeStats(steps={self.steps}, total_reward={self.get_total_reward():.2f}, " \
               f"avg_reward={self.get_average_reward():.3f}, duration={self.get_duration():.2f}s)"

class NLMBrain:
    """Enhanced Python wrapper for NLM brain with convenience methods."""
    
    def __init__(self, config=None):
        """
        Initialize NLM brain wrapper.
        
        Args:
            config: Optional configuration. If None, uses default config.
        """
        if not PYNLM_AVAILABLE:
            raise InitializationError("pynlm C++ bindings not available")
        
        if config is None:
            self.config = _pynlm.createDefaultConfig()
            # Apply sensible defaults for most users
            self.config.set("brain.neuron_count", 1000)
            self.config.set("brain.region_count", 1)
            self.config.set("brain.connection_probability", 0.1)
        else:
            self.config = config
        
        # Create brain with enhanced error handling
        try:
            self._brain = _pynlm.createBrain(self.config)
            self._brain.initialize()
        except Exception as e:
            raise InitializationError(f"Failed to initialize NLM brain: {e}")
        
        # Create agent brain interface
        self._agent_brain = _pynlm.createAgentBrain(self._brain)
        
        # Statistics tracking
        self._stats = BrainStats(self._brain)
    
    def initialize(self) -> bool:
        """Initialize the brain."""
        try:
            self._brain.initialize()
            return True
        except Exception as e:
            raise InitializationError(f"Brain initialization failed: {e}")
    
    def reset(self) -> None:
        """Reset brain to initial state."""
        self._brain.reset()
        self._brain.initialize()
    
    def step(self, step_num: int, time: Optional[float] = None) -> None:
        """
        Perform a single simulation step.
        
        Args:
            step_num: Current simulation step number
            time: Optional timestamp. If None, calculated from step number.
        """
        try:
            if time is not None:
                self._brain.step(step_num, time)
            else:
                self._brain.step(step_num)
            self._stats._timestep = step_num
        except Exception as e:
            raise SimulationError(f"Simulation step {step_num} failed: {e}")
    
    def run_simulation(self, num_steps: int, timestep: float = 0.001) -> Dict[str, Any]:
        """
        Run a complete simulation.
        
        Args:
            num_steps: Number of simulation steps to run
            timestep: Simulation timestep (default: 0.001)
        
        Returns:
            Dictionary with simulation statistics
        """
        if num_steps < 0:
            raise ValidationError(f"Number of steps must be non-negative, got {num_steps}")
        
        initial_spikes = self._brain.getTotalSpikeCount()
        initial_neurons = self._brain.getTotalNeuronCount()
        
        try:
            for step in range(num_steps):
                time = step * timestep
                self._brain.step(step, time)
            
            final_spikes = self._brain.getTotalSpikeCount()
            final_neurons = self._brain.getTotalNeuronCount()
            
            stats = self._stats.get_activity_summary()
            stats.update({
                'initial_spikes': initial_spikes,
                'final_spikes': final_spikes,
                'spikes_generated': final_spikes - initial_spikes,
                'simulation_steps': num_steps,
                'success': True
            })
            
            return stats
            
        except Exception as e:
            raise SimulationError(f"Simulation failed: {e}")
    
    def inject_current_to_neurons(self, neuron_type: Any, current: float) -> None:
        """
        Inject current into all neurons of a specific type.
        
        Args:
            neuron_type: Type of neuron (Excitatory, Inhibitory, Sensory, Motor, etc.)
            current: Current to inject (positive for excitation, negative for inhibition)
        """
        try:
            self._brain.injectCurrentToNeurons(neuron_type, current)
        except Exception as e:
            raise SimulationError(f"Current injection failed: {e}")
    
    def produce_action(self) -> Optional[Any]:
        """
        Produce motor action based on current neural activity.
        
        Returns:
            Motor command object or None if no action produced
        """
        try:
            return self._brain.produceAction()
        except Exception as e:
            raise SimulationError(f"Action production failed: {e}")
    
    def save(self, filepath: str) -> bool:
        """
        Save brain state to file.
        
        Args:
            filepath: Path to save file
        
        Returns:
            True if save succeeded, False otherwise
        """
        try:
            return self._brain.save(filepath)
        except Exception as e:
            raise SimulationError(f"Save failed: {e}")
    
    def load(self, filepath: str) -> bool:
        """
        Load brain state from file.
        
        Args:
            filepath: Path to load file
        
        Returns:
            True if load succeeded, False otherwise
        """
        try:
            return self._brain.load(filepath)
        except Exception as e:
            raise SimulationError(f"Load failed: {e}")
    
    # Convenience methods for common operations
    
    def add_sensory_stimulus(self, stimulus_strength: float, duration: int = 10) -> None:
        """
        Add sensory stimulus to the brain.
        
        Args:
            stimulus_strength: Strength of sensory input (0-1 scale)
            duration: Number of simulation steps to apply stimulus
        """
        if not 0.0 <= stimulus_strength <= 1.0:
            raise ValidationError(f"Stimulus strength must be between 0.0 and 1.0, got {stimulus_strength}")
        
        if duration < 0:
            raise ValidationError(f"Duration must be non-negative, got {duration}")
        
        max_current = stimulus_strength * 100.0  # Scale to appropriate current range
        self.inject_current_to_neurons(_pynlm.NeuronType.Sensory, max_current)
    
    def run_burst_simulation(self, num_bursts: int, steps_per_burst: int) -> Dict[str, Any]:
        """
        Run a burst simulation with periodic stimuli.
        
        Args:
            num_bursts: Number of stimulus bursts
            steps_per_burst: Steps between bursts
        """
        if num_bursts < 0 or steps_per_burst < 0:
            raise ValidationError("Number of bursts and steps per burst must be non-negative")
        
        total_steps = num_bursts * (steps_per_burst + 10)
        initial_spikes = self._brain.getTotalSpikeCount()
        
        try:
            for burst in range(num_bursts):
                # Apply burst stimulus
                self.add_sensory_stimulus(0.8, 10)
                
                # Run between bursts
                for step in range(steps_per_burst):
                    self.step(burst * (steps_per_burst + 10) + step)
            
            final_spikes = self._brain.getTotalSpikeCount()
            
            stats = self._stats.get_activity_summary()
            stats.update({
                'initial_spikes': initial_spikes,
                'final_spikes': final_spikes,
                'spikes_generated': final_spikes - initial_spikes,
                'bursts': num_bursts,
                'steps_per_burst': steps_per_burst,
                'success': True
            })
            
            return stats
            
        except Exception as e:
            raise SimulationError(f"Burst simulation failed: {e}")
    
    def enable_plasticity(self, hebbian: bool = True, stdp: bool = True, reward_modulated: bool = False) -> None:
        """
        Enable plasticity rules.
        
        Args:
            hebbian: Enable Hebbian plasticity
            stdp: Enable STDP plasticity
            reward_modulated: Enable reward-modulated plasticity
        """
        # Note: This would require additional C++ API support
        # For now, this is a placeholder for future enhancement
        warnings.warn("Plasticity enablement requires additional C++ API support", 
                     DeprecationWarning)
    
    def get_stats(self) -> BrainStats:
        """Get brain statistics object."""
        return self._stats
    
    @property
    def brain(self):
        """Get the underlying C++ brain object."""
        return self._brain
    
    @property
    def agent(self):
        """Get the underlying agent brain object."""
        return self._agent_brain
    
    def __str__(self):
        return f"NLMBrain(neurons={self._stats.get_neuron_count()}, " \
               f"firing={self._stats.get_firing_count()}, " \
               f"development={self._stats.get_developmental_stage()})"
    
    def __repr__(self):
        return f"NLMBrain(config={self.config})"

