# Default configuration
DEFAULT_BRAIN_FILE="brain_config.ini"
DEFAULT_CHECKPOINT_DIR="./checkpoints"
DEFAULT_LOG_FILE="nlm_simulation.log"

# Function to print usage information
print_usage() {
    cat << EOF
NLM - Neural Learning Machine Command-Line Interface

USAGE:
  nlm <command> [options]

COMMANDS:
  run                    Run NLM simulation
  checkpoint             Checkpoint management
  config                 Configuration utilities
  monitor                Real-time monitoring
  debug                  Debugging tools
  help                   Show help information

EXAMPLES:
  nlm run --brain-config mybrain.ini --steps 1000
  nlm checkpoint save --name snapshot1
  nlm checkpoint list
  nlm config show
  nlm config validate
  nlm monitor --interval 1.0

For detailed help on a specific command, use:
  nlm help <command>
EOF
}

# Function to show command-specific help
print_command_help() {
    local command=$1
    case $command in
        run)
            cat << EOF
RUN NLM SIMULATION

Usage: nlm run [options]

Options:
  --brain-config FILE    Brain configuration file (default: brain_config.ini)
  --steps N              Number of simulation steps (required)
  --checkpoint-dir DIR   Directory for checkpoints (default: ./checkpoints)
  --checkpoint-interval N Checkpoint interval in steps (default: 1000)
  --max-checkpoints N     Maximum number of checkpoints to keep (default: 5)
  --log-file FILE        Log file path (default: nlm_simulation.log)
  --verbose              Enable verbose output
  --help                 Show this help message

Examples:
  nlm run --steps 1000
  nlm run --brain-config config.ini --checkpoint-dir ./data/checkpoints --steps 5000
EOF
            ;;
        checkpoint)
            cat << EOF
CHECKPOINT MANAGEMENT

Usage: nlm checkpoint <subcommand> [options]

Subcommands:
  save <name>            Save current brain state
  load <name>            Load brain state
  list                   List available checkpoints
  delete <name>          Delete checkpoint
  clear                  Delete all checkpoints
  info <name>            Show checkpoint information
  export <name> FILE     Export checkpoint to file
  import FILE NAME        Import checkpoint from file

Options:
  --checkpoint-dir DIR   Checkpoint directory (default: ./checkpoints)
  --help                 Show this help message

Examples:
  nlm checkpoint save snapshot1
  nlm checkpoint load snapshot1
  nlm checkpoint list
  nlm checkpoint info checkpoint-1000.bin
EOF
            ;;
        config)
            cat << EOF
CONFIGURATION UTILITIES

Usage: nlm config <subcommand> [options]

Subcommands:
  show                   Show current configuration
  set KEY VALUE          Set configuration value
  get KEY                Get configuration value
  validate               Validate configuration
  reset                  Reset to defaults
  load FILE              Load configuration from file
  save FILE              Save configuration to file
  list                   List all configuration keys
  export                 Export configuration to file (JSON/YAML)
  import                 Import configuration from file

Options:
  --config-file FILE     Configuration file path (default: brain_config.ini)
  --help                 Show this help message

Examples:
  nlm config show
  nlm config set neuron_count 1000
  nlm config get neuron_count
  nlm config validate
  nlm config load myconfig.ini
  nlm config save myconfig.ini
EOF
            ;;
        monitor)
            cat << EOF
REAL-TIME MONITORING

Usage: nlm monitor [options]

Options:
  --interval SECONDS    Monitoring interval (default: 1.0)
  --duration SECONDS    Monitoring duration (default: 0 for continuous)
  --output-file FILE    Output file for monitoring data
  --csv                 Export data in CSV format
  --json                JSON output format
  --help                Show this help message

Examples:
  nlm monitor --interval 2.0
  nlm monitor --duration 60 --csv monitoring.csv
EOF
            ;;
        debug)
            cat << EOF
DEBUGGING TOOLS

Usage: nlm debug [options]

Options:
  --log-level LEVEL      Set log level (debug, info, warning, error)
  --profile              Enable performance profiling
  --trace               Enable detailed tracing
  --export TRACE_FILE   Export debug trace to file
  --help                Show this help message

Examples:
  nlm debug --log-level debug
  nlm debug --profile --export debug_profile.txt
EOF
            ;;
        help)
            cat << EOF
GENERAL HELP

Shows this general help information.
See specific command help for detailed options.
EOF
            ;;
        *)
            cat << EOF
Unknown command. Show this help message.
EOF
            ;;
    esac
}

# Function to run NLM simulation
run_simulation() {
    local brain_config=${DEFAULT_BRAIN_FILE}
    local steps=0
    local checkpoint_dir=${DEFAULT_CHECKPOINT_DIR}
    local checkpoint_interval=1000
    local max_checkpoints=5
    local log_file=${DEFAULT_LOG_FILE}
    local verbose=false

    # Parse command line arguments
    while [[ $# -gt 0 ]]; do
        local key="$1"
        if [[ $# -gt 1 ]]; then
            local value="$2"
        else
            local value=""
        fi

        case $key in
            --brain-config)
                brain_config="$value"
                shift 2
                ;;
            --steps)
                steps="$value"
                shift 2
                ;;
            --checkpoint-dir)
                checkpoint_dir="$value"
                shift 2
                ;;
            --checkpoint-interval)
                checkpoint_interval="$value"
                shift 2
                ;;
            --max-checkpoints)
                max_checkpoints="$value"
                shift 2
                ;;
            --log-file)
                log_file="$value"
                shift  фаминение 2
                ;;
            --verbose)
                verbose=true
                shift
                ;;
            --help)
                print_command_help run
                return
                ;;
            *)
                echo "Unknown option: $key"
                print_command_help run
                return 1
                ;;
        esac
    done

    # Validate required arguments
    if [[ -z "$steps" ]]; then
        echo "Error: --steps is required" >&2
        print_command_help run
        return 1
    fi

    # Check if brain binary exists
    if [[ ! -f "./nlm" ]]; then
        echo "Error: NLM binary not found. Please build the project first." >&2
        return 1
    fi

    # Create checkpoint directory
    mkdir -p "$checkpoint_dir" || {
        echo "Error: Cannot create checkpoint directory: $checkpoint_dir" >&2
        return 1
    }

    # Run the simulation
    echo "Starting NLM simulation with ${steps} steps..."
    echo "Checkpoint directory: $checkpoint_dir"
    echo "Log file: $log_file"

    # Run the binary with appropriate arguments
    if [[ "$verbose" == "true" ]]; then
        ./nlm --steps "$steps" --checkpoint-dir "$checkpoint_dir" --checkpoint-interval "$checkpoint_interval" --max-checkpoints "$max_checkpoints" 2>&1 | tee "$log_file"
    else
        ./nlm --steps "$steps" --checkpoint-dir "$checkpoint_dir" --checkpoint-interval "$checkpoint_interval" --max-checkpoints "$max_checkpoints" 2>&1 | tee "$log_file"
    fi

    local result=$?

    if [[ $result -eq 0 ]]; then
        echo "✓ Simulation completed successfully"
        echo "  Results saved to: $log_file"
        echo "  Checkpoints saved to: $checkpoint_dir"
    else
        echo "✗ Simulation failed"
        echo "  See $log_file for details"
    fi

    return $result
}

