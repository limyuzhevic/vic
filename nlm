#!/usr/bin/env bash
# NLM (Neural Learning Machine) Command-Line Interface

# This CLI provides tools for working with NLM simulations, including:
# - Brain simulation management
# - Checkpoint operations
# - Configuration utilities
# - Simulation monitoring
# - Debugging tools

