#!/usr/bin/env bash

# NLM Command Line Interface (CLI)
# Provides comprehensive tools for configuration management, simulation control, and debugging

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Configuration
NLM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUILD_DIR="${NLM_DIR}/build"
EXECUTABLE="${BUILD_DIR}/nlm"
PHASE3_DEMO="${BUILD_DIR}/nlm_phase3_demo"
PHASE4_DEMO="${BUILD_DIR}/nlm_phase4_demo"
PHASE6_DEMO="${BUILD_DIR}/nlm_phase6_demo"

# Logging
LOG_FILE="${NLM_DIR}/nlm_cli.log"
VERBOSE=false

# Default configuration
CONFIG_FILE="${NLM_DIR}/configs/default.cfg"
NEURON_COUNT=500
REGION_COUNT=1
SIMULATION_STEPS=1000
TIMESTEP=0.001

# Usage information
function print_usage() {
    cat << EOF
#!/usr/bin/env bash

# NLM Command Line Interface (CLI)
# Provides comprehensive tools for configuration management, simulation control, and debugging

set -euo pipefail
EOF
}

# Print version
function print_version() {
    cat << EOF
NLM - Neural Learning Machine v2.0 (Phase 6)
An experimental artificial developmental brain system
Build date: $(date)
Git commit: $(cd "${NLM_DIR}" && git log -1 --format=%h 2>/dev/null || echo "unknown")

Phase 6 Features:
- Integrated memory systems (working memory, episodic memory, associative memory)
- Neuromodulation (dopamine, curiosity, novelty, prediction error)
- Prediction and cognition systems
- Development and structural plasticity
- Checkpointing and replay
EOF
}

# Initialize logging
function setup_logging() {
    if [[ "$VERBOSE" == "true" ]]; then
        exec 1> >(tee -a "${LOG_FILE}") 2>&1
    else
        # Log only errors to file
        exec 2> >(tee -a "${LOG_FILE}")
    fi
}

# Parse command line arguments
function parse_args() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                print_usage
                exit 0
                ;;
            -v|--version)
                print_version
                exit 0
                ;;
            -c|--config)
                CONFIG_FILE="$2"
                shift 2
                ;;
            -n|--neurons)
                NEURON_COUNT="$2"
                shift 2
                ;;
            -r|--regions)
                REGION_COUNT="$2"
                shift 2
                ;;
            -s|--steps)
                SIMULATION_STEPS="$2"
                shift 2
                ;;
            -t|--timestep)
                TIMESTEP="$2"
                shift 2
                ;;
            -V|--verbose)
                VERBOSE=true
                shift
                ;;
            -l|--log)
                LOG_FILE="$2"
                shift 2
                ;;
            config|run|experiment|debug|help)
                COMMAND="$1"
                shift
                break
                ;;
            *)
                echo -e "${RED}Unknown option: $1${NC}" >&2
                print_usage >&2
                exit 1
                ;;
        esac
    done
}

# Configuration management functions
function config_commands() {
    local subcommand="$1"
    shift
    
    case "$subcommand" in
        save)
            config_save "$@"
            ;;
        load)
            config_load "$@"
            ;;
        show)
            config_show "$@"
            ;;
        edit)
            config_edit "$@"
            ;;
        validate)
            config_validate "$@"
            ;;
        *)
            echo -e "${RED}Unknown config command: $subcommand${NC}" >&2
            config_help
            exit 1
            ;;
    esac
}

function config_save() {
    local output_file="${CONFIG_FILE%.*}_backup$(date +%Y%m%d_%H%M%S).cfg"
    
    echo -e "${CYAN}Saving configuration to: ${NC}$CONFIG_FILE"
    
    # Generate configuration based on current settings
    cat > "${CONFIG_FILE}" << EOF
# NLM Configuration File
# Generated by NLM CLI on $(date)
# Backup available at: ${output_file}

[simulation]
neuron_count = ${NEURON_COUNT}
region_count = ${REGION_COUNT}
simulation_timestep = ${TIMESTEP}
max_steps = ${SIMULATION_STEPS}

[plasticity]
stdp_ltp_weight = 0.01
stdp_ltd_weight = 0.012
stdp_tau = 20.0
synaptogenesis_rate = 0.0001
pruning_rate = 0.00001

[neuromodulation]
dopamine_baseline = 0.1
curiosity_novelty_weight = 0.5
curiosity_prediction_error_weight = 0.5
novelty_threshold = 0.3

[development]
initial_plasticity = 1.0
critical_period_duration = 100.0
maturation_rate = 0.5

[memory]
working_memory_capacity = 50
episodic_memory_max_episodes = 1000
associative_memory_size = 100

[debug]
log_level = ${VERBOSE:-info}
checkpoint_interval = 1000
replay_interval = 100

# Command line overrides
EOF
    
    # Add command line specific settings
    if [[ "$VERBOSE" == "true" ]]; then
        echo "verbose = true" >> "${CONFIG_FILE}"
    fi
    
    echo -e "${GREEN}Configuration saved successfully!${NC}"
}

function config_load() {
    local input_file="$1"
    
    if [[ -z "$input_file" ]]; then
        echo -e "${RED}Error: No input file specified${NC}" >&2
        echo "Usage: nlm config load <file>" >&2
        exit 1
    fi
    
    if [[ ! -f "$input_file" ]]; then
        echo -e "${RED}Error: File not found: $input_file${NC}" >&2
        exit 1
    fi
    
    echo -e "${CYAN}Loading configuration from: ${NC}$input_file"
    
    # Parse the configuration file
    while IFS='=' read -r key value; do
        # Skip comments and empty lines
        [[ "$key" =~ ^#.*$ ]] && continue
        [[ -z "$key" ]] && continue
        
        # Remove whitespace
        key=$(echo "$key" | tr -d ' \t')
        value=$(echo "$value" | tr -d ' \t')
        
        # Handle simple key=value parsing
        if [[ "$key" =~ ^([^[]+)(\[.*\])?$ ]]; then
            echo -e "${YELLOW}Loaded: ${NC}$key = $value"
        fi
    done < "$input_file"
    
    echo -e "${GREEN}Configuration loaded successfully!${NC}"
}

function config_show() {
    echo -e "${CYAN}Current Configuration:${NC}"
    echo "Neuron Count: ${NEURON_COUNT}"
    echo "Region Count: ${REGION_COUNT}"
    echo "Simulation Steps: ${SIMULATION_STEPS}"
    echo "Timestep: ${TIMESTEP}"
    echo "Verbose Mode: ${VERBOSE}"
    echo "Config File: ${CONFIG_FILE}"
    echo "Log File: ${LOG_FILE}"
    
    if [[ -f "${CONFIG_FILE}" ]]; then
        echo -e "${CYAN}Loaded from: ${NC}$CONFIG_FILE"
    fi
}

function config_help() {
    cat << EOF
Configuration Management Commands:

  nlm config save      Save current configuration to file
  nlm config load <file>  Load configuration from file
  nlm config show     Show current configuration
  nlm config edit     Edit configuration interactively
  nlm config validate Validate configuration syntax

Configuration file format:
  [section]           Section header
  key = value         Key-value pair
  # comment           Comment line

Common sections:
  [simulation]        Simulation parameters
  [plasticity]        Plasticity parameters
  [neuromodulation]   Neuromodulation parameters
  [development]       Development parameters
  [memory]           Memory system parameters
  [debug]           Debug and logging parameters
EOF
}

# Simulation commands
function run_simulation() {
    local subcommand="$1"
    shift
    
    case "$subcommand" in
        simple)
            run_simple_simulation
            ;;
        phase2)
            run_phase2_simulation
            ;;
        phase3)
            run_phase3_simulation
            ;;
        phase4)
            run_phase4_simulation
            ;;
        phase6)
            run_phase6_simulation
            ;;
        *)
            echo -e "${RED}Unknown simulation: $subcommand${NC}" >&2
            simulation_help
            exit 1
            ;;
    esac
}

function run_simple_simulation() {
    echo -e "${CYAN}Running simple simulation with ${NEURON_COUNT} neurons...${NC}"
    
    # Create a temporary configuration file
    local temp_config="$(mktemp)"
    cat > "${temp_config}" << EOF
[simulation]
neuron_count = ${NEURON_COUNT}
region_count = ${REGION_COUNT}
simulation_timestep = ${TIMESTEP}
max_steps = ${SIMULATION_STEPS}

[plasticity]
stdp_ltp_weight = 0.01
stdp_ltd_weight = 0.012
stdp_tau = 20.0

[debug]
log_level = ${VERBOSE:-info}
EOF
    
    echo -e "${CYAN}Command: ${NC}${EXECUTABLE} --config ${temp_config}"
    "${EXECUTABLE}" --config "${temp_config}"
    
    rm -f "${temp_config}"
}

function run_phase2_simulation() {
    echo -e "${CYAN}Running Phase 2 simulation (real neural computation)...${NC}"
    
    # Check if the executable exists
    if [[ ! -x "${BUILD_DIR}/nlm" ]]; then
        echo -e "${RED}Error: nlm executable not found! Build the project first.${NC}" >&2
        exit 1
    fi
    
    # Run the simulation with Phase 2 specific parameters
    echo -e "${CYAN}Command: ${NC}${EXECUTABLE} --neurons ${NEURON_COUNT} --steps ${SIMULATION_STEPS}"
    "${EXECUTABLE}" --neurons "${NEURON_COUNT}" --steps "${SIMULATION_STEPS}"
}

function run_phase6_simulation() {
    echo -e "${CYAN}Running Phase 6 integration simulation...${NC}"
    
    if [[ ! -x "${PHASE6_DEMO}" ]]; then
        echo -e "${YELLOW}Phase 6 demo not found, trying to build...${NC}" >&2
        # Try to build
        if cd "${BUILD_DIR}" && cmake --build . --target nlm_phase6_demo 2>/dev/null; then
            echo -e "${GREEN}Built Phase 6 demo successfully${NC}"
        else
            echo -e "${RED}Error: Could not build Phase 6 demo${NC}" >&2
            exit 1
        fi
    fi
    
    echo -e "${CYAN}Command: ${NC}${PHASE6_DEMO} --neurons ${NEURON_COUNT} --steps ${SIMULATION_STEPS}"
    "${PHASE6_DEMO}" --neurons "${NEURON_COUNT}" --steps "${SIMULATION_STEPS}"
}

function simulation_help() {
    cat << EOF
Simulation Commands:

  nlm run simple        Run simple demo (Phase 2)
  nlm run phase2       Run Phase 2 neural computation demo
  nlm run phase3       Run Phase 3 world interaction demo
  nlm run phase4       Run Phase 4 prediction/cognition demo
  nlm run phase6       Run Phase 6 integration demo

Simulation parameters:
  -n, --neurons N     Number of neurons (default: 500)
  -r, --regions R     Number of regions (default: 1)
  -s, --steps S       Number of simulation steps (default: 1000)
  -t, --timestep T    Simulation timestep (default: 0.001)
EOF
}

# Experiment commands
function experiment_commands() {
    local subcommand="$1"
    shift
    
    case "$subcommand" in
        run)
            run_experiment "$@"
            ;;
        list)
            experiment_list
            ;;
        create)
            experiment_create "$@"
            ;;
        *)
            echo -e "${RED}Unknown experiment command: $subcommand${NC}" >&2
            experiment_help
            exit 1
            ;;
    esac
}

function run_experiment() {
    local exp_type="$1"
    
    case "$exp_type" in
        phase6)
            run_phase6_experiment
            ;;
        phase5)
            run_phase5_experiment
            ;;
        phase4)
            run_phase4_experiment
            ;;
        *)
            echo -e "${RED}Unknown experiment type: $exp_type${NC}" >&2
            exit 1
            ;;
    esac
}

function run_phase6_experiment() {
    echo -e "${CYAN}Running Phase 6 integration experiment...${NC}"
    
    # Create a configuration
    local config_file="$(mktemp)"
    cat > "${config_file}" << EOF
# Phase 6 Integration Experiment Configuration
[experiment]
type = phase6
neurons = ${NEURON_COUNT}
steps = ${SIMULATION_STEPS}
region_count = ${REGION_COUNT}

[memory]
working_memory_capacity = 50
episodic_memory_max_episodes = 1000
associative_memory_size = 100

[neuromodulation]
dopamine_baseline = 0.1
curiosity_enabled = true
novelty_enabled = true

[development]
enabled = true
critical_period_duration = 100.0

[checkpoints]
enabled = true
interval = 1000

[replay]
enabled = true
interval = 100
EOF
    
    echo -e "${CYAN}Running experiment with ${NEURON_COUNT} neurons for ${SIMULATION_STEPS} steps...${NC}"
    
    # Run the experiment (using the phase6 demo)
    if [[ -x "${PHASE6_DEMO}" ]]; then
        "${PHASE6_DEMO}" --config "${config_file}"
    else
        echo -e "${YELLOW}Phase 6 demo not found, building...${NC}" >&2
        if cd "${BUILD_DIR}" && cmake --build . --target nlm_phase6_demo 2>/dev/null; then
            "${BUILD_DIR}/nlm_phase6_demo" --config "${config_file}"
        else
            echo -e "${RED}Error: Could not build or run Phase 6 demo${NC}" >&2
            exit 1
        fi
    fi
    
    rm -f "${config_file}"
}

function experiment_help() {
    cat << EOF
Experiment Commands:

  nlm experiment run <type>    Run specific experiment type
  nlm experiment list         List available experiments
  nlm experiment create <type> Create new experiment configuration

Available experiment types:
  phase6         Phase 6 integration experiment
  phase5         Phase 5 performance experiment
  phase4         Phase 4 cognition experiment
EOF
}

# Debugging commands
function debug_commands() {
    local subcommand="$1"
    shift
    
    case "$subcommand" in
        monitor)
            debug_monitor "$@"
            ;;
        analyze)
            debug_analyze "$@"
            ;;
        profiler)
            debug_profiler "$@"
            ;;
        *)
            echo -e "${RED}Unknown debug command: $subcommand${NC}" >&2
            debug_help
            exit 1
            ;;
    esac
}

function debug_monitor() {
    local duration="${1:-60}"
    
    echo -e "${CYAN}Starting system monitor for ${duration} seconds...${NC}"
    
    # Check if the brain process is running
    if pgrep -f "nlm" >/dev/null; then
        echo -e "${GREEN}Brain process found${NC}"
        
        # Show system information
        echo -e "${CYAN}System Information:${NC}"
        echo "CPU Usage: $(top -bn1 | grep "Cpu(s)" | sed "s/.*, *\([0-9.]*\)%* id.*/$1/" | cut -d'%' -f1)%
"
        echo "Memory Usage: $(free -h | grep "Mem:" | awk '{print $3}')"
        
        # Show running processes
        echo -e "${CYAN}Running processes:${NC}"
        pgrep -f "nlm" --format "  %p (%c) %p"
        
        # Log monitor status
        echo -e "${YELLOW}Monitoring for ${duration} seconds (Ctrl+C to stop)${NC}"
        
        # Simple monitoring loop
        local end_time=$(($(date +%s) + duration))
        while [[ $(date +%s) -lt $end_time ]]; do
            echo -e "${CYAN} $(date +%H:%M:%S) $(pgrep -f "nlm" | wc -l) brain processes running${NC}"
            sleep 10
        done
        
    else
        echo -e "${YELLOW}No NLM brain processes found running${NC}"
        echo -e "${CYAN}Available processes:${NC}"
        pgrep -f "nlm" --format "  %p (%c) %p"
    fi
}

function debug_help() {
    cat << EOF
Debug Commands:

  nlm debug monitor <duration>   Monitor running brain processes
  nlm debug analyze <file>       Analyze experiment or log file
  nlm debug profiler <duration>  Profile performance for duration

Debug options:
  --verbose, -V                  Enable verbose output
  --log FILE, -l FILE           Set log file
EOF
}

# Main function
function main() {
    setup_logging
    parse_args "$@"
    
    case "$COMMAND" in
        config)
            config_commands "$@"
            ;;
        run)
            run_simulation "$@"
            ;;
        experiment)
            experiment_commands "$@"
            ;;
        debug)
            debug_commands "$@"
            ;;
        help)
            print_usage
            ;;
        "")
            echo -e "${RED}Error: No command specified${NC}" >&2
            print_usage >&2
            exit 1
            ;;
        *)
            echo -e "${RED}Unknown command: $COMMAND${NC}" >&2
            print_usage >&2
            exit 1
            ;;
    esac
}

# Run main function
main "$@"
