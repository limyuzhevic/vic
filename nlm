#!/usr/bin/env bash
# NLM Command Line Interface (CLI) - Basic Entry Point

# NLM CLI - Simple command-line interface for NLM (Neural Learning Machine)
# Provides basic commands for running demos, managing configurations, and system operations

# Exit on any error
set -e

# Default values
BUILD_DIR="${BUILD_DIR:-./build}"
DEFAULT_CONFIG="${DEFAULT_CONFIG:-configs/default.ini}"
LOG_LEVEL="${LOG_LEVEL:-INFO}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging function
log() {
    local level=$1
    local message=$2
    local color=""
    
    case $level in
        ERROR) color="$RED";;
        WARN) color="$YELLOW";;
        INFO) color="$GREEN";;
        DEBUG) color="$BLUE";;
        *) color="$NC";;
    esac
    
    echo -e "${color}[${level}]${NC} ${message}"
}

# Help message
show_help() {
    cat << EOF
NLM - Neural Learning Machine CLI

Usage: nlm [OPTIONS] [COMMAND] [ARGS...]

Commands:
  run          Run a simulation (default)
  demo         Run built-in demos
  config       Configuration management
  build        Build the project
  help         Show this help message

Options:
  -h, --help   Show help message
  -v, --version Show version
  -c, --config  Configuration file (default: configs/default.ini)
  -b, --build   Build directory (default: ./build)
  -l, --log     Log level (ERROR,WARN,INFO,DEBUG)

Examples:
  nlm run demo phase3      Run Phase 3 demo
  nlm config list          List configuration parameters
  nlm config set key value Set configuration value
  nlm build                Build the project
  nlm help                 Show help

For more detailed help on a specific command:
  nlm help <command>

EOF
}

# Version information
show_version() {
    cat << EOF
NLM (熙然) - Neural Learning Machine
Version: 0.1.0
Build: $(date +%Y-%m-%d)
Description: An experimental artificial developmental brain

For more information, visit: https://github.com/nlm-project/nlm
EOF
}

# Build the project
command_build() {
    log INFO "Building NLM project..."
    
    if [ ! -d "$BUILD_DIR" ]; then
        log WARN "Build directory $BUILD_DIR does not exist, creating it..."
        mkdir -p "$BUILD_DIR"
    fi
    
    cd "$BUILD_DIR"
    
    # Check if CMakeLists.txt exists
    if [ ! -f "../CMakeLists.txt" ]; then
        log ERROR "CMakeLists.txt not found in parent directory"
        log ERROR "Please run this command from the project root directory"
        exit 1
    fi
    
    # Configure CMake
    log INFO "Configuring CMake..."
    if ! cmake .. -DCMAKE_BUILD_TYPE=Release; then
        log ERROR "CMake configuration failed"
        exit 1
    fi
    
    # Build
    log INFO "Building with make..."
    if ! make -j$(nproc); then
        log ERROR "Build failed"
        exit 1
    fi
    
    log INFO "Build completed successfully!"
    
    # List executables
    echo ""
    log INFO "Available executables:"
    local executables=("nlm" "nlm_phase3_demo" "nlm_phase4_demo" "nlm_phase6_demo" "nlm_benchmark")
    for exe in "${executables[@]}"; do
        if [ -f "./${exe}" ]; then
            echo "  ✓ ./${exe}"
        else
            echo "  ✗ ./${exe} (not found)"
        fi
    done
}

# Configuration management
command_config() {
    local subcommand=$1
    shift || true
    
    case $subcommand in
        list)
            command_config_list
            ;;
        get)
            command_config_get "$@"
            ;;
        set)
            command_config_set "$@"
            ;;
        save)
            command_config_save "$@"
            ;;
        load)
            command_config_load "$@"
            ;;
        help)
            command_config_help
            ;;
        *)
            log ERROR "Unknown config command: $subcommand"
            command_config_help
            exit 1
            ;;
    esac
}

# List configuration parameters
command_config_list() {
    log INFO "Listing configuration parameters..."
    
    if [ ! -f "$DEFAULT_CONFIG" ]; then
        log WARN "Default config file $DEFAULT_CONFIG not found"
        log INFO "Available config files:"
        if [ -d "configs" ]; then
            ls -la configs/ 2>/dev/null || echo "  (configs directory not found)"
        else
            echo "  (configs directory not found)"
        fi
        return
    fi
    
    echo ""
    log INFO "Configuration parameters in $DEFAULT_CONFIG:"
    echo ""
    
    # Simple key=value parser (can be enhanced with JSON/YAML support)
    while IFS= read -r line; do
        # Skip comments and empty lines
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "$line" ]] && continue
        
        # Parse key=value
        if [[ "$line" =~ ^([^=]+)=(.*)$ ]]; then
            key="${BASH_REMATCH[1]}"
            value="${BASH_REMATCH[2]}"
            echo "  $key = $value"
        fi
    done < "$DEFAULT_CONFIG"
}

# Get configuration value
command_config_get() {
    local key=$1
    local config_file="${2:-$DEFAULT_CONFIG}"
    
    if [ -z "$key" ]; then
        log ERROR "Key is required"
        log INFO "Usage: nlm config get <key> [config_file]"
        exit 1
    fi
    
    if [ ! -f "$config_file" ]; then
        log ERROR "Config file not found: $config_file"
        exit 1
    fi
    
    # Simple key=value parser
    while IFS= read -r line; do
        # Skip comments and empty lines
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "$line" ]] && continue
        
        # Parse key=value
        if [[ "$line" =~ ^([^=]+)=(.*)$ ]]; then
            local k="${BASH_REMATCH[1]}"
            local v="${BASH_REMATCH[2]}"
            
            if [ "$k" = "$key" ]; then
                echo "$v"
                return 0
            fi
        fi
    done < "$config_file"
    
    log WARN "Key '$key' not found in $config_file"
    return 1
}

# Set configuration value
command_config_set() {
    local key=$1
    local value=$2
    local config_file="${3:-$DEFAULT_CONFIG}"
    
    if [ -z "$key" ] || [ -z "$value" ]; then
        log ERROR "Key and value are required"
        log INFO "Usage: nlm config set <key> <value> [config_file]"
        exit 1
    fi
    
    if [ ! -f "$config_file" ]; then
        log ERROR "Config file not found: $config_file"
        exit 1
    fi
    
    # Backup original file
    cp "$config_file" "${config_file}.backup.$(date +%s)"
    
    # Create a temporary file for the updated config
    local temp_file=$(mktemp)
    
    # Update the key or add new key
    local found=false
    while IFS= read -r line; do
        # Skip comments and empty lines
        [[ "$line" =~ ^[[:space:]]*# ]] && {
            echo "$line" >> "$temp_file"
            continue
        }
        [[ -z "$line" ]] && {
            echo "$line" >> "$temp_file"
            continue
        }
        
        # Parse key=value
        if [[ "$line" =~ ^([^=]+)=(.*)$ ]]; then
            local k="${BASH_REMATCH[1]}"
            local v="${BASH_REMATCH[2]}"
            
            if [ "$k" = "$key" ]; then
                echo "$k=$value" >> "$temp_file"
                found=true
            else
                echo "$line" >> "$temp_file"
            fi
        else
            echo "$line" >> "$temp_file"
        fi
    done < "$config_file"
    
    # If key not found, add it
    if [ "$found" = false ]; then
        echo "# Added by NLM CLI" >> "$temp_file"
        echo "$key=$value" >> "$temp_file"
    fi
    
    # Replace original file
    mv "$temp_file" "$config_file"
    
    log INFO "Configuration updated: $key = $value"
}

# Save configuration
command_config_save() {
    local output_file=$1
    
    if [ -z "$output_file" ]; then
        log ERROR "Output file is required"
        log INFO "Usage: nlm config save <output_file>"
        exit 1
    fi
    
    if [ -f "$output_file" ]; then
        log WARN "Output file already exists, overwriting..."
    fi
    
    log INFO "Saving configuration to $output_file"
    
    # For now, just copy the default config
    if [ -f "$DEFAULT_CONFIG" ]; then
        cp "$DEFAULT_CONFIG" "$output_file"
        log INFO "Configuration saved to $output_file"
    else
        log ERROR "Default config file not found: $DEFAULT_CONFIG"
        exit 1
    fi
}

# Load configuration
command_config_load() {
    local input_file=$1
    local target_file="${2:-$DEFAULT_CONFIG}"
    
    if [ -z "$input_file" ]; then
        log ERROR "Input file is required"
        log INFO "Usage: nlm config load <input_file> [target_file]"
        exit 1
    fi
    
    if [ ! -f "$input_file" ]; then
        log ERROR "Input file not found: $input_file"
        exit 1
    fi
    
    log INFO "Loading configuration from $input_file to $target_file"
    
    # Backup original file
    if [ -f "$target_file" ]; then
        cp "$target_file" "${target_file}.backup.$(date +%s)"
    fi
    
    cp "$input_file" "$target_file"
    log INFO "Configuration loaded successfully"
}

# Configuration help
command_config_help() {
    cat << EOF
NLM Configuration Management

Usage: nlm config <command> [args...]

Commands:
  list           List all configuration parameters
  get <key> [file]    Get a specific configuration value
  set <key> <value> [file]  Set a configuration value
  save <file>    Save current configuration to file
  load <file> [target] Load configuration from file

Examples:
  nlm config list
  nlm config get brain.neuron_count
  nlm config set brain.neuron_count 500
  nlm config save my_config.ini
  nlm config load my_config.ini

EOF
}

# Run a demo or simulation
command_run() {
    local demo_type=$1
    local config_file="${2:-$DEFAULT_CONFIG}"
    local additional_args="${3:-}"
    
    if [ -z "$demo_type" ]; then
        log INFO "No demo type specified, running default (Phase 6 demo)..."
        demo_type="phase6"
    fi
    
    log INFO "Running $demo_type demo with config $config_file"
    
    # Check if executables are built
    local exe_name=""
    case $demo_type in
        phase3) exe_name="nlm_phase3_demo" ;;
        phase4) exe_name="nlm_phase4_demo" ;;
        phase5) exe_name="nlm_phase5_demo" ;;
        phase6) exe_name="nlm_phase6_demo" ;;
        phase6_text) exe_name="nlm_phase6_text_demo" ;;
        benchmark) exe_name="nlm_benchmark" ;;
        *) log ERROR "Unknown demo type: $demo_type"
           log INFO "Available demos: phase3, phase4, phase5, phase6, phase6_text, benchmark"
           exit 1
           ;;
    esac
    
    if [ ! -f "$BUILD_DIR/$exe_name" ]; then
        log ERROR "Executable not found: $BUILD_DIR/$exe_name"
        log INFO "Please build the project first: nlm build"
        exit 1
    fi
    
    # Run the demo
    cd "$BUILD_DIR"
    echo ""
    log INFO "Running $exe_name..."
    echo ""
    
    # Pass config file as argument if provided
    local demo_args=""
    if [ -f "$config_file" ]; then
        demo_args="--config $config_file"
    fi
    
    # Run the demo with additional arguments
    echo "Command: ./$exe_name $demo_args $additional_args"
    echo ""
    
    ./"$exe_name" $demo_args $additional_args
}

# Run built-in demos
command_demo() {
    local demo_type=$1
    shift || true
    
    case $demo_type in
        phase3)
            command_run phase3 "$@"
            ;;
        phase4)
            command_run phase4 "$@"
            ;;
        phase5)
            command_run phase5 "$@"
            ;;
        phase6)
            command_run phase6 "$@"
            ;;
        phase6_text)
            command_run phase6_text "$@"
            ;;
        benchmark)
            command_run benchmark "$@"
            ;;
        *)
            log ERROR "Unknown demo: $demo_type"
            log INFO "Available demos: phase3, phase4, phase5, phase6, phase6_text, benchmark"
            exit 1
            ;;
    esac
}

# Main CLI entry point
main() {
    # Parse command line arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--version)
                show_version
                exit 0
                ;;
            -c|--config)
                DEFAULT_CONFIG="$2"
                shift 2
                ;;
            -b|--build)
                BUILD_DIR="$2"
                shift 2
                ;;
            -l|--log)
                LOG_LEVEL="$2"
                shift 2
                ;;
            -*)
                log ERROR "Unknown option: $1"
                show_help
                exit 1
                ;;
            *)
                break
                ;;
        esac
    done
    
    # Set up logging level
    export LOG_LEVEL
    
    # Determine command
    local command="${1:-run}"
    shift || true
    
    # Dispatch to command handler
    case $command in
        run)
            command_run "$@"
            ;;
        demo)
            command_demo "$@"
            ;;
        config)
            command_config "$@"
            ;;
        build)
            command_build
            ;;
        help)
            show_help
            ;;
        *)
            log ERROR "Unknown command: $command"
            show_help
            exit 1
            ;;
    esac
}

# Run main function with all arguments
main "$@"
