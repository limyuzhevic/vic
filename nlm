}

# Run Phase 6 experiment
function run_experiment() {
    echo -e "${BLUE}NLM Phase 6 Experiment${NC}"
    echo "========================="
    echo ""

    local experiment_type="${1:-phase6}"
    shift || true

    case "${experiment_type}" in
        "phase6")
            phase6_experiment "$@"
            ;;
        "phase4")
            phase4_experiment
            ;;
        "phase3")
            phase3_experiment
            ;;
        *)
            echo -e "${RED}Unknown experiment type: ${experiment_type}${NC}"
            echo "Available types: phase6, phase4, phase3"
            ;;
    esac
}

# Phase 6 integration experiment
function phase6_experiment() {
    local steps="${1:-2000}"
    local neurons="${2:-500}"
    shift 2 || true

    echo -e "${YELLOW}Running Phase 6 Integration Experiment...${NC}"
    echo "Steps: ${steps}, Neurons: ${neurons}"
    echo ""

    # Build if necessary
    if [[ ! -f "build/nlm_phase6_demo" ]]; then
        echo -e "${YELLOW}Building Phase 6 demo...${NC}"
        mkdir -p build
        cd build || exit 1
        cmake .. -DCMAKE_BUILD_TYPE=Release > /dev/null 2>&1
        make nlm_phase6_demo > /dev/null 2>&1
        cd .. || exit 1
    fi

    # Run the experiment
    ./build/nlm_phase6_demo
}

