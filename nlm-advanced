  python3 nlm-advanced optimize-parameters --neurons 1000 --target-rate 5.0
        """
    )
    
    subparsers = parser.add_subparsers(dest="command", help="Available commands")
    
    # Create experiment command
    create_parser = subparsers.add_parser("create-experiment", help="Create new experiment configuration")
    create_parser.add_argument("name", help="Name for the experiment")
    create_parser.add_argument("--type", dest="experiment_type",
                              choices=[e.value for e in ExperimentType],
                              default="basic", help="Experiment type (default: basic)")
    create_parser.add_argument("--mode", dest="simulation_mode",
                              choices=[m.value for m in SimulationMode],
                              default="balanced", help="Simulation mode (default: balanced)")
    create_parser.add_argument("--config", dest="config_file",
                              help="Load configuration from file")
    create_parser.add_argument("--save", dest="save_file",
                              help="Save experiment configuration to file")
    
    # Run experiment command
    run_parser = subparsers.add_parser("run-experiment", help="Run a specific experiment")
    run_parser.add_argument("name", help="Name of experiment to run")
    
    # Compare experiments command
    compare_parser = subparsers.add_parser("compare-experiments", help="Compare multiple experiments")
    compare_parser.add_argument("names", nargs="+", help="Names of experiments to compare")
    compare_parser.add_argument("--output", dest="output_file", default="experiment_comparison.png",
                               help="Output file for comparison plot (default: experiment_comparison.png)")
    
    # Visualize results command
    viz_parser = subparsers.add_parser("visualize-results", help="Visualize experiment results")
    viz_parser.add_argument("results_file", help="File containing experiment results")
    viz_parser.add_argument("--type", dest="viz_type", choices=["comparison", "training"],
                           default="comparison", help="Type of visualization (default: comparison)")
    
    # Load experiment command
    load_parser = subparsers.add_parser("load-experiment", help="Load experiment configuration")
    load_parser.add_argument("filepath", help="Path to experiment configuration file")
    
    # List experiments command
    subparsers.add_parser("list-experiments", help="List all registered experiments")
    
    # Run multiple experiments command
    multi_parser = subparsers.add_parser("run-multiple", help="Run multiple experiments")
    multi_parser.add_argument("names", nargs="+", help="Names of experiments to run")
    
    # Parse arguments
    args = parser.parse_args()
    
    # Execute commands
    try:
        if args.command == "create-experiment":
            # Create experiment configuration
            if args.config_file:
                # Load from existing config
                config = ExperimentConfig.load(args.config_file)
                config.name = args.name
                if args.experiment_type:
                    config.experiment_type = ExperimentType(args.experiment_type)
                if args.simulation_mode:
                    config.simulation_mode = SimulationMode(args.simulation_mode)
                if args.save_file:
                    config.save(args.save_file)
                    print(f"✓ Experiment '{args.name}' created and saved to {args.save_file}")
                else:
                    print(f"✓ Experiment '{args.name}' created")
            else:
                # Create minimal config
                config = ExperimentConfig(
                    name=args.name,
                    experiment_type=ExperimentType(args.experiment_type),
                    simulation_mode=SimulationMode(args.simulation_mode)
                )
                if args.save_file:
                    config.save(args.save_file)
                    print(f"✓ Experiment '{args.name}' created and saved to {args.save_file}")
                else:
                    print(f"✓ Experiment '{args.name}' created")
            
            # Register experiment
            experiment_runner.register_experiment(config)
            
        elif args.command == "run-experiment":
            # Run single experiment
            result = experiment_runner.run_experiment(args.name)
            print(f"✓ Experiment '{args.name}' completed successfully")
            
        elif args.command == "compare-experiments":
            # Compare multiple experiments
            results = experiment_runner.run_multiple_experiments(args.names)
            
            # Create comparison plot
            advanced_visualizer.plot_experiment_comparison(results, args.output_file)
            print(f"✓ Comparison completed and saved to {args.output_file}")
            
        elif args.command == "visualize-results":
            # Visualize results
            try:
                with open(args.results_file, 'r') as f:
                    results = json.load(f)
                
                if args.viz_type == "comparison":
                    advanced_visualizer.plot_experiment_comparison(results)
                elif args.viz_type == "training":
                    advanced_visualizer.plot_training_curves(results)
                
                print(f"✓ Results visualization completed")
            except Exception as e:
                print(f"Error loading results file: {e}")
                
        elif args.command == "load-experiment":
            # Load experiment configuration
            config = ExperimentConfig.load(args.filepath)
            experiment_runner.register_experiment(config)
            print(f"✓ Experiment loaded from {args.filepath}")
            
        elif args.command == "list-experiments":
            # List all experiments
            if experiment_runner.experiments:
                print("Registered experiments:")
                for name, config in experiment_runner.experiments.items():
                    print(f"  - {name}: {config.experiment_type.value} ({config.neurons} neurons)")
            else:
                print("No experiments registered.")
                
        elif args.command == "run-multiple":
            # Run multiple experiments
            results = experiment_runner.run_multiple_experiments(args.names)
            print(f"✓ Multiple experiments completed")
            
        else:
            parser.print_help()
            
    except Exception as e:
        print(f"Error: {e}")
        sys.exit(1)

