@dataclass
class NeuronConfig:
    """Neuron configuration parameters."""
    v_thresh: float = -50.0  # mV
    v_rest: float = -70.0    # mV
    v_reset: float = -75.0   # mV
    tau_mem: float = 20.0    # ms
    tau_ref: float = 2.0     # ms
    conductance: float = 10.0  # nS
    adaptation_strength: float = 1.0
    
    @classmethod
    def from_config(cls, config_dict: Dict[str, Any]) -> 'NeuronConfig':
        """Create NeuronConfig from configuration dictionary."""
        kwargs = {}
        for field_name in NeuronConfig.__dataclass_fields__:
            if field_name in config_dict:
                kwargs[field_name] = config_dict[field_name]
        return cls(**kwargs)

