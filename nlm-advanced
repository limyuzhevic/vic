@dataclass
class ExperimentConfig:
    """Experiment configuration."""
    name: str
    experiment_type: ExperimentType
    simulation_mode: SimulationMode
    neuron_config: NeuronConfig
    plasticity_config: PlasticityConfig
    neuromodulation_config: NeuromodulationConfig
    memory_config: MemoryConfig
    development_config: DevelopmentConfig
    
    # Simulation parameters
    neurons: int = 1000
    regions: int = 1
    connection_probability: float = 0.1
    max_steps: int = 10000
    timestep: float = 0.001
    
    # Features
    enable_checkpointing: bool = True
    enable_replay: bool = True
    enable_development: bool = True
    enable_structural_plasticity: bool = True
    
    # Analysis
    collect_statistics: bool = True
    output_file: Optional[str] = None
    verbose: bool = False
    
    # Custom
    custom_parameters: Dict[str, Any] = field(default_factory=dict)
    
    @classmethod
    def from_dict(cls, config_dict: Dict[str, Any]) -> 'ExperimentConfig':
        """Create ExperimentConfig from dictionary."""
        # Extract nested configurations
        neuron_config = NeuronConfig.from_config(
            config_dict.get('neuron_config', {})
        )
        plasticity_config = PlasticityConfig.from_config(
            config_dict.get('plasticity_config', {})
        )
        neuromodulation_config = NeuromodulationConfig.from_config(
            config_dict.get('neuromodulation_config', {})
        )
        memory_config = MemoryConfig.from_config(
            config_dict.get('memory_config', {})
        )
        development_config = DevelopmentConfig.from_config(
            config_dict.get('development_config', {})
        )
        
        # Extract simple parameters
        kwargs = {
            'name': config_dict.get('name', 'default_experiment'),
            'experiment_type': ExperimentType(config_dict.get('experiment_type', 'basic')),
            'simulation_mode': SimulationMode(config_dict.get('simulation_mode', 'balanced')),
            'neuron_config': neuron_config,
            'plasticity_config': plasticity_config,
            'neuromodulation_config': neuromodulation_config,
            'memory_config': memory_config,
            'development_config': development_config,
            'neurons': config_dict.get('neurons', 1000),
            'regions': config_dict.get('regions', 1),
            'connection_probability': config_dict.get('connection_probability', 0.1),
            'max_steps': config_dict.get('max_steps', 10000),
            'timestep': config_dict.get('timestep', 0.001),
            'enable_checkpointing': config_dict.get('enable_checkpointing', True),
            'enable_replay': config_dict.get('enable_replay', True),
            'enable_development': config_dict.get('enable_development', True),
            'enable_structural_plasticity': config_dict.get('enable_structural_plasticity', True),
            'collect_statistics': config_dict.get('collect_statistics', True),
            'output_file': config_dict.get('output_file'),
            'verbose': config_dict.get('verbose', False),
            'custom_parameters': config_dict.get('custom_parameters', {})
        }
        
        return cls(**kwargs)
    
    def to_dict(self) -> Dict[str, Any]:
        """Convert ExperimentConfig to dictionary."""
        return {
            'name': self.name,
            'experiment_type': self.experiment_type.value,
            'simulation_mode': self.simulation_mode.value,
            'neuron_config': {f: getattr(self.neuron_config, f) for f in NeuronConfig.__dataclass_fields__},
            'plasticity_config': {f: getattr(self.plasticity_config, f) for f in PlasticityConfig.__dataclass_fields__},
            'neuromodulation_config': {f: getattr(self.neuromodulation_config, f) for f in NeuromodulationConfig.__dataclass_fields__},
            'memory_config': {f: getattr(self.memory_config, f) for f in MemoryConfig.__dataclass_fields__},
            'development_config': {f: getattr(self.development_config, f) for f in DevelopmentConfig.__dataclass_fields__},
            'neurons': self.neurons,
            'regions': self.regions,
            'connection_probability': self.connection_probability,
            'max_steps': self.max_steps,
            'timestep': self.timestep,
            'enable_checkpointing': self.enable_checkpointing,
            'enable_replay': self.enable_replay,
            'enable_development': self.enable_development,
            'enable_structural_plasticity': self.enable_structural_plasticity,
            'collect_statistics': self.collect_statistics,
            'output_file': self.output_file,
            'verbose': self.verbose,
            'custom_parameters': self.custom_parameters
        }
    
    def save(self, filepath: str) -> bool:
        """Save experiment configuration to file."""
        try:
            data = self.to_dict()
            
            # Determine format based on file extension
            if filepath.endswith('.yaml') or filepath.endswith('.yml'):
                with open(filepath, 'w') as f:
                    yaml.dump(data, f, default_flow_style=False)
            else:
                # Default to JSON
                with open(filepath, 'w') as f:
                    json.dump(data, f, indent=2)
            
            return True
        except Exception as e:
            print(f"Error saving experiment config: {e}")
            return False
    
    @classmethod
    def load(cls, filepath: str) -> 'ExperimentConfig':
        """Load experiment configuration from file."""
        try:
            # Determine format based on file extension
            if filepath.endswith('.yaml') or filepath.endswith('.yml'):
                with open(filepath, 'r') as f:
                    data = yaml.safe_load(f)
            else:
                # Default to JSON
                with open(filepath, 'r') as f:
                    data = json.load(f)
            
            return cls.from_dict(data)
        except Exception as e:
            print(f"Error loading experiment config: {e}")
            raise

class ExperimentRunner:
    """Advanced experiment runner with sophisticated analysis capabilities."""
    
    def __init__(self):
        self.experiments: Dict[str, ExperimentConfig] = {}
        self.results: Dict[str, Dict[str, Any]] = {}
    
    def register_experiment(self, config: ExperimentConfig) -> None:
        """Register an experiment configuration."""
        self.experiments[config.name] = config
        print(f"Registered experiment: {config.name}")
    
    def run_experiment(self, experiment_name: str) -> Dict[str, Any]:
        """Run a registered experiment."""
        if experiment_name not in self.experiments:
            raise ValueError(f"Experiment '{experiment_name}' not found")
        
        config = self.experiments[experiment_name]
        print(f"Running experiment: {experiment_name}")
        print(f"  Type: {config.experiment_type.value}")
        print(f"  Neurons: {config.neurons}, Steps: {config.max_steps}")
        
        start_time = time.time()
        
        # Create configuration for NLM
        nlm_config = {
            "neuron_count": config.neurons,
            "region_count": config.regions,
            "connection_probability": config.connection_probability,
            "stdp_ltp_weight": config.plasticity_config.stdp_ltp_weight,
            "stdp_ltd_weight": config.plasticity_config.stdp_ltd_weight,
            "stdp_tau": config.plasticity_config.stdp_time_constant,
            "random_seed": config.custom_parameters.get("random_seed", 42)
        }
        
        # Run simulation (placeholder - actual implementation would use pynlm)
        # For now, we'll create a mock result
        result = self._run_simulation(config, nlm_config)
        
        end_time = time.time()
        
        # Store result
        self.results[experiment_name] = result
        
        return result
    
    def _run_simulation(self, config: ExperimentConfig, nlm_config: Dict[str, Any]) -> Dict[str, Any]:
        """Run the actual simulation with advanced analysis."""
        # This would integrate with the actual NLM simulation
        # For demonstration, we'll create a mock result with realistic data
        
        # Generate mock neural data
        steps_per_batch = 100
        num_batches = config.max_steps // steps_per_batch
        
        spike_counts = np.random.poisson(
            config.neurons * config.neuron_config.v_thresh / 100,
            size=num_batches
        )
        
        firing_rates = np.random.gamma(
            config.neurons * 0.05,
            1.0,
            size=num_batches
        )
        
        # Calculate derived metrics
        total_spikes = np.sum(spike_counts)
        avg_firing_rate = np.mean(firing_rates)
        
        # Calculate plasticity effects (mock data)
        weight_changes = np.random.normal(0, 0.001, size=num_batches)
        synaptic_strength = 1.0 + np.cumsum(weight_changes)
        
        # Calculate memory system metrics
        episodic_episodes = int(config.neurons * 0.1)
        working_memory_traces = int(config.neurons * 0.05)
        
        # Calculate neuromodulation effects
        dopamine_level = np.random.uniform(0, 1, size=num_batches)
        curiosity_level = np.random.uniform(0, 1, size=num_batches)
        novelty_level = np.random.uniform(0, 1, size=num_batches)
        
        # Calculate development effects
        developmental_stage = "initial"
        if config.max_steps > 1000:
            developmental_stage = "maturing"
        if config.max_steps > 5000:
            developmental_stage = "adult"
        
        # Build result
        result = {
            "experiment_name": config.name,
            "experiment_type": config.experiment_type.value,
            "neural_metrics": {
                "total_spikes": int(total_spikes),
                "average_firing_rate": float(avg_firing_rate),
                "max_firing_rate": float(np.max(firing_rates)),
                "min_firing_rate": float(np.min(firing_rates)),
                "firing_rate_std": float(np.std(firing_rates)),
                "spike_count_std": float(np.std(spike_counts)),
                "e_i_ratio": np.random.uniform(1.0, 3.0)  # Mock E/I ratio
            },
            "plasticity_metrics": {
                "total_weight_change": float(np.sum(np.abs(weight_changes))),
                "final_synaptic_strength": float(synaptic_strength[-1]),
                "plasticity_events": int(np.sum(np.abs(weight_changes) > 0.01)),
                "hebbian_contribution": 0.6,  # Mock percentage
                "stdp_contribution": 0.4    # Mock percentage
            },
            "memory_metrics": {
                "episodes_stored": episodic_episodes,
                "working_memory_traces": working_memory_traces,
                "memory_consolidation": config.memory_config.episodic_memory_consolidation_threshold,
                "memory_retention": 0.8  # Mock retention rate
            },
            "neuromodulation_metrics": {
                "average_dopamine": float(np.mean(dopamine_level)),
                "average_curiosity": float(np.mean(curiosity_level)),
                "average_novelty": float(np.mean(novelty_level)),
                "neuroplasticity_effects": 0.7  # Mock effect strength
            },
            "development_metrics": {
                "developmental_stage": developmental_stage,
                "structural_plasticity_events": int(config.max_steps * 0.1),
                "synaptic_pruning_events": int(config.max_steps * 0.05),
                "plasticity_rate_decay": 0.5  # Mock decay factor
            },
            "simulation_parameters": {
                "total_steps": config.max_steps,
                "simulation_time": config.max_steps * config.timestep,
                "neurons": config.neurons,
                "regions": config.regions,
                "config": nlm_config
            },
            "experiment_info": {
                "config_file": None,  # Would be the path
                "output_file": config.output_file,
                "verbose": config.verbose,
                "custom_parameters": config.custom_parameters
            }
        }
        
        return result
    
    def get_experiment_summary(self, experiment_name: str) -> Dict[str, Any]:
        """Get summary of experiment results."""
        if experiment_name not in self.results:
            raise ValueError(f"Experiment '{experiment_name}' not found in results")
        
        return {
            "experiment_name": experiment_name,
            "key_metrics": {
                "total_spikes": self.results[experiment_name]["neural_metrics"]["total_spikes"],
                "average_firing_rate": self.results[experiment_name]["neural_metrics"]["average_firing_rate"],
                "e_i_ratio": self.results[experiment_name]["neural_metrics"]["e_i_ratio"],
                "plasticity_events": self.results[experiment_name]["plasticity_metrics"]["plasticity_events"],
                "memory_episodes": self.results[experiment_name]["memory_metrics"]["episodes_stored"],
                "neuroplasticity_effects": self.results[experiment_name]["neuromodulation_metrics"]["neuroplasticity_effects"]
            },
            "performance": {
                "simulation_speed": self.results[experiment_name]["simulation_parameters"]["simulation_time"],
                "neurons_per_second": self.results[experiment_name]["neural_metrics"]["total_spikes"] / 
                                     self.results[experiment_name]["simulation_parameters"]["simulation_time"]
            }
        }
    
    def run_multiple_experiments(self, experiment_names: List[str]) -> Dict[str, Dict[str, Any]]:
        """Run multiple experiments and return comparative results."""
        results = {}
        
        for name in experiment_names:
            print(f"\n{'='*60}")
            print(f"Running experiment: {name}")
            print(f"{'='*60}")
            
            try:
                result = self.run_experiment(name)
                results[name] = result
                print(f"✓ Experiment '{name}' completed successfully")
            except Exception as e:
                print(f"✗ Experiment '{name}' failed: {e}")
                results[name] = {"error": str(e)}
        
        return results

class AdvancedVisualizer:
    """Advanced visualization capabilities for NLM results."""
    
    @staticmethod
    def plot_experiment_comparison(results: Dict[str, Dict[str, Any]], 
                                   output_file: str = "experiment_comparison.png") -> bool:
        """Create comparison plot of multiple experiment results."""
        try:
            import matplotlib.pyplot as plt
            import matplotlib
            matplotlib.use('Agg')  # Non-interactive backend
            
            fig, axes = plt.subplots(2, 3, figsize=(18, 12))
            axes = axes.flatten()
            
            experiment_names = list(results.keys())
            
            # Plot 1: Total spikes
            ax = axes[0]
            spikes = [results[name]["neural_metrics"]["total_spikes"] for name in experiment_names]
            ax.bar(experiment_names, spikes, alpha=0.7, color='skyblue')
            ax.set_title('Total Spikes by Experiment')
            ax.set_ylabel('Spike Count')
            ax.tick_params(axis='x', rotation=45)
            
            # Plot 2: Average firing rate
            ax = axes[1]
            rates = [results[name]["neural_metrics"]["average_firing_rate"] for name in experiment_names]
            ax.bar(experiment_names, rates, alpha=0.7, color='lightgreen')
            ax.set_title('Average Firing Rate by Experiment')
            ax.set_ylabel('Firing Rate (Hz)')
            ax.tick_params(axis='x', rotation=45)
            
            # Plot 3: E/I ratio
            ax = axes[2]
            ei_ratios = [results[name]["neural_metrics"]["e_i_ratio"] for name in experiment_names]
            ax.bar(experiment_names, ei_ratios, alpha=0.7, color='salmon')
            ax.set_title('E/I Ratio by Experiment')
            ax.set_ylabel('E/I Ratio')
            ax.tick_params(axis='x', rotation=45)
            
            # Plot 4: Plasticity events
            ax = axes[3]
            plasticity = [results[name]["plasticity_metrics"]["plasticity_events"] for name in experiment_names]
            ax.bar(experiment_names, plasticity, alpha=0.7, color='gold')
            ax.set_title('Plasticity Events by Experiment')
            ax.set_ylabel('Event Count')
            ax.tick_params(axis='x', rotation=45)
            
            # Plot 5: Memory episodes
            ax = axes[4]
            memory = [results[name]["memory_metrics"]["episodes_stored"] for name in experiment_names]
            ax.bar(experiment_names, memory, alpha=0.7, color='plum')
            ax.set_title('Memory Episodes by Experiment')
            ax.set_ylabel('Episode Count')
            ax.tick_params(axis='x', rotation=45)
            
            # Plot 6: Neuroplasticity effects
            ax = axes[5]
            neuro = [results[name]["neuromodulation_metrics"]["neuroplasticity_effects"] for name in experiment_names]
            ax.bar(experiment_names, neuro, alpha=0.7, color='cyan')
            ax.set_title('Neuroplasticity Effects by Experiment')
            ax.set_ylabel('Effect Strength (0-1)')
            ax.tick_params(axis='x', rotation=45)
            
            plt.tight_layout()
            plt.savefig(output_file, dpi=150, bbox_inches='tight')
            plt.close()
            
            print(f"✓ Comparison plot saved to {output_file}")
            return True
            
        except ImportError:
            print("Warning: matplotlib not available. Skipping visualization.")
            return False
        except Exception as e:
            print(f"Error creating comparison plot: {e}")
            return False
    
    @staticmethod
    def plot_training_curves(experiment_results: Dict[str, Any], 
                            output_file: str = "training_curves.png") -> bool:
        """Plot training curves for a single experiment."""
        try:
            import matplotlib.pyplot as plt
            import matplotlib
            matplotlib.use('Agg')  # Non-interactive backend
            
            fig, axes = plt.subplots(3, 2, figsize=(15, 12))
            axes = axes.flatten()
            
            # Mock data for demonstration
            steps = list(range(0, experiment_results["simulation_parameters"]["total_steps"], 100))
            
            # Plot 1: Spike count over time
            ax = axes[0]
            spike_counts = np.random.poisson(
                experiment_results["neural_metrics"]["total_spikes"] / len(steps),
                size=len(steps)
            )
            ax.plot(steps, spike_counts, 'b-', alpha=0.7, linewidth=1)
            ax.set_title('Spike Count Over Time')
            ax.set_xlabel('Step')
            ax.set_ylabel('Spike Count')
            ax.grid(True, alpha=0.3)
            
            # Plot 2: Firing rate over time
            ax = axes[1]
            firing_rates = np.random.gamma(
                experiment_results["neural_metrics"]["average_firing_rate"],
                1.0,
                size=len(steps)
            )
            ax.plot(steps, firing_rates, 'r-', alpha=0.7, linewidth=1)
            ax.set_title('Firing Rate Over Time')
            ax.set_xlabel('Step')
            ax.set_ylabel('Firing Rate (Hz)')
            ax.grid(True, alpha=0.3)
            
            # Plot 3: Synaptic weight changes
            ax = axes[2]
            weight_changes = np.random.normal(0, 0.001, size=len(steps))
            cumulative_weight = np.cumsum(weight_changes)
            ax.plot(steps, cumulative_weight, 'g-', alpha=0.7, linewidth=1)
            ax.set_title('Cumulative Synaptic Weight Changes')
            ax.set_xlabel('Step')
            ax.set_ylabel('Weight Change')
            ax.grid(True, alpha=0.3)
            
            # Plot 4: Memory episodes over time
            ax = axes[3]
            episodes = np.cumsum(np.random.poisson(0.1, size=len(steps)))
            ax.plot(steps, episodes, 'm-', alpha=0.7, linewidth=1)
            ax.set_title('Memory Episodes Over Time')
            ax.set_xlabel('Step')
            ax.set_ylabel('Episodes')
            ax.grid(True, alpha=0.3)
            
            # Plot 5: Neuromodulation levels
            ax = axes[4]
            dopamine = np.random.uniform(0, 1, size=len(steps))
            ax.plot(steps, dopamine, 'c-', alpha=0.7, linewidth=1)
            ax.set_title('Dopamine Level Over Time')
            ax.set_xlabel('Step')
            ax.set_ylabel('Dopamine Level (0-1)')
            ax.grid(True, alpha=0.3)
            
            # Plot 6: Development stage
            ax = axes[5]
            stages = ['Initial'] * (len(steps) // 3) + ['Critical'] * (len(steps) // 3) + ['Adult'] * (len(steps) - len(steps) // 2)
            ax.plot(steps[:len(stages)], stages[:len(steps)], 'orange', alpha=0.7, linewidth=2)
            ax.set_title('Development Stage Over Time')
            ax.set_xlabel('Step')
            ax.set_ylabel('Developmental Stage')
            ax.set_yticks(['Initial', 'Critical', 'Adult'])
            ax.grid(True, alpha=0.3)
            
            plt.tight_layout()
            plt.savefig(output_file, dpi=150, bbox_inches='tight')
            plt.close()
            
            print(f"✓ Training curves saved to {output_file}")
            return True
            
        except ImportError:
            print("Warning: matplotlib not available. Skipping visualization.")
            return False
        except Exception as e:
            print(f"Error creating training curves: {e}")
            return False

