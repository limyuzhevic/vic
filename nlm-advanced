    def _generate_json_report(self, experiment_name: str, report_file: Path):
        """Generate JSON report"""
        report = {
            'experiment_name': experiment_name,
            'generated_at': datetime.now().isoformat(),
            'report_type': 'advanced_analysis',
            'metrics': {},
            'insights': [],
            'recommendations': []
        }
        
        with open(report_file, 'w') as f:
            json.dump(report, f, indent=2)


def main():
    parser = argparse.ArgumentParser(
        description="Advanced NLM Command Line Interface",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  nlm-advanced create-experiment my_exp --neurons 1000 --plasticity 0.05
  nlm-advanced run-experiment my_exp.cfg --full
  nlm-advanced compare-experiments exp1.cfg exp2.cfg
  nlm-advanced generate-report my_exp --format html
  nlm-advanced batch-run experiments.txt
        """
    )
    
    subparsers = parser.add_subparsers(dest='command', help='Command to execute')
    
    # Create experiment command
    create_parser = subparsers.add_parser('create-experiment', help='Create a new experiment configuration')
    create_parser.add_argument('name', help='Experiment name')
    create_parser.add_argument('--neurons', type=int, default=500, help='Number of neurons')
    create_parser.add_argument('--regions', type=int, default=1, help='Number of regions')
    create_parser.add_argument('--plasticity', type=float, default=0.02, help='Plasticity learning rate')
    create_parser.add_argument('--stdp-ltp', type=float, default=0.02, help='STDP LTP weight')
    create_parser.add_argument('--stdp-ltd', type=float, default=0.015, help='STDP LTD weight')
    create_parser.add_argument('--dopamine', type=float, default=0.1, help='Dopamine baseline')
    create_parser.add_argument('--steps', type=int, default=5000, help='Max simulation steps')
    create_parser.add_argument('--output', help='Output configuration file path')
    
    # Run experiment command
    run_parser = subparsers.add_parser('run-experiment', help='Run an experiment')
    run_parser.add_argument('config', help='Configuration file')
    run_parser.add_argument('type', choices=['quick', 'full', 'comprehensive', 'debug'], 
                           default='full', help='Experiment type')
    run_parser.add_argument('--extra-args', help='Extra arguments for NLM executable')
    run_parser.add_argument('--output-dir', help='Output directory')
    
    # Compare experiments command
    compare_parser = subparsers.add_parser('compare-experiments', help='Compare two experiments')
    compare_parser.add_argument('experiment1', help='First experiment configuration file')
    compare_parser.add_argument('experiment2', help='Second experiment configuration file')
    
    # Generate report command
    report_parser = subparsers.add_parser('generate-report', help='Generate a report for an experiment')
    report_parser.add_argument('experiment', help='Experiment name or output prefix')
    report_parser.add_argument('--format', choices=['html', 'markdown', 'json'], 
                               default='html', help='Report format')
    
    # List experiments command
    list_parser = subparsers.add_parser('list-experiments', help='List available experiments')
    
    # Help command
    help_parser = subparsers.add_parser('help', help='Show detailed help information')
    help_parser.add_argument('topic', nargs='?', help='Help topic (commands, config, analysis)')
    
    args = parser.parse_args()
    
    cli = NLMAdvancedCLI()
    
    if args.command == 'create-experiment':
        params = {
            'neuron_count': args.neurons,
            'region_count': args.regions,
            'plasticity_learning_rate': args.plasticity,
            'stdp_ltp_weight': args.stdp_ltp,
            'stdp_ltd_weight': args.stdp_ltd,
            'dopamine_baseline': args.dopamine,
            'max_simulation_steps': args.steps
        }
        
        config_file = cli.create_experiment_config(args.name, params)
        if args.output:
            import shutil
            shutil.copy2(config_file, args.output)
            print(f"✓ Configuration copied to: {args.output}")
    
    elif args.command == 'run-experiment':
        extra_args = []
        if args.extra_args:
            extra_args = shlex.split(args.extra_args)
        
        result = cli.run_advanced_experiment(args.config, args.type, extra_args)
        
        if result['success']:
            print("✅ Experiment completed successfully!")
            print(f"📁 Output files: {result['output_prefix']}")
        else:
            print("❌ Experiment failed!")
            if 'error' in result:
                print(f"Error: {result['error']}")
            sys.exit(1)
    
    elif args.command == 'compare-experiments':
        comparison = cli.compare_experiments(args.experiment1, args.experiment2)
        
        print(f"🔍 Comparing experiments: {comparison['experiment1']} vs {comparison['experiment2']}")
        print(f"\nDifferences found: {len(comparison['differences'])}")
        
        for key, diff in comparison['differences'].items():
            print(f"\n  {key}:")
            print(f"    {comparison['experiment1']}: {diff['value1']}")
            print(f"    {comparison['experiment2']}: {diff['value2']}")
            print(f"    Significant change: {diff['significant_change']}")
        
        if comparison['recommendations']:
            print(f"\n📋 Recommendations:")
            for rec in comparison['recommendations']:
                print(f"  • {rec}")
    
    elif args.command == 'generate-report':
        report_file = cli.generate_report(args.experiment, args.format)
        print(f"📄 Report generated: {report_file}")
    
    elif args.command == 'list-experiments':
        print("📋 Available experiments:")
        for config_file in cli.config_dir.glob("*.cfg"):
            print(f"  • {config_file.name}")
    
    elif args.command == 'help':
        if args.topic:
            print(f"📚 Help for topic: {args.topic}")
            # Show topic-specific help
            if args.topic == 'commands':
                print("Available commands: create-experiment, run-experiment, compare-experiments, generate-report, list-experiments")
            elif args.topic == 'config':
                print("Configuration parameters: neuron_count, region_count, plasticity_learning_rate, etc.")
            elif args.topic == 'analysis':
                print("Analysis features: performance metrics, insights, recommendations")
        else:
            parser.print_help()
    
    else:
        parser.print_help()


if __name__ == '__main__':
    main()
