#!/usr/bin/env bash

# Performance monitoring command line interface
# Provides commands for:
# - Viewing current performance metrics
# - Starting/stopping performance monitoring
# - Generating performance reports
# - Analyzing performance bottlenecks

# Configuration
NLM_PERF_CONFIG_DIR="${NLM_PERF_CONFIG_DIR:-/etc/nlm}"
NLM_PERF_LOG_DIR="${NLM_PERF_LOG_DIR:-/var/log/nlm}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Performance monitor binary path
PERF_MONITOR_BIN="${PERF_MONITOR_BIN:-/usr/local/bin/nlm-perf-monitor}"

# Check if performance monitoring is available
check_perf_monitor() {
    if [[ ! -x "$PERF_MONITOR_BIN" ]]; then
        echo -e "${RED}Error: Performance monitor not installed${NC}" >&2
        echo "Please build and install the NLM performance monitoring system:" >&2
        echo "  mkdir build && cd build && cmake -DNLM_PERFORMANCE_ENABLED=ON -DNLM_PERFORMANCE_MONITOR_ENABLED=ON .." >&2
        echo "  make nlm-perf-monitor" >&2
        return 1
    fi
    return 0
}

# Show help information
usage() {
    cat << EOF
NLM Performance Monitor CLI

Usage: nlm-perf [OPTIONS] [COMMAND]

Options:
  --help, -h          Show this help message
  --version           Show version information
  --config FILE       Use specific config file (default: /etc/nlm/perf.conf)

Commands:
  status              Show current performance status
  start               Start performance monitoring
  stop                Stop performance monitoring
  report              Generate performance report
  metrics             Show current metrics
  alerts              Show active alerts
  history             Show performance history
  analyze             Analyze performance for bottlenecks
  benchmarks          Run performance benchmarks

Examples:
  nlm-perf status
  nlm-perf metrics
  nlm-perf report --output report.txt
  nlm-perf analyze --output analysis.json
EOF
}

# Show version information
version() {
    echo "NLM Performance Monitor CLI v1.0.0"
    echo "Built with CMake $(cmake --version | head -1)"
    echo "Performance monitoring: $(grep NLM_PERFORMANCE_ENABLED CMakeLists.txt | head -1)"
}

# Main function
show_help() {
    usage
}

# Check if a command is provided
if [[ $# -eq 0 ]]; then
    show_help
    exit 0
fi

# Parse command
COMMAND="$1"
shift

# Check if performance monitor is available
check_perf_monitor || exit 1

# Dispatch to command functions
case "$COMMAND" in
    "status")
        "$PERF_MONITOR_BIN" status "$@"
        ;;
    "start")
        "$PERF_MONITOR_BIN" start "$@"
        ;;
    "stop")
        "$PERF_MONITOR_BIN" stop "$@"
        ;;
    "report")
        "$PERF_MONITOR_BIN" report "$@"
        ;;
    "metrics")
        "$PERF_MONITOR_BIN" metrics "$@"
        ;;
    "alerts")
        "$PERF_MONITOR_BIN" alerts "$@"
        ;;
    "history")
        "$PERF_MONITOR_BIN" history "$@"
        ;;
    "analyze")
        "$PERF_MONITOR_BIN" analyze "$@"
        ;;
    "benchmarks")
        "$PERF_MONITOR_BIN" benchmarks "$@"
        ;;
    "--help"|"-h")
        show_help
        ;;
    "--version")
        version
        ;;
    *)
        echo -e "${RED}Error: Unknown command '$COMMAND'${NC}" >&2
        show_help
        exit 1
        ;;
esac

# End of script