#!/usr/bin/env bash

# NLM Configuration Script
# Provides convenient configuration options for Phase 2, Phase 4, and Phase 6

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Default configuration values
NLM_NEURON_COUNT=1000
NLM_REGION_COUNT=2
NLM_CONNECTION_PROB=0.1
NLM_SIMULATION_STEPS=2000
NLM_SIMULATION_TIMESTEP=0.001
NLM_RANDOM_SEED=42
NLM_CHECKPOINT_DIR="./checkpoints"
NLM_PHASE="2"

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Print usage information
print_usage() {
    echo "Usage: $0 [OPTIONS]"
    echo ""
    echo "NLM - Neural Learning Machine Configuration Script"
    echo ""
    echo "Options:"
    echo "  --phase N        Set phase: 2, 4, or 6 (default: $NLM_PHASE)"
    echo "  --neurons N      Set neuron count (default: $NLM_NEURON_COUNT)"
    echo "  --regions N      Set region count (default: $NLM_REGION_COUNT)"
    echo "  --connection N    Set connection probability (default: $NLM_CONNECTION_PROB)"
    echo "  --steps N        Set simulation steps (default: $NLM_SIMULATION_STEPS)"
    echo "  --timestep T      Set simulation timestep (default: $NLM_SIMULATION_TIMESTEP)"
    echo "  --seed S         Set random seed (default: $NLM_RANDOM_SEED)"
    echo "  --checkpoint DIR  Set checkpoint directory (default: $NLM_CHECKPOINT_DIR)"
    echo "  --quick           Use quick testing settings (small network)"
    echo "  --demo-phase6     Run Phase 6 integration demo"
    echo "  --demo-phase2     Run Phase 2 basic tests"
    echo "  --demo-phase4     Run Phase 4 experiments"
    echo "  --config-only     Show generated configuration file"
    echo "  --help            Show this help message"
    echo ""
    echo "Phase-specific defaults:"
    echo "  Phase 2: Small network for basic learning demonstration"
    echo "  Phase 4: Medium network with cognitive capabilities"
    echo "  Phase 6: Large network with full integration"
    echo ""
}

# Print progress messages
log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Set phase-specific defaults
set_phase_defaults() {
    case $NLM_PHASE in
        2)
            NLM_NEURON_COUNT=500
            NLM_REGION_COUNT=1
            NLM_CONNECTION_PROB=0.15
            NLM_SIMULATION_STEPS=1000
            log_info "Using Phase 2 settings: Basic neural computation demonstration"
            ;;
        4)
            NLM_NEURON_COUNT=1000
            NLM_REGION_COUNT=2
            NLM_CONNECTION_PROB=0.1
            NLM_SIMULATION_STEPS=2000
            log_info "Using Phase 4 settings: Cognitive capabilities demonstration"
            ;;
        6)
            NLM_NEURON_COUNT=2000
            NLM_REGION_COUNT=3
            NLM_CONNECTION_PROB=0.08
            NLM_SIMULATION_STEPS=5000
            log_info "Using Phase 6 settings: Full integration with all brain systems"
            ;;
        *)
            log_error "Invalid phase: $NLM_PHASE. Using Phase 6 defaults."
            NLM_PHASE=6
            ;;
    esac
}

# Generate configuration file
generate_config() {
    local config_file="$PROJECT_ROOT/configs/nlm_generated.cfg"
    mkdir -p "$PROJECT_ROOT/configs"
    
    cat > "$config_file" << EOF
# Generated NLM Configuration
# Phase: $NLM_PHASE
# Generated by: NLM Configuration Script
# Date: $(date)

# Basic Simulation Parameters
random_seed = $NLM_RANDOM_SEED
simulation_timestep = $NLM_SIMULATION_TIMESTEP
neuron_count = $NLM_NEURON_COUNT
region_count = $NLM_REGION_COUNT
connection_probability = $NLM_CONNECTION_PROB

# Plasticity Settings
stdp_ltp_weight = 0.01
stdp_ltd_weight = 0.012
stdp_time_constant = 20.0
development_synaptogenesis_rate = 0.0001
development_pruning_rate = 0.00001

# Neuromodulation Settings
dopamine_baseline = 0.1
dopamine_modulation = 0.0

# Environment Settings
environment_name = GridWorld
environment_width = 20
environment_height = 20

# Memory System Settings
enable_working_memory = true
enable_episodic_memory = true
enable_associative_memory = true

# Advanced System Settings
enable_prediction = true
enable_neuromodulation = true
enable_development = true
enable_curiosity = true
enable_novelty = true

# Experiment Settings
max_simulation_steps = $NLM_SIMULATION_STEPS
checkpoint_interval = 1000
enable_checkpointing = true
checkpoint_path = "$NLM_CHECKPOINT_DIR/nlm_checkpoint.bin"

# Logging
log_level = INFO
log_to_file = true
log_filename = nlm_phase$NLM_PHASE.log

EOF
    
    log_info "Generated configuration file: $config_file"
    echo "Configuration preview:"
    echo "===================="
    echo "Phase: $NLM_PHASE"
    echo "Neurons: $NLM_NEURON_COUNT"
    echo "Regions: $NLM_REGION_COUNT"
    echo "Connection Probability: $NLM_CONNECTION_PROB"
    echo "Simulation Steps: $NLM_SIMULATION_STEPS"
    echo "Random Seed: $NLM_RANDOM_SEED"
    echo "Checkpoint Directory: $NLM_CHECKPOINT_DIR"
}

# Build and run Phase 6 demo
run_demo_phase6() {
    log_info "Building and running Phase 6 integration demo..."
    
    # Create build directory
    mkdir -p "$PROJECT_ROOT/build"
    cd "$PROJECT_ROOT/build"
    
    # Configure with CMake
    cmake .. -DCMAKE_BUILD_TYPE=Release \
             -DNLM_NEURON_COUNT=$NLM_NEURON_COUNT \
             -DNLM_REGION_COUNT=$NLM_REGION_COUNT \
             -DNLM_CONNECTION_PROB=$NLM_CONNECTION_PROB \
             -DNLM_SIMULATION_STEPS=$NLM_SIMULATION_STEPS \
             -DNLM_RANDOM_SEED=$NLM_RANDOM_SEED
    
    # Build the project
    make -j$(nproc)
    
    if [ -f "nlm_phase6_demo" ]; then
        log_info "Running Phase 6 demo..."
        ./nlm_phase6_demo
        return $?
    else
        log_error "Failed to build nlm_phase6_demo executable"
        return 1
    fi
}

# Build and run Phase 2 demo
run_demo_phase2() {
    log_info "Building and running Phase 2 demo..."
    
    # Create build directory
    mkdir -p "$PROJECT_ROOT/build"
    cd "$PROJECT_ROOT/build"
    
    # Configure with CMake
    cmake .. -DCMAKE_BUILD_TYPE=Release \
             -DNLM_NEURON_COUNT=$NLM_NEURON_COUNT \
             -DNLM_REGION_COUNT=$NLM_REGION_COUNT
    
    # Build the project
    make -j$(nproc)
    
    if [ -f "nlm" ]; then
        log_info "Running Phase 2 demo..."
        ./nlm --neurons $NLM_NEURON_COUNT --regions $NLM_REGION_COUNT
        return $?
    else
        log_error "Failed to build nlm executable"
        return 1
    fi
}

# Build and run Phase 4 demo
run_demo_phase4() {
    log_info "Building and running Phase 4 demo..."
    
    # Create build directory
    mkdir -p "$PROJECT_ROOT/build"
    cd "$PROJECT_ROOT/build"
    
    # Configure with CMake
    cmake .. -DCMAKE_BUILD_TYPE=Release \
             -DNLM_NEURON_COUNT=$NLM_NEURON_COUNT \
             -DNLM_REGION_COUNT=$NLM_REGION_COUNT
    
    # Build the project
    make -j$(nproc)
    
    if [ -f "nlm_phase4_demo" ]; then
        log_info "Running Phase 4 demo..."
        ./nlm_phase4_demo
        return $?
    else
        log_error "Failed to build nlm_phase4_demo executable"
        return 1
    fi
}

# Parse command line arguments
parse_args() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            --phase)
                NLM_PHASE="$2"
                shift 2
                ;;
            --neurons)
                NLM_NEURON_COUNT="$2"
                shift 2
                ;;
            --regions)
                NLM_REGION_COUNT="$2"
                shift 2
                ;;
            --connection)
                NLM_CONNECTION_PROB="$2"
                shift 2
                ;;
            --steps)
                NLM_SIMULATION_STEPS="$2"
                shift 2
                ;;
            --timestep)
                NLM_SIMULATION_TIMESTEP="$2"
                shift 2
                ;;
            --seed)
                NLM_RANDOM_SEED="$2"
                shift 2
                ;;
            --checkpoint)
                NLM_CHECKPOINT_DIR="$2"
                shift 2
                ;;
            --quick)
                NLM_NEURON_COUNT=200
                NLM_REGION_COUNT=1
                NLM_SIMULATION_STEPS=500
                log_warn "Quick mode enabled: Using small network"
                shift 1
                ;;
            --demo-phase6)
                run_demo_phase6
                return $?
                ;;
            --demo-phase2)
                run_demo_phase2
                return $?
                ;;
            --demo-phase4)
                run_demo_phase4
                return $?
                ;;
            --config-only)
                set_phase_defaults
                generate_config
                exit 0
                ;;
            --help)
                print_usage
                exit 0
                ;;
            *)
                log_error "Unknown option: $1"
                print_usage
                exit 1
                ;;
        esac
    done
}

# Main script execution
main() {
    # Parse command line arguments
    parse_args "$@"
    
    # Set phase-specific defaults
    set_phase_defaults
    
    # Generate configuration file
    generate_config
    
    # Print configuration summary
    echo ""
    echo "Configuration Summary:"
    echo "====================="
    echo "Phase: $NLM_PHASE"
    echo "Neurons: $NLM_NEURON_COUNT"
    echo "Regions: $NLM_REGION_COUNT"
    echo "Connection Probability: $NLM_CONNECTION_PROB"
    echo "Simulation Steps: $NLM_SIMULATION_STEPS"
    echo "Timestep: $NLM_SIMULATION_TIMESTEP"
    echo "Random Seed: $NLM_RANDOM_SEED"
    echo "Checkpoint Directory: $NLM_CHECKPOINT_DIR"
    echo ""
    echo "To run a demo, use one of:"
    echo "  $0 --demo-phase2"
    echo "  $0 --demo-phase4"
    echo "  $0 --demo-phase6"
    echo ""
    echo "To see configuration only:"
    echo "  $0 --config-only"
}

# Run main function with all arguments
main "$@"

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
