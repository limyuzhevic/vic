    echo "  --neurons N      Set neuron count (default: $NLM_NEURON_COUNT)"
    echo "  --regions N      Set region count (default: $NLM_REGION_COUNT)"
    echo "  --connection N    Set connection probability (default: $NLM_CONNECTION_PROB)"
    echo "  --steps N        Set simulation steps (default: $NLM_SIMULATION_STEPS)"
    echo "  --timestep T      Set simulation timestep (default: $NLM_SIMULATION_TIMESTEP)"
    echo "  --seed S         Set random seed (default: $NLM_RANDOM_SEED)"
