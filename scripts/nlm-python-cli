def validate_config_file(config_file: str) -> bool:
    """Validate configuration file."""
    if not PYNLM_AVAILABLE:
        logger.error("pynlm not available for validation")
        return False
    
    try:
        logger.info(f"Validating configuration file: {config_file}")
        
        # Load configuration
        config = pynlm.createDefaultConfig()
        if config.loadFromFile(config_file):
            logger.info("✓ Configuration validation successful!")
            
            # Log key configuration details
            logger.info("Configuration summary:")
            logger.info(f"  random_seed: {config.has('random_seed')}")
            logger.info(f"  neuron_count: {config.has('neuron_count')}")
            logger.info(f"  region_count: {config.has('region_count')}")
            logger.info(f"  simulation_timestep: {config.has('simulation_timestep')}")
            
            return True
        else:
            logger.error(f"Failed to load configuration from: {config_file}")
            return False
            
    except Exception as e:
        logger.error(f"Validation failed with error: {e}")
        if logger.level == "DEBUG":
            logger.debug(traceback.format_exc(), verbose=True)
        return False

def export_config(config_file: str) -> bool:
    """Export configuration to file."""
    if not PYNLM_AVAILABLE:
        logger.error("pynlm not available for export")
        return False
    
    try:
        logger.info(f"Exporting configuration to: {config_file}")
        
        config = pynlm.createDefaultConfig()
        config.saveToFile(config_file)
        
        logger.info(f"✓ Configuration exported successfully to {config_file}")
        return True
        
    except Exception as e:
        logger.error(f"Export failed with error: {e}")
        if logger.level == "DEBUG":
            logger.debug(traceback.format_exc(), verbose=True)
        return False

