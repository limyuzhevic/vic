def analyze_brain_state(brain, verbose: bool = False) -> dict:
    """Perform comprehensive brain state analysis."""
    logger.info("=== Brain State Analysis ===")
    
    # Basic statistics
    total_neurons = brain.getTotalNeuronCount()
    total_synapses = brain.getTotalSynapseCount()
    total_spikes = brain.getTotalSpikeCount()
    active_neurons = brain.getActiveNeuronCount()
    firing_neurons = brain.getFiringNeuronCount()
    average_firing_rate = brain.getAverageFiringRate()
    e_i_ratio = brain.getExcitationInhibitionRatio()
    pending_spikes = brain.getPendingSpikeEventCount()
    
    # Calculate derived metrics
    activity_level = (firing_neurons / total_neurons * 100) if total_neurons > 0 else 0.0
    spike_rate_per_neuron = (total_spikes / total_neurons) if total_neurons > 0 else 0.0
    stability = 1.0 / (1.0 + pending_spikes)
    
    # Determine health status
    health_status = "HEALTHY"
    if pending_spikes > 100 or average_firing_rate < 0.1:
        health_status = "UNSTABLE"
    if firing_neurons == 0:
        health_status = "INACTIVE"
    
    # Log analysis results
    logger.info("Analysis Summary:")
    logger.info(f"  Total neurons: {total_neurons}")
    logger.info(f"  Total synapses: {total_synapses}")
    logger.info(f"  Total spikes: {total_spikes}")
    logger.info(f"  Active neurons: {active_neurons}")
    logger.info(f"  Firing neurons: {firing_neurons}")
    logger.info(f"  Average firing rate: {average_firing_rate:.4f} Hz")
    logger.info(f"  Activity level: {activity_level:.2f}%")
    logger.info(f"  E/I ratio: {e_i_ratio:.4f}")
    logger.info(f"  Spike rate per neuron: {spike_rate_per_neuron:.4f}")
    logger.info(f"  Stability metric: {stability:.4f}")
    logger.info(f"  Brain health: {health_status}")
    
    if verbose:
        logger.info("Detailed analysis:")
        logger.info(f"    Network density: {total_synapses / (total_neurons * total_neurons):.6f}")
        logger.info(f"    Firing efficiency: {(firing_neurons / active_neurons * 100) if active_neurons > 0 else 0:.2f}%")
        logger.info(f"    Spike efficiency: {(total_spikes / (firing_neurons * 10)) if firing_neurons > 0 else 0:.2f} spikes per neuron")
    
    return {
        'total_neurons': total_neurons,
        'total_synapses': total_synapses,
        'total_spikes': total_spikes,
        'active_neurons': active_neurons,
        'firing_neurons': firing_neurons,
        'average_firing_rate': average_firing_rate,
        'activity_level': activity_level,
        'e_i_ratio': e_i_ratio,
        'stability': stability,
        'health_status': health_status
    }

def generate_brain_state_report(brain, filename: str) -> bool:
    """Generate a comprehensive brain state report."""
    try:
        logger.info(f"=== Generating Brain State Report: {filename} ===")
        
        analysis = analyze_brain_state(brain, verbose=True)
        
        report = {
            "Report Header": {
                "Title": "NLM Brain State Report",
                "Generated": time.strftime("%Y-%m-%d %H:%M:%S"),
                "Version": "2.0.0",
                "Phase": "6 - Final Integration"
            },
            "Basic Statistics": {
                "Total Neurons": analysis['total_neurons'],
                "Total Synapses": analysis['total_synapses'],
                "Total Spikes": analysis['total_spikes'],
                "Active Neurons": analysis['active_neurons'],
                "Firing Neurons": analysis['firing_neurons'],
                "Average Firing Rate (Hz)": analysis['average_firing_rate'],
                "Activity Level (%)": analysis['activity_level'],
                "E/I Ratio": analysis['e_i_ratio'],
                "Stability Metric": analysis['stability'],
                "Health Status": analysis['health_status']
            },
            "Network Properties": {
                "Network Density": analysis['total_synapses'] / (analysis['total_neurons'] * analysis['total_neurons']) if analysis['total_neurons'] > 0 else 0,
                "Firing Efficiency (%)": (analysis['firing_neurons'] / analysis['active_neurons'] * 100) if analysis['active_neurons'] > 0 else 0,
                "Current Activity": "Active" if analysis['firing_neurons'] > 0 else "Inactive"
            },
            "System Status": {
                "Neuromodulation": "Active" if brain.getDopamine() and brain.getCuriosity() else "Inactive",
                "Memory Systems": "Active" if brain.getWorkingMemory() else "Inactive",
                "Plasticity": "Active" if analysis['total_synapses'] > 0 else "Inactive",
                "Prediction": "Active" if brain.getPredictionSystem() else "Inactive"
            },
            "Recommendations": generate_health_recommendations(analysis)
        }
        
        with open(filename, 'w') as f:
            json.dump(report, f, indent=2)
        
        logger.info(f"✓ Brain state report generated: {filename}")
        return True
        
    except Exception as e:
        logger.error(f"Failed to generate brain state report: {e}")
        return False

def generate_health_recommendations(analysis: dict) -> list:
    """Generate health recommendations based on brain state analysis."""
    recommendations = []
    
    if analysis['total_neurons'] == 0:
        recommendations.append("Increase neuron count or adjust initial conditions")
    
    if analysis['average_firing_rate'] < 0.1:
        recommendations.append("Increase stimulation or adjust plasticity parameters")
    
    if analysis['total_synapses'] == 0:
        recommendations.append("Check synapse formation or structural plasticity settings")
    
    if analysis['activity_level'] < 5:
        recommendations.append("Investigate neural activity and excitability settings")
    
    if analysis['stability'] < 0.5:
        recommendations.append("Review spike event management and network stability")
    
    if analysis['e_i_ratio'] > 10 or analysis['e_i_ratio'] < 0.1:
        recommendations.append("Balance excitation and inhibition in the network")
    
    if analysis['health_status'] != "HEALTHY":
        recommendations.append("Address current health issues before proceeding")
    
    if not recommendations:
        recommendations.append("All systems operating normally")
    
    return recommendations

def monitor_brain_performance(brain, interval: float = 1.0, continuous: bool = False) -> dict:
    """Monitor brain performance metrics."""
    logger.info(f"=== Brain Performance Monitoring ===")
    logger.info(f"Monitoring interval: {interval} seconds")
    logger.info(f"Continuous mode: {'Yes' if continuous else 'No'}")
    
    if continuous:
        logger.info("Continuous monitoring not implemented in Python CLI.")
        logger.info("For continuous monitoring, use the C++ CLI with --monitor flag.")
        return {}
    
    # Perform single monitoring iteration
    logger.info("Performance metrics (single iteration):")
    
    analysis = analyze_brain_state(brain)
    
    monitoring_data = {
        "timestamp": time.strftime("%Y-%m-%d %H:%M:%S"),
        "monitoring_interval": interval,
        "performance_metrics": {
            "neural_activity": f"{analysis['firing_neurons']}/{analysis['total_neurons']}",
            "spike_rate": f"{analysis['average_firing_rate']:.4f} Hz",
            "plasticity_activity": "Active" if analysis['total_synapses'] > 0 else "Inactive",
            "memory_utilization": "Active" if brain.getWorkingMemory() else "Inactive",
            "system_health": analysis['health_status']
        },
        "alerts": []
    }
    
    # Check for performance alerts
    if analysis['firing_neurons'] == 0:
        monitoring_data['alerts'].append("ALERT: No firing neurons detected")
    
    if analysis['average_firing_rate'] < 0.1:
        monitoring_data['alerts'].append("WARNING: Low firing rate detected")
    
    if analysis['stability'] < 0.5:
        monitoring_data['alerts'].append("WARNING: Low stability detected")
    
    if analysis['e_i_ratio'] > 10 or analysis['e_i_ratio'] < 0.1:
        monitoring_data['alerts'].append("WARNING: Unbalanced excitation/inhibition")
    
    logger.info(f"  Neural activity: {monitoring_data['performance_metrics']['neural_activity']}")
    logger.info(f"  Spike rate: {monitoring_data['performance_metrics']['spike_rate']}")
    logger.info(f"  Plasticity activity: {monitoring_data['performance_metrics']['plasticity_activity']}")
    logger.info(f"  System health: {monitoring_data['performance_metrics']['system_health']}")
    
    if monitoring_data['alerts']:
        logger.warning("Alerts:")
        for alert in monitoring_data['alerts']:
            logger.warning(f"    {alert}")
    else:
        logger.info("  No alerts - All systems normal")
    
    return monitoring_data

try:
    import pynlm
    PYNLM_AVAILABLE = True
except ImportError:
    PYNLM_AVAILABLE = False
    print("Warning: pynlm module not available. Some features will be disabled.", file=sys.stderr)

# Global logger (simplified version)
class SimpleLogger:
    def __init__(self, level: str = "INFO"):
        self.level = level.upper()
        self.levels = {
            "DEBUG": 0, "INFO": 1, "WARNING": 2, "ERROR": 3, "CRITICAL": 4
        }
    
    def log(self, level: str, message: str, verbose: bool = False):
        if self.levels.get(level, 1) >= self.levels.get(self.level, 1):
            timestamp = time.strftime("%H:%M:%S")
            print(f"[{timestamp} {level}] {message}")
            if verbose:
                import traceback as tb
                tb.print_stack(file=sys.stderr)
    
    def debug(self, msg: str, verbose: bool = False):
        self.log("DEBUG", msg, verbose)
    
    def info(self, msg: str):
        self.log("INFO", msg)
    
    def warning(self, msg: str, verbose: bool = False):
        self.log("WARNING", msg, verbose)
    
    def error(self, msg: str, verbose: bool = False):
        self.log("ERROR", msg, verbose)
    
    def critical(self, msg: str, verbose: bool = False):
        self.log("CRITICAL", msg, verbose)

logger = SimpleLogger()

