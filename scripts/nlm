#!/usr/bin/env python3
"""
NLM Command Line Tools

Utility tools for the NLM (Neural Learning Machine) brain simulation project.
Provides command-line access to common NLM operations.
"""

import argparse
import sys
import os
import json
import pynlm

def nlm_version():
    """Display NLM version information."""
    print("NLM (Neural Learning Machine)")
    print("Version: 0.1.0")
    print("Python bindings for NLM brain simulation")
    print("Phase 6: Final Integration")

def nlm_create_brain(args):
    """Create a brain with specified configuration."""
    config = pynlm.createDefaultConfig()
    
    # Apply command line overrides
    if args.neuron_count:
        config.set("brain.neuron_count", args.neuron_count)
    if args.region_count:
        config.set("brain.region_count", args.region_count)
    if args.connection_prob:
        config.set("brain.connection_probability", args.connection_prob)
    if args.random_seed:
        config.set("random_seed", args.random_seed)
    if args.simulation_timestep:
        config.set("simulation_timestep", args.simulation_timestep)
    
    # Create and initialize brain
    brain = pynlm.createBrain(config)
    brain.initialize()
    
    print(f"Created brain with {brain.getTotalNeuronCount()} neurons")
    print(f"  Regions: {brain.getRegionCount()}")
    print(f"  Synapses: {brain.getTotalSynapseCount()}")
    
    if args.save:
        brain.save(args.save)
        print(f"Saved brain to: {args.save}")
    
    if args.run_steps:
        print(f"Running {args.run_steps} simulation steps...")
        for step in range(args.run_steps):
            brain.step(step)
            if step % 100 == 0:
                print(f"  Step {step}: {brain.getFiringNeuronCount()} firing neurons")
        
        print(f"\nSimulation complete!")
        print(f"  Total spikes: {brain.getTotalSpikeCount()}")
        print(f"  Average firing rate: {brain.getAverageFiringRate():.2f} Hz")
    
    return brain

def nlm_analyze_brain(brain, args):
    """Analyze and export brain statistics."""
    print("=== Brain Analysis ===")
    print(f"Total neurons: {brain.getTotalNeuronCount()}")
    print(f"Total synapses: {brain.getTotalSynapseCount()}")
    print(f"Active neurons: {brain.getActiveNeuronCount()}")
    print(f"Firing neurons: {brain.getFiringNeuronCount()}")
    print(f"Total spike count: {brain.getTotalSpikeCount()}")
    print(f"Average firing rate: {brain.getAverageFiringRate():.2f} Hz")
    print(f"Excitatory/Inhibitory ratio: {brain.getExcitationInhibitionRatio():.3f}")
    print(f"Developmental stage: {brain.getDevelopmentalStage()}")
    
    if args.json:
        stats = {
            "neuron_count": brain.getTotalNeuronCount(),
            "synapse_count": brain.getTotalSynapseCount(),
            "active_neurons": brain.getActiveNeuronCount(),
            "firing_neurons": brain.getFiringNeuronCount(),
            "total_spikes": brain.getTotalSpikeCount(),
            "avg_firing_rate": brain.getAverageFiringRate(),
            "ei_ratio": brain.getExcitationInhibitionRatio(),
            "developmental_stage": str(brain.getDevelopmentalStage())
        }
        with open(args.json, 'w') as f:
            json.dump(stats, f, indent=2)
        print(f"Statistics saved to JSON: {args.json}")

def nlm_config_command(args):
    """Configuration file management commands."""
    if args.action == "create":
        print("Creating default configuration file...")
        config = pynlm.createDefaultConfig()
        
        # Default values for a typical simulation
        config.set("brain.neuron_count", 1000)
        config.set("brain.region_count", 2)
        config.set("brain.connection_probability", 0.1)
        config.set("plasticity.stdp.learning_rate", 0.01)
        config.set("plasticity.hebbian.learning_rate", 0.001)
        config.set("neuromod.dopamine.scale", 1.0)
        config.set("simulation_timestep", 0.001)
        config.set("log_level", "INFO")
        
        # Save to file
        filename = args.filename if args.filename else "config.json"
        config.saveToFile(filename)
        print(f"Default configuration saved to: {filename}")
        
    elif args.action == "validate":
        print("Configuration validation...")
        try:
            config = pynlm.createDefaultConfig()
            if args.file:
                config.loadFromFile(args.file)
            
            keys = config.getKeys()
            print(f"Configuration contains {len(keys)} parameters:")
            for key in sorted(keys):
                print(f"  {key}")
            
            print(f"✓ Configuration is valid")
            return True
            
        except Exception as e:
            print(f"✗ Configuration validation failed: {e}")
            return False

def nlm_simulate_command(args):
    """Run a simulation with world interaction."""
    print("Setting up simulation...")
    
    # Create brain
    config = pynlm.createDefaultConfig()
    config.set("brain.neuron_count", args.neurons or 500)
    config.set("brain.region_count", 1)
    
    brain = pynlm.createBrain(config)
    brain.initialize()
    
    # Create and configure world
    world = pynlm.createSimpleWorld()
    world.configure(
        width=args.width,
        height=args.height,
        visionWidth=args.vision_width,
        visionHeight=args.vision_height
    )
    world.reset()
    
    # Create agent
    agent = pynlm.createAgentBrain(brain)
    agent.initialize(world)
    
    # Enable subsystems if requested
    if args.reward_modulation:
        agent.enableRewardModulation(True)
    if args.structural_plasticity:
        agent.enableStructuralPlasticity(True)
    if args.development:
        agent.enableDevelopment(True)
    if args.curiosity:
        agent.enableCuriosity(True)
    
    print(f"Starting simulation: {args.steps} steps")
    print(f"  World size: {args.width}x{args.height}")
    print(f"  Vision: {args.vision_width}x{args.vision_height}")
    
    # Run simulation
    for step in range(args.steps):
        world.update(0.1)  # Fixed timestep for simplicity
        
        percept = world.getSensoryPercept()
        agent.processSensoryInput(percept)
        brain.step(step)
        
        action = agent.decodeMotorCommand()
        world.applyMotorCommand(action, world.getSimulationTime())
        
        # Apply reward modulation
        if args.reward_modulation:
            reward = 0.0
            if world.getSensoryPercept().getInternal():
                reward = world.getSensoryPercept().getInternal()[0]
            agent.applyRewardModulation(reward, 0.0)
        
        if args.development:
            agent.updateDevelopment(0.1)
        
        if args.verbose and step % 100 == 0:
            print(f"  Step {step}: firing={brain.getFiringNeuronCount()}, "
                  f"curiosity={agent.getCuriosityLevel():.3f}, "
                  f"novelty={agent.getNoveltyLevel():.3f}")
    
    print("\nSimulation complete!")
    
    # Print final statistics
    print(f"\nFinal Statistics:")
    print(f"  Firing neurons: {brain.getFiringNeuronCount()}")
    print(f"  Total spikes: {brain.getTotalSpikeCount()}")
    print(f"  Avg firing rate: {brain.getAverageFiringRate():.2f} Hz")
    print(f"  Curiosity level: {agent.getCuriosityLevel():.3f}")
    print(f"  Novelty level: {agent.getNoveltyLevel():.3f}")
    print(f"  Developmental stage: {brain.getDevelopmentalStage()}")
    
    if args.save_brain:
        brain.save(args.save_brain)
        print(f"Brain saved to: {args.save_brain}")
    
    return brain, world, agent

def main():
    """Main entry point for NLM command-line tools."""
    parser = argparse.ArgumentParser(
        description="NLM (Neural Learning Machine) Command Line Tools",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  nlm --create --neurons 1000 --steps 100 --save brain.bin
  nlm analyze brain.bin --json stats.json
  nlm config create --neurons 500
  nlm simulate --neurons 1000 --steps 500 --width 20 --height 20
  nlm version
        """
    )
    
    # Top-level subcommands
    subparsers = parser.add_subparsers(dest='command', help='Available commands')
    
    # Version command
    parser_version = subparsers.add_parser('version', help='Show version information')
    parser_version.set_defaults(func=nlm_version)
    
    # Create brain command
    parser_create = subparsers.add_parser('create', help='Create a new brain')
    parser_create.add_argument('--neurons', '-n', type=int, dest='neuron_count',
                               help='Number of neurons (default: 500)')
    parser_create.add_argument('--regions', type=int, dest='region_count',
                               help='Number of brain regions (default: 1)')
    parser_create.add_argument('--conn', type=float, dest='connection_prob',
                               help='Connection probability (default: 0.1)')
    parser_create.add_argument('--seed', type=int, dest='random_seed',
                               help='Random seed for reproducibility')
    parser_create.add_argument('--timestep', type=float, dest='simulation_timestep',
                               help='Simulation timestep (default: 0.001)')
    parser_create.add_argument('--save', '-s', help='Save brain to file')
    parser_create.add_argument('--run', '-r', type=int, dest='run_steps',
                               help='Run simulation for specified number of steps')
    parser_create.set_defaults(func=nlm_create_brain)
    
    # Analyze brain command
    parser_analyze = subparsers.add_parser('analyze', help='Analyze brain state')
    parser_analyze.add_argument('input', help='Input brain file')
    parser_analyze.add_argument('--json', help='Export statistics as JSON file')
    parser_analyze.set_defaults(func=lambda args: None)  # Will be set later
    
    # Config command
    parser_config = subparsers.add_parser('config', help='Configuration management')
    parser_config_sub = parser_config.add_subparsers(dest='action')
    
    parser_config_create = parser_config_sub.add_parser('create', help='Create default config')
    parser_config_create.add_argument('--filename', '-f', help='Output filename')
    
    parser_config_validate = parser_config_sub.add_parser('validate', help='Validate config file')
    parser_config_validate.add_argument('file', help='Configuration file to validate')
    
    parser_config.set_defaults(func=nlm_config_command)
    
    # Simulate command
    parser_simulate = subparsers.add_parser('simulate', help='Run complete simulation')
    parser_simulate.add_argument('--neurons', '-n', type=int, default=500,
                                 help='Number of neurons (default: 500)')
    parser_simulate.add_argument('--width', '-w', type=int, default=16,
                                 help='World width (default: 16)')
    parser_simulate.add_argument('--height', '-h', type=int, default=16,
                                 help='World height (default: 16)')
    parser_simulate.add_argument('--vision-width', type=int, default=8,
                                 help='Vision width (default: 8)')
    parser_simulate.add_argument('--vision-height', type=int, default=8,
                                 help='Vision height (default: 8)')
    parser_simulate.add_argument('--steps', '-s', type=int, default=1000,
                                 help='Number of simulation steps (default: 1000)')
    parser_simulate.add_argument('--save-brain', help='Save final brain state')
    parser_simulate.add_argument('--reward-modulation', action='store_true',
                                 help='Enable reward modulation')
    parser_simulate.add_argument('--structural-plasticity', action='store_true',
                                 help='Enable structural plasticity')
    parser_simulate.add_argument('--development', action='store_true',
                                 help='Enable developmental learning')
    parser_simulate.add_argument('--curiosity', action='store_true',
                                 help='Enable curiosity-driven exploration')
    parser_simulate.add_argument('--verbose', '-v', action='store_true',
                                 help='Verbose output')
    parser_simulate.set_defaults(func=nlm_simulate_command)
    
    # Parse arguments
    args = parser.parse_args()
    
    # Execute command
    try:
        if hasattr(args, 'func'):
            if args.command == 'create':
                nlm_create_brain(args)
            elif args.command == 'analyze':
                nlm_analyze_brain(pynlm.createBrain(pynlm.createDefaultConfig()), args)
            elif args.command == 'config':
                nlm_config_command(args)
            elif args.command == 'simulate':
                nlm_simulate_command(args)
            elif args.command == 'version':
                nlm_version()
            else:
                parser.print_help()
        else:
            parser.print_help()
    except Exception as e:
        print(f"Error: {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()