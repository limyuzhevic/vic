nlm_help() {
    echo "NLM - Neural Learning Machine Command Line Interface"
    echo "====================================================="
    echo ""
    echo "Usage: nlm <command> [options]"
    echo ""
    echo "Commands:"
    echo "  run <config> [steps] [output]     Run simulation"
    echo "  train <epochs> [lr]              Train neural network"
    echo "  analyze <input> [type]            Analyze simulation results"
    echo "  benchmark <type> [duration] [output]  Run performance benchmarks"
    echo "  visualize <input> [format] [scale]  Create visualizations"
    echo "  export <format> <output>           Export data in various formats"
    echo "  help                              Show this help message"
    echo "  version                           Show NLM version"
    echo ""
    echo "Analysis Types:"
    echo "  basic, learning, performance, comprehensive"
    echo ""
    echo "Benchmark Types:"
    echo "  neural, memory, plasticity, comprehensive"
    echo ""
    echo "Export Formats:"
    echo "  json, protobuf, hdf5, csv"
    echo ""
    echo "Visualization Formats:"
    echo "  text, csv, json, plot"
    echo ""
    echo "Examples:"
    echo "  nlm run configs/default.cfg 1000 results.txt"
    echo "  nlm train 20 0.001"
    echo "  nlm analyze simulation_output.txt learning"
    echo "  nlm benchmark neural 60"
    echo "  nlm visualize results.txt plot 1.5"
    echo "  nlm export json brain_state.json"
    echo ""
    echo "Configuration Files:"
    echo "  Look in $NLM_CONFIG_DIR/ for available configs"
    echo ""
    echo "For more information, visit: https://github.com/nlm-project/nlm"
}

