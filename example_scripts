#### `competitive_learning.py` - Multi-Agent Competition

```python
import pynlm
import numpy as np

"""
Multi-agent competitive learning example demonstrating how multiple
agents compete for resources and develop strategies.
"""

def setup_competitive_environment():
    """Setup environment with multiple competing agents."""
    
    # Create world
    world = pynlm.createSimpleWorld()
    world.configure(
        width=60,
        height=60,
        visionWidth=8,
        visionHeight=8
    )
    world.reset()
    world.setRandomSeed(42)  # For reproducible results
    
    # Create resources for competition
    resources = [
        (10, 10, 100.0),
        (50, 20, 150.0),
        (30, 40, 200.0),
        (20, 30, 120.0),
        (40, 50, 180.0)
    ]
    
    for x, y, value in resources:
        world.addObject(pynlm.WorldObject(x, y, pynlm.WorldObjectType.Resource, value=value))
    
    # Create agents with different strategies
    agents = []
    agent_configs = [
        {"name": "Conservative", "neurons": 400, "curiosity": 0.5, "learning_rate": 0.01},
        {"name": "Aggressive", "neurons": 800, "curiosity": 1.5, "learning_rate": 0.03},
        {"name": "Balanced", "neurons": 600, "curiosity": 1.0, "learning_rate": 0.02},
    ]
    
    for i, config in enumerate(agent_configs):
        # Create agent configuration
        agent_config = pynlm.createDefaultConfig()
        agent_config.setInt("brain.neuron_count", config["neurons"])
        agent_config.setFloat("brain.synapse_density", 0.08)
        agent_config.setFloat("plasticity.stdp.learning_rate", config["learning_rate"])
        agent_config.setFloat("neuromod.curiosity.sensitivity", config["curiosity"])
        
        # Create agent
        brain = pynlm.createBrain(agent_config)
        brain.initialize()
        
        agent = pynlm.createAgentBrain(brain)
        agent.initialize(world)
        
        # Set different starting positions
        start_x = (i + 1) * 15
        start_y = (i + 1) * 10
        world.setAgentStart(start_x, start_y)
        
        agents.append({
            'brain': brain,
            'agent': agent,
            'name': config['name'],
            'stats': {
                'resources_found': 0,
                'steps_without_resource': 0,
                'energy_peaks': [],
                'learning_curve': []
            }
        })
    
    return world, agents

def run_competitive_simulation(world, agents, num_steps=800):
    """Run competitive simulation with multiple agents."""
    
    print("Starting competitive learning simulation...")
