# NLM - Example Scripts

## Overview

This directory contains example scripts that demonstrate common use cases and advanced scenarios for the NLM framework. These examples are designed to help you get started with NLM development and showcase various capabilities of the system.

## Available Example Scripts

### 1. Basic Learning Examples

#### `basic_learning.py` - Introduction to NLM Learning

```python
import pynlm
import numpy as np

"""
Basic learning example that demonstrates the fundamental concepts
of NLM: brain creation, sensory processing, and reward-based learning.
"""

def basic_learning_example():
    """Run a basic learning example."""
    print("=== Basic Learning Example ===")
    
    # Create a simple brain configuration
    config = pynlm.createDefaultConfig()
    config.setInt("brain.neuron_count", 500)
    config.setFloat("brain.synapse_density", 0.08)
    config.setFloat("plasticity.stdp.learning_rate", 0.01)
    
    # Create and initialize the brain
    brain = pynlm.createBrain(config)
    brain.initialize()
    
    # Create world and agent
    world = pynlm.createSimpleWorld()
    world.configure(width=30, height=30, visionWidth=8, visionHeight=8)
    world.reset()
    
    agent = pynlm.createAgentBrain(brain)
    agent.initialize(world)
    
    # Enable learning systems
    agent.enableRewardModulation(True)
    agent.enableCuriosity(True)
    
    # Create some resources for the agent to find
    world.addObject(pynlm.WorldObject(10, 10, pynlm.WorldObjectType.Resource, value=100.0))
    world.addObject(pynlm.WorldObject(20, 20, pynlm.WorldObjectType.Resource, value=150.0))
    
    # Run learning simulation
    for step in range(300):
        # Update world
        world.update(0.1)
        
        # Get sensory input
        percept = world.getSensoryPercept()
        agent.processSensoryInput(percept)
        
        # Brain computation
        brain.step(step)
        
        # Get motor command
        motor_cmd = agent.decodeMotorCommand()
        
        # Apply action to world
        world.applyMotorCommand(motor_cmd, world.getSimulationTime())
        
        # Apply reward for finding resources
        agent_x, agent_y = world.getAgentBody().x, world.getAgentBody().y
        reward = 0.0
        
        # Check if agent found a resource (simplified check)
        for obj in [pynlm.WorldObject(10, 10, pynlm.WorldObjectType.Resource, value=100.0),
                    pynlm.WorldObject(20, 20, pynlm.WorldObjectType.Resource, value=150.0)]:
            if abs(agent_x - obj.x) < 2.0 and abs(agent_y - obj.y) < 2.0:
                reward = 10.0
                break
        
        agent.applyRewardModulation(reward, 0.0)
        
        # Print progress every 50 steps
        if step % 50 == 0:
            print(f"Step {step}: Curiosity={agent.getCuriosityLevel():.3f}, "
                  f"Novelty={agent.getNoveltyLevel():.3f}, "
                  f"Firing={brain.getFiringNeuronCount()}, "
                  f"Energy={world.getAgentBody().energy:.1f}")
    
    print("\nLearning Example Complete!")
    print(f"Final curiosity level: {agent.getCuriosityLevel():.3f}")
    print(f"Final developmental stage: {brain.getDevelopmentalStage()}")
    print(f"Total spikes: {brain.getTotalSpikeCount()}")

if __name__ == "__main__":
    basic_learning_example()
```

