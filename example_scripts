#### `benchmarking.py` - Performance Benchmarking

```python
import pynlm
import time
import numpy as np
import matplotlib.pyplot as plt

"""
Performance benchmarking tool for NLM simulations.
Measures execution time, memory usage, and computational efficiency.
"""

class NLMBenchmark:
    """Benchmark class for NLM performance testing."""
    
    def __init__(self):
        self.results = []
    
    def benchmark_simulation(self, config, simulation_steps, description):
        """Benchmark a single simulation configuration."""
        
        print(f"\nBenchmarking: {description}")
        print(f"  Configuration: {config.getKeys()}")
        print(f"  Simulation steps: {simulation_steps}")
        
        # Measure start time
        start_time = time.time()
        
        # Create and run simulation
        brain = pynlm.createBrain(config)
        brain.initialize()
        
        world = pynlm.createSimpleWorld()
        world.configure(30, 30, 8, 8)
        world.reset()
        
        agent = pynlm.createAgentBrain(brain)
        agent.initialize(world)
        
        # Enable learning
        agent.enableRewardModulation(True)
        agent.enableCuriosity(True)
        
        # Run simulation
        for step in range(simulation_steps):
            world.update(0.1)
            percept = world.getSensoryPercept()
            agent.processSensoryInput(percept)
            brain.step(step)
            motor_cmd = agent.decodeMotorCommand()
            world.applyMotorCommand(motor_cmd, world.getSimulationTime())
        
        # Measure end time
        end_time = time.time()
        
        # Calculate performance metrics
        simulation_time = end_time - start_time
        steps_per_second = simulation_steps / simulation_time
        time_per_step_ms = simulation_time * 1000 / simulation_steps
        
        # Get final statistics
        brain_stats = {
            'total_neurons': brain.getTotalNeuronCount(),
            'total_synapses': brain.getTotalSynapseCount(),
            'firing_neurons': brain.getFiringNeuronCount(),
            'average_firing_rate': brain.getAverageFiringRate(),
            'total_spikes': brain.getTotalSpikeCount(),
            'development_stage': brain.getDevelopmentalStage(),
        }
        
        agent_stats = {
            'curiosity_level': agent.getCuriosityLevel(),
            'novelty_level': agent.getNoveltyLevel(),
            'neuromodulation_level': agent.getNeuromodulationLevel(),
            'prediction_error': agent.getPredictionError(),
            'developmental_stage': agent.getDevelopmentalStage(),
        }
        
        # Store results
        result = {
            'description': description,
            'config': config,
            'simulation_steps': simulation_steps,
            'simulation_time': simulation_time,
            'steps_per_second': steps_per_second,
            'time_per_step_ms': time_per_step_ms,
            'brain_stats': brain_stats,
            'agent_stats': agent_stats,
            'timestamp': time.time()
        }
        
        self.results.append(result)
        
        # Print summary
        print(f"  Simulation time: {simulation_time:.3f}s")
        print(f"  Steps per second: {steps_per_second:.1f}")
        print(f"  Time per step: {time_per_step_ms:.3f}ms")
        print(f"  Total neurons: {brain_stats['total_neurons']}")
        print(f"  Total synapses: {brain_stats['total_synapses']}")
        print(f"  Final curiosity: {agent_stats['curiosity_level']:.3f}")
        print(f"  Final developmental stage: {agent_stats['developmental_stage']}")
        
        return result
    
    def run_benchmark_suite(self):
        """Run comprehensive benchmark suite."""
        
        print("=== NLM Performance Benchmark Suite ===")
        
        # Define benchmark configurations
        benchmarks = [
            {
                'name': 'Small Brain (Basic)',
                'config': lambda: self.create_basic_config(200, 0.1),
                'steps': 200
            },
            {
                'name': 'Medium Brain (Learning)',
                'config': lambda: self.create_learning_config(500, 0.08),
                'steps': 500
            },
            {
                'name': 'Large Brain (Complex)',
                'config': lambda: self.create_complex_config(1000, 0.06),
                'steps': 1000
            },
            {
                'name': 'High Plasticity',
                'config': lambda: self.create_high_plasticity_config(800, 0.12),
                'steps': 800
            },
            {
                'name': 'Development Intensive',
                'config': lambda: self.create_development_config(600, 0.07),
                'steps': 600
            },
        ]
        
        # Run each benchmark
        for benchmark in benchmarks:
            config = benchmark['config']()
            self.benchmark_simulation(config, benchmark['steps'], benchmark['name'])
    
    def create_basic_config(self, neuron_count, synapse_density):
        """Create basic configuration for benchmarking."""
        config = pynlm.createDefaultConfig()
        config.setInt("brain.neuron_count", neuron_count)
        config.setFloat("brain.synapse_density", synapse_density)
        return config
    
    def create_learning_config(self, neuron_count, synapse_density):
        """Create learning-focused configuration."""
        config = self.create_basic_config(neuron_count, synapse_density)
        config.setFloat("plasticity.stdp.learning_rate", 0.02)
        config.setBool("neuromod.curiosity.enable", True)
        config.setBool("neuromod.novelty.enable", True)
        return config
    
    def create_complex_config(self, neuron_count, synapse_density):
        """Create complex configuration with advanced features."""
        config = self.create_learning_config(neuron_count, synapse_density)
        config.setBool("plasticity.structural.enable", True)
        config.setBool("development.enabled", True)
        config.setFloat("neuromod.dopamine.scale", 1.5)
        return config
    
    def create_high_plasticity_config(self, neuron_count, synapse_density):
        """Create high plasticity configuration."""
        config = self.create_basic_config(neuron_count, synapse_density)
        config.setFloat("plasticity.stdp.learning_rate", 0.05)
        config.setFloat("plasticity.hebbian.learning_rate", 0.03)
        config.setBool("plasticity.structural.enable", True)
        config.setBool("plasticity.structural.formation_rate", 0.01)
        config.setBool("neuromod.curiosity.enable", True)
        config.setBool("neuromod.novelty.enable", True)
        return config
    
    def create_development_config(self, neuron_count, synapse_density):
        """Create development-focused configuration."""
        config = self.create_learning_config(neuron_count, synapse_density)
        config.setBool("development.enabled", True)
        config.setFloat("development.plasticity_modulation", 1.2)
        config.setBool("neuromod.curiosity.enable", True)
        return config
    
    def analyze_results(self):
        """Analyze benchmark results."""
        
        if not self.results:
            print("No benchmark results to analyze.")
            return
        
        print("\n=== Benchmark Analysis ===")
        
        # Create comparison table
        print("\nBenchmark Results Summary:")
        print("-" * 80)
        print(f"{'Benchmark':<25} {'Steps/sec':<12} {'Time/step(ms)':<15} {'Total Neurons':<15} {'Curiosity':<10}")
        print("-" * 80)
        
        for result in self.results:
            print(f"{result['description']:<25} "
                  f"{result['steps_per_second']:<12.1f} "
                  f"{result['time_per_step_ms']:<15.3f} "
                  f"{result['brain_stats']['total_neurons']:<15} "
                  f"{result['agent_stats']['curiosity_level']:<10.3f}")
        
        # Calculate average performance
        avg_steps_per_second = np.mean([r['steps_per_second'] for r in self.results])
        avg_time_per_step = np.mean([r['time_per_step_ms'] for r in self.results])
        total_neuron_avg = np.mean([r['brain_stats']['total_neurons'] for r in self.results])
        
        print("-" * 80)
        print(f"{'Averages':<25} "
              f"{avg_steps_per_second:<12.1f} "
              f"{avg_time_per_step:<15.3f} "
              f"{total_neuron_avg:<15.0f}")
        
        # Performance analysis
        print("\nPerformance Analysis:")
        print(f"  Most efficient: {max(self.results, key=lambda r: r['steps_per_second'])['description']}")
        print(f"  Fastest configuration: {min(self.results, key=lambda r: r['time_per_step_ms'])['description']}")
        print(f"  Largest simulation: {max(self.results, key=lambda r: r['simulation_steps'])['description']}")
        
        # Correlation analysis
        if len(self.results) > 1:
            curiosity_values = [r['agent_stats']['curiosity_level'] for r in self.results]
            firing_rates = [r['brain_stats']['average_firing_rate'] for r in self.results]
            
            curiosity_firing_corr = np.corrcoef(curiosity_values, firing_rates)[0, 1]
            print(f"  Curiosity vs Firing rate correlation: {curiosity_firing_corr:.3f}")
    
    def save_results(self, filename):
        """Save benchmark results to file."""
        try:
            import json
            
            # Convert results to JSON-serializable format
            serializable_results = []
            for result in self.results:
                serializable_result = result.copy()
                # Convert numpy arrays to lists
                serializable_result['config_dict'] = dict(result['config'].getKeys())
                serializable_results.append(serializable_result)
            
            with open(filename, 'w') as f:
                json.dump(serializable_results, f, indent=2)
            
            print(f"Benchmark results saved to {filename}")
            
        except Exception as e:
            print(f"ERROR: Failed to save results: {e}")
    
    def plot_results(self, output_file="benchmark_results.png"):
        """Plot benchmark results."""
        try:
            import matplotlib.pyplot as plt
            
            if not self.results:
                print("No results to plot.")
                return
            
            fig, ((ax1, ax2), (ax3, ax4)) = plt.subplots(2, 2, figsize=(12, 10))
            
            # Plot 1: Steps per second comparison
            benchmarks = [r['description'] for r in self.results]
            steps_per_second = [r['steps_per_second'] for r in self.results]
            ax1.bar(benchmarks, steps_per_second, color='skyblue')
            ax1.set_title('Simulation Steps per Second')
            ax1.set_ylabel('Steps per Second')
            ax1.tick_params(axis='x', rotation=45)
            
            # Plot 2: Time per step comparison
            time_per_step = [r['time_per_step_ms'] for r in self.results]
            ax2.bar(benchmarks, time_per_step, color='lightgreen')
            ax2.set_title('Time per Simulation Step (ms)')
            ax2.set_ylabel('Time (ms)')
            ax2.tick_params(axis='x', rotation=45)
            
            # Plot 3: Total neurons comparison
            total_neurons = [r['brain_stats']['total_neurons'] for r in self.results]
            ax3.bar(benchmarks, total_neurons, color='salmon')
            ax3.set_title('Total Neurons in Brain')
            ax3.set_ylabel('Neuron Count')
            ax3.tick_params(axis='x', rotation=45)
            
            # Plot 4: Curiosity level comparison
            curiosity_levels = [r['agent_stats']['curiosity_level'] for r in self.results]
            ax4.bar(benchmarks, curiosity_levels, color='gold')
            ax4.set_title('Final Curiosity Level')
            ax4.set_ylabel('Curiosity Level (0-1)')
            ax4.tick_params(axis='x', rotation=45)
            
            plt.tight_layout()
            plt.savefig(output_file, dpi=300, bbox_inches='tight')
            plt.close()
            
            print(f"Benchmark results plot saved to {output_file}")
            
        except ImportError:
            print("Matplotlib not available for plotting")
        except Exception as e:
            print(f"ERROR: Failed to create plot: {e}")

def main():
    """Run comprehensive benchmarking suite."""
    
    print("NLM Performance Benchmarking Suite")
    print("=" * 50)
    
    # Create benchmark suite
    benchmark = NLMBenchmark()
    
    # Run benchmark suite
    benchmark.run_benchmark_suite()
    
    # Analyze results
    benchmark.analyze_results()
    
    # Save results
    benchmark.save_results("benchmark_results.json")
    
    # Create plots
    benchmark.plot_results()
    
    print("\nBenchmarking complete!")
    print("Results saved to benchmark_results.json")
    print("Plot saved to benchmark_results.png")

if __name__ == "__main__":
    main()
