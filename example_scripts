def memory_example():
    """Run a memory development example."""
    print("=== Memory and Development Example ===")
    
    # Create a brain optimized for memory tasks
    config = pynlm.createDefaultConfig()
    config.setInt("brain.neuron_count", 800)
    config.setFloat("brain.synapse_density", 0.05)
    config.setFloat("plasticity.stdp.learning_rate", 0.02)
    config.setFloat("neuromod.dopamine.scale", 1.2)
    config.setBool("neuromod.curiosity.enable", True)
    config.setBool("neuromod.novelty.enable", True)
    config.setBool("development.enabled", True)
    
    # Create brain and agent
    brain = pynlm.createBrain(config)
    brain.initialize()
    
    world = pynlm.createSimpleWorld()
    world.configure(width=40, height=40, visionWidth=10, visionHeight=10)
    world.reset()
    
    agent = pynlm.createAgentBrain(brain)
