    world.addObject(pynlm.WorldObject(35, 35, pynlm.WorldObjectType.Resource, value=200.0))
    world.addObject(pynlm.WorldObject(25, 25, pynlm.WorldObjectType.Hazard, value=-30.0))
    world.addObject(pynlm.WorldObject(30, 30, pynlm.WorldObjectType.Wall, value=0.0))
    
    # Run memory development simulation
    for step in range(500):
        # Update world
        world.update(0.1)
        
        # Get sensory input
        percept = world.getSensoryPercept()
        agent.processSensoryInput(percept)
        
        # Brain computation
        brain.step(step)
        
        # Get motor command
        motor_cmd = agent.decodeMotorCommand()
        
        # Apply action
        world.applyMotorCommand(motor_cmd, world.getSimulationTime())
        
        # Apply reward modulation
        reward = 0.0
        if step % 50 == 0:  # Give small reward for exploration
            reward = 1.0
        
        agent.applyRewardModulation(reward, 0.0)
        
        # Update development
        agent.updateDevelopment(0.1)
        
        # Print development progress
        if step % 100 == 0:
            print(f"Step {step}:")
            print(f"  Developmental Stage: {brain.getDevelopmentalStage()}")
            print(f"  Curiosity Level: {agent.getCuriosityLevel():.3f}")
            print(f"  Novelty Level: {agent.getNoveltyLevel():.3f}")
            print(f"  Prediction Error: {agent.getPredictionError():.3f}")
            print(f"  Firing Rate: {brain.getAverageFiringRate():.3f}")
    
    print("\nMemory Development Example Complete!")
    print(f"Final developmental stage: {brain.getDevelopmentalStage()}")
    print(f"Final memory consolidation: {agent.getNeuromodulationLevel():.3f}")

