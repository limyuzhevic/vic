        world.update(0.1)
        
        # Get sensory input
        percept = world.getSensoryPercept()
        agent.processSensoryInput(percept)
        
        # Brain computation
        brain.step(step)
        
        # Get motor command
        motor_cmd = agent.decodeMotorCommand()
        
        # Apply action
        world.applyMotorCommand(motor_cmd, world.getSimulationTime())
        
        # Apply reward modulation (negative for hazard proximity)
        reward = 0.0
        # Simplified hazard avoidance logic
        
        agent.applyRewardModulation(reward, 0.0)
        
        # Update development
        agent.updateDevelopment(0.1)
        
        # Print progress
        if step % 80 == 0:
            agent_body = world.getAgentBody()
            print(f"Step {step}: "
                  f"Pos=({agent_body.x:.1f},{agent_body.y:.1f}), "
                  f"Energy={agent_body.energy:.1f}, "
                  f"Curiosity={agent.getCuriosityLevel():.3f}, "
                  f"Firing={brain.getFiringNeuronCount()}")
    
    print("\nMoving Hazard Simulation Complete!")
    print(f"Final state:")
    print(f"  Curiosity level: {agent.getCuriosityLevel():.3f}")
    print(f"  Novelty level: {agent.getNoveltyLevel():.3f}")
    print(f"  Survival: {world.getAgentBody().energy > 0}")

def demonstrate_environment_adaptation():
    """Demonstrate agent adaptation to different environments."""
    
    print("\n=== Environment Adaptation Demo ===")
    
    environments = [
        {"name": "Forest", "width": 50, "height": 50, "vision": 8},
        {"name": "Ocean", "width": 60, "height": 40, "vision": 10},
        {"name": "Mountain", "width": 40, "height": 60, "vision": 12},
    ]
    
    for env in environments:
        print(f"\nTesting in {env['name']} environment:")
        
        # Create environment
        world = pynlm.createSimpleWorld()
        world.configure(
            width=env['width'],
            height=env['height'],
            visionWidth=env['vision'],
            visionHeight=env['vision']
        )
        world.reset()
        
        # Create agent
        config = pynlm.createDefaultConfig()
        config.setInt("brain.neuron_count", 500)
        config.setFloat("brain.synapse_density", 0.08)
        
        brain = pynlm.createBrain(config)
        brain.initialize()
        
        agent = pynlm.createAgentBrain(brain)
        agent.initialize(world)
        
        # Run adaptation simulation
        for step in range(100):
            world.update(0.1)
            percept = world.getSensoryPercept()
            agent.processSensoryInput(percept)
            brain.step(step)
            motor_cmd = agent.decodeMotorCommand()
            world.applyMotorCommand(motor_cmd, world.getSimulationTime())
        
        print(f"  Adapted to {env['name']}: "
              f"Curiosity={agent.getCuriosityLevel():.3f}, "
              f"Novelty={agent.getNoveltyLevel():.3f}")
    
    print("\nEnvironment Adaptation Demo Complete!")

if __name__ == "__main__":
    # Run complex environment simulation
    run_complex_environment_simulation()
    
    # Run moving hazard simulation
