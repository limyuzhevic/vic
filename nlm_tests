// Unit test examples
class UnitTestExamples {
public:
    static void basicBrainTest() {
        auto config = std::make_shared<Config>();
        config->set("neuron_count", static_cast<int64_t>(100), ConfigSource::Default);
        config->set("region_count", static_cast<int64_t>(1), ConfigSource::Default);
        
        Brain brain(config);
        assert(brain.getTotalNeuronCount() == 100);
        assert(brain.getRegionCount() == 1);
        
        bool initialized = brain.initialize();
        assert(initialized);
        
        // Test basic step functionality
        for (SimulationStep step = 0; step < 10; ++step) {
            brain.step(step);
        }
        
        NLM_LOG_INFO("Basic brain test passed");
    }
    
    static void connectivityTest() {
        auto config = std::make_shared<Config>();
        config->set("neuron_count", static_cast<int64_t>(200), ConfigSource::Default);
        config->set("region_count", static_cast<int64_t>(2), ConfigSource::Default);
        config->set("connection_probability", 0.15, ConfigSource::Default);
        
        Brain brain(config);
        bool initialized = brain.initialize();
        assert(initialized);
        
        // Verify connectivity
        size_t totalSynapses = brain.getTotalSynapseCount();
        assert(totalSynapses > 0);
        
        // Test step with connectivity
        for (SimulationStep step = 0; step < 50; ++step) {
            brain.step(step);
        }
        
        NLM_LOG_INFO("Connectivity test passed");
    }
    
    static void plasticityTest() {
        auto config = std::make_shared<Config>();
        config->set("neuron_count", static_cast<int64_t>(150), ConfigSource::Default);
        config->set("region_count", static_cast<int64_t>(1), ConfigSource::Default);
        config->set("stdp_ltp_weight", 0.02, ConfigSource::Default);
        config->set("stdp_ltd_weight", 0.015, ConfigSource::Default);
        
        Brain brain(config);
        bool initialized = brain.initialize();
        assert(initialized);
        
        // Enable plasticity
        if (auto* region = brain.getRegion(RegionId(1))) {
            for (auto& syn : region->getSynapses()) {
                syn->enablePlasticity(true, true, false);
            }
        }
        
        // Test plasticity through steps
        for (SimulationStep step = 0; step < 100; ++step) {
            brain.step(step);
        }
        
        NLM_LOG_INFO("Plasticity test passed");
    }
};

// Benchmarking examples
class BenchmarkExamples {
public:
    static void brainStepBenchmark(std::shared_ptr<Brain> brain) {
        PerformanceProfiler profiler;
        profiler.start();
        
        // Warmup
        for (size_t i = 0; i < 100; ++i) {
            brain->step(i);
        }
        
        // Benchmark
        for (size_t i = 0; i < 1000; ++i) {
            brain->step(i);
        }
        
        profiler.stop();
        
        double totalTimeMs = profiler.getWallTimeMs();
        double avgStepTimeMs = totalTimeMs / 1000.0;
        double stepsPerSecond = 1000.0 / (totalTimeMs / 1000.0);
        
        NLM_LOG_INFO(std::string("Step benchmark: ") + std::to_string(stepsPerSecond) + " steps/sec, " + std::to_string(avgStepTimeMs) + " ms/step");
    }
    
    static void memoryUsageBenchmark(std::shared_ptr<Brain> brain) {
        MemoryProfiler memoryProfiler;
        memoryProfiler.startTracking();
        
        // Run simulation with memory monitoring
        for (SimulationStep step = 0; step < 500; ++step) {
            brain->step(step);
            memoryProfiler.takeSample();
        }
        
        memoryProfiler.stopTracking();
        
        double peakMemory = memoryProfiler.getPeakMemoryUsage();
        double avgMemory = memoryProfiler.getAverageMemoryUsage();
        
        NLM_LOG_INFO(std::string("Memory benchmark: Peak ") + std::to_string(peakMemory) + " MB, Avg " + std::to_string(avgMemory) + " MB");
    }
};

// Comparison test examples
class ComparisonExamples {
public:
    static void connectivityComparison() {
        std::vector<std::shared_ptr<Config>> configs;
        
        // Configuration A: Low connectivity
        auto configA = std::make_shared<Config>();
        configA->set("neuron_count", static_cast<int64_t>(500), ConfigSource::Default);
        configA->set("region_count", static_cast<int64_t>(1), ConfigSource::Default);
        configA->set("connection_probability", 0.05, ConfigSource::Default);
        configs.push_back(configA);
        
        // Configuration B: Medium connectivity
        auto configB = std::make_shared<Config>();
        configB->set("neuron_count", static_cast<int64_t>(500), ConfigSource::Default);
        configB->set("region_count", static_cast<int64_t>(2), ConfigSource::Default);
        configB->set("connection_probability", 0.15, ConfigSource::Default);
        configs.push_back(configB);
        
        // Configuration C: High connectivity
        auto configC = std::make_shared<Config>();
        configC->set("neuron_count", static_cast<int64_t>(500), ConfigSource::Default);
        configC->set("region_count", static_cast<int64_t>(3), ConfigSource::Default);
        configC->set("connection_probability", 0.25, ConfigSource::Default);
        configs.push_back(configC);
        
        ComparisonTester comparisonTester;
        auto results = comparisonTester.compare(configs, "Connectivity Comparison Test", 300);
        
        NLM_LOG_INFO("Connectivity comparison completed with " + std::to_string(results.size()) + " configurations");
    }
};

// Stress test examples
class StressExamples {
public:
    static void memoryStressTest() {
        StressTester stressTester;
        
        StressTester::StressTestConfig config;
        config.maxNeurons = 2000;
        config.testMemoryLimits = true;
        config.testPerformanceLimits = false;
        config.testNetworkLimits = false;
        
        auto results = stressTester.runStressTests(config);
        
        for (const auto& result : results) {
            if (result.passed) {
                NLM_LOG_INFO(std::string("Memory stress test passed: ") + result.testName);
            } else {
                NLM_LOG_ERROR(std::string("Memory stress test failed: ") + result.errorMessage);
            }
        }
    }
    
    static void performanceStressTest() {
        StressTester stressTester;
        
        StressTester::StressTestConfig config;
        config.maxNeurons = 1000;
        config.testMemoryLimits = false;
        config.testPerformanceLimits = true;
        config.testNetworkLimits = false;
        
        auto results = stressTester.runStressTests(config);
        
        for (const auto& result : results) {
            if (result.passed) {
                NLM_LOG_INFO(std::string("Performance stress test passed: ") + result.testName);
            } else {
                NLM_LOG_ERROR(std::string("Performance stress test failed: ") + result.errorMessage);
            }
        }
    }
};

// Main test runner
int main(int argc, char** argv) {
    TestCommandLineArgs args = parseArgs(argc, argv);
    
    // Initialize test framework
    auto logger = std::make_shared<Logger>();
    auto consoleLogger = std::make_shared<ConsoleLogger>(args.verbose ? LogLevel::Debug : LogLevel::Info);
    logger->addLogger(consoleLogger);
    Logger::setGlobal(logger);
    
    if (args.testMode == "help") {
        printUsage();
        return 0;
    }
    
    std::cout << "=== NLM Testing Framework Started ===" << std::endl;
    std::cout << "Test mode: " << args.testMode << std::endl;
    std::cout << "Configuration: " << args.configFile << std::endl;
    std::cout << std::endl;
    
    try {
        if (args.testMode == "unit") {
            std::cout << "=== Running Unit Tests ===" << std::endl;
            
            TestSuite testSuite("NLM Unit Tests");
            testSuite.addTest("Basic Brain Test", UnitTestExamples::basicBrainTest);
            testSuite.addTest("Connectivity Test", UnitTestExamples::connectivityTest);
            testSuite.addTest("Plasticity Test", UnitTestExamples::plasticityTest);
            
            auto results = testSuite.runAll();
            TestReporter::printSummary(results);
            
            if (!args.outputFile.empty()) {
                TestReporter::generateReport(results, args.outputFile, TestReporter::ReportFormat::HTML);
                std::cout << "Results saved to: " << args.outputFile << std::endl;
            }
            
        } else if (args.testMode == "benchmark") {
            std::cout << "=== Running Benchmarks ===" << std::endl;
            
            auto config = std::make_shared<Config>();
            config->set("neuron_count", static_cast<int64_t>(args.neurons), ConfigSource::Default);
            config->set("region_count", static_cast<int64_t>(args.regions), ConfigSource::Default);
            config->set("connection_probability", args.connectionProb, ConfigSource::Default);
            
            Brain brain(config);
            if (!brain.initialize()) {
                std::cerr << "Failed to initialize brain for benchmarking" << std::endl;
                return 1;
            }
            
            BenchmarkSuite benchmarkSuite("Brain Benchmarks");
            BenchmarkConfig benchmarkConfig;
            benchmarkConfig.maxIterations = 5;
            benchmarkConfig.warmupSteps = 100;
            
            benchmarkSuite.addBenchmark("Step Performance",
                                       std::bind(BenchmarkExamples::brainStepBenchmark, std::placeholders::_1),
                                       benchmarkConfig);
            
            auto results = benchmarkSuite.runAll(std::make_shared<Brain>(brain));
            
            std::cout << "Benchmark completed with " << results.size() << " tests" << std::endl;
            
            if (!args.outputFile.empty()) {
                TestReporter::generateReport(results, args.outputFile, TestReporter::ReportFormat::JSON);
                std::cout << "Benchmark results saved to: " << args.outputFile << std::endl;
            }
            
        } else if (args.testMode == "compare") {
            std::cout << "=== Running Configuration Comparison ===" << std::endl;
            
            ComparisonExamples::connectivityComparison();
            
            if (!args.outputFile.empty()) {
                std::cout << "Note: Comparison tests don't generate detailed reports in this example" << std::endl;
            }
            
        } else if (args.testMode == "stress") {
            std::cout << "=== Running Stress Tests ===" << std::endl;
            
            if (args.benchmark) {
                StressExamples::performanceStressTest();
            } else if (args.stress) {
                StressExamples::memoryStressTest();
            } else {
                StressExamples::memoryStressTest();
                StressExamples::performanceStressTest();
            }
            
            if (!args.outputFile.empty()) {
                std::cout << "Note: Stress test results don't generate detailed reports in this example" << std::endl;
            }
            
        } else if (args.testMode == "all") {
            std::cout << "=== Running All Tests (Unit + Benchmark + Comparison + Stress) ===" << std::endl;
            
            // Run unit tests
            TestSuite testSuite("Full Test Suite");
            testSuite.addTest("Basic Brain Test", UnitTestExamples::basicBrainTest);
            testSuite.addTest("Connectivity Test", UnitTestExamples::connectivityTest);
            testSuite.addTest("Plasticity Test", UnitTestExamples::plasticityTest);
            
            auto unitResults = testSuite.runAll();
            TestReporter::printSummary(unitResults);
            
            if (!args.outputFile.empty()) {
                std::string unitReport = args.outputFile + "_unit.html";
                TestReporter::generateReport(unitResults, unitReport, TestReporter::ReportFormat::HTML);
                std::cout << "Unit test results saved to: " << unitReport << std::endl;
            }
            
            // Run benchmarks
            auto config = std::make_shared<Config>();
            config->set("neuron_count", static_cast<int64_t>(args.neurons), ConfigSource::Default);
            config->set("region_count", static_cast<int64_t>(args.regions), ConfigSource::Default);
            config->set("connection_probability", args.connectionProb, ConfigSource::Default);
            
            Brain brain(config);
            if (brain.initialize()) {
                BenchmarkSuite benchmarkSuite("Integrated Benchmarks");
                BenchmarkConfig benchmarkConfig;
                benchmarkConfig.maxIterations = 3;
                benchmarkConfig.warmupSteps = 50;
                
                benchmarkSuite.addBenchmark("Step Performance",
                                           std::bind(BenchmarkExamples::brainStepBenchmark, std::placeholders::_1),
                                           benchmarkConfig);
                
                auto benchmarkResults = benchmarkSuite.runAll(std::make_shared<Brain>(brain));
                
                std::cout << "Benchmarks completed with " << benchmarkResults.size() << " tests" << std::endl;
                
                if (!args.outputFile.empty()) {
                    std::string benchmarkReport = args.outputFile + "_benchmark.json";
                    TestReporter::generateReport(benchmarkResults, benchmarkReport, TestReporter::ReportFormat::JSON);
                    std::cout << "Benchmark results saved to: " << benchmarkReport << std::endl;
                }
            }
            
            std::cout << "=== Full Test Suite Complete ===" << std::endl;
        }
        
    } catch (const std::exception& e) {
        std::cerr << "Test suite failed with error: " << e.what() << std::endl;
        return 1;
    }
    
    std::cout << "=== NLM Testing Framework Finished ===" << std::endl;
    
    return 0;
}
