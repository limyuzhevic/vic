using namespace nlm;
using namespace nlm::testing;

// Command-line argument parsing
struct TestCommandLineArgs {
    std::string testMode = "help";  // help, unit, benchmark, compare, stress, all
    std::string configFile = "configs/default.cfg";
    std::string outputFile;
    std::string testName;
    size_t steps = 1000;
    size_t neurons = 500;
    size_t regions = 1;
    double connectionProb = 0.15;
    bool verbose = false;
    bool benchmark = false;
    bool stress = false;
    std::vector<std::string> extraArgs;
};

// Parse command line arguments
TestCommandLineArgs parseArgs(int argc, char** argv) {
    TestCommandLineArgs args;
    
    for (int i = 1; i < argc; ++i) {
        std::string arg(argv[i]);
        
        if (arg == "--help" || arg == "-h") {
            args.testMode = "help";
        } else if (arg == "--unit") {
            args.testMode = "unit";
        } else if (arg == "--benchmark") {
            args.testMode = "benchmark";
            args.benchmark = true;
        } else if (arg == "--compare") {
            args.testMode = "compare";
        } else if (arg == "--stress") {
            args.testMode = "stress";
            args.stress = true;
        } else if (arg == "--all") {
            args.testMode = "all";
        } else if (arg.substr(0, 7) == "--config") {
            if (arg.find('=') != std::string::npos) {
                args.configFile = arg.substr(arg.find('=') + 1);
            } else if (i + 1 < argc) {
                args.configFile = argv[++i];
            }
        } else if (arg == "--output" && i + 1 < argc) {
            args.outputFile = argv[++i];
        } else if (arg == "--test-name" && i + 1 < argc) {
            args.testName = argv[++i];
        } else if (arg == "--steps" && i + 1 < argc) {
            args.steps = std::stoul(argv[++i]);
        } else if (arg == "--neurons" && i + 1 < argc) {
            args.neurons = std::stoul(argv[++i]);
        } else if (arg == "--regions" && i + 1 < argc) {
            args.regions = std::stoul(argv[++i]);
        } else if (arg == "--connection-prob" && i + 1 < argc) {
            args.connectionProb = std::stod(argv[++i]);
        } else if (arg == "--verbose") {
            args.verbose = true;
        } else {
            args.extraArgs.push_back(arg);
        }
    }
    
    return args;
}

