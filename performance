### Example 3: Debugging

```python
from nlm.performance import Debugger

# Create debugger with detailed logging
debugger = Debugger(debug_level="detailed", log_file="simulation_debug.log")

# Start debugging
debugger.start_debugging()

# Run simulation with debugging
for step in range(100):
    try:
        brain.step(step)
        debugger.log_step(step, brain.getTotalSpikeCount())
        
        # Simulate some potential issues
        if step % 50 == 0:
            # Simulate performance issue
            import time
            time.sleep(0.01)
        
        # Simulate memory issue
        if step % 75 == 0:
            # Access large data
            large_data = list(range(1000000))
            debugger.log_memory_usage(step, len(large_data) * 8)  # bytes
            del large_data
            
    except Exception as e:
        debugger.handle_exception(e, step)

# Stop debugging
debug_info = debugger.stop_debugging()

# Analyze debugging results
analysis = debugger.analyze_debugging(debug_info)

print("Debugging Analysis Results:")
print(f"Debug issues detected: {analysis['issues']}")
print(f"Performance bottlenecks: {analysis['bottlenecks']}")
print(f"Memory issues: {analysis['memory_issues']}")
print(f"Error occurrences: {analysis['error_occurrences']}")
```

