### Custom Performance Monitoring

```python
from nlm.performance import BasePerformanceMonitor

class CustomPerformanceMonitor(BasePerformanceMonitor):
    def __init__(self, custom_metrics):
        super().__init__()
        self.custom_metrics = custom_metrics
    
    def collect_custom_metrics(self, step):
        """Collect custom performance metrics."""
        metrics = {}
        
        for metric_name, metric_func in self.custom_metrics.items():
            try:
                metrics[metric_name] = metric_func(step)
            except Exception as e:
                metrics[metric_name] = f"Error: {e}"
        
        return metrics
    
    def analyze_custom_performance(self, performance_data):
        """Analyze custom performance metrics."""
        analysis = {}
        
        for metric_name, values in performance_data.items():
            if isinstance(values, list) and len(values) > 0:
                analysis[metric_name] = {
                    'mean': sum(values) / len(values),
                    'min': min(values),
                    'max': max(values),
                    'std': (sum((x - sum(values)/len(values))**2 for x in values) / len(values))**0.5,
                    'trend': self.calculate_trend(values)
                }
        
        return analysis
    
    def calculate_trend(self, values):
        """Calculate trend for a series of values."""
        if len(values) < 2:
            return "stable"
        
        x = list(range(len(values)))
        y = values
        
        # Simple linear regression
        n = len(x)
        sum_x = sum(x)
        sum_y = sum(y)
        sum_xy = sum(x[i] * y[i] for i in range(n))
        sum_x2 = sum(x[i] ** 2 for i in range(n))
        
        slope = (n * sum_xy - sum_x * sum_y) / (n * sum_x2 - sum_x ** 2)
        
        if abs(slope) < 0.01:
            return "stable"
        elif slope > 0.01:
            return "increasing"
        else:
            return "decreasing"

# Use custom performance monitor
custom_metrics = {
    'cpu_usage': lambda step: brain.get_average_firing_rate() * 0.01,
    'memory_usage': lambda step: brain.get_total_neuron_count() * 0.1,
    'spike_frequency': lambda step: brain.get_total_spike_count() / (step + 1)
}

custom_monitor = CustomPerformanceMonitor(custom_metrics)
```

