### Python API Integration

```python
import pynlm
from nlm.performance import PerformanceMonitor, MemoryManager, Profiler

# Create performance monitoring suite
performance_suite = PerformanceMonitor()
memory_suite = MemoryManager()
profiler_suite = Profiler()

# Start monitoring
performance_suite.start_monitoring()
memory_suite.start_monitoring()
profiler_suite.start_profiling()

# Run simulation
config = pynlm.createDefaultConfig()
brain = pynlm.createBrain(config)
brain.initialize()

for step in range(1000):
    brain.step(step)

# Stop monitoring
perf_data = performance_suite.stop_monitoring()
mem_data = memory_suite.stop_monitoring()
prof_data = profiler_suite.stop_profiling()

# Analyze results
perf_analysis = performance_suite.analyze_performance(perf_data)
mem_analysis = memory_suite.analyze_memory_usage(mem_data)
prof_analysis = profiler_suite.analyze_profiling(prof_data)

# Generate optimization report
optimizer = Optimizer()
optimization_recommendations = optimizer.get_optimization_recommendations({
    **perf_analysis,
    **mem_analysis,
    **prof_analysis
})
```

