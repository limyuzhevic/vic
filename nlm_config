#!/usr/bin/env bash
# nlm_config - Configuration file generator and manager

# Color codes
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

print_info() {
    echo -e "${BLUE}[INFO]${NC} $*"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $*"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $*"
}

# Configuration template generator
generate_config() {
    local filename="${1:-configs/default.cfg}"
    
    print_info "Generating configuration file: $filename"
    
    mkdir -p "$(dirname "$filename")"
    
    cat > "$filename" << 'EOF'
# NLM Configuration File
# Generated by nlm_config tool

# Core Settings
random_seed = 42
simulation_timestep = 0.001
neuron_count = 1000
region_count = 1
connection_probability = 0.1

# STDP Plasticity Parameters
stdp_ltp_weight = 0.01
stdp_ltd_weight = 0.012
stdp_tau = 20.0

# Structural Plasticity
synaptogenesis_rate = 0.0001
pruning_rate = 0.00001

# Memory System Settings
replay_interval = 100
consolidation_interval = 1000

# Development Settings
developmental_stage = 3  # 0=Initial, 1=CriticalPeriod, 2=Maturation, 3=Adult, 4=Aging
plasticity_modifier = 1.0

# Neuromodulation
dopamine_level = 0.0
curiosity_level = 0.0
novelty_level = 0.0
prediction_error = 0.0

# Simulation Parameters
max_steps = 10000
checkpoint_interval = 1000
output_frequency = 100

# Agent Settings
agent_start_x = 10.0
agent_start_y = 10.0
agent_max_energy = 100.0
agent_energy_decay_rate = 0.01

# World Settings
world_width = 20
world_height = 20
vision_width = 8
vision_height = 8
max_energy = 100.0
energy_decay_rate = 0.01

# Sensory Processing
sensory_noise_level = 0.01
sensory_sensitivity = 1.0

# Motor Control
motor_noise_level = 0.05
motor_efficiency = 1.0

# Logging
log_level = "info"
log_file = "nlm.log"
enable_console_output = true
enable_file_output = false

EOF
    
    print_success "Configuration file generated: $filename"
    print_info "You can edit this file to customize your NLM simulation."
}

# Configuration editor
edit_config() {
    local filename="${1:-configs/default.cfg}"
    
    if [ ! -f "$filename" ]; then
        print_error "Configuration file not found: $filename"
        print_info "Use 'nlm_config generate' to create one."
        exit 1
    fi
    
    # Use a simple editor - try nano first, then vi, then cat
    if command -v nano >/dev/null 2>&1; then
        nano "$filename"
    elif command -v vi >/dev/null 2>&1; then
        vi "$filename"
    else
        print_warning "No editor found. Displaying configuration:"
        cat "$filename"
    fi
}

# Configuration validator
validate_config() {
    local filename="${1:-configs/default.cfg}"
    
    if [ ! -f "$filename" ]; then
        print_error "Configuration file not found: $filename"
        return 1
    fi
    
    print_info "Validating configuration file: $filename"
    
    # Basic validation
    local valid=0
    
    # Check for required sections
    if grep -q "random_seed" "$filename"; then
        print_info "✓ random_seed setting found"
        valid=$((valid + 1))
    else
        print_warning "random_seed setting not found (will use default)"
    fi
    
    if grep -q "neuron_count" "$filename"; then
        print_info "✓ neuron_count setting found"
        valid=$((valid + 1))
    else
        print_warning "neuron_count setting not found (will use default)"
    fi
    
    if grep -q "simulation_timestep" "$filename"; then
        print_info "✓ simulation_timestep setting found"
        valid=$((valid + 1))
    else
        print_warning "simulation_timestep setting not found (will use default)"
    fi
    
    # Check for syntax errors (basic)
    if grep -q "=" "$filename"; then
        print_info "✓ Configuration file contains key=value pairs"
        valid=$((valid + 1))
    else
        print_error "Configuration file appears to have syntax errors"
        return 1
    fi
    
    # Count settings
    local settings=$(grep -c "^[^#].*=.*$" "$filename" || true)
    print_info "Found approximately $settings configuration settings"
    
    if [ $valid -ge 3 ]; then
        print_success "Configuration file validation passed"
        return 0
    else
        print_error "Configuration file validation failed"
        return 1
    fi
}

# Configuration summary
config_summary() {
    local filename="${1:-configs/default.cfg}"
    
    if [ ! -f "$filename" ]; then
        print_error "Configuration file not found: $filename"
        return 1
    fi
    
    print_info "Configuration Summary for: $filename"
    echo "================================================"
    
    # Extract key settings with defaults
    local random_seed=$(grep -i "random_seed" "$filename" | head -1 | sed 's/.*= *//')
    local neuron_count=$(grep -i "neuron_count" "$filename" | head -1 | sed 's/.*= *//')
    local region_count=$(grep -i "region_count" "$filename" | head -1 | sed 's/.*= *//')
    local timestep=$(grep -i "simulation_timestep" "$filename" | head -1 | sed 's/.*= *//')
    local conn_prob=$(grep -i "connection_probability" "$filename" | head -1 | sed 's/.*= *//')
    local stdp_ltp=$(grep -i "stdp_ltp_weight" "$filename" | head -1 | sed 's/.*= *//')
    local stdp_ltd=$(grep -i "stdp_ltd_weight" "$filename" | head -1 | sed 's/.*= *//')
    
    # Use defaults if not found
    : ${random_seed:-42}
    : ${neuron_count:-1000}
    : ${region_count:-1}
    : ${timestep:-0.001}
    : ${conn_prob:-0.1}
    : ${stdp_ltp:-0.01}
    : ${stdp_ltd:-0.012}
    
    echo "Core Settings:"
    echo "  Random Seed: $random_seed"
    echo "  Neuron Count: $neuron_count"
    echo "  Region Count: $region_count"
    echo "  Simulation Timestep: $timestep ms"
    echo "  Connection Probability: $conn_prob"
    echo ""
    echo "Plasticity Settings:"
    echo "  STDP LTP Weight: $stdp_ltp"
    echo "  STDP LTD Weight: $stdp_ltd"
    echo ""
    
    # Count additional settings
    local total_settings=$(grep -c "^[^#].*=.*$" "$filename" || true)
    echo "Total Settings: $total_settings"
    
    # Count comments
    local comments=$(grep -c "^#" "$filename" || true)
    echo "Comment Lines: $comments"
    echo ""
    print_success "Configuration summary complete"
}

# Show help
print_help() {
    cat << EOF
NLM Configuration Tool (nlm_config)

USAGE:
  nlm_config [COMMAND] [OPTIONS]

COMMANDS:
  generate FILE               Generate a new configuration file
  edit FILE                   Edit an existing configuration file
  validate FILE               Validate configuration file syntax
  summary FILE                Show configuration summary
  help                        Show this help message

COMMANDS:
  generate                    Create a new configuration file with default values
  edit                        Open configuration file in an editor
  validate                    Check configuration file for syntax errors
  summary                     Display a summary of configuration settings
  help                        Show this help message

EXAMPLES:
  nlm_config generate                     # Create default config file
  nlm_config generate my_config.cfg       # Create custom config file
  nlm_config edit configs/default.cfg     # Edit existing config file
  nlm_config validate my_config.cfg       # Validate config file
  nlm_config summary my_config.cfg        # Show config summary

GLOBAL OPTIONS:
  --help, -h               Show help message
  --version                Show version information

For more detailed help on specific commands, use:
  nlm_config help COMMAND
EOF
}

# Main execution
if [ $# -eq 0 ]; then
    print_help
    exit 0
fi

COMMAND="$1"
shift

case "$COMMAND" in
    "generate")
        generate_config "$1"
        ;;
    "edit")
        edit_config "$1"
        ;;
    "validate")
        validate_config "$1"
        ;;
    "summary")
        config_summary "$1"
        ;;
    "help")
        if [ $# -gt 0 ]; then
            case "$1" in
                "generate")
                    echo "Generate a new configuration file with default values."
                    echo "Usage: nlm_config generate [FILENAME]"
                    echo "Default filename: configs/default.cfg"
                    ;;
                "edit")
                    echo "Edit an existing configuration file."
                    echo "Usage: nlm_config edit FILENAME"
                    ;;
                "validate")
                    echo "Validate configuration file syntax."
                    echo "Usage: nlm_config validate FILENAME"
                    ;;
                "summary")
                    echo "Show configuration summary."
                    echo "Usage: nlm_config summary FILENAME"
                    ;;
                *)
                    print_help
                    ;;
            esac
        else
            print_help
        fi
        ;;
    *)
        print_error "Unknown command: $COMMAND"
        print_help
        exit 1
        ;;
esac
