# NLM Test Framework Package Configuration
# This file is used by CMake's find_package() to locate the NLM test framework.

set(NLM_TEST_FRAMEWORK_FOUND TRUE)

if(NLM_TEST_FRAMEWORK_INCLUDE_DIR)
    set(NLM_TEST_FRAMEWORK_INCLUDE_DIRS ${NLM_TEST_FRAMEWORK_INCLUDE_DIR})
else()
    set(NLM_TEST_FRAMEWORK_INCLUDE_DIRS 
        ${CMAKE_CURRENT_LIST_DIR}/../test_framework
        ${CMAKE_CURRENT_LIST_DIR}/../test_framework/base
        ${CMAKE_CURRENT_LIST_DIR}/../test_framework/types
        ${CMAKE_CURRENT_LIST_DIR}/../test_framework/utils
        ${CMAKE_CURRENT_LIST_DIR}/../test_framework/benchmarks
        ${CMAKE_CURRENT_LIST_DIR}/../test_framework/main
    )
endif()

include(CMakeFindDependencyMacro)

# Find the main NLM library
find_dependency(nlm_core REQUIRED)

# Add the interface library
if(NOT TARGET nlm_test_framework)
    add_library(nlm_test_framework INTERFACE IMPORTED)
    
    set_target_properties(nlm_test_framework PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${NLM_TEST_FRAMEWORK_INCLUDE_DIRS}"
        INTERFACE_LINK_LIBRARIES "nlm_core"
    )
endif()

# Provide summary
message(STATUS "Found NLM Test Framework")
message(STATUS "  Include directories: ${NLM_TEST_FRAMEWORK_INCLUDE_DIRS}")
message(STATUS "  Library dependencies: nlm_core")
