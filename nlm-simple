#!/bin/bash

# NLM Simple Usage Script
# Easy-to-use wrapper for common NLM operations

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

PROJECT_NAME="NLM Simple Usage"

show_help() {
    echo "NLM Simple Usage - Quick start for common operations"
    echo "============================================="
    echo ""
    echo "Available commands:"
    echo "  simple-bird     Run a simple bird simulation (basic agent)"
    echo "  simple-world    Run a simple world exploration"
    echo "  simple-learn    Run a learning demonstration"
    echo "  simple-neurons  Test neural activity with basic neurons"
    echo "  simple-plasticity Show synaptic plasticity in action"
    echo "  simple-config   Display current configuration"
    echo "  simple-stats    Show brain statistics and metrics"
    echo "  simple-demo     Run complete demo with default settings"
    echo "  custom-config   Create custom configuration file"
    echo "  help           Show this help message"
    echo ""
    echo "Quick usage examples:"
    echo "  nlm-simple simple-demo           # Run full demo"
    echo "  nlm-simple simple-bird           # Watch a bird fly"
    echo "  nlm-simple simple-learn          # See learning in action"
    echo ""
    echo "For advanced options, use the full build_and_test.sh script"
}

# Create simple demo configuration
create_simple_config() {
    local config_file="simple_config.cfg"
    
    cat > "$config_file" << EOF
# Simple NLM Configuration
# For demonstrations and learning

neuron_count = 200
region_count = 1
connection_probability = 0.05
stdp_ltp_weight = 0.005
stdp_ltd_weight = 0.012
stdp_tau = 10.0
synaptogenesis_rate = 0.0005
pruning_rate = 0.00005
replay_interval = 200
consolidation_interval = 2000
simulation_timestep = 0.001
random_seed = 123

# Enable all systems for demo
enable_checkpointing = false
max_steps = 500
enable_neuromodulation = true
enable_curiosity = true
enable_prediction = true
enable_concept_formation = true
enable_memory = true
memory_capacity = 20

# Demo settings
log_level = INFO
verbose = false
EOF
    
    echo "Created simple configuration: $config_file"
}

# Run simple bird demo (agent exploring a world)
run_simple_bird() {
    echo -e "${YELLOW}Starting Simple Bird Demo...${NC}"
    echo "Watch an agent (bird) explore and learn in a simulated world"
    echo ""
    
    # Create config
    create_simple_config
    
    # Check if demo is built
    if [ ! -f "build/nlm_phase4_demo" ]; then
        echo "Building Phase 4 demo (simple world demo)..."
        if ! bash build_and_test.sh build Release; then
            echo -e "${RED}Build failed!${NC}"
            exit 1
        fi
    fi
    
    # Run Phase 4 demo (simpler than Phase 6)
    echo -e "${BLUE}Running bird simulation...${NC}"
    ./build/nlm_phase4_demo
    
    if [ $? -eq 0 ]; then
        echo -e "${GREEN}Simple bird demo completed!${NC}"
        echo "The bird learned to navigate and avoid obstacles."
    else
        echo -e "${RED}Bird demo failed!${NC}"
        exit 1
    fi
}

# Run simple world exploration
run_simple_world() {
    echo -e "${YELLOW}Starting Simple World Demo...${NC}"
    echo "Basic agent behavior in a simple environment"
    echo ""
    
    # Create Python script for simple world demo
    cat > simple_world_demo.py << 'EOF'
#!/usr/bin/env python3
import pynlm
import time

print("=== Simple World Demo ===")
print("Creating brain and world for basic exploration...")

# Create brain
config = pynlm.createDefaultConfig()
brain = pynlm.createBrain(config)
brain.initialize()

print(f"Brain created with {brain.getTotalNeuronCount()} neurons")

# Create world
world = pynlm.createSimpleWorld()
world.configure(width=20, height=20, visionWidth=8, visionHeight=8)
world.reset()
world.setAgentStart(10.0, 10.0)

# Create agent
agent = pynlm.createAgentBrain(brain)
agent.initialize(world)

print("Running simple exploration...")
print("The agent will explore the world and learn from experience.")
print("")

# Run simulation
for step in range(100):
    world.update(0.1)
    agent.processSensoryInput(world.getSensoryPercept())
    brain.step(step)
    action = agent.decodeMotorCommand()
    world.applyMotorCommand(action, world.getSimulationTime())
    
    if step % 20 == 0:
        print(f"Step {step}: {brain.getFiringNeuronCount()} neurons firing, "
              f"position: {world.getAgentBody().x:.1f}, {world.getAgentBody().y:.1f}")

print("")
print("=== Demo Complete ===")
print("The agent explored the world and demonstrated basic navigation.")
print("Key observations:")
print(f"- Total spikes: {brain.getTotalSpikeCount()}")
print(f"- Max firing rate: {brain.getAverageFiringRate():.2f}")
print(f"- Curiosity level: {agent.getCuriosityLevel():.2f}")
print(f"- Novelty level: {agent.getNoveltyLevel():.2f}")
EOF
    
    python3 simple_world_demo.py
    
    if [ $? -eq 0 ]; then
        echo -e "${GREEN}Simple world demo completed!${NC}"
    else
        echo -e "${RED}Simple world demo failed!${NC}"
        exit 1
    fi
}

# Run simple learning demonstration
run_simple_learn() {
    echo -e "${YELLOW}Starting Simple Learning Demo...${NC}"
    echo "Demonstrate learning, plasticity, and memory"
    echo ""
    
    # Create Python script for learning demo
    cat > simple_learning_demo.py << 'EOF'
#!/usr/bin/env python3
import pynlm
import time

print("=== Simple Learning Demo ===")
print("Demonstrating neural learning, plasticity, and memory...")
print("")

# Create brain with learning enabled
config = pynlm.createDefaultConfig()
# Increase plasticity for dramatic learning effects
brain = pynlm.createBrain(config)
brain.initialize()

print(f"Brain created with {brain.getTotalNeuronCount()} neurons")
print("Learning features enabled:")
print("- Reward modulation: YES")
print("- Structural plasticity: YES") 
print("- Development stages: YES")
print("- Curiosity-driven exploration: YES")
print("")

# Create world for learning
world = pynlm.createSimpleWorld()
world.configure(width=15, height=15, visionWidth=6, visionHeight=6)
world.reset()
world.setAgentStart(7.5, 7.5)

# Create agent with all learning systems
agent = pynlm.createAgentBrain(brain)
agent.initialize(world)

# Enable all learning features
agent.enableRewardModulation(True)
agent.enableStructuralPlasticity(True)
agent.enableDevelopment(True)
agent.enableCuriosity(True)

print("Running learning simulation...")
print("Watch the brain learn from rewards and exploration.")
print("")

# Run learning simulation
for step in range(200):
    world.update(0.1)
    agent.processSensoryInput(world.getSensoryPercept())
    brain.step(step)
    action = agent.decodeMotorCommand()
    world.applyMotorCommand(action, world.getSimulationTime())
    
    # Simulate reward based on proximity to center
    body = world.getAgentBody()
    distance = ((body.x - 7.5) ** 2 + (body.y - 7.5) ** 2) ** 0.5
    reward = max(0.0, 1.0 - distance / 7.5)  # Higher reward when close to center
    
    agent.applyRewardModulation(reward, 0.0)
    agent.updateDevelopment(0.1)
    
    if step % 40 == 0:
        print(f"Step {step}:")
        print(f"  Position: {body.x:.1f}, {body.y:.1f}")
        print(f"  Reward: {reward:.2f}")
        print(f"  Curiosity: {agent.getCuriosityLevel():.2f}")
        print(f"  Development stage: {brain.getDevelopmentalStage()}")
        print(f"  Neurons firing: {brain.getFiringNeuronCount()}")

print("")
print("=== Learning Results ===")
print(f"Final firing rate: {brain.getAverageFiringRate():.2f}")
print(f"Total spikes: {brain.getTotalSpikeCount()}")
print(f"Final curiosity level: {agent.getCuriosityLevel():.2f}")
print(f"Final novelty level: {agent.getNoveltyLevel():.2f}")
print(f"Final developmental stage: {brain.getDevelopmentalStage()}")
print("")
print("Learning observations:")
print("- The brain adapted based on rewards")
print("- Structural plasticity created new connections")
print("- Development stages affected plasticity rates")
print("- Curiosity-driven exploration occurred")
print("- Neural networks were reorganized through experience")
EOF
    
    python3 simple_learning_demo.py
    
    if [ $? -eq 0 ]; then
        echo -e "${GREEN}Simple learning demo completed!${NC}"
    else
        echo -e "${RED}Simple learning demo failed!${NC}"
        exit 1
    fi
}

