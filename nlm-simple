# Main command processing
main() {
    local command="${1:-help}"
    
    case $command in
        simple-bird)
            run_simple_bird
            ;;
        simple-world)
            run_simple_world
            ;;
        simple-learn)
            run_simple_learn
            ;;
        simple-neurons)
            run_simple_neurons
            ;;
        simple-plasticity)
            run_simple_plasticity
            ;;
        simple-config)
            run_simple_config
            ;;
        simple-stats)
            run_simple_stats
            ;;
        simple-demo)
            run_simple_demo
            ;;
        custom-config)
            run_custom_config
            ;;
        help|*)
            show_help
            ;;
        *)
            echo -e "${RED}Unknown command: $command${NC}"
            echo "Use 'nlm-simple help' to see available commands"
            exit 1
            ;;
    esac
}

# Execute main function with all arguments
main "$@"