    echo -e "${YELLOW}Starting Simple Neuron Test...${NC}"
    echo "Test basic neural activity and spiking"
    echo ""
    
    cat > simple_neuron_test.py << 'EOF'
#!/usr/bin/env python3
import pynlm

print("=== Simple Neuron Test ===")
print("Testing basic neural dynamics and spiking...")
print("")

# Create brain
config = pynlm.createDefaultConfig()
brain = pynlm.createBrain(config)
brain.initialize()

print(f"Brain created: {brain.getTotalNeuronCount()} neurons")
print("")

# Test without any input (silence)
