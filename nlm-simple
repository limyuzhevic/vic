# Run simple plasticity demo
run_simple_plasticity() {
    echo -e "${YELLOW}Starting Simple Plasticity Demo...${NC}"
    echo "Demonstrate synaptic plasticity and learning"
    echo ""
    
    cat > simple_plasticity_demo.py << 'EOF'
#!/usr/bin/env python3
import pynlm

print("=== Simple Plasticity Demo ===")
print("Demonstrating synaptic plasticity mechanisms...")
print("")

# Create brain with high plasticity
config = pynlm.createDefaultConfig()
brain = pynlm.createBrain(config)
brain.initialize()

print(f"Brain created: {brain.getTotalNeuronCount()} neurons")
print("Plasticity systems enabled:")
print("- STDP: YES")
print("- Hebbian: YES")
print("- Structural: YES")
print("- Neuromodulation: YES")
print("")

# Get plasticity systems
stdp = brain.getSTDP()
hebbian = brain.getHebbian()
structural = brain.getStructuralPlasticity()

print("Running plasticity simulation...")
print("Watch synaptic weights change through learning.")
print("")

# Run simulation with plasticity
for step in range(100):
    # Inject activity to trigger plasticity
    brain.injectCurrentToNeurons(pynlm.NeuronType.Internal, 2.0)
    
    # Step the brain (triggers plasticity)
    brain.step(step)
    
    # Check development
    brain.develop()
    
    # Apply some neuromodulation effects
    brain.develop()
    
    if step % 20 == 0:
        print(f"Step {step}:")
        print(f"  Firing neurons: {brain.getFiringNeuronCount()}")
        print(f"  Total spikes: {brain.getTotalSpikeCount()}")
        print(f"  Development stage: {brain.getDevelopmentalStage()}")

print("")
print("=== Plasticity Results ===")
print(f"Average firing rate: {brain.getAverageFiringRate():.2f}")
print(f"Total spikes: {brain.getTotalSpikeCount()}")
print(f"E/I ratio: {brain.getExcitationInhibitionRatio():.2f}")
print("")
print("Plasticity observations:")
print("- STDP strengthens active synapses")
print("- Hebbian learning reinforces correlated activity")
print("- Structural plasticity creates new connections")
print("- Development stages modulate plasticity rates")
print("- Neuromodulation coordinates learning")
EOF
    
    python3 simple_plasticity_demo.py
    
    if [ $? -eq 0 ]; then
        echo -e "${GREEN}Simple plasticity demo completed!${NC}"
    else
        echo -e "${RED}Simple plasticity demo failed!${NC}"
        exit 1
    fi
}

