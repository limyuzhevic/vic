## Usage Examples

### Basic Simulation

```cpp
#include <nlm/core/Config.hpp>
#include <nlm/brain/Brain.hpp>
#include <nlm/core/Logger/Logger.hpp>

int main() {
    // Initialize logging
    auto logger = std::make_shared<nlm::Logger>();
    auto consoleLogger = std::make_shared<nlm::ConsoleLogger>(nlm::LogLevel::Info);
    logger->addLogger(consoleLogger);
    nlm::Logger::setGlobal(logger);
    
    // Create configuration
    auto config = std::make_shared<nlm::Config>();
    config->set("neuron_count", 1000);
    config->set("random_seed", 42);
    
    // Create and initialize brain
    auto brain = std::make_shared<nlm::Brain>(config);
    if (!brain->initialize()) {
        nlm::Logger::getGlobal().error("Failed to initialize brain");
        return 1;
    }
    
    // Run simulation
    for (nlm::SimulationStep step = 0; step < 1000; ++step) {
        brain->step(step, step * 0.001);
    }
    
    // Display results
    brain->logStatus();
    
    return 0;
}
```

### Advanced Configuration

```cpp
#include <nlm/core/Config.hpp>

int main(int argc, char** argv) {
    // Load configuration from file
    auto config = std::make_shared<nlm::Config>();
    if (config->loadFromFile("configs/default.cfg")) {
        std::cout << "Loaded configuration from file" << std::endl;
    }
    
    // Override with command line arguments
    config->loadFromArgs(argc, argv);
    
    // Get configuration values
    std::cout << "Neuron count: " << config->getOr<int64_t>("neuron_count", 1000) << std::endl;
    std::cout << "Timestep: " << config->getOr<double>("simulation_timestep", 0.001) << std::endl;
    
    // Set runtime configuration
    config->set("plasticity_learning_rate", 0.05f);
    config->set("random_seed", 1234567890LL);
    
    // Display configuration summary
    std::cout << config->summary() << std::endl;
    
    return 0;
}
```

### Custom Experiment

```cpp
#include <nlm/brain/Brain.hpp>
#include <nlm/experiments/Phase3Experiment.hpp>

int main() {
    // Create experiment configuration
    nlm::Phase3Config config;
    config.neuronCount = 500;
    config.maxSteps = 2000;
    config.enableLearning = true;
    config.enableDevelopment = true;
    
    // Create and run experiment
    nlm::Phase3Experiment experiment(config);
    nlm::ExperimentResult result = experiment.run();
    
    // Analyze results
    std::cout << "Experiment completed successfully!" << std::endl;
    std::cout << "Total reward: " << result.totalReward << std::endl;
    std::cout << "Success rate: " << result.successRate << std::endl;
    std::cout << "Average firing rate: " << result.avgFiringRate << std::endl;
    
    return 0;
}
```

### Python Integration

```python
import nlm
import numpy as np

# Create brain with Python interface
brain_config = nlm.Config()
brain_config.set("neuron_count", 2000)
brain_config.set("simulation_timestep", 0.0005)

# Initialize brain
brain = nlm.Brain(brain_config)
brain.initialize()

# Run training simulation
for step in range(5000):
    # Inject random sensory input
    input_pattern = np.random.randn(100) * 10.0
    sensory_input = nlm.SensoryInput(input_pattern)
    brain.receiveSensoryInput(sensory_input)
    
    brain.step(step, step * 0.0005)
    
    if step % 1000 == 0:
        print(f"Step {step}: Spikes={brain.getTotalSpikeCount()}")

# Analyze performance
print(f"Final spike count: {brain.getTotalSpikeCount()}")
print(f"Firing neurons: {brain.getFiringNeuronCount()}")
print(f"Excitatory/inhibitory ratio: {brain.getExcitationInhibitionRatio()}")

# Save brain state
brain.saveToCheckpoint("brain_checkpoint.nml")

# Load brain state
loaded_brain = nlm.Brain(brain_config)
loaded_brain.loadFromCheckpoint("brain_checkpoint.nml")
```

