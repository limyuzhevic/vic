# CMake configuration file for Doxygen
doxygen_doxygen_project = "NLM"
doxygen_doxygen_output = "@CMAKE_CURRENT_BINARY_DIR@/docs"
doxygen_doxygen_html = "YES"
doxygen_doxygen_xml = "YES"
doxygen_doxygen_index = "YES"
doxygen_doxygen_generate_treeview = "YES"
doxygen_doxygen_project_logo = "@CMAKE_CURRENT_SOURCE_DIR@/docs/images/logo.png"
doxygen_doxygen_output_directory = "@CMAKE_CURRENT_BINARY_DIR@/docs"
doxygen_doxygen_file_patterns = "*.cpp;*.h;*.hpp;*.cxx;*.cc"
doxygen_doxygen_exclude_patterns = "*/tests/*;*/build/*;*/install/*"
doxygen_doxygen_excluded_groups = ""
doxygen_doxygen_example_patterns = "*.cpp"
doxygen_doxygen_images = "YES"
doxygen_doxygen_input = "@CMAKE_CURRENT_SOURCE_DIR@/src"
doxygen_doxygen_html_extra = "@CMAKE_CURRENT_SOURCE_DIR@/docs/doxygen/html_extra.css"
doxygen_doxygen_index = "YES"
doxygen_doxygen_project_name = "NLM Documentation"
doxygen_doxygen_project_number = "@PROJECT_VERSION@"
doxygen_doxygen_output_language = "English"
doxygen_doxygen_generate_html = "YES"
doxygen_doxygen_generate_latex = "NO"
doxygen_doxygen_generate_man = "NO"
doxygen_doxygen_generate_rtf = "NO"
doxygen_doxygen_generate_xml = "YES"
doxygen_doxygen_generate_docset = "NO"
doxygen_doxygen_generate_braille = "NO"
doxygen_doxygen_generate_texinfo = "NO"
doxygen_doxygen_generate_perl = "NO"
doxygen_doxygen_generate_ps = "NO"
doxygen_doxygen_table_of_contents = "YES"
doxygen_doxygen_verbose = "YES"
doxygen_doxygen_quiet = "NO"
doxygen_doxygen_warn_if_unused = "YES"
doxygen_doxygen_warn_if_undocumented = "YES"
doxygen_doxygen_warn_if_doc = "NO"
doxygen_doxygen_warn_if_todo = "YES"
doxygen_doxygen_enable_preprocessing = "YES"
doxygen_doxygen_disable_macros = ""
doxygen_doxygen_macro_expansion = "YES"
doxygen_doxygen_expand_only_macros = ""
doxygen_doxygen_template = ""
doxygen_doxygen_ignored_warnings = ""
doxygen_doxygen_auto_excluder = ""
doxygen_doxygen_case_sensitive = "YES"
doxygen_doxygen_enable_autoindex = "YES"
doxygen_doxygen_autogen_namespaces = ""
doxygen_doxygen_enable_auto_overview = "YES"
doxygen_doxygen_enable_auto_methods = "YES"
doxygen_doxygen_enable_auto_attrs = "YES"
doxygen_doxygen_enable_auto_files = "YES"
doxygen_doxygen_enable_auto_namespaces = "YES"
