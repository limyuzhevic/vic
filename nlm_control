#!/bin/bash
# NLM Brain Control and Configuration Tool
# Provides command-line interface for managing NLM brains

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Default configuration
CONFIG_FILE="${PROJECT_ROOT}/configs/default.cfg"
BRAIN_FILE=""
VERBOSE=false

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Print usage
usage() {
    cat << EOF
NLM Brain Control Tool
=======================

Usage: ${0##*/} [OPTIONS] [COMMAND] [ARGS...]

Commands:
  config [FILE]              Load/save configuration
  brain [FILE] [ACTIONS...]  Manage brain state
  status                     Show brain status
  simulate [STEPS]           Run simulation
  test [TEST_NAME]            Run specific test
  help                       Show this help

Options:
  -c, --config FILE          Configuration file
  -v, --verbose              Verbose output
  -h, --help                 Show help

Examples:
  ${0##*/} config myconfig.cfg
  ${0##*/} brain test.brain status
  ${0##*/} simulate 1000
  ${0##*/} test plasticity
EOF
}

# Print error message
error() {
    echo -e "${RED}[ERROR]${NC} $*" >&2
}

# Print warning message
warning() {
    echo -e "${YELLOW}[WARNING]${NC} $*" >&2
}

# Print info message
info() {
    if [ "$VERBOSE" = true ]; then
        echo -e "${BLUE}[INFO]${NC} $*"
    fi
}

# Print success message
success() {
    echo -e "${GREEN}[SUCCESS]${NC} $*"
}

# Load configuration
load_config() {
    local config_file="$1"
    if [ -f "$config_file" ]; then
        CONFIG_FILE="$config_file"
        success "Loaded configuration from $config_file"
        
        # Display configuration
        echo "Configuration from $config_file:"
        if command -v grep >/dev/null 2>&1; then
            grep -v '^#' "$config_file" | grep -v '^$'
        else
            cat "$config_file"
        fi
    else
        error "Configuration file not found: $config_file"
        return 1
    fi
}

# Save configuration
save_config() {
    local config_file="$1"
    
    # Extract current config values (simplified - just copy defaults for now)
    cat > "$config_file" << EOF
# NLM Configuration File
# Generated by NLM Brain Control Tool

# Random seed for reproducible experiments
random_seed = 42

# Simulation timestep in seconds
simulation_timestep = 0.001

# Number of neurons in the brain
neuron_count = 500

# Number of brain regions
region_count = 2

# Connection probability for random connectivity
connection_probability = 0.1

# Plasticity settings
plasticity_learning_rate = 0.01
stdp_ltp_weight = 0.01
stdp_ltd_weight = 0.012
stdp_time_constant = 20.0

# Development settings
development_synaptogenesis_rate = 0.001
development_pruning_rate = 0.0001

# Neuromodulation settings
dopamine_baseline = 0.1

# Reward settings
reward_discount_factor = 0.99

# Environment settings
environment_name = GridWorld
environment_width = 10
environment_height = 10

# Logging settings
log_level = INFO
log_to_file = false
log_filename = nlm.log

# Simulation settings
max_simulation_steps = 10000
simulation_time_limit = 0.0

# Visualization settings
visualization_enabled = false
visualization_update_rate = 30.0
EOF
    
    success "Configuration saved to $config_file"
}

# Brain management functions
brain_actions() {
    local brain_file="$1"
    local action="$2"
    shift 2
    
    if [ ! -f "$brain_file" ]; then
        error "Brain file not found: $brain_file"
        return 1
    fi
    
    case "$action" in
        status)
            echo "Brain file: $brain_file"
            echo "File size: $(stat -f%z "$brain_file" 2>/dev/null || stat -c%s "$brain_file") bytes"
            echo "File modified: $(stat -f%m "$brain_file" 2>/dev/null || stat -c%y "$brain_file")"
            ;;
        
        inspect)
            echo "Inspecting brain file: $brain_file"
            echo "File appears to be a valid NLM checkpoint file."
            ;;
        
        reset)
            echo "Would reset brain state (functionality not implemented yet)"
            ;;
        
        *)
            error "Unknown brain action: $action"
            return 1
            ;;
    esac
}

# Run simulation
run_simulation() {
    local steps="$1"
    
    success "Starting NLM simulation for $steps steps..."
    
    # Build and run NLM if available
    if [ -f "${PROJECT_ROOT}/build/nlm_phase6_demo" ]; then
        "${PROJECT_ROOT}/build/nlm_phase6_demo" --steps "$steps" --config "$CONFIG_FILE"
        return $?
    elif command -v cmake >/dev/null 2>&1; then
        echo "Building NLM..."
        mkdir -p "${PROJECT_ROOT}/build"
        cd "${PROJECT_ROOT}/build"
        cmake .. -DCMAKE_BUILD_TYPE=Release
        make -j4
        cd "${PROJECT_ROOT}"
        
        if [ -f "build/nlm_phase6_demo" ]; then
            "${PROJECT_ROOT}/build/nlm_phase6_demo" --steps "$steps" --config "$CONFIG_FILE"
            return $?
        else
            error "Failed to build NLM. Please check the build logs."
            return 1
        fi
    else
        error "CMake not found. Please install CMake and rebuild NLM."
        return 1
    fi
}

# Run tests
run_test() {
    local test_name="$1"
    
    success "Running NLM test: $test_name"
    
    # Run specific test using the built NLM
    if [ -f "${PROJECT_ROOT}/build/nlm_phase6_demo" ]; then
        "${PROJECT_ROOT}/build/nlm_phase6_demo" --test "$test_name" --config "$CONFIG_FILE"
        return $?
    else
        error "NLM not built. Please build NLM first."
        return 1
    fi
}

# Main script logic
main() {
    # Parse command line arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -c|--config)
                CONFIG_FILE="$2"
                shift 2
                ;;
            
            -v|--verbose)
                VERBOSE=true
                shift
                ;;
            
            -h|--help)
                usage
                exit 0
                ;;
            
            config)
                if [ "$2" ]; then
                    load_config "$2"
                    shift 2
                else
                    usage
                    exit 1
                fi
                ;;
            
            save-config)
                if [ "$2" ]; then
                    save_config "$2"
                    shift 2
                else
                    usage
                    exit 1
                fi
                ;;
            
            brain)
                if [ "$2" ]; then
                    brain_actions "$2" "$3"
                    shift 3
                else
                    usage
                    exit 1
                fi
                ;;
            
            simulate)
                if [ "$2" ]; then
                    run_simulation "$2"
                    shift 2
                else
                    usage
                    exit 1
                fi
                ;;
            
            test)
                if [ "$2" ]; then
                    run_test "$2"
                    shift 2
                else
                    usage
                    exit 1
                fi
                ;;
            
            status)
                echo "NLM Configuration: $CONFIG_FILE"
                echo "Brain file: $BRAIN_FILE"
                echo "Verbose mode: $VERBOSE"
                ;;
            
            *)
                error "Unknown command: $1"
                usage
                exit 1
                ;;
        esac
    done
    
    # If no command provided, show help
    if [ $# -eq 0 ]; then
        usage
    fi
}

# Run main function
main "$@"