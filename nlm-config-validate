#!/usr/bin/env python3
"""
NLM Configuration Validation Tool

This tool validates NLM configuration files (JSON/YAML format) and provides
comprehensive analysis of configuration content, including:
- Format validation (JSON/YAML syntax)
- Schema validation against NLM requirements
- Parameter validation and type checking
- Cross-parameter consistency validation
- Error reporting and suggestions

Usage:
    nlm-config-validate [options] <config_file>

Options:
    --format <format>    Expected format: json|yaml (auto-detected by default)
    --schema <file>      Schema file for validation
    --verbose            Show detailed information about validation
    --errors-only        Show only errors, not warnings
    --strict             Enable strict validation mode
    --output <file>      Write validation results to file
    --check-unused       Check for unused configuration parameters
    --validate-types      Validate parameter types and ranges
    --validate-consistency Check for logical consistency between parameters

Examples:
    nlm-config-validate config.json
    nlm-config-validate --format yaml --strict --verbose brain_config.yaml
    nlm-config-validate --schema nlm_schema.json config.json > validation_report.json

Exit codes:
    0 - Success (no errors, warnings are OK)
    1 - Validation failed (errors found)
    2 - Configuration file not found or cannot be read
    3 - Schema file not found or cannot be read
    4 - Invalid command line arguments
    5 - Internal error during validation
"""

import json
import yaml
import sys
