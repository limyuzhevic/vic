{
    "name": "advanced_debug_config",
    "description": "Advanced debugging configuration for NLM with comprehensive monitoring",
    "version": "1.0.0",
    "created": "2026-10-11T14:30:30Z",
    "author": "NLM Development Team",
    "configuration": {
        "console": {
            "enabled": true,
            "autoRefresh": true,
            "refreshInterval": 0.05,
            "enableHistory": true,
            "commandHistorySize": 2000,
            "enableBreakpoints": true,
            "enableWatchVariables": true,
            "enableMemoryProfiling": true,
            "enablePerformanceProfiling": true,
            "enableRealTimeLogging": true,
            "maxLogHistory": 5000,
            "logLevel": "debug",
            "prompt": "nlm> ",
            "title": "NLM Advanced Debug Console",
            "theme": "dark",
            "fontSize": "medium"
        },
        "visualization": {
            "enabled": true,
            "updateInterval": 0.033,
            "enableNetworkView": true,
            "enableSpikeView": true,
            "enableWeightView": true,
            "enableActivityView": true,
            "enableMemoryView": true,
            "enableNeuromodulationView": true,
            "enableDevelopmentView": true,
            "enableConnectivityView": true,
            "enablePlasticityView": true,
            "backend": "opengl",
            "width": 2560,
            "height": 1440,
            "fullscreen": false,
            "showGrid": true,
            "showLabels": true,
            "showTooltips": true,
            "showLegend": true,
            "animationEnabled": true,
            "animationSpeed": 1.0,
            "colorScheme": "neuroscience",
            "neuronSize": "medium",
            "synapseThickness": "medium"
        },
        "dataExporter": {
            "enabled": true,
            "exportFormats": ["csv", "json", "binary", "protobuf", "hdf5"],
            "defaultFormat": "json",
            "outputDirectory": "./exports/advanced",
            "overwriteExisting": false,
            "enableCompression": true,
            "compressionAlgorithm": "zstd",
            "compressionLevel": 9,
            "enableStreaming": true,
            "chunkSize": 4194304,
            "enableValidation": true,
            "enableIntegrityCheck": true,
            "integrityAlgorithm": "sha256",
            "enableVersionControl": true,
            "versionFile": "./exports/advanced/version.json",
            "backupExisting": true,
            "backupRetention": 10,
            "backupDirectory": "./exports/backup",
            "enableProgressReporting": true,
            "progressInterval": 0.5
        },
        "performanceProfiler": {
            "enabled": true,
            "autoProfile": true,
            "profileInterval": 0.05,
            "enableCPUProfiling": true,
            "enableMemoryProfiling": true,
            "enableNeuralProfiling": true,
            "enableSystemProfiling": true,
            "enableNetworkProfiling": true,
            "enableMemoryLeakDetection": true,
            "profileSampleSize": 500,
            "maxMemoryUsage": 2147483648,
            "maxCpuUsage": 100.0,
            "enableAnomalyDetection": true,
            "anomalyThreshold": 3.0,
            "enablePerformanceWarnings": true,
            "enablePerformanceErrorDetection": true,
            "warningThresholds": {
                "memory": 0.8,
                "cpu": 0.8,
                "frameTime": 0.05,
                "memoryGrowth": 0.1,
                "cpuUsageDuration": 60.0
            },
            "errorThresholds": {
                "memory": 0.9,
                "cpu": 0.9,
                "frameTime": 0.1,
                "memoryUsage": 1536.0 * 1024 * 1024,
                "cpuUsage": 90.0
            },
            "enableReportGeneration": true,
            "reportDirectory": "./profiles",
            "reportFormat": "html",
            "generatePerformanceReports": true,
            "generateComparisonReports": true
        },
        "breakpoints": [
            {"step": 0, "description": "Simulation start", "active": true, "type": "start"},
            {"step": 100, "description": "Initial stability check", "active": false, "type": "performance"},
            {"step": 500, "description": "Synaptic weight stability", "active": false, "type": "plasticity"},
            {"step": 1000, "description": "Memory consolidation phase", "active": false, "type": "memory"},
            {"step": 2000, "description": "Mid-simulation checkpoint", "active": false, "type": "general"},
            {"step": 5000, "description": "Learning plateau check", "active": false, "type": "performance"},
            {"step": 10000, "description": "Near end of simulation", "active": false, "type": "general"},
            {"step": 20000, "description": "Simulation end", "active": false, "type": "end"}
        ],
        "watchVariables": [
            {"expression": "brain->getTotalSpikeCount()", "description": "Total spike count", "type": "metric"},
            {"expression": "brain->getFiringNeurons()", "description": "Current firing neurons", "type": "metric"},
            {"expression": "brain->getActiveNeuronCount()", "description": "Active neuron count", "type": "metric"},
            {"expression": "brain->getAverageFiringRate()", "description": "Average firing rate (Hz)", "type": "metric"},
            {"expression": "brain->getExcitationInhibitionRatio()", "description": "E/I ratio", "type": "metric"},
            {"expression": "brain->getTotalNeuronCount()", "description": "Total neuron count", "type": "metric"},
            {"expression": "brain->getTotalSynapseCount()", "description": "Total synapse count", "type": "metric"},
            {"expression": "getWorkingMemorySize()", "description": "Working memory size", "type": "memory"},
            {"expression": "getEpisodicMemorySize()", "description": "Episodic memory size", "type": "memory"},
            {"expression": "getDopamineLevel()", "description": "Dopamine level", "type": "neuromodulation"},
            {"expression": "getCuriosityLevel()", "description": "Curiosity level", "type": "neuromodulation"},
            {"expression": "getNoveltyLevel()", "description": "Novelty level", "type": "neuromodulation"}
        ],
        "simulationSettings": {
            "stepSize": 0.001,
            "maxSteps": 100000,
            "maxTime": 100.0,
            "enableLogging": true,
            "logLevel": "debug",
            "logFile": "./logs/debug.log",
            "enableStructuredLogging": true,
            "logFormat": "json",
            "logRotation": "daily",
            "maxLogFileSize": 100485760,
            "enableConsoleLogging": true,
            "enableFileLogging": true,
            "enablePerformanceLogging": true,
            "performanceLogInterval": 1.0,
            "enableBrainStateLogging": true,
            "brainStateLogInterval": 10.0
        },
        "visualizationSettings": {
            "neuronVisualization": {
                "showConnectivity": true,
                "showActivation": true,
                "showFiringState": true,
                "showType": true,
                "colorByType": true,
                "colorByActivation": true,
                "sizeByImportance": true,
                "showLabels": true,
                "labelFormat": "id"
            },
            "synapseVisualization": {
                "showWeight": true,
                "colorByType": true,
                "colorByStrength": true,
                "thicknessByWeight": true,
                "showDelay": true,
                "showPlasticity": true,
                "showActivity": true
            },
            "activityVisualization": {
                "showFiringRate": true,
                "showSpikeHistory": true,
                "showMembranePotential": true,
                "showRefractoryState": true,
                "showAdaptationVariable": true,
                "showSynapticInput": true
            }
        },
        "exportSettings": {
            "brainExport": {
                "includeNeurons": true,
                "includeSynapses": true,
                "includeRegions": true,
                "includeConnectivity": true,
                "includePlasticity": true,
                "includeMemory": true,
                "includeNeuromodulation": true,
                "includeCognition": true,
                "compressData": true,
                "formatVersion": "2.0"
            },
            "replaySettings": {
                "enableReplay": true,
                "replaySpeed": 1.0,
                "autoReplay": false,
                "replayPath": "./replays",
                "enableCheckpoints": true,
                "checkpointInterval": 1000,
                "enableInterpolation": true,
                "interpolationMethod": "linear"
            }
        }
    }
}
