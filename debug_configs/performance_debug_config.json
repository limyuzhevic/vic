{
    "name": "performance_debug_config",
    "description": "Performance debugging configuration focused on optimization and bottleneck detection",
    "version": "1.0.0",
    "created": "2026-10-11T14:30:30Z",
    "author": "NLM Development Team",
    "configuration": {
        "console": {
            "enabled": true,
            "autoRefresh": false,
            "refreshInterval": 1.0,
            "enableHistory": true,
            "commandHistorySize": 500,
            "enableBreakpoints": true,
            "enableWatchVariables": true,
            "enableMemoryProfiling": true,
            "enablePerformanceProfiling": true,
            "enableRealTimeLogging": false,
            "maxLogHistory": 1000,
            "logLevel": "warning",
            "prompt": "perf> ",
            "title": "NLM Performance Debug Console"
        },
        "visualization": {
            "enabled": false,
            "updateInterval": 0.0,
            "enableNetworkView": false,
            "enableSpikeView": false,
            "enableWeightView": false,
            "enableActivityView": false,
            "enableMemoryView": false,
            "enableNeuromodulationView": false,
            "enableDevelopmentView": false,
            "backend": "software",
            "width": 1920,
            "height": 1080,
            "fullscreen": false,
            "showGrid": false,
            "showLabels": false,
            "showTooltips": false,
            "colorScheme": "default"
        },
        "dataExporter": {
            "enabled": true,
            "exportFormats": ["csv", "json"],
            "defaultFormat": "json",
            "outputDirectory": "./performance_exports",
            "overwriteExisting": true,
            "enableCompression": true,
            "compressionAlgorithm": "gzip",
            "compressionLevel": 9,
            "enableStreaming": true,
            "chunkSize": 8388608,
            "enableValidation": true,
            "enableIntegrityCheck": true,
            "integrityAlgorithm": "sha256",
            "enableVersionControl": true,
            "versionFile": "./performance_exports/version.json",
            "backupExisting": true,
            "backupExtension": ".perf.bak"
        },
        "performanceProfiler": {
            "enabled": true,
            "autoProfile": true,
            "profileInterval": 0.05,
            "enableCPUProfiling": true,
            "enableMemoryProfiling": true,
            "enableNeuralProfiling": true,
            "enableSystemProfiling": true,
            "enableNetworkProfiling": false,
            "enableMemoryLeakDetection": true,
            "enableObjectAllocationTracking": true,
            "profileSampleSize": 200,
            "maxMemoryUsage": 2147483648,
            "maxCpuUsage": 100.0,
            "enableAnomalyDetection": true,
            "anomalyThreshold": 3.0,
            "enablePerformanceWarnings": true,
            "enablePerformanceErrorDetection": true,
            "enableRegressionDetection": true,
            "enableBottleneckAnalysis": true,
            "warningThresholds": {
                "memory": 0.85,
                "cpu": 0.85,
                "frameTime": 0.1,
                "memoryGrowth": 0.05,
                "cpuUsageDuration": 30.0,
                "frameTimeDuration": 10.0
            },
            "errorThresholds": {
                "memory": 0.95,
                "cpu": 0.95,
                "frameTime": 0.2,
                "memoryUsage": 1536.0 * 1024 * 1024,
                "cpuUsage": 90.0,
                "memoryGrowth": 0.1
            },
            "enableReportGeneration": true,
            "reportDirectory": "./performance_reports",
            "reportFormat": "json",
            "generatePerformanceReports": true,
            "generateBottleneckReports": true,
            "generateOptimizationReports": true,
            "generateTrendReports": true
        },
        "breakpoints": [
            {"step": 0, "description": "Performance baseline", "active": true, "type": "baseline"},
            {"step": 500, "description": "Initial performance check", "active": false, "type": "performance"},
            {"step": 1000, "description": "Memory leak detection", "active": false, "type": "memory"},
            {"step": 2000, "description": "/mid-simulation performance check", "active": false, "type": "performance"},
            {"step": 5000, "description": "Performance optimization opportunity", "active": false, "type": "optimization"},
            {"step": 10000, "description": "Late performance check", "active": false, "type": "performance"}
        ],
        "watchVariables": [
            {"expression": "perf->getCPUAverage()", "description": "Average CPU usage", "type": "performance"},
            {"expression": "perf->getMemoryUsage()", "description": "Memory usage", "type": "performance"},
            {"expression": "perf->getFPS()", "description": "Frames per second", "type": "performance"},
            {"expression": "perf->getFrameTime()", "description": "Average frame time", "type": "performance"},
            {"expression": "perf->getMemoryGrowthRate()", "description": "Memory growth rate", "type": "performance"},
            {"expression": "perf->getTotalAllocationCount()", "description": "Total allocation count", "type": "memory"},
            {"expression": "perf->getDeallocationCount()", "description": "Deallocation count", "type": "memory"},
            {"expression": "perf->getMemoryLeakEstimate()", "description": "Memory leak estimate", "type": "memory"}
        ],
        "simulationSettings": {
            "stepSize": 0.001,
            "maxSteps": 50000,
            "maxTime": 50.0,
            "enableLogging": true,
            "logLevel": "warning",
            "logFile": "./logs/performance.log",
            "enableStructuredLogging": false,
            "logFormat": "text",
            "logRotation": "hourly",
            "maxLogFileSize": 10485760,
            "enableConsoleLogging": false,
            "enableFileLogging": true,
            "enablePerformanceLogging": true,
            "performanceLogInterval": 5.0,
            "enableBrainStateLogging": false,
            "brainStateLogInterval": 60.0
        }
    }
}
