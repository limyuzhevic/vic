def main():
    parser = argparse.ArgumentParser(
        description="NLM Brain Control Interface - Advanced brain management for power users",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    
    parser.add_argument(
        'command',
        choices=['status', 'checkpoint', 'config', 'memory', 'neuromod', 'develop', 'test', 'help'],
        help='Command to execute'
    )
    
    parser.add_argument(
        '--checkpoint',
        help='Checkpoint file path (for checkpoint command)'
    )
    
    parser.add_argument(
        '--config',
        help='Configuration file path (for config command)'
    )
    
    parser.add_argument(
        '--verbose', '-v',
        action='store_true',
        help='Enable verbose output'
    )
    
    parser.add_argument(
        '--home',
        default='.',
        help='Path to NLM installation directory'
    )
    
    args = parser.parse_args()
    
    # Initialize controller
    try:
        controller = NLMBrainController(args.home)
    except Exception as e:
        print(f"✗ Failed to initialize NLM controller: {e}")
        sys.exit(1)
    
    # Execute command
    try:
        if args.command == 'status':
            controller.show_brain_status()
        
        elif args.command == 'checkpoint':
            if args.checkpoint:
                # Load from checkpoint
                if not controller.load_brain_from_checkpoint(args.checkpoint):
                    sys.exit(1)
            else:
                # Save to default checkpoint
                if not controller.save_brain_checkpoint():
                    sys.exit(1)
        
        elif args.command == 'config':
            print("Configuration management requires additional implementation")
            print("Current config location:", controller.config_path)
        
        elif args.command == 'memory':
            print("Memory system inspection - requires additional implementation")
        
        elif args.command == 'neuromod':
            print("Neuromodulation control - requires additional implementation")
        
        elif args.command == 'develop':
            print("Development control - requires additional implementation")
        
        elif args.command == 'test':
            controller.run_advanced_tests()
        
        elif args.command == 'help':
            controller.show_help()
            
    except KeyboardInterrupt:
        print("\nOperation cancelled by user")
        sys.exit(0)
    except Exception as e:
        print(f"✗ Command failed: {e}")
        if args.verbose:
            import traceback
            traceback.print_exc()
        sys.exit(1)

if __name__ == '__main__':
    main()