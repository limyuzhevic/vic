// NLM Test Configuration
// Generated by CMake build system

// Test framework configuration
test_framework "google_test"
test_language "C++"
test_standard "C++20"

// Performance testing configuration
performance {
    benchmark_enabled "true"
    benchmark_iterations "1000"
    benchmark_warmup "100"
    benchmark_tolerance "0.01"
}

// Test data management
test_data {
    base_path "${CMAKE_CURRENT_BINARY_DIR}/tests/data"
    auto_generate "true"
    versioning "enabled"
    backup "enabled"
}

// Coverage configuration
coverage {
    enabled "${NLM_ENABLE_COVERAGE}"
    report_format "json"
    threshold "90.0"
}

// Integration testing
integration {
    system_tests "enabled"
    component_tests "enabled"
    interface_tests "enabled"
    performance_tests "enabled"
}

// Build optimization
build {
    optimization_level "${CMAKE_BUILD_TYPE}"
    enable_caching "true"
    enable_incremental "true"
    parallel_build "${NPROC}"
}