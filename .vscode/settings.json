{
    "files.exclude": {
        "**/.git": true,
        "**/.hg": true,
        "**/.svn": true,
        "**/.vscode": true,
        "**/.DS_Store": true,
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/*.so": true,
        "**/*.dylib": true,
        "**/*.dll": true,
        "build/": true,
        "*.log": true
    },
    "files.associations": {
        "*.cfg": "ini"
    },
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.wordWrap": "on",
    "editor.rulers": [
        80,
        120
    ],
    "editor.autoIndent": "full",
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.cursorSurroundingEdges": [
        20,
        40
    ],
    "search.exclude": {
        "**/.git": true,
        "**/.hg": true,
        "**/.svn": true,
        "**/build": true,
        "**/.vscode": true
    },
    "C_Cpp.clangd.path": "${workspaceFolder}}/build/clangd",
    "C_Cpp.default.cppStandard": "c++20",
    "C_Cpp.autocomplete": "Enabled",
    "C_Cpp.errorSquiggles": "Enabled",
    "C_Cpp.intelliSenseEngine": "Enabled",
    "C_Cpp.backgroundAnalysis": "Enabled",
    "C_Cpp.SuggestSystemCppTools": true,
    "C_Cpp.experimentalFeatures": true,
    "cmake.buildDirectory": "${workspaceFolder}}/build",
    "cmake.environment": {
        "PATH": "${env:PATH}:${workspaceFolder}/bin"
    },
    "cmake.configureOnOpen": false,
    "cmake.configureOnCMakeLists": "always",
    "cmake.generator": "Ninja",
    "cmake.buildArgs": "-j$(nproc)",
    "cmake.debugConfig": "Local",
    "cmake.debugVariant": "Debug",
    "cmake.debugEnvironment": "terminal",
    "cmake.debugInitCommands": [],
    "cmake.debugInitBreak": false,
    "cmake.debugStopOnEntry": false,
    "cmake.debugBreakAfterConstruction": true,
    "cmake.debugClearLaunch":"", 
    "cmake.debugClearAnalyze":"",
    "cmake.debugBreakOnCMakeLists":"",
    "cmake.debugBreakOnConfigure":"",
    "cmake.debugBreakOnBuild":"",
    "cmake.debugBreakOnDebug":"",
    "cmake.debugBreakOnRun":"",
    "cmake.debugClearAllBreak":"",
    "cmake.debugUseCMakeServer": true,
    "cmake.debugLogging": true,
    "cmake.debugPerformanceLogging": false,
    "cmake.debugCache": "${workspaceFolder}}/build/cache.cmake",
    "cmake.debugInternalProgress": false,
    "${cmake.sortIncludes": false},
    "${cmake.useCMakeToolchain": false},
    "${cmake.cppdbPath": ""}
}
