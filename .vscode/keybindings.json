{
    "files.associations": {
        "*.hpp": "c++",
        "*.h": "c++",
        "*.cpp": "cpp",
        "*.cc": "cpp",
        "*.cxx": "cpp",
        "*.c": "c"
    },
    "search.exclude": {
        "**/.git": true,
        "**/.vscode": true,
        "**/.idea": true,
        "**/build": true,
        "**/.build": true,
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.pytest_cache": true
    },
    "clangd.arguments": [
        "--background-index",
        "--completion-style=detailed",
        "--clang-tidy",
        "--cross-file-rename",
        "--deep-completion",
        "--enable-config", "--header-insertion=iwyu",
        "--header-insertion-decorators",
        "--log=error",
        "--pretty-status=true"
    ],
    "clangd.onConfigDidChange": {
        "command": "refreshIncludePath"
    },
    "cmake.configurationFilter": "Release",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.formatOnType": true,
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.minimap.enabled": true,
    "editor.wordWrap": "on",
    "editor.mouseWheelZoom": true,
    "editor.cursorSurroundingVisible": false,
    "editor.renderValidationDecorations": "off",
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.suggest.shareSuggestSelections": false,
    "editor.tabCompletion": "on",
    "editor.suggestLoc": "bottom",
    "editor.acceptSuggestionOnEnter": "on",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.guides.brackets": true,
    "workbench.colorTheme": "Default Dark+",
    "workbench.iconTheme": "vscknight",
    "workbench.sideBar.location": "left",
    "workbench.statusBar.visible": true,
    "workbench.activityBar.visible": true,
    "window.title": "${folderName} - ${relativeFile}",
    "window.doubleClickBehavior": "maximize",
    "window.restoreWindows": "all",
    "window.openFilesInNewWindow": "off",
    "window.openFolder": "none",
    "window.newWindowDimensions": "max",
    "window.menuBar": "visible",
    "accessibility.treeLimit": 100,
    "accessibility.alertMode": "sound",
    "accessibility.preciseTime": true,
    "accessibility.signals.tone": true,
    "accessibility.signals.toneFrequency": 440,
    "accessibility.signals.toneVolume": 0.8,
    "accessibility.signals.timeout": 5000
}